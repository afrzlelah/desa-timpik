<style>
  .desktop-dropdown-link {
    display: block;
    padding: 0.75rem;
    border-radius: 0.75rem;
    transition: background-color 180ms ease;
  }

  .desktop-dropdown-link:hover {
    background-color: rgb(239 246 255);
  }

  .desktop-dropdown-link strong {
    display: block;
    color: rgb(15 23 42);
    font-size: 12px;
    font-weight: 800;
  }

  .desktop-dropdown-link span {
    display: block;
    margin-top: 4px;
    color: rgb(100 116 139);
    font-size: 11px;
    line-height: 1.5;
  }

  .mobile-nav-label {
    padding-left: 0.5rem;
    color: rgb(147 197 253);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 44px;
    padding: 0.65rem 0.6rem;
    border-radius: 0.75rem;
    color: rgb(241 245 249);
    font-size: 13px;
    font-weight: 600;
    transition: background-color 180ms ease, color 180ms ease;
  }

  .mobile-nav-link:hover,
  .mobile-nav-link:focus-visible {
    background-color: rgb(255 255 255 / 9%);
    color: white;
    outline: none;
  }

  .mobile-nav-active {
    background-color: rgb(255 255 255 / 13%);
    color: white;
  }

  .mobile-nav-icon {
    width: 27px;
    height: 27px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    background-color: rgb(255 255 255 / 9%);
    color: rgb(147 197 253);
    font-size: 10px;
    font-weight: 800;
  }

  .mobile-nav-icon svg {
    width: 15px;
    height: 15px;
  }

  .mobile-nav-arrow {
    color: rgb(148 163 184);
    font-size: 16px;
    transition: transform 180ms ease;
  }

  .mobile-nav-link:hover .mobile-nav-arrow {
    transform: translateX(3px);
  }

  #mobile-menu {
    transform-origin: top right;
    animation: menuEnter 180ms ease-out;
  }

  @keyframes menuEnter {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #mobile-menu {
      animation: none;
    }

    .mobile-nav-link,
    .mobile-nav-arrow {
      transition: none;
    }
  }
</style>

    <!-- Main Navigation Header (Clean Crisp White & Elegant Blue) -->
    <header class="sticky top-0 z-50 w-full bg-blue-600 text-white border-b border-white/10 shadow-lg shadow-slate-950/10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16 sm:h-[72px] lg:h-20 gap-4">

          <div class="flex items-center gap-3 min-w-0 shrink-0">
            <a href="/" class="flex items-center gap-3 group" aria-label="Beranda Desa Timpik">
              <img
                src="/logo/logo.png"
                alt="Logo Desa Timpik"
                width="50"
                height="50"
                class="w-10 h-10 sm:w-13 sm:h-13 object-contain shrink-0 transition-transform duration-200 group-hover:scale-105"
              />

              <div class="flex flex-col">
                <span class="text-base sm:text-lg font-black tracking-tight text-white uppercase leading-none group-hover:text-blue-200 transition-colors">
                  Desa Timpik
                </span>
                <span class="text-[9px] sm:text-[10px] text-blue-200/80 uppercase tracking-[0.16em] mt-1.5">
