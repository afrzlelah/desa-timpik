---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Website Resmi Pemerintah Desa Timpik, Kecamatan Susukan, Kabupaten Semarang, Jawa Tengah. Portal informasi desa agraris, transparansi, 13 Dusun, potensi kesenian budaya, dan layanan administrasi online."
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title} | Desa Timpik - Kec. Susukan, Kab. Semarang</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="Desa Timpik, Susukan, Kabupaten Semarang, 13 Dusun Timpik, Bogo, Sumber, Krajan, Kencana, Desa Agraris, Wayang Orang Badoyo, Layanan Surat Timpik, KKN Timpik" />
    <meta name="author" content="Pemerintah Desa Timpik & Tim KKN" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={`${title} | Desa Timpik`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/gapura-desa-timpik.jpg" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={`${title} | Desa Timpik`} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="/images/gapura-desa-timpik.jpg" />

    <!-- Security Headers via Meta -->
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta http-equiv="X-XSS-Protection" content="1; mode=block" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
  </head>
  <body class="bg-sky-50 text-slate-900 antialiased flex flex-col min-h-screen font-sans selection:bg-blue-100 selection:text-blue-900">
    
    <!-- Top Sovereign Masthead Bar (Elegant Deep Navy) -->
