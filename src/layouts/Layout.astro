    <!-- Client Scripts: Global Navigation, Hydration & Search Modal -->
    <script>
      // Global Quick Search Modal (Ctrl+K or trigger)
      const searchTrigger = document.getElementById('global-search-trigger');
      const searchModal = document.getElementById('quick-search-modal');
      const closeSearch = document.getElementById('close-search-modal');
      const searchInput = document.getElementById('modal-search-input') as HTMLInputElement | null;
      const resultsContainer = document.getElementById('modal-search-results');
      const quickLinks = document.getElementById('modal-quick-links');

      let searchDebounceTimer: ReturnType<typeof setTimeout> | null = null;

      function openSearch() {
        if (searchModal) {
          searchModal.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
          setTimeout(() => searchInput?.focus(), 50);
        }
      }

      function closeSearchModal() {
        if (searchModal) {
          searchModal.classList.add('hidden');
          document.body.style.overflow = '';
          if (searchInput) searchInput.value = '';
          if (resultsContainer) {
            resultsContainer.innerHTML = '';
            resultsContainer.classList.add('hidden');
          }
          if (quickLinks) quickLinks.classList.remove('hidden');
        }
      }

      searchTrigger?.addEventListener('click', openSearch);
      closeSearch?.addEventListener('click', closeSearchModal);

      // Keyboard Shortcut Ctrl+K / Cmd+K / Esc
      window.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
          e.preventDefault();
          if (searchModal?.classList.contains('hidden')) {
            openSearch();
          } else {
            closeSearchModal();
          }
        }
        if (e.key === 'Escape' && !searchModal?.classList.contains('hidden')) {
          closeSearchModal();
        }
      });

      // Search input live query
      searchInput?.addEventListener('input', (e) => {
        const query = (e.target as HTMLInputElement).value.trim();
        if (searchDebounceTimer) clearTimeout(searchDebounceTimer);

        if (!query) {
          if (resultsContainer) {
            resultsContainer.innerHTML = '';
            resultsContainer.classList.add('hidden');
          }
          if (quickLinks) quickLinks.classList.remove('hidden');
          return;
        }

        searchDebounceTimer = setTimeout(async () => {
          try {
            const res = await fetch(`/api/search.json?q=${encodeURIComponent(query)}`);
            if (res.ok) {
              const data = await res.json();
              renderSearchResults(data.results || []);
            }
          } catch (err) {
            console.warn('Gagal mencari:', err);
          }
        }, 200);
      });

      function escapeSearchText(value: unknown): string {
        return String(value ?? '').replace(/[&<>"']/g, (char) => ({
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          '"': '&quot;',
          "'": '&#39;'
        })[char] ?? char);
      }

      function safeSearchPath(value: unknown): string {
        const path = String(value ?? '');
        if (!path.startsWith('/') || path.startsWith('//')) return '#';
        try {
          const url = new URL(path, window.location.origin);
          return url.origin === window.location.origin ? `${url.pathname}${url.search}${url.hash}` : '#';
        } catch {
          return '#';
        }
      }

      function renderSearchResults(results: Array<{ title: string; category: string; description: string; url: string }>) {
        if (!resultsContainer) return;

        if (quickLinks) quickLinks.classList.add('hidden');
        resultsContainer.classList.remove('hidden');

        if (!Array.isArray(results) || results.length === 0) {
          resultsContainer.innerHTML = `
            <div class="py-6 text-center text-xs text-slate-500">
              Tidak ditemukan hasil. Coba kata kunci lain seperti SKU, beras, atau nama dusun.
            </div>
          `;
          return;
        }

        resultsContainer.innerHTML = results.map((item) => `
          <a href="${safeSearchPath(item.url)}" class="block p-3 rounded-xl hover:bg-blue-50/70 border border-transparent hover:border-blue-200 transition-colors">
            <div class="flex items-center justify-between gap-2">
              <span class="text-xs font-bold text-slate-900">${escapeSearchText(item.title)}</span>
              <span class="text-[10px] uppercase font-bold px-2 py-0.5 rounded bg-blue-100 text-blue-800">${escapeSearchText(item.category)}</span>
            </div>
            <p class="text-[11px] text-slate-500 mt-1 line-clamp-1">${escapeSearchText(item.description)}</p>
          </a>
        `).join('');
      }

      // Close search modal when clicking outside
      searchModal?.addEventListener('click', (e) => {
        if (e.target === searchModal) closeSearchModal();
      });

      // 3. Dynamic Footer Hydration from timpik_kontak_data (if updated by Admin)
      try {
        const storedKontak = localStorage.getItem('timpik_kontak_data');
        if (storedKontak) {
          const parsed = JSON.parse(storedKontak);
          if (parsed && parsed.operasional) {
            const op = parsed.operasional;
            const ftAlamat = document.getElementById('global-footer-alamat');
            if (ftAlamat) ftAlamat.textContent = op.alamat || 'Informasi alamat belum tersedia';

            const ftTelepon = document.getElementById('global-footer-telepon');
            if (ftTelepon) ftTelepon.textContent = op.telepon ? `${op.telepon} (WA Pelayanan)` : 'Nomor WhatsApp belum tersedia';

            const ftEmail = document.getElementById('global-footer-email');
            if (ftEmail) ftEmail.textContent = op.email || 'Email belum tersedia';

            const hdJam = document.getElementById('header-jam-kerja');
            if (hdJam) {
              hdJam.textContent = `Senin–Kamis ${op.jam_senin_kamis || '—'} • Jumat ${op.jam_jumat || '—'}`;
            }
          }
        }
      } catch (err) {
        console.warn('Gagal membaca kontak lokal untuk footer', err);
      }
    </script>
    <script is:inline>
      try {
        const data = JSON.parse(localStorage.getItem('timpik_profil_data') || 'null');
        if (data) {
          const escapeHtml = value => String(value ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
          const safeDusunImage = value => { try { const url = new URL(String(value ?? '')); return url.protocol === 'https:' && url.hostname.endsWith('.supabase.co') && url.pathname.startsWith('/storage/v1/object/public/dusun/') ? url.href : ''; } catch { return ''; } };
          const visi = document.getElementById('profil-visi');
          if (visi) visi.textContent = data.visi ? `“${data.visi}”` : 'Visi desa belum tersedia.';
          const misi = document.getElementById('profil-misi');
          if (misi && Array.isArray(data.misi)) misi.innerHTML = data.misi.map((item, i) => { const kode = typeof item === 'string' ? String(i + 1).padStart(2, '0') : escapeHtml(item?.kode || String(i + 1).padStart(2, '0')); const judul = typeof item === 'string' ? '' : escapeHtml(item?.judul || ''); const deskripsi = typeof item === 'string' ? item : (item?.deskripsi || ''); const poin = Array.isArray(item?.poin) ? item.poin : []; return `<article class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 space-y-3"><div class="flex items-center gap-3"><span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-blue-50 text-sm font-black text-blue-800">${kode}</span>${judul ? `<h3 class="font-bold text-slate-900">${judul}</h3>` : ''}</div>${deskripsi ? `<p class="text-sm sm:text-base text-slate-700 leading-relaxed">${escapeHtml(deskripsi)}</p>` : ''}${poin.length ? `<ul class="space-y-2 pl-5 list-disc text-sm text-slate-700">${poin.map(point => `<li>${escapeHtml(point)}</li>`).join('')}</ul>` : ''}</article>`; }).join('');
          const dusun = document.getElementById('profil-dusun-grid');
          if (dusun && Array.isArray(data.dusun)) dusun.innerHTML = data.dusun.map(d => { const photo = safeDusunImage(d.foto); return `<a href="/dusun/${encodeURIComponent(d.id)}" class="glass-panel group overflow-hidden rounded-2xl border border-slate-200 hover:border-blue-500 hover:shadow-md flex flex-col"><div class="relative aspect-[16/9] bg-gradient-to-br from-blue-100 to-slate-200"><div class="absolute inset-0 flex items-center justify-center text-sm font-semibold text-slate-600">Foto dusun belum tersedia</div>${photo ? `<img src="${escapeHtml(photo)}" alt="Foto wilayah ${escapeHtml(d.nama)}" width="640" height="360" class="dusun-photo relative h-full w-full object-cover" loading="lazy" decoding="async">` : ''}</div><div class="flex flex-1 flex-col p-5"><span class="text-xs font-bold text-blue-800">${escapeHtml(d.panggilan || 'Wilayah Desa Timpik')}</span><h3 class="mt-2 text-lg font-bold text-slate-950">${escapeHtml(d.nama)}</h3><p class="mt-2 flex-1 text-sm leading-6 text-slate-700">${escapeHtml(d.deskripsi || 'Informasi wilayah belum tersedia.')}</p><span class="mt-4 inline-flex min-h-10 items-center font-bold text-blue-800">Lihat profil dusun →</span></div></a>`; }).join('');
          const total = document.getElementById('stat-total-penduduk');
          if (total && data.statistik && Object.hasOwn(data.statistik, 'total_penduduk')) total.textContent = data.statistik.total_penduduk || 'Data belum tersedia';
          const lk = document.getElementById('stat-laki-laki');
          if (lk && data.statistik && Object.hasOwn(data.statistik, 'laki_laki')) lk.textContent = `Laki-laki (${data.statistik.laki_laki || '—'})`;
          const pm = document.getElementById('stat-perempuan');
          if (pm && data.statistik && Object.hasOwn(data.statistik, 'perempuan')) pm.textContent = `Perempuan (${data.statistik.perempuan || '—'})`;
          const alamat = document.getElementById('view-alamat-kantor');
          if (alamat && Object.hasOwn(data, 'alamat_kantor')) alamat.textContent = data.alamat_kantor || 'Alamat belum tersedia.';
          const foto = document.getElementById('foto-struktur-desa');
          const kosong = document.getElementById('foto-struktur-kosong');
          if (foto && Object.hasOwn(data, 'foto_struktur')) {
            if (data.foto_struktur) { foto.src = data.foto_struktur; foto.classList.remove('hidden'); if (kosong) kosong?.classList.add('hidden'); }
            else { foto.classList.add('hidden'); if (kosong) kosong?.classList.remove('hidden'); }
          }
        }
      } catch (error) { console.warn('Profil lokal tidak dapat dibaca.', error); }
    </script>
    <script>
      const mobileMenuButton = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      const mobileBackdrop = document.getElementById('mobile-menu-backdrop');
      const mobileCloseButton = document.getElementById('mobile-menu-close');
      const menuIconOpen = document.getElementById('menu-icon-open');
      const menuIconClose = document.getElementById('menu-icon-close');
    
      const setMobileMenu = (isOpen: boolean) => {
        if (!mobileMenu || !mobileBackdrop || !mobileMenuButton) return;
    
        mobileMenu.classList.toggle('hidden', !isOpen);
        mobileBackdrop.classList.toggle('hidden', !isOpen);
    
        mobileMenuButton.setAttribute('aria-expanded', String(isOpen));
        mobileMenu.setAttribute('aria-hidden', String(!isOpen));
        mobileMenu.toggleAttribute('inert', !isOpen);
    
        menuIconOpen?.classList.toggle('hidden', isOpen);
        menuIconClose?.classList.toggle('hidden', !isOpen);
    
        document.body.style.overflow = isOpen ? 'hidden' : '';
    
        if (isOpen) {
          mobileCloseButton?.focus();
        } else {
          mobileMenuButton.focus();
        }
      };
    
      mobileMenuButton?.addEventListener('click', () => {
        const isOpen = mobileMenuButton.getAttribute('aria-expanded') === 'true';
        setMobileMenu(!isOpen);
      });
    
      mobileCloseButton?.addEventListener('click', () => {
        setMobileMenu(false);
      });
    
      mobileBackdrop?.addEventListener('click', () => {
        setMobileMenu(false);
      });
    
      mobileMenu?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          setMobileMenu(false);
        });
      });
    
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && mobileMenuButton?.getAttribute('aria-expanded') === 'true') {
          setMobileMenu(false);
        }
      });
    
      window.addEventListener('resize', () => {
        if (window.innerWidth >= 1280 && mobileMenuButton?.getAttribute('aria-expanded') === 'true') {
          setMobileMenu(false);
        }
      });
    </script>
    <script>
      const publicStorageKeys = {
        profil: 'timpik_profil_data',
        kontak: 'timpik_kontak_data',
        berita: 'timpik_berita_list',
        agenda: 'timpik_agenda_list',
        surat: 'timpik_surat_list',
        apbdes: 'timpik_apbdes_data',
      };

      fetch('/api/content?key=all', { cache: 'no-store' })
        .then(async (response) => {
          if (!response.ok) throw new Error(`Supabase content request failed (${response.status})`);
          const { contents = {} } = await response.json();
          (window as any).__timpikSupabaseContent = contents;
          window.dispatchEvent(new CustomEvent('timpik-supabase-content', { detail: contents }));
          let changed = false;

          for (const [contentKey, storageKey] of Object.entries(publicStorageKeys)) {
            const next = Object.hasOwn(contents, contentKey) ? JSON.stringify(contents[contentKey]) : null;
            const previous = localStorage.getItem(storageKey);
            if (next === previous) continue;

            if (next === null) localStorage.removeItem(storageKey);
            else localStorage.setItem(storageKey, next);
            changed = true;
          }

          if (changed) window.location.reload();
        })
        .catch((error) => console.warn('Konten Supabase belum dapat dimuat.', error));

      document.addEventListener('error', (event) => {
        const image = event.target;
        if (image instanceof HTMLImageElement && image.classList.contains('dusun-photo')) image.hidden = true;
      }, true);
    </script>
