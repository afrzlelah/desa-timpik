    <!-- Client Scripts: Global Navigation, Hydration & Search Modal -->
    <script>
      // 1. Mobile Menu Toggle
      const mobileBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      const iconOpen = document.getElementById('menu-icon-open');
      const iconClose = document.getElementById('menu-icon-close');

      if (mobileBtn && mobileMenu) {
        mobileBtn.addEventListener('click', () => {
          const isHidden = mobileMenu.classList.contains('hidden');
          if (isHidden) {
            mobileMenu.classList.remove('hidden');
            iconOpen?.classList.add('hidden');
            iconClose?.classList.remove('hidden');
          } else {
            mobileMenu.classList.add('hidden');
            iconOpen?.classList.remove('hidden');
            iconClose?.classList.add('hidden');
          }
        });
      }

      // 2. Global Quick Search Modal (Ctrl+K or trigger)
      const searchTrigger = document.getElementById('global-search-trigger');
      const searchModal = document.getElementById('quick-search-modal');
      const closeSearch = document.getElementById('close-search-modal');
      const searchInput = document.getElementById('modal-search-input') as HTMLInputElement | null;
      const resultsContainer = document.getElementById('modal-search-results');
      const quickLinks = document.getElementById('modal-quick-links');

      let searchDebounceTimer: ReturnType<typeof setTimeout> | null = null;

      function openSearch() {
        if (searchModal) {
          searchModal.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
          setTimeout(() => searchInput?.focus(), 50);
        }
      }

      function closeSearchModal() {
        if (searchModal) {
          searchModal.classList.add('hidden');
          document.body.style.overflow = '';
          if (searchInput) searchInput.value = '';
          if (resultsContainer) {
            resultsContainer.innerHTML = '';
            resultsContainer.classList.add('hidden');
          }
          if (quickLinks) quickLinks.classList.remove('hidden');
        }
      }

      searchTrigger?.addEventListener('click', openSearch);
      closeSearch?.addEventListener('click', closeSearchModal);

      // Keyboard Shortcut Ctrl+K / Cmd+K / Esc
      window.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
          e.preventDefault();
          if (searchModal?.classList.contains('hidden')) {
            openSearch();
          } else {
            closeSearchModal();
          }
        }
        if (e.key === 'Escape' && !searchModal?.classList.contains('hidden')) {
          closeSearchModal();
        }
      });

      // Search input live query
      searchInput?.addEventListener('input', (e) => {
        const query = (e.target as HTMLInputElement).value.trim();
        if (searchDebounceTimer) clearTimeout(searchDebounceTimer);

        if (!query) {
          if (resultsContainer) {
            resultsContainer.innerHTML = '';
            resultsContainer.classList.add('hidden');
          }
          if (quickLinks) quickLinks.classList.remove('hidden');
          return;
        }

        searchDebounceTimer = setTimeout(async () => {
          try {
            const res = await fetch(`/api/search.json?q=${encodeURIComponent(query)}`);
            if (res.ok) {
              const data = await res.json();
              renderSearchResults(data.results || []);
            }
          } catch (err) {
            console.warn('Gagal mencari:', err);
          }
        }, 200);
      });

      function renderSearchResults(results: Array<{ title: string; category: string; description: string; url: string }>) {
        if (!resultsContainer) return;

        if (quickLinks) quickLinks.classList.add('hidden');
        resultsContainer.classList.remove('hidden');

        if (results.length === 0) {
          resultsContainer.innerHTML = `
            <div class="py-6 text-center text-xs text-slate-400">
              Tidak ditemukan hasil untuk pencarian tersebut. Coba kata kunci lain (misal: SKU, beras, Bogo).
            </div>
          `;
          return;
        }

        resultsContainer.innerHTML = results.map(item => `
          <a
            href="${item.url}"
            class="block p-3 rounded-xl hover:bg-blue-50/70 border border-transparent hover:border-blue-200 transition-colors"
          >
            <div class="flex items-center justify-between gap-2">
              <span class="text-xs font-bold text-slate-900">${item.title}</span>
              <span class="text-[10px] uppercase font-bold px-2 py-0.5 rounded bg-blue-100 text-blue-800">${item.category}</span>
            </div>
            <p class="text-[11px] text-slate-500 mt-1 line-clamp-1">${item.description}</p>
          </a>
        `).join('');
      }

      // Close search modal when clicking outside
      searchModal?.addEventListener('click', (e) => {
        if (e.target === searchModal) closeSearchModal();
      });

      // 3. Dynamic Footer Hydration from timpik_kontak_data (if updated by Admin)
      try {
        const storedKontak = localStorage.getItem('timpik_kontak_data');
        if (storedKontak) {
          const parsed = JSON.parse(storedKontak);
          if (parsed && parsed.operasional) {
            const op = parsed.operasional;
            const ftAlamat = document.getElementById('global-footer-alamat');
            if (ftAlamat && op.alamat) ftAlamat.textContent = op.alamat;

            const ftTelepon = document.getElementById('global-footer-telepon');
            if (ftTelepon && op.telepon) ftTelepon.textContent = `${op.telepon} (WA Pelayanan)`;

            const ftEmail = document.getElementById('global-footer-email');
            if (ftEmail && op.email) ftEmail.textContent = op.email;

            const hdJam = document.getElementById('header-jam-kerja');
            if (hdJam && op.jam_senin_kamis) {
              hdJam.textContent = `Senin–Kamis ${op.jam_senin_kamis} • Jumat ${op.jam_jumat || '08.00–11.30 WIB'}`;
            }
          }
        }
      } catch (err) {
        console.warn('Gagal membaca kontak lokal untuk footer', err);
      }
    </script>
  </body>
