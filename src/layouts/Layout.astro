                    <span>Aparatur dan struktur organisasi desa</span>
                  </a>

                  <a href="/potensi" class="desktop-dropdown-link">
                    <strong>Potensi & Seni Budaya</strong>
                    <span>Pertanian dan kesenian lokal</span>
                  </a>
                </div>
              </div>
            </div>

            <div class="relative group">
              <button
                type="button"
                aria-haspopup="true"
