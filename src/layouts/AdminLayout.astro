---
import '../styles/global.css';

interface Props {
  title: string;
  activeMenu?: 'dashboard' | 'surat' | 'berita' | 'agenda' | 'aduan' | 'apbdes' | 'register' | 'kontak' | 'informasi';
}

const { title, activeMenu = 'dashboard' } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} &bull; Panel Admin Desa Timpik</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>

  <body class="flex min-h-screen bg-slate-50 font-sans text-slate-900 antialiased">

    <!-- Sidebar -->
    <aside id="admin-sidebar" class="fixed inset-y-0 left-0 z-40 flex h-dvh w-64 flex-row overflow-hidden bg-[#0B1E36] transition-[width] duration-300 ease-in-out">

      <!-- Icon Rail: visible in collapsed mode -->
      <div id="sidebar-rail" class="flex h-full w-0 shrink-0 flex-col items-center overflow-hidden border-r-0 border-slate-700 bg-[#0B1E36] opacity-0 transition-all duration-300">

        <a href="/admin/dashboard" title="Panel Admin Timpik" class="flex h-16 w-full shrink-0 items-center justify-center border-b border-slate-700 bg-[#08172b]">
          <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-blue-600 text-xs font-bold text-white">DT</span>
        </a>

        <nav class="flex flex-1 flex-col items-center gap-2 overflow-y-auto py-5">

          <a href="/admin/dashboard" title="Ringkasan" class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-lg transition ${activeMenu === 'dashboard' ? 'bg-blue-600 text-white' : 'text-slate-400 hover:bg-slate-800 hover:text-white'}`}>
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 12l9-9 9 9M5 10v10h14V10"/>
            </svg>
          </a>

          <a href="/admin/surat" title="Kelola Surat" class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-lg transition ${activeMenu === 'surat' ? 'bg-blue-600 text-white' : 'text-slate-400 hover:bg-slate-800 hover:text-white'}`}>
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5l5 5v11a2 2 0 01-2 2z"/>
            </svg>
          </a>

          <a href="/admin/berita" title="Kelola Berita" class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-lg transition ${activeMenu === 'berita' ? 'bg-blue-600 text-white' : 'text-slate-400 hover:bg-slate-800 hover:text-white'}`}>
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13V7"/>
            </svg>
          </a>

          <a href="/admin/agenda" title="Agenda Desa" class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-lg transition ${activeMenu === 'agenda' ? 'bg-blue-600 text-white' : 'text-slate-400 hover:bg-slate-800 hover:text-white'}`}>
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 7V3m8 4V3M4 11h16M5 21h14a1 1 0 001-1V7a2 2 0 00-2-2H6a2 2 0 00-2 2v13a1 1 0 001 1z"/>
            </svg>
          </a>

          <a href="/admin/aduan" title="Aduan Warga" class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-lg transition ${activeMenu === 'aduan' ? 'bg-blue-600 text-white' : 'text-slate-400 hover:bg-slate-800 hover:text-white'}`}>
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/>
            </svg>
          </a>

          <a href="/admin/apbdes" title="Transparansi APBDes" class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-lg transition ${activeMenu === 'apbdes' ? 'bg-blue-600 text-white' : 'text-slate-400 hover:bg-slate-800 hover:text-white'}`}>
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 8v8m-3-6c0-1 1.3-2 3-2s3 1 3 2-1 2-3 2-3-1-3 2 1.3 2 3 2 3-1 3-2M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </a>

          <a href="/admin/kontak" title="Kelola Kontak" class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-lg transition ${activeMenu === 'kontak' ? 'bg-blue-600 text-white' : 'text-slate-400 hover:bg-slate-800 hover:text-white'}`}>
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 5a2 2 0 012-2h3l2 5-3 2a11 11 0 005 5l2-3 5 2v3a2 2 0 01-2 2A16 16 0 013 5z"/>
            </svg>
          </a>

          <a href="/admin/informasi" title="Informasi Desa & Dusun" class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-lg transition ${activeMenu === 'informasi' ? 'bg-blue-600 text-white' : 'text-slate-400 hover:bg-slate-800 hover:text-white'}`}>
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
            </svg>
          </a>

          <a href="/admin/register-ekspor" title="Buku Register" class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-lg transition ${activeMenu === 'register' ? 'bg-blue-600 text-white' : 'text-slate-400 hover:bg-slate-800 hover:text-white'}`}>
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 10v6m0 0l-3-3m3 3l3-3m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5l5 5v11a2 2 0 01-2 2z"/>
            </svg>
          </a>

        </nav>

        <!-- Rail Actions -->
        <div class="flex w-full shrink-0 flex-col items-center gap-2 border-t border-slate-700 py-3">

          <a href="/" target="_blank" rel="noopener noreferrer" title="Web Publik" class="flex h-10 w-10 items-center justify-center rounded-lg text-slate-400 transition hover:bg-slate-800 hover:text-white">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M14 4h6v6m0-6L10 14M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/>
            </svg>
          </a>

          <button type="button" data-admin-logout title="Keluar Sesi" class="flex h-10 w-10 items-center justify-center rounded-lg text-rose-300 transition hover:bg-rose-950 hover:text-rose-200">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
            </svg>
          </button>

        </div>
      </div>

      <!-- Expanded Panel -->
      <div id="sidebar-panel" class="flex h-full w-64 min-w-0 shrink-0 flex-col overflow-hidden border-r border-slate-700 bg-[#0B1E36] text-white transition-all duration-300">

        <!-- Panel Header -->
        <div class="flex h-16 shrink-0 items-center justify-between border-b border-slate-700 bg-[#08172b] px-4">
          <div class="flex min-w-0 items-center gap-2">
            <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-blue-600 text-xs font-bold text-white">DT</div>
            <span class="truncate text-sm font-bold text-white">Panel Admin Timpik</span>
          </div>

          <button type="button" id="btn-toggle-sidebar" aria-label="Sembunyikan menu" aria-expanded="true" class="ml-2 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg text-slate-300 transition hover:bg-slate-700 hover:text-white">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <rect x="3" y="4" width="18" height="16" rx="2" stroke-width="1.8"/>
              <path d="M9 4v16" stroke-width="1.8"/>
            </svg>
          </button>
        </div>

        <!-- Role -->
        <div class="shrink-0 border-b border-slate-700 px-5 py-3">
          <span class="text-[11px] text-slate-400">Hak Akses</span>
          <span class="ml-2 rounded-md bg-blue-500/20 px-2 py-1 text-[11px] font-semibold text-blue-300">Admin Desa</span>
        </div>

        <!-- Main Navigation -->
        <nav class="flex-1 space-y-1.5 overflow-y-auto px-3 py-4">
          <p class="mb-3 px-3 text-xs font-bold uppercase tracking-wider text-slate-400">Menu Kelola Desa</p>

          <a href="/admin/dashboard" class={`flex h-12 items-center gap-3.5 rounded-xl px-3.5 text-sm font-semibold transition ${activeMenu === 'dashboard' ? 'bg-blue-600 font-bold text-white shadow-sm' : 'text-slate-300 hover:bg-slate-800 hover:text-white'}`}>
            <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 12l9-9 9 9M5 10v10h14V10"/>
            </svg>
            <span>Ringkasan</span>
          </a>

          <a href="/admin/surat" class={`flex h-12 items-center justify-between gap-3.5 rounded-xl px-3.5 text-sm font-semibold transition ${activeMenu === 'surat' ? 'bg-blue-600 font-bold text-white shadow-sm' : 'text-slate-300 hover:bg-slate-800 hover:text-white'}`}>
            <span class="flex items-center gap-3.5">
              <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5l5 5v11a2 2 0 01-2 2z"/>
              </svg>
              Kelola Surat & GForm
            </span>
            <span id="badge-count-surat" class="rounded-md bg-blue-500/20 px-2 py-0.5 text-xs font-bold text-blue-300">10</span>
          </a>

          <a href="/admin/informasi" class={`flex h-12 items-center gap-3.5 rounded-xl px-3.5 text-sm font-semibold transition ${activeMenu === 'informasi' ? 'bg-blue-600 font-bold text-white shadow-sm' : 'text-slate-300 hover:bg-slate-800 hover:text-white'}`}>
            <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
            </svg>
            <span>Informasi Desa & Dusun</span>
          </a>

          <a href="/admin/berita" class={`flex h-12 items-center gap-3.5 rounded-xl px-3.5 text-sm font-semibold transition ${activeMenu === 'berita' ? 'bg-blue-600 font-bold text-white shadow-sm' : 'text-slate-300 hover:bg-slate-800 hover:text-white'}`}>
            <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13V7"/>
            </svg>
            <span>Kelola Berita</span>
          </a>

          <a href="/admin/agenda" class={`flex h-12 items-center gap-3.5 rounded-xl px-3.5 text-sm font-semibold transition ${activeMenu === 'agenda' ? 'bg-blue-600 font-bold text-white shadow-sm' : 'text-slate-300 hover:bg-slate-800 hover:text-white'}`}>
            <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 7V3m8 4V3M4 11h16M5 21h14a1 1 0 001-1V7a2 2 0 00-2-2H6a2 2 0 00-2 2v13a1 1 0 001 1z"/>
            </svg>
            <span>Agenda & Kegiatan</span>
          </a>

          <a href="/admin/aduan" class={`flex h-12 items-center gap-3.5 rounded-xl px-3.5 text-sm font-semibold transition ${activeMenu === 'aduan' ? 'bg-blue-600 font-bold text-white shadow-sm' : 'text-slate-300 hover:bg-slate-800 hover:text-white'}`}>
            <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/>
            </svg>
            <span>Kotak Aduan Warga</span>
          </a>

          <a href="/admin/apbdes" class={`flex h-12 items-center gap-3.5 rounded-xl px-3.5 text-sm font-semibold transition ${activeMenu === 'apbdes' ? 'bg-blue-600 font-bold text-white shadow-sm' : 'text-slate-300 hover:bg-slate-800 hover:text-white'}`}>
            <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 8v8m-3-6c0-1 1.3-2 3-2s3 1 3 2-1 2-3 2-3-1-3 2 1.3 2 3 2 3-1 3-2M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span>Transparansi APBDes</span>
          </a>

          <a href="/admin/kontak" class={`flex h-12 items-center gap-3.5 rounded-xl px-3.5 text-sm font-semibold transition ${activeMenu === 'kontak' ? 'bg-blue-600 font-bold text-white shadow-sm' : 'text-slate-300 hover:bg-slate-800 hover:text-white'}`}>
            <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 5a2 2 0 012-2h3l2 5-3 2a11 11 0 005 5l2-3 5 2v3a2 2 0 01-2 2A16 16 0 013 5z"/>
            </svg>
            <span>Kontak & Hotline</span>
          </a>

          <a href="/admin/register-ekspor" class={`flex h-12 items-center gap-3.5 rounded-xl px-3.5 text-sm font-semibold transition ${activeMenu === 'register' ? 'bg-blue-600 font-bold text-white shadow-sm' : 'text-slate-300 hover:bg-slate-800 hover:text-white'}`}>
            <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 10v6m0 0l-3-3m3 3l3-3m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5l5 5v11a2 2 0 01-2 2z"/>
            </svg>
            <span>Buku Register & Ekspor</span>
          </a>
        </nav>

        <!-- Expanded Bottom Actions -->
        <div class="shrink-0 border-t border-slate-700 bg-[#08172b] p-3 space-y-1">

          <a href="/" target="_blank" rel="noopener noreferrer" class="flex h-11 items-center gap-3.5 rounded-xl px-3.5 text-sm font-semibold text-slate-300 transition hover:bg-slate-800 hover:text-white">
            <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M14 4h6v6m0-6L10 14M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/>
            </svg>
            <span>Buka Web Publik &rarr;</span>
          </a>

          <button type="button" data-admin-logout class="flex h-11 w-full items-center gap-3.5 rounded-xl px-3.5 text-sm font-semibold text-rose-300 transition hover:bg-rose-950 hover:text-rose-200">
            <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
            </svg>
            <span>Keluar Sesi</span>
          </button>

          <div class="mt-3 flex items-center gap-3 border-t border-slate-700 px-2 pt-3">
            <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-blue-600 text-sm font-bold text-white">A</div>
            <div class="min-w-0">
              <p class="truncate text-xs font-semibold text-white">Administrator Desa</p>
              <p class="text-[11px] text-slate-400">Admin</p>
            </div>
          </div>

        </div>
      </div>
    </aside>

    <!-- Main Content -->
    <div id="admin-main" class="min-h-screen min-w-0 flex-1 overflow-x-hidden transition-[margin] duration-300 md:ml-64">

      <!-- Topbar -->
      <header class="sticky top-0 z-30 flex h-16 items-center justify-between border-b border-slate-200 bg-white px-4 sm:px-8">

        <div class="flex min-w-0 items-center gap-3">
          <button type="button" id="btn-toggle-sidebar-main" aria-label="Sembunyikan menu" aria-expanded="true" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-slate-200 text-slate-600 transition hover:border-blue-200 hover:bg-blue-50 hover:text-blue-900">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <rect x="3" y="4" width="18" height="16" rx="2" stroke-width="1.8"/>
              <path d="M9 4v16" stroke-width="1.8"/>
            </svg>
          </button>

          <div class="flex min-w-0 items-center gap-2">
            <span class="hidden shrink-0 text-xs text-slate-500 sm:inline">Panel Administrasi &bull;</span>
            <span class="truncate text-xs font-bold text-slate-800">{title}</span>
          </div>
        </div>

        <a href="/" target="_blank" rel="noopener noreferrer" class="ml-3 flex shrink-0 items-center gap-2 rounded-lg border border-slate-200 px-3 py-2 text-xs font-semibold text-slate-700 transition hover:border-blue-200 hover:bg-blue-50 hover:text-blue-900">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M14 4h6v6m0-6L10 14M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/>
          </svg>
          <span class="hidden sm:inline">Web Publik</span>
        </a>

      </header>

      <main class="min-w-0 p-4 sm:p-6 lg:p-8">
        <slot />
      </main>
    </div>

    <!-- Scripts -->
    <script>
      // Session protection
      const sessionUser = sessionStorage.getItem('timpik_admin_user');
      const currentLoc = window.location.pathname;

      if (!sessionUser && currentLoc !== '/admin/login' && currentLoc !== '/admin/login/') {
        window.location.href = '/admin/login';
      }

      // Logout
      document.querySelectorAll('[data-admin-logout]').forEach((button) => {
        button.addEventListener('click', () => {
          sessionStorage.removeItem('timpik_admin_user');
          localStorage.removeItem('timpik_sidebar_mode');
          window.location.href = '/admin/login';
        });
      });

      // Sidebar state
      const sidebar = document.getElementById('admin-sidebar');
      const rail = document.getElementById('sidebar-rail');
      const panel = document.getElementById('sidebar-panel');
      const main = document.getElementById('admin-main');

      const toggleButtons = [
        document.getElementById('btn-toggle-sidebar'),
        document.getElementById('btn-toggle-sidebar-main')
      ];

      const STORAGE_KEY = 'timpik_sidebar_mode';
      let collapsed = localStorage.getItem(STORAGE_KEY) === 'collapsed';

      function updateSidebar() {
        if (!sidebar || !rail || !panel || !main) return;

        // Container width
        sidebar.classList.toggle('w-64', !collapsed);
        sidebar.classList.toggle('w-16', collapsed);

        // Icon rail
        rail.classList.toggle('w-16', collapsed);
        rail.classList.toggle('w-0', !collapsed);
        rail.classList.toggle('opacity-100', collapsed);
        rail.classList.toggle('opacity-0', !collapsed);
        rail.classList.toggle('border-r', collapsed);
        rail.classList.toggle('border-r-0', !collapsed);

        // Expanded panel
        panel.classList.toggle('w-64', !collapsed);
        panel.classList.toggle('w-0', collapsed);
        panel.classList.toggle('opacity-100', !collapsed);
        panel.classList.toggle('opacity-0', collapsed);
        panel.classList.toggle('pointer-events-none', collapsed);

        // Main content position
        main.classList.toggle('md:ml-64', !collapsed);
        main.classList.toggle('md:ml-16', collapsed);

        // Button accessibility
        toggleButtons.forEach((button) => {
          if (!button) return;
          button.setAttribute('aria-expanded', String(!collapsed));
          button.setAttribute('aria-label', collapsed ? 'Tampilkan menu' : 'Sembunyikan menu');
        });
      }

      // Toggle and persist state
      toggleButtons.forEach((button) => {
        button?.addEventListener('click', () => {
          collapsed = !collapsed;
          localStorage.setItem(STORAGE_KEY, collapsed ? 'collapsed' : 'expanded');
          updateSidebar();
        });
      });

      updateSidebar();
    </script>

  </body>
</html>
