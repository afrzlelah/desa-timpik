---
import '../styles/global.css';

interface Props {
  title: string;
  activeMenu?: 'dashboard' | 'surat' | 'berita' | 'agenda' | 'aduan' | 'apbdes' | 'register' | 'kontak';
}

const {
  title,
  activeMenu = 'dashboard'
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} &bull; Panel Admin Desa Timpik</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="bg-slate-50 text-slate-900 antialiased flex min-h-screen font-sans">
    
    <!-- Sidebar Kiri (Clean Solid Deep Navy) -->
    <aside class="w-64 bg-[#0B1E36] text-white shrink-0 hidden md:flex flex-col justify-between border-r border-slate-800 z-30">
      <div>
        <!-- Brand Header -->
        <div class="h-16 px-6 flex items-center gap-3 border-b border-slate-800 bg-[#08172b]">
          <div class="w-8 h-8 rounded-lg bg-blue-600 flex items-center justify-center font-bold text-white text-xs shadow-sm">
            DT
          </div>
          <div>
            <h1 class="text-sm font-bold text-white leading-tight">Panel Admin Timpik</h1>
            <p class="text-[11px] text-slate-400">Pemerintah Desa Timpik</p>
          </div>
        </div>

        <!-- Role Badge -->
        <div class="px-6 py-3 border-b border-slate-800/60 bg-[#0d223c]">
          <div class="flex items-center justify-between">
            <span class="text-[11px] text-slate-400">Hak Akses:</span>
            <span class="text-xs font-bold text-blue-300 bg-blue-900/60 px-2 py-0.5 rounded border border-blue-700/50">Admin Desa</span>
          </div>
        </div>

        <!-- Navigation Links -->
        <nav class="p-3 space-y-1 text-xs font-medium">
          <a
            href="/admin/dashboard"
            class={`flex items-center gap-2.5 px-3 py-2 rounded-xl transition-colors ${activeMenu === 'dashboard' ? 'bg-blue-600 text-white font-bold' : 'text-slate-300 hover:text-white hover:bg-slate-800/60'}`}
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
            <span>Ringkasan</span>
          </a>

          <a
            href="/admin/surat"
            class={`flex items-center justify-between px-3 py-2 rounded-xl transition-colors ${activeMenu === 'surat' ? 'bg-blue-600 text-white font-bold' : 'text-slate-300 hover:text-white hover:bg-slate-800/60'}`}
          >
            <div class="flex items-center gap-2.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
              <span>Kelola Surat & GForm</span>
            </div>
            <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-blue-500/30 text-blue-200" id="badge-count-surat">10</span>
          </a>

          <a
            href="/admin/berita"
            class={`flex items-center gap-2.5 px-3 py-2 rounded-xl transition-colors ${activeMenu === 'berita' ? 'bg-blue-600 text-white font-bold' : 'text-slate-300 hover:text-white hover:bg-slate-800/60'}`}
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>
            <span>Kelola Berita</span>
          </a>

          <a
            href="/admin/agenda"
            class={`flex items-center gap-2.5 px-3 py-2 rounded-xl transition-colors ${activeMenu === 'agenda' ? 'bg-blue-600 text-white font-bold' : 'text-slate-300 hover:text-white hover:bg-slate-800/60'}`}
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            <span>Agenda & Info Desa</span>
          </a>

          <a
            href="/admin/aduan"
            class={`flex items-center gap-2.5 px-3 py-2 rounded-xl transition-colors ${activeMenu === 'aduan' ? 'bg-blue-600 text-white font-bold' : 'text-slate-300 hover:text-white hover:bg-slate-800/60'}`}
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
            <span>Kotak Aduan Warga</span>
          </a>

          <a
            href="/admin/apbdes"
            class={`flex items-center gap-2.5 px-3 py-2 rounded-xl transition-colors ${activeMenu === 'apbdes' ? 'bg-blue-600 text-white font-bold' : 'text-slate-300 hover:text-white hover:bg-slate-800/60'}`}
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span>Transparansi APBDes</span>
          </a>

          <a
            href="/admin/kontak"
            class={`flex items-center gap-2.5 px-3 py-2 rounded-xl transition-colors ${activeMenu === 'kontak' ? 'bg-blue-600 text-white font-bold' : 'text-slate-300 hover:text-white hover:bg-slate-800/60'}`}
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            <span>Kelola Kontak & Hotline</span>
          </a>

          <a
            href="/admin/register-ekspor"
            class={`flex items-center gap-2.5 px-3 py-2 rounded-xl transition-colors ${activeMenu === 'register' ? 'bg-blue-600 text-white font-bold' : 'text-slate-300 hover:text-white hover:bg-slate-800/60'}`}
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            <span>Buku Register & Ekspor</span>
          </a>
        </nav>
      </div>

      <!-- Bottom Nav / Exit -->
      <div class="p-3 border-t border-slate-800 space-y-1">
        <a
          href="/"
          target="_blank"
          class="flex items-center justify-between px-3 py-2 rounded-lg text-xs text-slate-400 hover:text-white hover:bg-slate-800/60 transition-colors"
        >
          <span>Buka Web Publik</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        </a>
        <button
          type="button"
          id="btn-admin-logout"
          class="w-full flex items-center justify-center gap-1.5 px-3 py-2 rounded-lg text-xs font-semibold text-rose-300 hover:text-white hover:bg-rose-950/60 transition-colors"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
          <span>Keluar Sesi</span>
        </button>
      </div>
    </aside>

    <!-- Main Content Area -->
    <div class="flex-grow flex flex-col min-h-screen overflow-x-hidden">
      
      <!-- Topbar Header -->
      <header class="h-16 bg-white border-b border-slate-200 px-4 sm:px-8 flex items-center justify-between sticky top-0 z-20">
        <div class="flex items-center gap-3">
          <div class="flex items-center gap-2">
            <span class="text-xs font-semibold text-slate-500">Panel Administrasi &bull;</span>
            <span class="text-xs font-bold text-slate-800">{title}</span>
          </div>
        </div>

        <div class="flex items-center gap-3 text-xs">
          <span class="hidden sm:inline text-slate-500">Login sebagai: <strong class="text-slate-800">Administrator Desa</strong></span>
          <a
            href="/"
            target="_blank"
            class="px-3 py-1.5 rounded-lg border border-slate-300 hover:bg-slate-50 text-slate-700 font-semibold transition-colors flex items-center gap-1"
          >
            <span>Web Publik</span>
            <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </a>
        </div>
      </header>

      <!-- Main Slot -->
      <main class="p-4 sm:p-8 flex-grow">
        <slot />
      </main>

    </div>

    <!-- Script Proteksi Sesi Client -->
    <script>
      const sessionUser = sessionStorage.getItem('timpik_admin_user');
      const currentLoc = window.location.pathname;

      if (!sessionUser && currentLoc !== '/admin/login' && currentLoc !== '/admin/login/') {
        window.location.href = '/admin/login';
      }

      const logoutBtn = document.getElementById('btn-admin-logout');
      if (logoutBtn) {
        logoutBtn.addEventListener('click', () => {
          sessionStorage.removeItem('timpik_admin_user');
          window.location.href = '/admin/login';
        });
      }
    </script>
  </body>
</html>
