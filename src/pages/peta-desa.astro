---
import Layout from '../layouts/Layout.astro';
import profilData from '../data/profil.json';
---

<Layout
  title="Peta Wilayah & Geografis Desa Timpik"
  description="Peta wilayah Desa Timpik di Kecamatan Susukan, Kabupaten Semarang, dengan informasi lokasi kantor desa, batas wilayah, dan sebaran dusun."
>
  <!-- Architectural Civic Header -->
  <section class="bg-gradient-to-br from-blue-950 via-blue-900 to-blue-700 text-white border-b border-white/20 pt-14 pb-12 sm:pt-16 sm:pb-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs font-mono uppercase tracking-wider text-slate-400 mb-5" aria-label="Breadcrumb">
        <a href="/" class="hover:text-blue-300 transition-colors">Beranda</a>
        <span class="text-slate-600">/</span>
        <span class="text-blue-300 font-bold">Peta Wilayah</span>
      </nav>

      <div class="max-w-3xl space-y-3">
        <!-- <div class="flex items-center gap-2.5">
          <span class="h-px w-6 bg-blue-400"></span>
          <span class="text-xs font-mono uppercase tracking-widest text-blue-300 font-bold">Geospasial & Batas Teritorial</span>
        </div> -->
        
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-black tracking-tight text-white leading-tight">
          Peta Wilayah & Geografis Desa
        </h1>
        
        <p class="text-slate-300 text-sm sm:text-base leading-relaxed pt-1">
          Peta administratif Desa Timpik yang mencakup 13 wilayah dusun, batas wilayah, kondisi geografis, fasilitas umum, dan akses menuju Balai Desa Timpik, Kecamatan Susukan.
        </p>
      </div>

    </div>
  </section>

  <!-- Peta Embed & Lokasi Strategis -->
  <section class="py-14 sm:py-16 bg-gray-100 border-b border-white/70">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start mb-14">
        
        <!-- Peta Interaktif Frame -->
        <div class="lg:col-span-8 glass-panel rounded-2xl overflow-hidden">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d15828.69482161642!2d110.57500000000002!3d-7.335000000000001!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e7a7837b2d55555%3A0x1234567890abcdef!2sTimpik%2C%20Susukan%2C%20Semarang%20Regency%2C%20Central%20Java!5e0!3m2!1sen!2sid!4v1700000000000!5m2!1sen!2sid"
            width="100%"
            height="460"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Peta Desa Timpik Google Maps"
            class="w-full h-[460px] grayscale contrast-125 hover:grayscale-0 transition-all duration-300"
          ></iframe>
          <div class="p-4 bg-blue-900/90 text-white flex flex-col sm:flex-row items-center justify-between gap-3 text-sm font-mono backdrop-blur-xl">
            <span class="flex items-center gap-2">
              <span class="w-2 h-2 bg-emerald-400"></span>
              <span>Titik Pusat: Balai Desa Timpik</span>
            </span>
            <a
              href="https://maps.google.com/?q=Balai+Desa+Timpik+Susukan+Semarang"
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white font-bold transition-colors flex items-center gap-1.5 uppercase tracking-wider text-[11px] rounded shadow-xs"
            >
              <span>Buka Google Maps &rarr;</span>
            </a>
          </div>
        </div>

        <!-- Info Batas Wilayah & Geospasial -->
        <div class="lg:col-span-4 space-y-6">
          <div class="glass-panel rounded-2xl overflow-hidden">
            <div class="p-5 border-b border-white/70 bg-blue-800/5">
              <h3 class="font-serif font-bold text-civic-navy text-base">
                Batas Wilayah Administratif
              </h3>
            </div>
            
            <div class="p-5 space-y-3 text-xs">
              <div class="p-3 rounded-xl bg-white/65 border border-white/80">
                <span class="text-civic-muted font-mono uppercase text-[10px] block">Sebelah Utara:</span>
                <strong class="font-serif text-civic-navy text-sm font-bold">Desa Kemetul & Kenteng</strong>
              </div>
              <div class="p-3 rounded-xl bg-white/65 border border-white/80">
                <span class="text-civic-muted font-mono uppercase text-[10px] block">Sebelah Timur:</span>
                <strong class="font-serif text-civic-navy text-sm font-bold">Desa Ketapang & Koripan</strong>
              </div>
              <div class="p-3 rounded-xl bg-white/65 border border-white/80">
                <span class="text-civic-muted font-mono uppercase text-[10px] block">Sebelah Selatan:</span>
                <strong class="font-serif text-civic-navy text-sm font-bold">Kecamatan Kaliwungu</strong>
              </div>
              <div class="p-3 rounded-xl bg-white/65 border border-white/80">
                <span class="text-civic-muted font-mono uppercase text-[10px] block">Sebelah Barat:</span>
                <strong class="font-serif text-civic-navy text-sm font-bold">Desa Badran & Bakalrejo</strong>
              </div>
            </div>
          </div>

          <div class="glass-panel-blue rounded-2xl text-white p-5 space-y-2 text-sm">
            <span class="text-[10px] font-mono uppercase tracking-widest text-blue-700 font-bold block">Topografi & Hidrologi</span>
            <p class="text-blue-50 leading-relaxed">
              Desa Timpik berada pada ketinggian <strong>± 450 – 600 meter di atas permukaan laut (dpl)</strong> di lereng Merbabu. Wilayahnya dialiri jaringan irigasi persawahan teknis yang dikelola oleh perkumpulan <strong>P3A Bogo Wastro</strong>.
            </p>
          </div>
        </div>

      </div>

      <!-- 13 Dusun dalam Peta -->
      <div>
        <div class="border-b border-civic-border pb-4 mb-8">
          <span class="text-xs font-mono uppercase tracking-widest text-blue-700 font-bold block mb-1">
            Struktur Kewilayahan
          </span>

          <h3 class="text-2xl font-serif font-black text-civic-navy">
            Pembagian 13 Wilayah Dusun
          </h3>

          <p class="text-xs text-civic-muted mt-1">
            Persebaran wilayah dusun di bawah administrasi Pemerintah Desa Timpik.
          </p>
        </div>

        <div id="peta-dusun-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
          {(profilData.dusun as Array<(typeof profilData.dusun)[number] & { foto?: string }>).map((dusun, idx) => (
            <article class="glass-panel rounded-2xl overflow-hidden flex flex-col justify-between">
              <div class="relative aspect-[16/9] bg-gradient-to-br from-blue-100 to-slate-200">
                <div class="absolute inset-0 flex items-center justify-center text-sm font-semibold text-slate-600">Foto dusun belum tersedia</div>
                {dusun.foto && <img src={dusun.foto} alt={`Foto wilayah ${dusun.nama}`} width="640" height="360" loading="lazy" decoding="async" class="dusun-photo relative h-full w-full object-cover" />}
              </div>
              <div class="p-6 flex flex-1 flex-col justify-between space-y-4">
              <div>
                <span class="text-xs font-mono text-blue-700 font-bold block mb-2">
                  WILAYAH {String(idx + 1).padStart(2, '0')}
                </span>

                <h4 class="font-serif font-bold text-lg text-civic-navy">
                  {dusun.nama}
                </h4>

                <p class="text-xs text-civic-muted mt-2 leading-relaxed">
                  {dusun.deskripsi || 'Wilayah administratif Desa Timpik.'}
                </p>
              </div>

              {/* <div class="pt-3 border-t border-civic-border/60">
                <a
                  href={`/dusun/${dusun.id}`}
                  class="text-xs font-mono font-bold text-blue-700 hover:text-blue-900 uppercase tracking-wider inline-flex items-center gap-1"
                >
                  <span>Lihat Informasi Wilayah</span>
                  <span>&rarr;</span>
                </a>
              </div> */}
              </div>
            </article>
          ))}
        </div>
      </div>

    </div>
  </section>
  <script>
    const escapeDusunPeta = (value: unknown): string => {
      const entities: Record<string, string> = {
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;'
      };

      return String(value ?? '').replace(/[&<>"']/g, (char) => entities[char]);
    };

    const safeDusunPhoto = (value: unknown): string => {
      try {
        const url = new URL(String(value ?? ''));
        return url.protocol === 'https:' && url.hostname.endsWith('.supabase.co') && url.pathname.startsWith('/storage/v1/object/public/dusun/') ? url.href : '';
      } catch {
        return '';
      }
    };

    const renderPetaDusun = (items: unknown) => {
      const grid = document.getElementById('peta-dusun-grid');

      if (!grid) return;

      if (!Array.isArray(items)) {
        console.warn('Data dusun bukan array.');
        return;
      }

      if (items.length === 0) {
        grid.innerHTML = `
          <div class="col-span-full text-center py-10 text-slate-500">
            Belum ada data wilayah yang tersedia.
          </div>
        `;
        return;
      }

      grid.className =
        'grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5';

      grid.innerHTML = items.map((dusun: any, idx: number) => {
        const id = String(dusun?.id ?? '').trim();
        const nama = escapeDusunPeta(dusun?.nama || 'Wilayah Desa Timpik');
        const deskripsi = escapeDusunPeta(
          dusun?.deskripsi || 'Wilayah administratif Desa Timpik.'
        );
        const foto = safeDusunPhoto(dusun?.foto);

        const detailUrl = id
          ? `/dusun/${encodeURIComponent(id)}`
          : '#';

        return `
          <article class="glass-panel rounded-2xl overflow-hidden flex flex-col justify-between">
            <div class="relative aspect-[16/9] bg-gradient-to-br from-blue-100 to-slate-200">
              <div class="absolute inset-0 flex items-center justify-center text-sm font-semibold text-slate-600">Foto dusun belum tersedia</div>
              ${foto ? `<img src="${escapeDusunPeta(foto)}" alt="Foto wilayah ${nama}" width="640" height="360" loading="lazy" decoding="async" class="dusun-photo relative h-full w-full object-cover" />` : ''}
            </div>
            <div class="p-6 flex flex-1 flex-col justify-between space-y-4">
            <div>
              <span class="text-xs font-mono text-blue-700 font-bold block mb-2">
                WILAYAH ${String(idx + 1).padStart(2, '0')}
              </span>

              <h4 class="font-serif font-bold text-lg text-civic-navy">
                ${nama}
              </h4>

              <p class="text-xs text-civic-muted mt-2 leading-relaxed">
                ${deskripsi}
              </p>
            </div>

            <div class="pt-3 border-t border-civic-border/60">
              <a
                href="${detailUrl}"
                class="text-xs font-mono font-bold text-blue-700 hover:text-blue-900 uppercase tracking-wider inline-flex items-center gap-1"
                ${id ? '' : 'aria-disabled="true" tabindex="-1"'}
              >
                <span>Lihat Informasi Wilayah</span>
                <span>&rarr;</span>
              </a>
            </div>
            </div>
          </article>
        `;
      }).join('');
    };

    const loadSupabaseDusun = () => {
      const supabaseContent = (window as any).__timpikSupabaseContent;
      const profil = supabaseContent?.profil;

      if (Array.isArray(profil?.dusun)) {
        renderPetaDusun(profil.dusun);
      }
    };

    loadSupabaseDusun();

    window.addEventListener('timpik-supabase-content', (event: Event) => {
      const customEvent = event as CustomEvent;
      const dusun = customEvent.detail?.profil?.dusun;

      if (Array.isArray(dusun)) {
        renderPetaDusun(dusun);
      }
    });
  </script>
</Layout>
