---
import Layout from '../../layouts/Layout.astro';
import { getAllDusun, getDusunById } from '../../lib/data';

export function getStaticPaths() {
  const allDusun = getAllDusun();
  return allDusun.map((dusun) => ({
    params: { id: dusun.id }
  }));
}

const { id } = Astro.params;
const dusun = getDusunById(id || '');

if (!dusun) {
  return Astro.redirect('/404');
}
---

<Layout
  title={`${dusun.nama} - Wilayah Desa Timpik`}
  description={dusun.deskripsi}
>
  <!-- Architectural Civic Header -->
  <section class="bg-civic-navy text-white border-b border-civic-border/30 pt-14 pb-12 sm:pt-16 sm:pb-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="space-y-4">
        <nav class="flex items-center gap-2 text-xs font-mono uppercase tracking-wider text-slate-400" aria-label="Breadcrumb">
          <a href="/" class="hover:text-sky-300 transition-colors">Beranda</a>
          <span class="text-slate-600">/</span>
          <a href="/profil#dusun" class="hover:text-sky-300 transition-colors">Kewilayahan</a>
          <span class="text-slate-600">/</span>
          <span class="text-sky-300 font-bold">{dusun.nama}</span>
        </nav>

        <div class="flex items-center gap-2">
          <span class="h-px w-6 bg-sky-400"></span>
          <span class="text-[10px] font-mono uppercase tracking-widest text-sky-300 font-bold">
            Satuan Wilayah Kadus
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-black tracking-tight text-white leading-tight">
          {dusun.nama}
        </h1>

        <p class="text-slate-300 text-sm sm:text-base max-w-3xl leading-relaxed pt-1">
          {dusun.deskripsi}
        </p>
      </div>
    </div>
  </section>

  <!-- Dusun Profile & Stats Ledger Bar -->
  <section class="py-10 bg-civic-sand/30 border-b border-civic-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 lg:grid-cols-4 divide-y sm:divide-y-0 sm:divide-x divide-civic-border bg-white border border-civic-border shadow-xs">
        
        <div class="p-6 sm:p-8 space-y-2">
          <span class="text-[10px] font-mono uppercase tracking-widest text-civic-muted block">Kepala Dusun (Kadus)</span>
          <h2 class="text-lg sm:text-xl font-serif font-bold text-civic-navy">{dusun.kepala_dusun}</h2>
          <p class="text-xs text-civic-muted">Pengampu Wilayah</p>
        </div>

        <div class="p-6 sm:p-8 space-y-2">
          <span class="text-[10px] font-mono uppercase tracking-widest text-civic-muted block">Cakupan RT / RW</span>
          <h2 class="text-lg sm:text-xl font-mono font-bold text-civic-navy">{dusun.jumlah_rt}</h2>
          <p class="text-xs text-civic-muted">Rukun Tetangga Warga</p>
        </div>

        <div class="p-6 sm:p-8 space-y-2">
          <span class="text-[10px] font-mono uppercase tracking-widest text-civic-muted block">Estimasi Warga</span>
          <h2 class="text-lg sm:text-xl font-mono font-bold text-civic-navy">{dusun.jumlah_penduduk || '± 700 Jiwa'}</h2>
          <p class="text-xs text-civic-muted">Penduduk Terdata</p>
        </div>

        <div class="p-6 sm:p-8 space-y-2 bg-slate-50/40">
          <span class="text-[10px] font-mono uppercase tracking-widest text-emerald-800 font-bold block">Luas Wilayah</span>
          <h2 class="text-lg sm:text-xl font-mono font-bold text-emerald-900">{dusun.luas || '± 60 Ha'}</h2>
          <p class="text-xs text-civic-muted">Sawah & Pemukiman</p>
        </div>

      </div>
    </div>
  </section>

  <!-- INTERCONNECTED SECTION: Potensi & Lembaga Terkait -->
  <section class="py-14 sm:py-16 bg-civic-cream flex-grow">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <!-- Lembaga yang Berbasis di Dusun Ini -->
      <div class="space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-civic-border pb-4">
          <div>
            <span class="text-xs font-mono uppercase tracking-widest text-blue-700 font-bold block mb-1">Kelembagaan Terkait</span>
            <h3 class="text-2xl font-serif font-black text-civic-navy">Lembaga di {dusun.nama}</h3>
          </div>
          <a href="/kelembagaan" class="text-xs font-mono font-bold text-blue-700 hover:text-blue-900 uppercase tracking-wider">
            Lihat Semua 14 Lembaga &rarr;
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {dusun.lembagaList.length > 0 ? (
            dusun.lembagaList.map((lembaga) => (
              <div class="bg-white border border-civic-border p-6 shadow-xs flex flex-col justify-between space-y-4">
                <div>
                  <span class="text-[10px] font-mono uppercase tracking-wider px-2 py-0.5 border border-civic-border bg-civic-sand text-civic-navy font-bold">
                    {lembaga.singkatan}
                  </span>
                  <h4 class="font-serif font-bold text-civic-navy text-base mt-2">
                    <a href={`/kelembagaan/${lembaga.id}`} class="hover:text-blue-700 transition-colors">
                      {lembaga.nama}
                    </a>
                  </h4>
                  <p class="text-xs text-civic-muted mt-2 line-clamp-2 leading-relaxed">{lembaga.deskripsi}</p>
                </div>
                <div class="pt-3 border-t border-civic-border/60">
                  <a href={`/kelembagaan/${lembaga.id}`} class="text-xs font-mono font-bold text-blue-700 hover:text-blue-900 uppercase tracking-wider inline-flex items-center gap-1">
                    <span>Lihat Profil Lembaga &rarr;</span>
                  </a>
                </div>
              </div>
            ))
          ) : (
            <div class="bg-white border border-civic-border p-6 text-xs text-civic-muted col-span-3 text-center">
              Seluruh kelembagaan desa melayani warga {dusun.nama} secara terpadu.
            </div>
          )}
        </div>
      </div>

      <!-- Berita & Warta Dusun -->
      <div class="space-y-6">
        <div class="border-b border-civic-border pb-4">
          <span class="text-xs font-mono uppercase tracking-widest text-blue-700 font-bold block mb-1">Publikasi Terkait</span>
          <h3 class="text-2xl font-serif font-black text-civic-navy">Warta & Berita {dusun.nama}</h3>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {dusun.beritaList.length > 0 ? (
            dusun.beritaList.map((berita) => (
              <article class="bg-white border border-civic-border overflow-hidden shadow-xs flex flex-col justify-between group">
                <div>
                  <img src={berita.gambar} alt={berita.judul} class="w-full h-40 object-cover border-b border-civic-border"/>
                  <div class="p-5 space-y-2">
                    <span class="text-[10px] font-mono uppercase text-blue-700 font-bold">{berita.kategori}</span>
                    <h4 class="font-serif font-bold text-sm sm:text-base text-civic-navy group-hover:text-blue-700 transition-colors line-clamp-2">
                      <a href={`/berita/${berita.id}`}>
                        {berita.judul}
                      </a>
                    </h4>
                    <p class="text-xs text-civic-muted line-clamp-2 leading-relaxed">{berita.ringkasan}</p>
                  </div>
                </div>
                <div class="p-5 pt-0">
                  <a href={`/berita/${berita.id}`} class="text-xs font-mono font-bold text-blue-700 hover:text-blue-900 uppercase tracking-wider">
                    Baca Lengkap &rarr;
                  </a>
                </div>
              </article>
            ))
          ) : (
            <div class="bg-white border border-civic-border p-6 text-xs text-civic-muted col-span-3 text-center">
              Belum ada publikasi warta khusus untuk dusun ini.
            </div>
          )}
        </div>
      </div>

      <!-- Quick Back Nav -->
      <div class="text-center pt-6">
        <a href="/profil#dusun" class="px-6 py-2.5 border border-civic-border bg-white hover:bg-civic-sand text-civic-navy font-mono text-xs uppercase tracking-wider font-bold transition-colors">
          &larr; Kembali ke Daftar 4 Dusun
        </a>
      </div>

    </div>
  </section>
</Layout>
