---
import Layout from '../layouts/Layout.astro';
import profilData from '../data/profil.json';
---

<Layout
  title="Pemerintahan & Struktur Organisasi Desa Timpik"
  description="Struktur Organisasi Pemerintahan Desa Timpik, Kecamatan Susukan, Kabupaten Semarang. Maklumat pelayanan publik dan bagan struktur pamong desa."
>
  <!-- Architectural Civic Header -->
  <section class="bg-gradient-to-r from-slate-950 via-blue-900 to-blue-800 text-white border-b border-blue-900/40 pt-14 pb-12 sm:pt-16 sm:pb-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm uppercase tracking-wider text-slate-300 mb-5" aria-label="Breadcrumb">
        <a href="/" class="hover:text-blue-300 transition-colors">Beranda</a>
        <span class="text-slate-500">/</span>
        <span class="text-blue-300 font-bold">Pemerintahan & SOTK</span>
      </nav>

      <div class="max-w-3xl space-y-3">
        <div class="flex items-center gap-2.5">
          <span class="h-1 w-8 bg-blue-400 rounded-full"></span>
          <span class="text-sm font-bold uppercase tracking-widest text-blue-300">Aparatur Pamong Praja</span>
        </div>
        
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white leading-tight">
          Pemerintahan Desa Timpik
        </h1>
        
        <p class="text-slate-200 text-base sm:text-lg leading-relaxed pt-1">
          Tata kelola pemerintahan desa yang bersih, transparan, dan berkeadaban dalam melayani seluruh warga di 4 wilayah dusun Kecamatan Susukan.
        </p>
      </div>

    </div>
  </section>

  <!-- Maklumat Pelayanan Publik -->
  <section class="py-8 bg-sky-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="p-6 sm:p-8 bg-white rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="space-y-2 max-w-3xl">
          <span class="text-xs font-bold uppercase tracking-widest text-emerald-700 bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200 inline-block">
            Maklumat Pelayanan Publik Resmi
          </span>
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 leading-snug">
            "Melayani dengan Integritas, Transparan, dan Rp 0,- Bebas Pungutan Liar"
          </h2>
          <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
            Pemerintah Desa Timpik berkomitmen memberikan pelayanan administrasi yang ramah, akuntabel, dan bebas biaya bagi seluruh warga tanpa membedakan status sosial.
          </p>
        </div>
        <div class="shrink-0 flex flex-col sm:flex-row gap-3 w-full sm:w-auto">
          <a
            href="/layanan-surat"
            class="px-6 py-3.5 bg-blue-700 hover:bg-blue-800 text-white text-sm uppercase tracking-wider font-bold transition-colors text-center rounded-xl shadow-xs"
          >
            Katalog Layanan Surat &rarr;
          </a>
          <a
            href="/layanan-surat/lacak"
            class="px-6 py-3.5 border border-slate-300 bg-slate-50 hover:bg-slate-100 text-slate-800 text-sm uppercase tracking-wider font-bold transition-colors text-center rounded-xl"
          >
            Lacak Permohonan
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Struktur Organisasi Desa (Berdasarkan Arahan: Diambil dari Foto Saja) -->
  <section class="py-12 sm:py-16 bg-slate-50 flex-grow">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      
      <div class="border-b border-slate-200 pb-4">
        <span class="text-xs sm:text-sm font-bold uppercase tracking-widest text-blue-700 block mb-1">
          Bagan Resmi Pemerintah Desa
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
          Struktur Organisasi & Tata Kerja (SOTK) Desa Timpik
        </h2>
        <p class="text-sm sm:text-base text-slate-600 mt-1">
          Bagan kepengurusan pemerintahan Desa Timpik ditampilkan langsung dari dokumentasi foto bagan resmi desa.
        </p>
      </div>

      <!-- Container Foto Struktur -->
      <div class="rounded-2xl border border-slate-200 bg-white p-4 sm:p-6 shadow-md space-y-4">
        
        <div class="flex items-center justify-between pb-3 border-b border-slate-100 flex-wrap gap-2">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
            <span class="text-xs sm:text-sm font-bold text-slate-700">Foto Dokumen Bagan Resmi</span>
          </div>
          <a
            id="link-unduh-foto"
            href="/images/balai-desa-timpik.jpg"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-blue-50 text-blue-700 hover:bg-blue-100 text-xs sm:text-sm font-bold transition-colors"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            <span>Buka Foto Ukuran Penuh</span>
          </a>
        </div>

        <div class="overflow-hidden rounded-xl bg-slate-100 border border-slate-200 flex items-center justify-center min-h-[350px]">
          <img
            id="foto-struktur-desa"
            src="/images/balai-desa-timpik.jpg"
            alt="Struktur Organisasi Pemerintah Desa Timpik"
            class="w-full h-auto max-h-[700px] object-contain rounded-xl transition-all"
            loading="lazy"
          />
        </div>

        <p class="text-xs sm:text-sm text-slate-500 text-center italic pt-2">
          Catatan: Bagan ini dapat diperbarui oleh pengelola desa melalui Dashboard Admin.
        </p>
      </div>

    </div>
  </section>
</Layout>

<script is:inline define:vars={{ defaultProfil: profilData }}>
  (() => {
    const STORAGE_KEY = 'timpik_profil_data';
    let data = defaultProfil;

    try {
      const stored = localStorage.getItem(STORAGE_KEY);
      if (stored) {
        const parsed = JSON.parse(stored);
        if (parsed && typeof parsed === 'object') {
          data = { ...defaultProfil, ...parsed };
        }
      }
    } catch (e) {
      console.error(e);
    }

    const imgEl = document.getElementById('foto-struktur-desa');
    const linkEl = document.getElementById('link-unduh-foto');
    const fotoSrc = data.foto_struktur || '/images/balai-desa-timpik.jpg';

    if (imgEl && fotoSrc) {
      imgEl.src = fotoSrc;
    }
    if (linkEl && fotoSrc) {
      linkEl.href = fotoSrc;
    }
  })();
</script>
