---
import Layout from '../layouts/Layout.astro';
import profilData from '../data/profil.json';
---

<Layout
  title="Pemerintahan & Struktur Organisasi Desa Timpik"
  description="Struktur Organisasi Pemerintahan Desa Timpik, Kecamatan Susukan, Kabupaten Semarang. Maklumat pelayanan publik dan bagan struktur pamong desa."
>
  <!-- Architectural Civic Header -->
  <section class="bg-gradient-to-br from-blue-950 via-blue-900 to-blue-700 text-white border-b border-white/20 pt-14 pb-12 sm:pt-16 sm:pb-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm uppercase tracking-wider text-slate-300 mb-5" aria-label="Breadcrumb">
        <a href="/" class="hover:text-blue-300 transition-colors">Beranda</a>
        <span class="text-slate-500">/</span>
        <span class="text-blue-300 font-bold">Pemerintahan & SOTK</span>
      </nav>

      <div class="max-w-3xl space-y-3">
        <div class="flex items-center gap-2.5">
          <span class="h-1 w-8 bg-blue-400 rounded-full"></span>
          <span class="text-sm font-bold uppercase tracking-widest text-blue-300">Aparatur Pamong Praja</span>
        </div>
        
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white leading-tight">
          Pemerintahan Desa Timpik
        </h1>
        
        <p class="text-slate-200 text-base sm:text-lg leading-relaxed pt-1">
          Tata kelola pemerintahan desa yang bersih, transparan, dan berkeadaban dalam melayani seluruh warga di 4 wilayah dusun Kecamatan Susukan.
        </p>
      </div>

    </div>
  </section>

  <!-- Maklumat Pelayanan Publik -->
  <section class="py-8 bg-gray-100 border-b border-white/70">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="glass-panel rounded-2xl p-6 sm:p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="space-y-2 max-w-3xl">
          <span class="text-xs font-bold uppercase tracking-widest text-emerald-700 bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200 inline-block">
            Maklumat Pelayanan Publik Resmi
          </span>
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 leading-snug">
            "Melayani dengan Integritas, Transparan, dan Rp 0,- Bebas Pungutan Liar"
          </h2>
          <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
            Pemerintah Desa Timpik berkomitmen memberikan pelayanan administrasi yang ramah, akuntabel, dan bebas biaya bagi seluruh warga tanpa membedakan status sosial.
          </p>
        </div>
        <div class="shrink-0 flex flex-col sm:flex-row gap-3 w-full sm:w-auto">
          <a
            href="/layanan-surat"
            class="px-6 py-3.5 bg-blue-700 hover:bg-blue-800 text-white text-sm uppercase tracking-wider font-bold transition-colors text-center rounded-xl shadow-xs"
          >
            Katalog Layanan Surat &rarr;
          </a>
          <a
            href="/layanan-surat/lacak"
            class="px-6 py-3.5 border border-slate-300 bg-slate-50 hover:bg-slate-100 text-slate-800 text-sm uppercase tracking-wider font-bold transition-colors text-center rounded-xl"
          >
            Lacak Permohonan
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Struktur Organisasi Desa (Berdasarkan Arahan: Diambil dari Foto Saja) -->
  <section class="py-12 sm:py-16 bg-gray-100 flex-grow">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      
      <div class="border-b border-slate-200 pb-4">
        <span class="text-xs sm:text-sm font-bold uppercase tracking-widest text-blue-700 block mb-1">
          Bagan Resmi Pemerintah Desa
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
          Struktur Organisasi & Tata Kerja (SOTK) Desa Timpik
        </h2>
        <p class="text-sm sm:text-base text-slate-600 mt-1">
          Bagan kepengurusan pemerintahan Desa Timpik ditampilkan langsung dari dokumentasi foto bagan resmi desa.
        </p>
      </div>

      <!-- Container Foto Struktur -->
      <div class="glass-panel rounded-2xl p-4 sm:p-6 space-y-4">
        
        <div class="flex items-center justify-between pb-3 border-b border-slate-100 flex-wrap gap-2">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
            <span class="text-sm font-bold text-slate-800">Foto Dokumen Bagan Resmi SOTK</span>
          </div>
          <button
            type="button"
            id="btn-open-lightbox"
            class="inline-flex min-h-[40px] items-center gap-2 px-4 py-2 rounded-xl bg-blue-50 text-blue-900 hover:bg-blue-100 text-sm font-bold transition-colors border border-blue-200 shadow-2xs"
          >
            <svg class="w-4 h-4 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7"/></svg>
            <span>Klik untuk Perbesar Foto</span>
          </button>
        </div>

        <div class="overflow-hidden rounded-xl bg-blue-900/5 border border-white/80 flex items-center justify-center min-h-[350px] p-2 cursor-zoom-in" id="foto-container-click">
          <img
            id="foto-struktur-desa"
            src="/images/struktur-organisasi-timpik.jpg"
            alt="Struktur Organisasi Pemerintah Desa Timpik"
            class="w-full h-auto max-h-[750px] object-contain rounded-xl transition-transform duration-200 hover:scale-[1.01]"
            loading="lazy"
            onerror="this.src='/images/balai-desa-timpik.jpg'"
          />
        </div>

        <p class="text-xs sm:text-sm text-slate-500 text-center italic pt-2">
          Petunjuk: Klik gambar atau tombol di atas untuk memperbesar foto bagan struktur organisasi.
        </p>
      </div>

    </div>
  </section>

  <!-- Lightbox Modal Fullscreen untuk Memperbesar Gambar Struktur -->
  <div id="lightbox-modal" class="fixed inset-0 z-50 hidden bg-slate-950/90 backdrop-blur-md flex flex-col p-4 sm:p-6 overflow-hidden">
    <div class="flex items-center justify-between pb-3 text-white border-b border-white/20">
      <span class="text-sm sm:text-base font-bold">Bagan Struktur Organisasi Pemerintah Desa Timpik</span>
      <button
        type="button"
        id="btn-close-lightbox"
        class="min-h-[44px] min-w-[44px] flex items-center justify-center rounded-xl bg-white/20 hover:bg-white/30 text-white font-bold text-lg transition-colors"
        aria-label="Tutup Pratinjau"
      >
        &times;
      </button>
    </div>
    <div class="flex-grow overflow-auto flex items-center justify-center p-2">
      <img
        id="lightbox-img"
        src="/images/struktur-organisasi-timpik.jpg"
        alt="Struktur Organisasi Fullscreen"
        class="max-w-none w-auto max-h-[88vh] object-contain rounded-xl shadow-2xl transition-transform"
      />
    </div>
  </div>
</Layout>

<script is:inline define:vars={{ defaultProfil: profilData }}>
  (() => {
    const STORAGE_KEY = 'timpik_profil_data';
    let data = defaultProfil;

    try {
      const stored = localStorage.getItem(STORAGE_KEY);
      if (stored) {
        const parsed = JSON.parse(stored);
        if (parsed && typeof parsed === 'object') {
          data = { ...defaultProfil, ...parsed };
        }
      }
    } catch (e) {
      console.error(e);
    }

    const imgEl = document.getElementById('foto-struktur-desa');
    const lightboxImg = document.getElementById('lightbox-img');
    const lightboxModal = document.getElementById('lightbox-modal');
    const btnOpen = document.getElementById('btn-open-lightbox');
    const containerClick = document.getElementById('foto-container-click');
    const btnClose = document.getElementById('btn-close-lightbox');

    const fotoSrc = data.foto_struktur || '/images/struktur-organisasi-timpik.jpg';

    if (imgEl && fotoSrc) {
      imgEl.src = fotoSrc;
    }
    if (lightboxImg && fotoSrc) {
      lightboxImg.src = fotoSrc;
    }

    function openLightbox() {
      if (lightboxModal) lightboxModal.classList.remove('hidden');
    }

    function closeLightbox() {
      if (lightboxModal) lightboxModal.classList.add('hidden');
    }

    if (btnOpen) btnOpen.addEventListener('click', openLightbox);
    if (containerClick) containerClick.addEventListener('click', openLightbox);
    if (btnClose) btnClose.addEventListener('click', closeLightbox);
    if (lightboxModal) {
      lightboxModal.addEventListener('click', (e) => {
        if (e.target === lightboxModal) closeLightbox();
      });
    }
  })();
</script>
