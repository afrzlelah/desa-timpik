---
import Layout from '../layouts/Layout.astro';
import profilData from '../data/profil.json';

const pamongList = [
  {
    "jabatan": "Kepala Desa (Kades)",
    "nama": "Pemerintah Desa Timpik",
    "kategori": "Pimpinan Desa",
    "tugas": "Memimpin penyelenggaraan pemerintahan desa, pembinaan kemasyarakatan, dan pemberdayaan 4 dusun.",
    "status": "Aktif Menjabat"
  },
  {
    "jabatan": "Sekretaris Desa (Sekdes)",
    "nama": "Sekretariat Desa",
    "kategori": "Pimpinan Administrasi",
    "tugas": "Mengkoordinasikan urusan ketatausahaan, administrasi keuangan APBDes, dan pelayanan surat menyurat.",
    "status": "Aktif Menjabat"
  },
  {
    "jabatan": "Kaur Keuangan",
    "nama": "Staf Keuangan Desa",
    "kategori": "Urusan Keuangan",
    "tugas": "Pengelolaan kas desa, penatausahaan APBDes 2026, dan pelaporan pertanggungjawaban Dana Desa.",
    "status": "Aktif Menjabat"
  },
  {
    "jabatan": "Kaur Perencanaan",
    "nama": "Staf Perencanaan Pembangunan",
    "kategori": "Urusan Perencanaan",
    "tugas": "Penyusunan RKPDes, inventarisasi data potensi desa, dan fasilitasi Musrenbangdes.",
    "status": "Aktif Menjabat"
  },
  {
    "jabatan": "Kaur Tata Usaha & Umum",
    "nama": "Staf Tata Usaha",
    "kategori": "Urusan Umum",
    "tugas": "Pengelolaan arsip, buku register kependudukan, inventaris aset balai desa, dan surat masuk-keluar.",
    "status": "Aktif Menjabat"
  },
  {
    "jabatan": "Kasi Pemerintahan",
    "nama": "Seksi Tata Praja",
    "kategori": "Seksi Pelaksana",
    "tugas": "Pembinaan ketentraman warga, verifikasi SKCK, administrasi pertanahan, dan koordinasi Babinsa/Bhabinkamtibmas.",
    "status": "Aktif Menjabat"
  },
  {
    "jabatan": "Kasi Kesejahteraan",
    "nama": "Seksi Pembangunan & Kesejahteraan",
    "kategori": "Seksi Pelaksana",
    "tugas": "Pembangunan sarana prasarana fisik irigasi sawah, bedah rumah, posyandu, dan bantuan sosial DTKS.",
    "status": "Aktif Menjabat"
  },
  {
    "jabatan": "Kasi Pelayanan",
    "nama": "Seksi Pelayanan Warga",
    "kategori": "Seksi Pelaksana",
    "tugas": "Loket utama permohonan surat kependudukan (SKU, SKD, Kelahiran, Kematian) dan otomasi GForm.",
    "status": "Aktif Menjabat"
  }
];
---

<Layout
  title="Pemerintahan & Struktur Organisasi (SOTK) Desa Timpik"
  description="Struktur Organisasi dan Tata Kerja (SOTK) Pemerintah Desa Timpik, Kecamatan Susukan, Kabupaten Semarang. Maklumat pelayanan publik dan pembagian tugas pamong desa."
>
  <!-- Architectural Civic Header -->
  <section class="bg-civic-navy text-white border-b border-civic-border/30 pt-14 pb-12 sm:pt-16 sm:pb-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs font-mono uppercase tracking-wider text-slate-400 mb-5" aria-label="Breadcrumb">
        <a href="/" class="hover:text-civic-cream transition-colors">Beranda</a>
        <span class="text-slate-600">/</span>
        <span class="text-civic-gold">Pemerintahan & SOTK</span>
      </nav>

      <div class="max-w-3xl space-y-3">
        <div class="flex items-center gap-2.5">
          <span class="h-px w-6 bg-civic-gold"></span>
          <span class="text-xs font-mono uppercase tracking-widest text-civic-gold">Struktur Organisasi & Tata Kerja (SOTK)</span>
        </div>
        
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-black tracking-tight text-white leading-tight">
          Pemerintahan Desa Timpik
        </h1>
        
        <p class="text-slate-300 text-sm sm:text-base leading-relaxed pt-1">
          Jajaran pamong praja desa, maklumat standar pelayanan publik bebas pungli, pembagian tugas urusan administrasi, serta pelaksana kewilayahan 4 Kepala Dusun di Kecamatan Susukan.
        </p>
      </div>

    </div>
  </section>

  <!-- Maklumat Pelayanan Publik (Civic Covenant) -->
  <section class="py-10 bg-civic-sand/30 border-b border-civic-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="p-6 sm:p-8 bg-white border border-civic-border shadow-xs flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="space-y-2 max-w-3xl">
          <span class="text-[10px] font-mono uppercase tracking-widest text-emerald-800 font-bold block">
            Maklumat Pelayanan Publik
          </span>
          <h2 class="text-xl sm:text-2xl font-serif font-bold text-civic-navy">
            "Melayani dengan Integritas, Transparan, dan Rp 0,- Bebas Pungutan Liar"
          </h2>
          <p class="text-xs sm:text-sm text-civic-muted leading-relaxed font-sans">
            Pemerintah Desa Timpik berkomitmen memberikan pelayanan administrasi yang ramah, akuntabel, dan bebas biaya bagi seluruh warga tanpa membedakan status sosial.
          </p>
        </div>
        <div class="shrink-0 flex flex-col sm:flex-row gap-3 w-full sm:w-auto">
          <a
            href="/layanan-surat"
            class="px-5 py-2.5 bg-civic-navy hover:bg-civic-navy/90 text-white font-mono text-xs uppercase tracking-wider font-bold transition-colors text-center"
          >
            Katalog Layanan Surat &rarr;
          </a>
          <a
            href="/layanan-surat/lacak"
            class="px-5 py-2.5 border border-civic-border bg-civic-sand hover:bg-civic-border/60 text-civic-navy font-mono text-xs uppercase tracking-wider font-bold transition-colors text-center"
          >
            Lacak Status Permohonan
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Jajaran Perangkat Desa (SOTK) -->
  <section class="py-14 sm:py-16 bg-civic-cream flex-grow">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <!-- SOTK Perangkat Balai Desa -->
      <div class="space-y-8">
        <div class="border-b border-civic-border pb-4">
          <span class="text-xs font-mono uppercase tracking-widest text-civic-gold block mb-1">Aparatur Pamong Praja</span>
          <h2 class="text-2xl sm:text-3xl font-serif font-black text-civic-navy">Struktur Organisasi & Tata Kerja (SOTK)</h2>
          <p class="text-xs text-civic-muted mt-1">Berdasarkan amanat Permendagri No. 84 Tahun 2015 tentang Tata Kerja Pemerintah Desa.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {pamongList.map((pamong, idx) => (
            <div class="bg-white border border-civic-border p-6 shadow-xs flex flex-col justify-between space-y-4">
              <div>
                <div class="flex items-center justify-between pb-3 border-b border-civic-border/60 mb-3">
                  <span class="text-xs font-mono text-civic-gold font-bold">0{idx + 1}</span>
                  <span class="text-[10px] font-mono uppercase tracking-wider px-2 py-0.5 border border-civic-border bg-civic-sand text-civic-navy font-bold">
                    {pamong.kategori}
                  </span>
                </div>
                <h3 class="font-serif font-bold text-base text-civic-navy">{pamong.jabatan}</h3>
                <p class="text-xs font-mono text-civic-muted mt-0.5">{pamong.nama}</p>
                <p class="text-xs text-civic-muted mt-3 leading-relaxed font-sans">{pamong.tugas}</p>
              </div>
              <div class="pt-3 border-t border-civic-border/60 flex items-center justify-between text-[11px] font-mono text-civic-muted">
                <span>Status Jabatan:</span>
                <span class="text-emerald-800 font-bold flex items-center gap-1.5">
                  <span class="w-1.5 h-1.5 bg-emerald-600"></span>
                  {pamong.status}
                </span>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- 4 Kepala Dusun (Pengampu Kewilayahan) -->
      <div class="space-y-8">
        <div class="border-b border-civic-border pb-4">
          <span class="text-xs font-mono uppercase tracking-widest text-emerald-800 font-bold block mb-1">Pelaksana Kewilayahan</span>
          <h2 class="text-2xl sm:text-3xl font-serif font-black text-civic-navy">Empat Kepala Dusun (Kadus)</h2>
          <p class="text-xs text-civic-muted mt-1">Ujung tombak pelayanan warga, pemeliharaan ketentraman, dan koordinasi tingkat dusun.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {profilData.dusun.map((dusun, idx) => (
            <div class="bg-white border border-civic-border p-6 shadow-xs flex flex-col justify-between space-y-4">
              <div>
                <div class="flex items-center justify-between pb-3 border-b border-civic-border/60 mb-3">
                  <span class="text-xs font-mono text-emerald-800 font-bold">Kadus 0{idx + 1}</span>
                  <span class="text-[10px] font-mono uppercase text-civic-muted font-bold">{dusun.jumlah_rt}</span>
                </div>
                <h4 class="font-serif font-bold text-lg text-civic-navy">{dusun.kepala_dusun}</h4>
                <p class="text-xs font-mono text-civic-gold font-bold mt-0.5">{dusun.nama}</p>
                <p class="text-xs text-civic-muted mt-2 leading-relaxed font-sans line-clamp-3">{dusun.deskripsi}</p>
              </div>

              <div class="pt-3 border-t border-civic-border/60">
                <a
                  href={`/dusun/${dusun.id}`}
                  class="text-xs font-mono font-bold text-civic-navy hover:text-civic-gold uppercase tracking-wider inline-flex items-center gap-1"
                >
                  <span>Buka Dusun</span>
                  <span>&rarr;</span>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>
</Layout>
