---
import Layout from '../layouts/Layout.astro';
import agendaData from '../data/agenda.json';

const categories = [
  'Semua Kategori',
  'Pertanian',
  'Kesehatan',
  'Kebudayaan',
  'Pemerintahan'
];
---

<Layout
  title="Kalender & Agenda Resmi Kegiatan Desa Timpik"
  description="Kalender interaktif kegiatan resmi Desa Timpik, Kecamatan Susukan, Kabupaten Semarang: jadwal giliran air irigasi, posyandu balita & lansia, wayang orang Badoyo, dan musyawarah desa."
>
  <!-- GovTech Header Banner (Solid Deep Navy) -->
  <section class="bg-[#0B1E36] text-white border-b border-slate-800 py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-slate-400 mb-4" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition-colors">Beranda</a>
        <span class="text-slate-600">/</span>
        <a href="/info-desa" class="hover:text-white transition-colors">Pusat Info Desa</a>
        <span class="text-slate-600">/</span>
        <span class="text-blue-300 font-semibold">Kalender Kegiatan</span>
      </nav>

      <div class="max-w-3xl space-y-3">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-blue-900/60 text-blue-200 border border-blue-700/60 text-xs font-semibold">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Kalender Interaktif Resmi Desa</span>
        </div>
        
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white leading-tight">
          Kalender & Agenda Desa Timpik
        </h1>
        
        <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
          Pantau seluruh jadwal musyawarah perencanaan desa, jadwal posyandu balita & lansia, pembagian giliran debit air sawah P3A Bogo Wastro, hingga pementasan kesenian tradisional. Klik tanggal bertanda untuk melihat detail agenda.
        </p>
      </div>

    </div>
  </section>

  <!-- Navigation Toolbar: Bulan, Filter Kategori, & Mode Tampilan -->
  <section class="py-5 bg-white border-b border-slate-200 sticky top-16 z-30 shadow-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
        
        <!-- Controls Bulan & Tahun -->
        <div class="flex items-center gap-2 sm:gap-3">
          <div class="flex items-center bg-slate-100 rounded-2xl p-1.5 border border-slate-200">
            <button
              type="button"
              id="cal-btn-prev"
              class="min-h-[44px] min-w-[44px] p-2.5 rounded-xl text-slate-700 hover:bg-white hover:text-blue-900 hover:shadow-xs transition-all flex items-center justify-center"
              title="Bulan Sebelumnya"
              aria-label="Bulan Sebelumnya"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            </button>
            
            <button
              type="button"
              id="cal-btn-today"
              class="min-h-[44px] px-4 py-2 rounded-xl text-sm font-bold text-slate-800 hover:bg-white hover:text-blue-900 hover:shadow-xs transition-all"
            >
              Bulan Ini
            </button>

            <button
              type="button"
              id="cal-btn-next"
              class="min-h-[44px] min-w-[44px] p-2.5 rounded-xl text-slate-700 hover:bg-white hover:text-blue-900 hover:shadow-xs transition-all flex items-center justify-center"
              title="Bulan Berikutnya"
              aria-label="Bulan Berikutnya"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </button>
          </div>

          <h2 id="cal-current-label" class="text-lg sm:text-2xl font-black text-slate-900 tracking-tight ml-2 whitespace-nowrap">
            November 2026
          </h2>
        </div>

        <!-- View Switcher & Kategori Filter -->
        <div class="flex flex-wrap items-center gap-3">
          
          <!-- Mode Tampilan: Kalender vs Daftar -->
          <div class="inline-flex rounded-2xl p-1.5 bg-slate-100 border border-slate-200 text-sm font-bold">
            <button
              type="button"
              id="btn-mode-calendar"
              class="min-h-[40px] px-4 py-2 rounded-xl bg-blue-900 text-white shadow-xs transition-all flex items-center gap-2"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              <span>Kalender</span>
            </button>
            <button
              type="button"
              id="btn-mode-list"
              class="min-h-[40px] px-4 py-2 rounded-xl text-slate-700 hover:text-slate-900 hover:bg-white/70 transition-all flex items-center gap-2"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"/></svg>
              <span>Daftar</span>
            </button>
          </div>

          <!-- Filter Kategori Pills -->
          <div class="flex items-center gap-2 overflow-x-auto pb-1 sm:pb-0" id="agenda-category-filters">
            {categories.map((cat, idx) => (
              <button
                type="button"
                data-category={cat}
                class={`cal-filter-btn min-h-[40px] px-4 py-2 rounded-xl text-xs sm:text-sm font-bold whitespace-nowrap transition-all ${
                  idx === 0
                    ? 'bg-blue-900 text-white font-bold shadow-xs'
                    : 'bg-slate-100 text-slate-700 hover:bg-slate-200'
                }`}
              >
                {cat}
              </button>
            ))}
          </div>

        </div>

      </div>
    </div>
  </section>

  <!-- Konten Utama: Kalender Bulanan & Daftar Agenda -->
  <section class="py-10 bg-slate-50 flex-grow">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      
      <!-- Petunjuk Singkat -->
      <div class="flex items-center justify-between text-xs text-slate-500 bg-white px-4 py-2.5 rounded-xl border border-slate-200">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-blue-600"></span>
          <span>Klik salah satu tanggal bertanda untuk membuka rincian agenda desa & jadwal kegiatan.</span>
        </div>
        <div class="hidden sm:flex items-center gap-3 text-[11px]">
          <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-teal-500"></span> Pertanian</span>
          <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-rose-500"></span> Kesehatan</span>
          <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-indigo-500"></span> Kebudayaan</span>
          <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-blue-600"></span> Pemerintahan</span>
        </div>
      </div>

      <!-- TAMPILAN 1: GRID KALENDER BULANAN INTERAKTIF -->
      <div id="view-calendar-container" class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
        
        <!-- Header Hari (Minggu - Sabtu) -->
        <div class="grid grid-cols-7 border-b border-slate-200 bg-slate-50/80 text-center text-xs font-bold text-slate-600 py-3">
          <div class="text-rose-600">Min</div>
          <div>Sen</div>
          <div>Sel</div>
          <div>Rab</div>
          <div>Kam</div>
          <div class="text-emerald-700">Jum</div>
          <div>Sab</div>
        </div>

        <!-- Grid 7 Kolom Tanggal (Diisi via JavaScript) -->
        <div id="calendar-days-grid" class="grid grid-cols-7 auto-rows-fr divide-x divide-y divide-slate-100">
          <!-- Dynamically populated by renderCalendar() -->
        </div>

      </div>

      <!-- TAMPILAN 2: DAFTAR KARTU AGENDA (Alternatif List View) -->
      <div id="view-list-container" class="hidden space-y-4">
        <div class="space-y-4" id="agenda-cards-list">
          <!-- Dynamically populated by renderList() -->
        </div>

        <div id="agenda-empty-state" class="hidden py-16 bg-white rounded-3xl border border-slate-200 text-center">
          <svg class="w-12 h-12 text-slate-300 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          <p class="text-sm font-bold text-slate-700">Tidak ada agenda pada kategori ini</p>
          <p class="text-xs text-slate-400 mt-1">Gunakan tombol "Semua Kategori" untuk melihat jadwal lainnya.</p>
        </div>
      </div>

    </div>
  </section>

  <!-- MODAL POP-UP DETAIL AGENDA (Muncul saat tanggal ditekan) -->
  <div id="agenda-modal" class="fixed inset-0 z-50 bg-slate-950/70 backdrop-blur-xs hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl border border-slate-200 shadow-2xl w-full max-w-lg overflow-hidden flex flex-col max-h-[90vh] modal-enter">
      
      <!-- Header Pop-up -->
      <div class="bg-[#0B1E36] text-white p-6 relative">
        <div class="flex items-center justify-between gap-2 mb-2">
          <span id="modal-category-badge" class="px-2.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-blue-800 text-blue-200 border border-blue-700">
            Kategori
          </span>
          <span id="modal-date-display" class="text-xs font-mono font-bold text-sky-300">
            Tanggal
          </span>
        </div>

        <h3 id="modal-agenda-title" class="text-xl font-black text-white leading-snug">
          Judul Agenda Kegiatan
        </h3>

        <button
          type="button"
          id="btn-close-modal"
          class="absolute top-4 right-4 p-1.5 rounded-full bg-slate-800/80 hover:bg-slate-700 text-slate-300 hover:text-white transition-colors"
          aria-label="Tutup Pop-up"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <!-- Konten Rincian Agenda -->
      <div class="p-6 overflow-y-auto space-y-4 text-xs flex-grow">
        
        <!-- Info Meta (Waktu, Tempat, Panitia, Sasaran) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 p-4 rounded-2xl bg-slate-50 border border-slate-200">
          <div>
            <span class="text-[10px] font-bold uppercase text-slate-400 block mb-0.5">Waktu Pelaksanaan:</span>
            <p id="modal-agenda-waktu" class="font-bold text-slate-800 flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-blue-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              <span>-</span>
            </p>
          </div>

          <div>
            <span class="text-[10px] font-bold uppercase text-slate-400 block mb-0.5">Lokasi Kegiatan:</span>
            <p id="modal-agenda-lokasi" class="font-bold text-slate-800 flex items-center gap-1.5 truncate">
              <svg class="w-3.5 h-3.5 text-rose-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/></svg>
              <span>-</span>
            </p>
          </div>

          <div>
            <span class="text-[10px] font-bold uppercase text-slate-400 block mb-0.5">Penyelenggara / Panitia:</span>
            <p id="modal-agenda-penyelenggara" class="font-semibold text-slate-800">
              -
            </p>
          </div>

          <div>
            <span class="text-[10px] font-bold uppercase text-slate-400 block mb-0.5">Sasaran Peserta:</span>
            <p id="modal-agenda-peserta" class="font-bold text-blue-700">
              -
            </p>
          </div>
        </div>

        <!-- Deskripsi Kegiatan -->
        <div class="space-y-1.5">
          <span class="text-[11px] font-bold uppercase tracking-wider text-slate-700 block">Uraian Kegiatan:</span>
          <p id="modal-agenda-deskripsi" class="text-slate-600 leading-relaxed bg-slate-50 p-4 rounded-2xl border border-slate-200">
            -
          </p>
        </div>

        <!-- Notifikasi untuk Multi-Agenda pada hari yang sama -->
        <div id="modal-multi-agenda-container" class="hidden pt-2 border-t border-slate-200 space-y-2">
          <span class="text-[11px] font-bold text-slate-700 block">Agenda Lain Pada Hari Yang Sama:</span>
          <div id="modal-multi-agenda-list" class="space-y-1.5"></div>
        </div>

      </div>

      <!-- Footer Tombol Aksi Pop-up -->
      <div class="p-4 sm:p-5 border-t border-slate-200 bg-slate-50 flex flex-wrap items-center justify-between gap-3">
        <a
          id="btn-modal-wa-share"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="min-h-[44px] px-5 py-2.5 rounded-xl text-sm font-bold bg-emerald-700 hover:bg-emerald-800 text-white shadow-sm transition-colors flex items-center gap-2"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.087-.179.182-.077.357.101.174.452.747.971 1.209.667.593 1.23.776 1.403.863.174.087.275.072.376-.043.101-.116.433-.506.549-.68.116-.173.231-.144.39-.087s1.011.477 1.184.564c.173.087.289.13.332.203.043.072.043.419-.101.824z"/></svg>
          <span>Bagikan ke WA</span>
        </a>

        <div class="flex items-center gap-2">
          <a
            id="btn-modal-gcal"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="min-h-[44px] px-4 py-2.5 rounded-xl text-sm font-bold bg-white border border-slate-300 text-slate-800 hover:bg-slate-100 transition-colors flex items-center gap-2"
          >
            <svg class="w-4 h-4 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            <span>Simpan Kalender</span>
          </a>

          <button
            type="button"
            id="btn-modal-close-bottom"
            class="min-h-[44px] px-5 py-2.5 rounded-xl text-sm font-bold text-slate-800 bg-slate-200 hover:bg-slate-300 transition-colors"
          >
            Tutup
          </button>
        </div>
      </div>

    </div>
  </div>

</Layout>

<script is:inline define:vars={{ initialAgenda: agendaData }}>
  const STORAGE_KEY = 'timpik_agenda_list';

  function getStoredAgenda() {
    try {
      const stored = localStorage.getItem(STORAGE_KEY);
      if (stored) {
        const parsed = JSON.parse(stored);
        if (Array.isArray(parsed) && parsed.length > 0) return parsed;
      }
    } catch (e) {
      console.warn('Gagal membaca agenda localStorage', e);
    }
    return initialAgenda;
  }

  let agendaList = getStoredAgenda();
  let activeCategory = 'Semua Kategori';

  // State Kalender (Bulan & Tahun aktif)
  // Default ke November 2026 sesuai rentang data kegiatan KKN & Desa
  let currentYear = 2026;
  let currentMonth = 10; // 0-indexed: 10 = November

  const MONTH_NAMES = [
    'Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni',
    'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'
  ];

  // Helper Parse Tanggal Indonesia: "15 November 2026"
  function parseIndoDate(dateStr) {
    if (!dateStr) return null;
    const parts = dateStr.trim().split(/\s+/);
    if (parts.length >= 3) {
      const day = parseInt(parts[0], 10);
      const mStr = parts[1].toLowerCase();
      let month = -1;
      MONTH_NAMES.forEach((m, idx) => {
        if (m.toLowerCase().startsWith(mStr) || mStr.startsWith(m.toLowerCase())) {
          month = idx;
        }
      });
      const year = parseInt(parts[2], 10);
      if (!isNaN(day) && month !== -1 && !isNaN(year)) {
        return { day, month, year };
      }
    }
    // Fallback Date object
    const d = new Date(dateStr);
    if (!isNaN(d.getTime())) {
      return { day: d.getDate(), month: d.getMonth(), year: d.getFullYear() };
    }
    return null;
  }

  // Helper Warna Kategori
  function getCategoryTheme(cat) {
    switch (cat) {
      case 'Pertanian':
        return {
          chip: 'bg-teal-100 text-teal-900 border-teal-300',
          dot: 'bg-teal-500',
          badge: 'bg-teal-50 text-teal-800 border-teal-200'
        };
      case 'Kesehatan':
        return {
          chip: 'bg-rose-100 text-rose-900 border-rose-300',
          dot: 'bg-rose-500',
          badge: 'bg-rose-50 text-rose-800 border-rose-200'
        };
      case 'Kebudayaan':
        return {
          chip: 'bg-indigo-100 text-indigo-900 border-indigo-300',
          dot: 'bg-indigo-500',
          badge: 'bg-indigo-50 text-indigo-900 border-indigo-200'
        };
      default:
        return {
          chip: 'bg-blue-100 text-blue-900 border-blue-300',
          dot: 'bg-blue-600',
          badge: 'bg-blue-50 text-blue-800 border-blue-200'
        };
    }
  }

  // 1. RENDER KALENDER BULANAN
  function renderCalendar() {
    const grid = document.getElementById('calendar-days-grid');
    const label = document.getElementById('cal-current-label');
    if (!grid || !label) return;

    label.textContent = `${MONTH_NAMES[currentMonth]} ${currentYear}`;

    // Menghitung hari pertama dan total hari
    const firstDayIndex = new Date(currentYear, currentMonth, 1).getDay(); // 0 = Minggu
    const totalDays = new Date(currentYear, currentMonth + 1, 0).getDate();
    const prevMonthDays = new Date(currentYear, currentMonth, 0).getDate();

    let cellsHtml = '';

    // A. Hari-hari dari bulan sebelumnya (padding)
    for (let i = firstDayIndex - 1; i >= 0; i--) {
      const prevDate = prevMonthDays - i;
      cellsHtml += `
        <div class="min-h-[90px] sm:min-h-[115px] p-2 bg-slate-50/50 text-slate-300 select-none flex flex-col justify-between opacity-60">
          <span class="text-xs font-semibold">${prevDate}</span>
        </div>
      `;
    }

    // B. Hari-hari bulan aktif
    for (let day = 1; day <= totalDays; day++) {
      // Cari agenda pada tanggal ini
      const dayAgendas = agendaList.filter(a => {
        const parsed = parseIndoDate(a.tanggal);
        if (!parsed) return false;
        const matchDate = parsed.year === currentYear && parsed.month === currentMonth && parsed.day === day;
        const matchCat = activeCategory === 'Semua Kategori' || a.kategori === activeCategory;
        return matchDate && matchCat;
      });

      const hasEvents = dayAgendas.length > 0;
      const isSunday = new Date(currentYear, currentMonth, day).getDay() === 0;
      const isFriday = new Date(currentYear, currentMonth, day).getDay() === 5;

      let dateNumberColor = 'text-slate-800';
      if (isSunday) dateNumberColor = 'text-rose-600';
      if (isFriday) dateNumberColor = 'text-emerald-700';

      const cellBg = hasEvents
        ? 'bg-blue-50/40 hover:bg-blue-50/90 border-blue-300 cursor-pointer shadow-xs'
        : 'bg-white hover:bg-slate-50/60';

      cellsHtml += `
        <div
          class="calendar-day-cell min-h-[90px] sm:min-h-[115px] p-2 flex flex-col justify-between transition-all group ${cellBg}"
          data-day="${day}"
          data-has-events="${hasEvents ? '1' : '0'}"
        >
          <div class="flex items-center justify-between mb-1">
            <span class="text-xs sm:text-sm font-bold ${dateNumberColor} group-hover:scale-110 transition-transform">
              ${day}
            </span>
            ${hasEvents ? `
              <span class="inline-flex sm:hidden w-2 h-2 rounded-full bg-blue-600"></span>
              <span class="hidden sm:inline-flex px-1.5 py-0.5 rounded text-[9px] font-black bg-blue-700 text-white">
                ${dayAgendas.length}
              </span>
            ` : ''}
          </div>

          <!-- Event Chips (Desktop & Tablet) -->
          <div class="space-y-1 overflow-hidden flex-grow flex flex-col justify-end">
            ${dayAgendas.slice(0, 2).map(ev => {
              const theme = getCategoryTheme(ev.kategori);
              return `
                <div
                  class="event-chip text-[10px] font-semibold px-1.5 py-0.5 rounded truncate border ${theme.chip} flex items-center gap-1 shadow-2xs hover:brightness-95"
                  title="${ev.nama} (${ev.waktu})"
                  data-event-id="${ev.id}"
                >
                  <span class="w-1.5 h-1.5 rounded-full shrink-0 ${theme.dot}"></span>
                  <span class="truncate">${ev.nama}</span>
                </div>
              `;
            }).join('')}
            ${dayAgendas.length > 2 ? `
              <span class="text-[9px] font-bold text-blue-700 block truncate">
                +${dayAgendas.length - 2} agenda lainnya
              </span>
            ` : ''}
          </div>
        </div>
      `;
    }

    // C. Hari-hari bulan berikutnya untuk menggenapi grid (total cell kelipatan 7)
    const totalFilled = firstDayIndex + totalDays;
    const nextDaysNeeded = (7 - (totalFilled % 7)) % 7;
    for (let j = 1; j <= nextDaysNeeded; j++) {
      cellsHtml += `
        <div class="min-h-[90px] sm:min-h-[115px] p-2 bg-slate-50/50 text-slate-300 select-none flex flex-col justify-between opacity-60">
          <span class="text-xs font-semibold">${j}</span>
        </div>
      `;
    }

    grid.innerHTML = cellsHtml;

    // Attach click events to cells
    attachCalendarClickEvents();
  }

  // 2. RENDER DAFTAR (LIST VIEW)
  function renderList() {
    const container = document.getElementById('agenda-cards-list');
    const emptyState = document.getElementById('agenda-empty-state');
    if (!container) return;

    const filtered = agendaList.filter(a => {
      const matchCat = activeCategory === 'Semua Kategori' || a.kategori === activeCategory;
      return matchCat;
    });

    if (filtered.length === 0) {
      container.innerHTML = '';
      if (emptyState) emptyState.classList.remove('hidden');
      return;
    }

    if (emptyState) emptyState.classList.add('hidden');

    container.innerHTML = filtered.map(a => {
      const theme = getCategoryTheme(a.kategori);
      return `
        <div
          class="agenda-list-card bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-all p-5 sm:p-6 flex flex-col md:flex-row gap-5 items-start md:items-center justify-between cursor-pointer"
          data-event-id="${a.id}"
        >
          <div class="flex-grow space-y-2">
            <div class="flex flex-wrap items-center gap-2">
              <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded border ${theme.badge}">
                ${a.kategori}
              </span>
              <span class="text-xs text-slate-500 font-medium">&bull; Panitia: <strong class="text-slate-700">${a.penyelenggara}</strong></span>
            </div>

            <h3 class="text-base sm:text-lg font-bold text-slate-900 leading-snug">
              ${a.nama}
            </h3>

            <p class="text-xs text-slate-600 leading-relaxed line-clamp-2">
              ${a.deskripsi}
            </p>

            <div class="pt-2 flex flex-wrap items-center gap-4 text-xs text-slate-600">
              <span class="flex items-center gap-1.5 font-bold text-blue-700">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                ${a.tanggal}
              </span>
              <span class="flex items-center gap-1.5 text-slate-500">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                ${a.waktu}
              </span>
              <span class="flex items-center gap-1.5 text-slate-700">
                <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/></svg>
                ${a.lokasi}
              </span>
            </div>
          </div>

          <div class="shrink-0 w-full md:w-auto flex md:flex-col items-center md:items-end justify-between gap-2 border-t md:border-t-0 pt-3 md:pt-0 border-slate-100">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Sasaran:</span>
            <span class="text-xs font-bold text-blue-700">${a.peserta || 'Warga Desa'}</span>
            <button type="button" class="mt-1 px-3 py-1.5 rounded-lg bg-blue-50 text-blue-800 text-xs font-bold hover:bg-blue-100 transition-colors">
              Lihat Detail &rarr;
            </button>
          </div>
        </div>
      `;
    }).join('');

    // List click events
    document.querySelectorAll('.agenda-list-card').forEach(card => {
      card.addEventListener('click', () => {
        const id = card.getAttribute('data-event-id');
        const ev = agendaList.find(a => a.id === id);
        if (ev) openAgendaModal(ev);
      });
    });
  }

  // 3. EVENT MODAL POP-UP LOGIC
  const modal = document.getElementById('agenda-modal');
  const modalBadge = document.getElementById('modal-category-badge');
  const modalDate = document.getElementById('modal-date-display');
  const modalTitle = document.getElementById('modal-agenda-title');
  const modalWaktu = document.getElementById('modal-agenda-waktu');
  const modalLokasi = document.getElementById('modal-agenda-lokasi');
  const modalPanitia = document.getElementById('modal-agenda-penyelenggara');
  const modalPeserta = document.getElementById('modal-agenda-peserta');
  const modalDeskripsi = document.getElementById('modal-agenda-deskripsi');
  const modalMultiContainer = document.getElementById('modal-multi-agenda-container');
  const modalMultiList = document.getElementById('modal-multi-agenda-list');
  const btnWaShare = document.getElementById('btn-modal-wa-share');
  const btnGcal = document.getElementById('btn-modal-gcal');

  function openAgendaModal(ev, allDayEvents = []) {
    if (!modal || !ev) return;

    modalBadge.textContent = ev.kategori || 'Kegiatan Desa';
    modalDate.textContent = ev.tanggal || '';
    modalTitle.textContent = ev.nama || '';
    modalWaktu.querySelector('span').textContent = ev.waktu || '-';
    modalLokasi.querySelector('span').textContent = ev.lokasi || '-';
    modalPanitia.textContent = ev.penyelenggara || 'Pemerintah Desa Timpik';
    modalPeserta.textContent = ev.peserta || 'Seluruh Warga Desa';
    modalDeskripsi.textContent = ev.deskripsi || 'Tidak ada deskripsi tambahan.';

    // WhatsApp share text
    const textWa = `*Pengumuman Agenda Desa Timpik*%0A%0A*Kegiatan:* ${encodeURIComponent(ev.nama)}%0A*Kategori:* ${encodeURIComponent(ev.kategori)}%0A*Tanggal:* ${encodeURIComponent(ev.tanggal)}%0A*Waktu:* ${encodeURIComponent(ev.waktu)}%0A*Lokasi:* ${encodeURIComponent(ev.lokasi)}%0A*Penyelenggara:* ${encodeURIComponent(ev.penyelenggara)}%0A%0A*Uraian:*%0A${encodeURIComponent(ev.deskripsi)}%0A%0ASumber: Website Resmi Desa Timpik (https://timpik-desa.id/agenda)`;
    if (btnWaShare) {
      btnWaShare.href = `https://wa.me/?text=${textWa}`;
    }

    // Google Calendar Link
    if (btnGcal) {
      const gcalTitle = encodeURIComponent(ev.nama);
      const gcalDetails = encodeURIComponent(`${ev.deskripsi}\n\nPenyelenggara: ${ev.penyelenggara}\nSasaran: ${ev.peserta}`);
      const gcalLocation = encodeURIComponent(ev.lokasi);
      btnGcal.href = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${gcalTitle}&details=${gcalDetails}&location=${gcalLocation}`;
    }

    // Handle multiple events on the same day
    if (allDayEvents.length > 1 && modalMultiContainer && modalMultiList) {
      modalMultiContainer.classList.remove('hidden');
      modalMultiList.innerHTML = allDayEvents
        .filter(other => other.id !== ev.id)
        .map(other => `
          <button
            type="button"
            class="btn-switch-multi-agenda w-full text-left p-2 rounded-xl bg-blue-50/70 hover:bg-blue-100 text-blue-900 border border-blue-200 transition-colors flex items-center justify-between text-xs"
            data-id="${other.id}"
          >
            <span class="font-bold truncate">${other.nama}</span>
            <span class="text-[11px] text-blue-700 shrink-0 ml-2">${other.waktu} &rarr;</span>
          </button>
        `).join('');

      modalMultiList.querySelectorAll('.btn-switch-multi-agenda').forEach(btn => {
        btn.addEventListener('click', () => {
          const targetId = btn.getAttribute('data-id');
          const targetEv = allDayEvents.find(x => x.id === targetId);
          if (targetEv) openAgendaModal(targetEv, allDayEvents);
        });
      });
    } else if (modalMultiContainer) {
      modalMultiContainer.classList.add('hidden');
    }

    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeAgendaModal() {
    if (modal) {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }
  }

  document.getElementById('btn-close-modal')?.addEventListener('click', closeAgendaModal);
  document.getElementById('btn-modal-close-bottom')?.addEventListener('click', closeAgendaModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeAgendaModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAgendaModal();
  });

  // Attach click listener ke sel kalender
  function attachCalendarClickEvents() {
    document.querySelectorAll('.calendar-day-cell').forEach(cell => {
      cell.addEventListener('click', () => {
        const day = parseInt(cell.getAttribute('data-day') || '0', 10);
        if (!day) return;

        // Ambil semua agenda pada tanggal yang diklik
        const dayAgendas = agendaList.filter(a => {
          const parsed = parseIndoDate(a.tanggal);
          if (!parsed) return false;
          const matchDate = parsed.year === currentYear && parsed.month === currentMonth && parsed.day === day;
          const matchCat = activeCategory === 'Semua Kategori' || a.kategori === activeCategory;
          return matchDate && matchCat;
        });

        if (dayAgendas.length > 0) {
          openAgendaModal(dayAgendas[0], dayAgendas);
        } else {
          // Jika tanggal kosong diklik
          openAgendaModal({
            id: 'empty',
            nama: `Belum Ada Agenda Terjadwal`,
            kategori: 'Informasi',
            tanggal: `${day} ${MONTH_NAMES[currentMonth]} ${currentYear}`,
            waktu: 'Tidak ada kegiatan terjadwal',
            lokasi: 'Wilayah Desa Timpik',
            penyelenggara: 'Pemerintah Desa Timpik',
            peserta: 'Warga Desa Timpik',
            deskripsi: `Belum ada agenda kegiatan resmi desa pada tanggal ${day} ${MONTH_NAMES[currentMonth]} ${currentYear}. Hubungi perangkat desa bila ingin mendaftarkan musyawarah RT/RW atau kegiatan warga.`
          });
        }
      });
    });
  }

  // 4. BULAN NAVIGATION (PREV, NEXT, TODAY)
  document.getElementById('cal-btn-prev')?.addEventListener('click', () => {
    currentMonth--;
    if (currentMonth < 0) {
      currentMonth = 11;
      currentYear--;
    }
    renderCalendar();
  });

  document.getElementById('cal-btn-next')?.addEventListener('click', () => {
    currentMonth++;
    if (currentMonth > 11) {
      currentMonth = 0;
      currentYear++;
    }
    renderCalendar();
  });

  document.getElementById('cal-btn-today')?.addEventListener('click', () => {
    // Kembali ke November 2026 (atau current real date)
    currentYear = 2026;
    currentMonth = 10;
    renderCalendar();
  });

  // 5. VIEW SWITCHER (KALENDER VS LIST)
  const btnCalendar = document.getElementById('btn-mode-calendar');
  const btnList = document.getElementById('btn-mode-list');
  const viewCalendar = document.getElementById('view-calendar-container');
  const viewList = document.getElementById('view-list-container');

  btnCalendar?.addEventListener('click', () => {
    btnCalendar.className = 'px-3.5 py-1.5 rounded-lg bg-blue-700 text-white shadow-xs transition-all flex items-center gap-1.5';
    btnList.className = 'px-3.5 py-1.5 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-white/60 transition-all flex items-center gap-1.5';
    viewCalendar?.classList.remove('hidden');
    viewList?.classList.add('hidden');
  });

  btnList?.addEventListener('click', () => {
    btnList.className = 'px-3.5 py-1.5 rounded-lg bg-blue-700 text-white shadow-xs transition-all flex items-center gap-1.5';
    btnCalendar.className = 'px-3.5 py-1.5 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-white/60 transition-all flex items-center gap-1.5';
    viewCalendar?.classList.add('hidden');
    viewList?.classList.remove('hidden');
    renderList();
  });

  // 6. CATEGORY FILTER
  const filterBtns = document.querySelectorAll('.cal-filter-btn');
  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => {
        b.className = 'cal-filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold whitespace-nowrap bg-slate-100 text-slate-600 hover:bg-slate-200 transition-all';
      });
      btn.className = 'cal-filter-btn px-3 py-1.5 rounded-lg text-xs font-bold whitespace-nowrap bg-blue-700 text-white transition-all shadow-xs';
      activeCategory = btn.getAttribute('data-category') || 'Semua Kategori';
      renderCalendar();
      renderList();
    });
  });

  // 7. INITIAL RENDER
  renderCalendar();
</script>
