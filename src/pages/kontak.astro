---
import Layout from '../layouts/Layout.astro';
import kontakData from '../data/kontak.json';

const { operasional, kontak_darurat } = kontakData;
---

<Layout
  title="Direktori Kontak & Komunikasi Resmi Desa Timpik"
  description="Pusat informasi kontak resmi Balai Desa Timpik, jam operasional pelayanan, direktori telepon darurat 24 jam medis, ambulans, Babinsa, serta form kirim pesan langsung."
>
  <!-- Architectural Civic Header -->
  <section class="bg-gradient-to-r from-black to-blue-900 text-white border-b border-civic-border/30 pt-14 pb-12 sm:pt-16 sm:pb-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs  uppercase tracking-wider text-slate-400 mb-5" aria-label="Breadcrumb">
        <a href="/" class="hover:text-blue-300 transition-colors">Beranda</a>
        <span class="text-slate-600">/</span>
        <span class="text-blue-300 font-bold">Kontak & Pusat Layanan</span>
      </nav>

      <div class="max-w-3xl space-y-3">
        <!-- <div class="flex items-center gap-2.5">
          <span class="h-px w-6 bg-blue-400"></span>
          <span class="text-xs  uppercase tracking-widest text-blue-300 font-bold">Saluran Resmi Pemerintah Desa</span>
        </div> -->
        
        <h1 class="text-3xl sm:text-4xl lg:text-5xl  font-black tracking-tight text-white leading-tight">
          Direktori Kontak & Pelayanan Warga
        </h1>
        
        <p class="text-slate-300 text-sm sm:text-base leading-relaxed pt-1">
          Hubungi aparatur Balai Desa Timpik, koordinasi perangkat 4 dusun, akses kontak siaga 24 jam medis & ketertiban, serta sampaikan aspirasi warga melalui saluran terpadu.
        </p>
      </div>

    </div>
  </section>

  <!-- Section 1: Balai Desa Operational & Direct Desk Ledger -->
  <section class="py-10 bg-sky-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-3 divide-y lg:divide-y-0 lg:divide-x divide-slate-200 bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        
        <!-- Kolom 1: Balai Desa & Jam Kerja -->
        <div class="p-6 sm:p-8 flex flex-col justify-between space-y-6">
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="text-xs uppercase tracking-widest text-slate-500 font-bold" id="view-nama-kantor">{operasional.nama_kantor}</span>
              <span class="text-xs uppercase tracking-wider px-2.5 py-1 rounded-md border border-emerald-300 bg-emerald-50 text-emerald-800 font-bold" id="view-status-badge">
                {operasional.status_layanan}
              </span>
            </div>
            
            <h2 class="text-xl font-extrabold text-slate-900">Jam Pelayanan Kantor</h2>
            <p class="text-sm sm:text-base text-slate-600 mt-1 leading-relaxed" id="view-alamat-kantor">
              {operasional.alamat}
            </p>
          </div>

          <div class="pt-4 border-t border-slate-100 space-y-2 text-sm">
            <div class="flex items-center justify-between">
              <span class="text-slate-600">Senin &ndash; Kamis:</span>
              <strong class="text-slate-900 font-bold" id="view-jam-senin-kamis">{operasional.jam_senin_kamis}</strong>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-slate-600">Jumat:</span>
              <strong class="text-slate-900 font-bold" id="view-jam-jumat">{operasional.jam_jumat}</strong>
            </div>
            <p class="text-xs text-slate-500 italic pt-1.5 border-t border-dashed border-slate-200" id="view-keterangan-layanan">
              {operasional.keterangan_layanan}
            </p>
          </div>
        </div>

        <!-- Kolom 2: WhatsApp Pelayanan Warga -->
        <div class="p-6 sm:p-8 flex flex-col justify-between space-y-6 bg-emerald-50/50">
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="text-xs uppercase tracking-wider text-emerald-800 font-bold">Layanan Warga Online</span>
              <span class="text-xs px-2.5 py-1 bg-emerald-200/80 text-emerald-950 font-bold rounded-md">Respon Cepat</span>
            </div>

            <h2 class="text-xl font-bold text-slate-900">WhatsApp Pelayanan Desa</h2>
            <p class="text-sm text-slate-700 mt-2 leading-relaxed">
              Konsultasi persyaratan berkas surat, panduan pengisian formulir, atau tindak lanjut dokumen administrasi kependudukan Anda.
            </p>
          </div>

          <div class="pt-4 border-t border-emerald-200/60">
            <a
              id="view-wa-link"
              href={`https://wa.me/${operasional.telepon.replace(/[^0-9]/g, '')}?text=Halo%20Admin%20Pelayanan%20Desa%20Timpik,%20saya%20ingin%20berkonsultasi%20mengenai%20pelayanan%20surat`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full min-h-[48px] py-3 px-4 bg-emerald-700 hover:bg-emerald-800 text-white text-sm font-bold rounded-xl transition-colors flex items-center justify-center gap-2 shadow-sm"
            >
              <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-5.46-4.45-9.92-9.91-9.92z"/></svg>
              <span id="view-wa-text">Chat WhatsApp ({operasional.telepon})</span>
            </a>
          </div>
        </div>

        <!-- Kolom 3: Email Resmi Kedinasan -->
        <div class="p-6 sm:p-8 flex flex-col justify-between space-y-6">
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="text-xs uppercase tracking-wider text-blue-900 font-bold">Surat & Kerja Sama</span>
              <span class="text-xs px-2.5 py-1 bg-blue-100 text-blue-950 font-bold rounded-md">Resmi</span>
            </div>

            <h2 class="text-xl font-bold text-slate-900">Surat Dinas & Kemitraan</h2>
            <p class="text-sm text-slate-700 mt-2 leading-relaxed">
              Penerimaan surat kedinasan, kemitraan perguruan tinggi / KKN, instansi vertikal, maupun kerjasama pembangunan desa.
            </p>
          </div>

          <div class="pt-4 border-t border-slate-200">
            <a
              id="view-email-link"
              href={`mailto:${operasional.email}`}
              class="w-full min-h-[48px] py-3 px-4 bg-blue-900 hover:bg-blue-950 text-white text-sm font-bold rounded-xl transition-colors flex items-center justify-center gap-2 shadow-sm truncate"
            >
              <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              <span id="view-email-text" class="truncate">{operasional.email}</span>
            </a>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- Section 2: Form Kirim Pesan & Lokasi Fisik Balai Desa -->
  <section class="py-12 sm:py-16 bg-slate-50 flex-grow">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        
        <!-- Form Kirim Pesan / Pertanyaan Warga -->
        <div class="lg:col-span-7 bg-white p-6 sm:p-8 rounded-2xl border border-slate-200 shadow-sm space-y-6">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs uppercase tracking-wider text-blue-900 font-bold block">
              Formulir Komunikasi Warga
            </span>
            <h2 class="text-2xl sm:text-3xl font-black text-slate-900 mt-1">Kirim Pertanyaan atau Masukan</h2>
            <p class="text-sm sm:text-base text-slate-600 mt-2 leading-relaxed">
              Pesan Anda akan dirangkai dan diteruskan secara langsung ke nomor WhatsApp petugas pelayanan Balai Desa Timpik.
            </p>
          </div>

          <form id="form-kontak-publik" class="space-y-5 text-sm">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="contact-nama" class="block text-sm text-slate-800 font-bold mb-1.5">
                  Nama Lengkap <span class="text-rose-600">*</span>
                </label>
                <input
                  type="text"
                  id="contact-nama"
                  required
                  placeholder="Contoh: Bpk. Budi Santoso"
                  class="w-full px-4 py-3 text-sm sm:text-base border border-slate-300 rounded-xl text-slate-900 bg-white focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-blue-600 font-sans"
                />
              </div>

              <div>
                <label for="contact-dusun" class="block text-sm text-slate-800 font-bold mb-1.5">
                  Wilayah / Dusun <span class="text-rose-600">*</span>
                </label>
                <select
                  id="contact-dusun"
                  required
                  class="w-full px-4 py-3 text-sm sm:text-base border border-slate-300 rounded-xl text-slate-900 bg-white focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-blue-600 font-sans"
                >
                  <option value="Dusun Krajan">Dusun Krajan</option>
                  <option value="Dusun Sumber">Dusun Sumber</option>
                  <option value="Dusun Bogo">Dusun Bogo</option>
                  <option value="Dusun Kencana">Dusun Kencana</option>
                  <option value="Luar Desa Timpik">Warga Luar Desa Timpik</option>
                </select>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="contact-telepon" class="block text-sm text-slate-800 font-bold mb-1.5">
                  Nomor WhatsApp / HP <span class="text-rose-600">*</span>
                </label>
                <input
                  type="tel"
                  id="contact-telepon"
                  required
                  placeholder="Contoh: 081234567890"
                  class="w-full px-4 py-3 text-sm sm:text-base border border-slate-300 rounded-xl text-slate-900 bg-white focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-blue-600 font-sans"
                />
              </div>

              <div>
                <label for="contact-kategori" class="block text-sm text-slate-800 font-bold mb-1.5">
                  Kategori Keperluan
                </label>
                <select
                  id="contact-kategori"
                  class="w-full px-4 py-3 text-sm sm:text-base border border-slate-300 rounded-xl text-slate-900 bg-white focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-blue-600 font-sans"
                >
                  <option value="Pelayanan Administrasi & Surat">Pelayanan Administrasi & Surat</option>
                  <option value="Pertanian & Irigasi (P3A / Gapoktan)">Pertanian & Irigasi (P3A / Gapoktan)</option>
                  <option value="Pembangunan & Fasilitas Dusun">Pembangunan & Fasilitas Dusun</option>
                  <option value="Kemitraan KKN & Lembaga">Kemitraan KKN & Lembaga</option>
                  <option value="Pertanyaan Umum">Pertanyaan Umum Lainnya</option>
                </select>
              </div>
            </div>

            <div>
              <label for="contact-pesan" class="block text-sm text-slate-800 font-bold mb-1.5">
                Isi Pesan / Pertanyaan <span class="text-rose-600">*</span>
              </label>
              <textarea
                id="contact-pesan"
                rows="4"
                required
                placeholder="Tuliskan secara jelas dan ringkas pesan atau pertanyaan Anda..."
                class="w-full px-4 py-3 text-sm sm:text-base border border-slate-300 rounded-xl text-slate-900 bg-white focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-blue-600 font-sans leading-relaxed"
              ></textarea>
            </div>

            <div class="pt-2">
              <button
                type="submit"
                class="w-full min-h-[50px] py-3.5 px-6 bg-blue-900 hover:bg-blue-950 text-white text-base font-bold transition-all flex items-center justify-center gap-2 rounded-xl shadow-md"
              >
                <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-5.46-4.45-9.92-9.91-9.92z"/></svg>
                <span>Kirim Pesan ke WhatsApp Pelayanan Balai Desa</span>
              </button>
            </div>
          </form>
        </div>

        <!-- Peta Interaktif & Rute -->
        <div class="lg:col-span-5 bg-white p-6 sm:p-8 rounded-2xl border border-slate-200 shadow-sm space-y-4">
          <div class="border-b border-slate-200 pb-3">
            <span class="text-xs uppercase tracking-wider text-blue-900 font-bold block">Lokasi & Navigasi</span>
            <h2 class="text-2xl font-black text-slate-900 mt-1">Kompleks Balai Desa Timpik</h2>
            <p class="text-sm text-slate-600 mt-1">Patokan: Jalan Utama Dusun Krajan arah Susukan &ndash; Kaliwungu.</p>
          </div>

          <div class="border border-slate-200 rounded-xl overflow-hidden shadow-xs">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d15828.69482161642!2d110.57500000000002!3d-7.335000000000001!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e7a7837b2d55555%3A0x1234567890abcdef!2sTimpik%2C%20Susukan%2C%20Semarang%20Regency%2C%20Central%20Java!5e0!3m2!1sen!2sid!4v1700000000000!5m2!1sen!2sid"
              width="100%"
              height="260"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Peta Kantor Balai Desa Timpik"
              class="w-full grayscale contrast-125 hover:grayscale-0 transition-all duration-300"
            ></iframe>
          </div>

          <div class="space-y-3 pt-2 text-sm">
            <div class="p-3.5 bg-slate-50 rounded-xl border border-slate-200 text-slate-800 space-y-1">
              <p class="font-bold text-slate-900">Aksesibilitas Wilayah:</p>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                Dapat dijangkau dengan kendaraan roda dua maupun roda empat melalui rute Susukan &ndash; Kemetul &ndash; Timpik. Area parkir pendopo balai desa tersedia luas bagi warga.
              </p>
            </div>

            <a
              href="https://maps.google.com/?q=Balai+Desa+Timpik+Susukan+Semarang"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full min-h-[46px] py-3 px-4 bg-slate-100 hover:bg-slate-200 text-slate-800 text-sm font-bold border border-slate-300 rounded-xl transition-colors flex items-center justify-center gap-2"
            >
              <svg class="w-5 h-5 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
              <span>Petunjuk Arah Google Maps</span>
            </a>
          </div>
        </div>

      </div>

      <!-- Emergency Hotline Ledger: Buku Telepon Siaga Warga -->
      <div class="border-t border-slate-200 pt-12">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6">
          <div>
            <div class="flex items-center gap-2 mb-1.5">
              <span class="w-3 h-3 bg-rose-600 rounded-full animate-pulse"></span>
              <span class="text-xs uppercase tracking-wider text-rose-700 font-bold">Siaga Darurat 24 Jam</span>
            </div>
            <h2 class="text-2xl sm:text-3xl font-black text-slate-900">Buku Telepon Siaga Warga</h2>
          </div>
          <p class="text-sm text-slate-600 max-w-md">
            Layanan tanggap darurat medis, keamanan teritorial, dan saluran irigasi pertanian Desa Timpik yang dikelola aparatur.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4" id="emergency-cards-grid">
          {kontak_darurat.map((item) => (
            <div class="bg-white border border-slate-200 rounded-2xl p-5 flex flex-col justify-between space-y-4 shadow-sm">
              <div>
                <div class="flex items-center justify-between gap-1 mb-2 pb-2 border-b border-slate-100">
                  <span class={`text-xs uppercase tracking-wider px-2 py-0.5 rounded font-bold border ${
                    item.badge_color === 'emerald' ? 'bg-emerald-50 text-emerald-800 border-emerald-200' :
                    item.badge_color === 'teal' ? 'bg-teal-50 text-teal-800 border-teal-200' :
                    item.badge_color === 'blue' ? 'bg-blue-50 text-blue-900 border-blue-200' :
                    'bg-rose-50 text-rose-800 border-rose-200'
                  }`}>
                    {item.kategori}
                  </span>
                  <span class="text-xs text-slate-500 font-semibold truncate">&bull; {item.ketersediaan}</span>
                </div>
                
                <h3 class="text-base font-bold text-slate-900 leading-snug">{item.nama}</h3>
                <p class="text-xs text-slate-500 mt-0.5 mb-2 font-medium">{item.instansi}</p>
                <p class="text-sm text-slate-600 leading-relaxed line-clamp-2">{item.deskripsi}</p>
              </div>

              <div class="pt-3 border-t border-slate-100">
                {item.tipe_kontak === 'whatsapp' ? (
                  <a
                    href={`https://wa.me/${item.nomor.replace(/[^0-9]/g, '')}?text=Halo%20${encodeURIComponent(item.nama)},%20butuh%20bantuan%20segera`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-full min-h-[44px] py-2.5 px-3 bg-emerald-700 hover:bg-emerald-800 text-white text-sm font-bold text-center flex items-center justify-center rounded-xl transition-colors shadow-xs"
                  >
                    Hubungi WhatsApp
                  </a>
                ) : (
                  <a
                    href={`tel:${item.nomor.replace(/[^0-9]/g, '')}`}
                    class="w-full min-h-[44px] py-2.5 px-3 bg-blue-900 hover:bg-blue-950 text-white text-sm font-bold text-center flex items-center justify-center rounded-xl transition-colors shadow-xs"
                  >
                    Telepon ({item.nomor})
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>
</Layout>

<script is:inline define:vars={{ initialKontak: kontakData }}>
  const STORAGE_KEY = 'timpik_kontak_data';

  function getLocalData() {
    try {
      const stored = localStorage.getItem(STORAGE_KEY);
      if (stored) {
        const parsed = JSON.parse(stored);
        if (parsed && parsed.operasional && Array.isArray(parsed.kontak_darurat)) {
          return parsed;
        }
      }
    } catch (e) {
      console.warn('Gagal membaca kontak lokal', e);
    }
    return initialKontak;
  }

  let liveData = getLocalData();

  function hydratePublicPage() {
    const op = liveData.operasional || {};
    
    // Update Operasional info
    const elNama = document.getElementById('view-nama-kantor');
    if (elNama && op.nama_kantor) elNama.textContent = op.nama_kantor;

    const elStatus = document.getElementById('view-status-badge');
    if (elStatus && op.status_layanan) {
      elStatus.textContent = op.status_layanan;
      if (op.status_layanan === 'Tutup Libur') {
        elStatus.className = 'text-[10px]  uppercase tracking-wider px-2 py-0.5 border border-rose-300 bg-rose-50 text-rose-800 font-bold';
      } else if (op.status_layanan === 'Buka Terbatas') {
        elStatus.className = 'text-[10px]  uppercase tracking-wider px-2 py-0.5 border border-amber-300 bg-amber-50 text-amber-800 font-bold';
      } else {
        elStatus.className = 'text-[10px]  uppercase tracking-wider px-2 py-0.5 border border-emerald-300 bg-emerald-50 text-emerald-800 font-bold';
      }
    }

    const elAlamat = document.getElementById('view-alamat-kantor');
    if (elAlamat && op.alamat) elAlamat.textContent = op.alamat;

    const elJamSK = document.getElementById('view-jam-senin-kamis');
    if (elJamSK && op.jam_senin_kamis) elJamSK.textContent = op.jam_senin_kamis;

    const elJamJumat = document.getElementById('view-jam-jumat');
    if (elJamJumat && op.jam_jumat) elJamJumat.textContent = op.jam_jumat;

    const elKet = document.getElementById('view-keterangan-layanan');
    if (elKet && op.keterangan_layanan) elKet.textContent = op.keterangan_layanan;

    const elWaLink = document.getElementById('view-wa-link');
    const elWaText = document.getElementById('view-wa-text');
    if (elWaLink && op.telepon) {
      const cleanTel = op.telepon.replace(/[^0-9]/g, '');
      elWaLink.href = `https://wa.me/${cleanTel}?text=Halo%20Admin%20Pelayanan%20Desa%20Timpik,%20saya%20ingin%20berkonsultasi%20mengenai%20pelayanan%20surat`;
      if (elWaText) elWaText.textContent = `Chat WhatsApp (${op.telepon})`;
    }

    const elEmailLink = document.getElementById('view-email-link');
    const elEmailText = document.getElementById('view-email-text');
    if (elEmailLink && op.email) {
      elEmailLink.href = `mailto:${op.email}`;
      if (elEmailText) elEmailText.textContent = op.email;
    }

    // Update Emergency Hotline Grid with consistent civic ledger styling
    const grid = document.getElementById('emergency-cards-grid');
    if (grid && Array.isArray(liveData.kontak_darurat)) {
      grid.innerHTML = liveData.kontak_darurat.map(item => {
        let badgeStyle = 'bg-rose-50 text-rose-800 border-rose-200';
        let btnStyle = 'bg-rose-700 hover:bg-rose-800';

        if (item.badge_color === 'emerald') {
          badgeStyle = 'bg-emerald-50 text-emerald-800 border-emerald-200';
          btnStyle = 'bg-emerald-700 hover:bg-emerald-800';
        } else if (item.badge_color === 'teal') {
          badgeStyle = 'bg-teal-50 text-teal-800 border-teal-200';
          btnStyle = 'bg-teal-700 hover:bg-teal-800';
        } else if (item.badge_color === 'blue') {
          badgeStyle = 'bg-blue-50 text-blue-900 border-blue-200';
          btnStyle = 'bg-blue-900 hover:bg-blue-950';
        }

        const cleanNo = (item.nomor || '').replace(/[^0-9]/g, '');

        return `
          <div class="bg-white border border-slate-200 rounded-2xl p-5 flex flex-col justify-between space-y-4 shadow-sm">
            <div>
              <div class="flex items-center justify-between gap-1 mb-2 pb-2 border-b border-slate-100">
                <span class="text-xs uppercase tracking-wider px-2 py-0.5 rounded font-bold border ${badgeStyle}">
                  ${item.kategori}
                </span>
                <span class="text-xs text-slate-500 font-semibold truncate">&bull; ${item.ketersediaan}</span>
              </div>
              
              <h3 class="text-base font-bold text-slate-900 leading-snug">${item.nama}</h3>
              <p class="text-xs text-slate-500 mt-0.5 mb-2 font-medium">${item.instansi}</p>
              <p class="text-sm text-slate-600 leading-relaxed line-clamp-2">${item.deskripsi}</p>
            </div>

            <div class="pt-3 border-t border-slate-100">
              ${item.tipe_kontak === 'whatsapp' ? `
                <a
                  href="https://wa.me/${cleanNo}?text=Halo%20${encodeURIComponent(item.nama)},%20butuh%20bantuan%20segera"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full min-h-[44px] py-2.5 px-3 ${btnStyle} text-white text-sm font-bold text-center flex items-center justify-center rounded-xl transition-colors shadow-xs"
                >
                  Hubungi WhatsApp
                </a>
              ` : `
                <a
                  href="tel:${cleanNo}"
                  class="w-full min-h-[44px] py-2.5 px-3 bg-blue-900 hover:bg-blue-950 text-white text-sm font-bold text-center flex items-center justify-center rounded-xl transition-colors shadow-xs"
                >
                  Telepon (${item.nomor})
                </a>
              `}
            </div>
          </div>
        `;
      }).join('');
    }
  }

  // Quick WhatsApp message sender
  const formKontak = document.getElementById('form-kontak-publik');
  if (formKontak) {
    formKontak.addEventListener('submit', (e) => {
      e.preventDefault();
      const nama = document.getElementById('contact-nama')?.value?.trim() || '';
      const dusun = document.getElementById('contact-dusun')?.value || '';
      const telepon = document.getElementById('contact-telepon')?.value?.trim() || '';
      const kategori = document.getElementById('contact-kategori')?.value || '';
      const pesan = document.getElementById('contact-pesan')?.value?.trim() || '';

      const targetWa = (liveData.operasional?.telepon || '081234567890').replace(/[^0-9]/g, '');
      const text = `Halo Admin Pelayanan Balai Desa Timpik,%0A%0ASaya ingin menyampaikan pesan / pertanyaan:%0A- *Nama:* ${encodeURIComponent(nama)}%0A- *Dusun:* ${encodeURIComponent(dusun)}%0A- *No. HP:* ${encodeURIComponent(telepon)}%0A- *Kategori:* ${encodeURIComponent(kategori)}%0A%0A*Isi Pesan:*%0A${encodeURIComponent(pesan)}%0A%0ATerima kasih.`;

      window.open(`https://wa.me/${targetWa}?text=${text}`, '_blank');
    });
  }

  // Check and hydrate immediately if localStorage data exists
  if (localStorage.getItem(STORAGE_KEY)) {
    hydratePublicPage();
  }
</script>
