---
import AdminLayout from '../../layouts/AdminLayout.astro';

const aduanList = [
  {
    "id": "ADU-2026-01",
    "pelapor": "Bpk. Sutrisno (Warga Dusun Bogo)",
    "kategori": "Infrastruktur Irigasi Sawah",
    "tanggal": "07 Nov 2026",
    "uraian": "Pintu pembagi air irigasi tersier di perbatasan sawah blok timur Dusun Bogo tersumbat endapan lumpur dan sampah ranting, debit air ke sawah bagian bawah berkurang.",
    "status": "Dalam Investigasi",
    "disposisi_kepada": "Pengurus P3A Bogo Wastro & Kadus Bogo"
  },
  {
    "id": "ADU-2026-02",
    "pelapor": "Ibu Maryatun (Warga Dusun Sumber)",
    "kategori": "Fasilitas Umum & Penerangan Jalan",
    "tanggal": "06 Nov 2026",
    "uraian": "Lampu penerangan jalan desa (PJU) dekat tikungan gapura batas Dusun Sumber mati sejak dua malam lalu, rawan kecelakaan bagi pengendara malam.",
    "status": "Disposisi Selesai",
    "disposisi_kepada": "Kasi Kesejahteraan / Petugas Listrik Desa"
  }
];
---

<AdminLayout title="Disposisi Aduan Warga" activeMenu="aduan">
  
  <div class="space-y-6 max-w-7xl mx-auto">
    
    <div>
      <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">Pusat Disposisi Aduan & Aspirasi Warga</h1>
      <p class="text-sm text-slate-600 mt-1">Kelola laporan warga yang masuk, tetapkan penanggung jawab aparatur desa, dan perbarui status tindak lanjut.</p>
    </div>

    <!-- Daftar Aduan Cards -->
    <div class="space-y-4">
      {aduanList.map((aduan) => (
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 sm:p-7 space-y-4">
          
          <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-slate-100">
            <div>
              <span class="text-xs font-mono font-bold text-slate-400 block uppercase">No. Register Laporan: {aduan.id}</span>
              <h3 class="text-lg sm:text-xl font-bold text-slate-900 mt-0.5">{aduan.kategori}</h3>
              <p class="text-sm text-slate-600 font-semibold mt-0.5">Pelapor: {aduan.pelapor}</p>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-xs text-slate-500 font-medium">Tanggal: {aduan.tanggal}</span>
              <span class={`px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider ${
                aduan.status === 'Disposisi Selesai' ? 'bg-emerald-100 text-emerald-900' : 'bg-sky-100 text-sky-900'
              }`}>
                {aduan.status}
              </span>
            </div>
          </div>

          <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 text-sm text-slate-800 leading-relaxed">
            <span class="font-bold text-slate-900 block mb-1">Uraian Laporan Warga:</span>
            "{aduan.uraian}"
          </div>

          <div class="flex flex-wrap items-center justify-between gap-3 text-sm pt-2">
            <div>
              <span class="text-slate-500">Disposisi Penanganan:</span>
              <strong class="text-blue-900 ml-1 font-bold">{aduan.disposisi_kepada}</strong>
            </div>

            <div class="flex items-center gap-2">
              <button
                type="button"
                onclick="alert('Tindak lanjut laporan berhasil diperbarui.')"
                class="min-h-[44px] px-5 py-2.5 rounded-xl bg-blue-900 hover:bg-blue-950 text-white font-bold text-sm transition-colors shadow-2xs"
              >
                Perbarui Status Laporan
              </button>
            </div>
          </div>

        </div>
      ))}
    </div>

  </div>

</AdminLayout>

