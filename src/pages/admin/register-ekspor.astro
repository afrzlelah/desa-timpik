---
import AdminLayout from '../../layouts/AdminLayout.astro';
import trackingData from '../../data/tracking.json';
---

<AdminLayout title="Buku Register Pelayanan" activeMenu="register">
  
  <div class="space-y-6 max-w-7xl mx-auto">
    
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl font-black text-slate-900 tracking-tight">Buku Register Pelayanan Administrasi Desa</h1>
        <p class="text-xs text-slate-500 mt-1">Rekapitulasi resmi pelayanan kependudukan Desa Timpik untuk arsip Kecamatan Susukan.</p>
      </div>

      <button
        type="button"
        onclick="window.print()"
        class="px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-blue-800 text-white font-bold text-xs shadow-md transition-all flex items-center gap-2"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
        <span>Cetak Buku Register Resmi (PDF)</span>
      </button>
    </div>

    <!-- Tabel Register Resmi -->
    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden p-6 sm:p-8">
      
      <div class="text-center pb-6 border-b border-slate-200 mb-6 space-y-1">
        <h2 class="text-lg font-black uppercase text-slate-900">Buku Register Pelayanan Surat Kependudukan</h2>
        <h3 class="text-sm font-bold text-slate-700">Pemerintah Desa Timpik &bull; Kecamatan Susukan &bull; Kabupaten Semarang</h3>
        <p class="text-xs text-slate-400">Periode: November 2026 &bull; Status Biaya: Rp 0,- (Bebas Pungutan)</p>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs border border-slate-200">
          <thead class="bg-slate-900 text-white text-[11px] uppercase tracking-wider">
            <tr>
              <th class="p-3 border border-slate-800">No.</th>
              <th class="p-3 border border-slate-800">No. Registrasi</th>
              <th class="p-3 border border-slate-800">Nama Pemohon</th>
              <th class="p-3 border border-slate-800">Wilayah Dusun</th>
              <th class="p-3 border border-slate-800">Jenis Surat</th>
              <th class="p-3 border border-slate-800">Tanggal Masuk</th>
              <th class="p-3 border border-slate-800">Status Penyelesaian</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 text-slate-700 font-medium">
            {trackingData.map((item, idx) => (
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="p-3 border border-slate-200 text-center font-bold">{idx + 1}</td>
                <td class="p-3 border border-slate-200 font-mono font-bold text-blue-700">{item.id}</td>
                <td class="p-3 border border-slate-200 font-bold text-slate-900">{item.nama_pemohon_masked}</td>
                <td class="p-3 border border-slate-200">{item.dusun}</td>
                <td class="p-3 border border-slate-200">{item.jenis_surat}</td>
                <td class="p-3 border border-slate-200">{item.tanggal_pengajuan}</td>
                <td class="p-3 border border-slate-200">
                  <span class="font-bold text-emerald-700">{item.status_label}</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="mt-8 pt-6 border-t border-slate-200 grid grid-cols-2 text-center text-xs">
        <div>
          <p class="mb-14">Mengetahui,<br/><strong>Sekretaris Desa Timpik</strong></p>
          <p>( .................................................... )</p>
        </div>
        <div>
          <p class="mb-14">Timpik, 08 November 2026<br/><strong>Kasi Pelayanan Desa Timpik</strong></p>
          <p>( .................................................... )</p>
        </div>
      </div>

    </div>

  </div>

</AdminLayout>

