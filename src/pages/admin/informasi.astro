---
import AdminLayout from '../../layouts/AdminLayout.astro';
import profil from '../../data/profil.json';

const pengumumanAwal = [
  {
    id: 'pengumuman-surat',
    kategori: 'Administrasi Surat',
    judul: 'Permohonan Dokumen Administrasi Warga Kini Dapat Diajukan Online',
    ringkasan: 'Warga dapat mengurus SKU, SKTM, pengantar SKCK, surat domisili, dan surat kematian secara online tanpa harus mengantre di Balai Desa.',
    isi: 'Pemerintah Desa Timpik menyediakan layanan pengajuan dokumen administrasi secara online. Warga dapat mengajukan SKU, SKTM, pengantar SKCK, surat domisili, dan surat kematian melalui formulir layanan yang tersedia.',
    tanggal: '',
    url: '/layanan-surat',
    label_tautan: 'Buka Katalog Layanan Surat',
    status: 'terbit',
    prioritas: 'normal'
  },
  {
    id: 'pengumuman-irigasi',
    kategori: 'Pertanian & Irigasi',
    judul: 'Jadwal Pembagian Giliran Aliran Air Irigasi P3A Bogo Wastro',
    ringkasan: 'Pengurus P3A Bogo Wastro menetapkan rotasi debit air sawah untuk pemerataan suplai air pada wilayah pertanian.',
    isi: 'Informasi mengenai jadwal pembagian aliran air irigasi P3A Bogo Wastro untuk wilayah Dusun Bogo, Dusun Sumber, dan wilayah terkait. Warga dapat menghubungi pengurus P3A untuk memperoleh informasi jadwal pelaksanaan.',
    tanggal: '',
    url: '/kelembagaan/p3a',
    label_tautan: 'Lihat Detail P3A',
    status: 'terbit',
    prioritas: 'normal'
  },
  {
    id: 'pengumuman-apbdes',
    kategori: 'Transparansi Anggaran',
    judul: 'Publikasi Rincian APBDes dan Alokasi Pembangunan Fisik',
    ringkasan: 'Warga dapat memantau informasi penggunaan anggaran desa dan alokasi pembangunan melalui publikasi transparansi APBDes.',
    isi: 'Pemerintah Desa Timpik menyediakan informasi transparansi anggaran sebagai bagian dari keterbukaan penyelenggaraan pemerintahan desa. Rincian anggaran dan alokasi pembangunan dapat dilihat melalui halaman transparansi.',
    tanggal: '',
    url: '/transparansi',
    label_tautan: 'Buka Laporan APBDes',
    status: 'terbit',
    prioritas: 'normal'
  }
];
---

<AdminLayout title="Kelola Informasi & Profil Desa" activeMenu="informasi">
  <main class="mx-auto max-w-6xl space-y-8 pb-16">
    
    <!-- Header -->
    <header class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-200 pb-5">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Pengelolaan Informasi Profil Desa</h1>
        <p class="mt-1 text-sm sm:text-base text-slate-600">Perbarui visi & misi, data dusun, statistik warga, alamat kantor, dan foto struktur organisasi.</p>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <button
          type="button"
          id="btn-clear-all-profil"
          class="inline-flex min-h-[44px] items-center gap-2 rounded-xl border border-rose-300 bg-rose-50 px-4 py-2 text-sm font-bold text-rose-800 shadow-xs transition-colors hover:bg-rose-100"
          title="Kosongkan seluruh informasi profil desa"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 7h12m-10 0 1 13h6l1-13M9 7V4h6v3"/></svg>
          <span>Kosongkan Semua Data</span>
        </button>
        <a
          href="/profil"
          target="_blank"
          class="inline-flex min-h-[44px] items-center gap-1.5 rounded-xl bg-blue-700 px-4 py-2 text-sm font-bold text-white shadow-xs hover:bg-blue-800 transition-colors"
        >
          <span>Buka Halaman Profil Publik</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        </a>
      </div>
    </header>

    <!-- Notification Alert -->
    <div id="notice-toast" class="hidden rounded-xl bg-emerald-50 border border-emerald-300 p-4 text-emerald-950 flex items-center justify-between shadow-xs">
      <div class="flex items-center gap-3">
        <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        <span id="notice-text" class="text-sm font-semibold">Perubahan data desa berhasil disimpan dan langsung aktif di halaman publik!</span>
      </div>
      <button type="button" onclick="document.getElementById('notice-toast').classList.add('hidden')" class="text-emerald-700 font-bold text-lg">&times;</button>
    </div>

    <!-- Tab Section -->
    <div role="tablist" aria-label="Bagian informasi profil" class="flex flex-wrap gap-2 rounded-2xl border border-slate-200 bg-slate-100 p-2 text-sm font-bold">
      <button type="button" role="tab" aria-selected="true" aria-controls="panel-umum" id="tab-btn-umum" class="min-h-11 rounded-xl border border-blue-700 bg-blue-700 px-4 py-2 text-white shadow-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-700 focus-visible:ring-offset-2">
        1. Visi, Misi & Alamat
      </button>
      <button type="button" role="tab" aria-selected="false" tabindex="-1" aria-controls="panel-dusun" id="tab-btn-dusun" class="min-h-11 rounded-xl border border-slate-300 bg-white px-4 py-2 text-slate-700 transition-colors hover:border-blue-400 hover:bg-blue-50 hover:text-blue-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-700 focus-visible:ring-offset-2">
        2. Kelola Data Dusun (<span id="dusun-tab-count">4</span>)
      </button>
      <button type="button" role="tab" aria-selected="false" tabindex="-1" aria-controls="panel-penduduk" id="tab-btn-penduduk" class="min-h-11 rounded-xl border border-slate-300 bg-white px-4 py-2 text-slate-700 transition-colors hover:border-blue-400 hover:bg-blue-50 hover:text-blue-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-700 focus-visible:ring-offset-2">
        3. Data Total Warga
      </button>
      <button type="button" role="tab" aria-selected="false" tabindex="-1" aria-controls="panel-struktur" id="tab-btn-struktur" class="min-h-11 rounded-xl border border-slate-300 bg-white px-4 py-2 text-slate-700 transition-colors hover:border-blue-400 hover:bg-blue-50 hover:text-blue-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-700 focus-visible:ring-offset-2">
        4. Foto Struktur Organisasi
      </button>
      <button type="button" id="tab-btn-pengumuman" class="pb-3 border-b-2 border-transparent text-slate-500 hover:text-slate-800 px-3 transition-colors">
        5. Pengumuman Balai Desa
      </button>
    </div>

    <!-- FORM SECTIONS -->
    <form id="form-info" class="space-y-8">

      <!-- ================= SECTION 1: VISI, MISI & ALAMAT ================= -->
      <div id="panel-umum" role="tabpanel" aria-labelledby="tab-btn-umum" tabindex="0" class="space-y-6">
        <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-xs space-y-6">
          <h2 class="text-lg sm:text-xl font-bold text-slate-900 border-b border-slate-100 pb-3">Visi, Misi & Alamat Kantor Desa</h2>
          
          <div>
            <label for="input-visi" class="block text-sm sm:text-base font-bold text-slate-900 mb-1.5">
              Visi Desa Timpik
            </label>
            <p class="text-xs text-slate-500 mb-2">Tuliskan visi besar arah pembangunan Desa Timpik.</p>
            <textarea
              id="input-visi"
              rows="3"
              required
              class="w-full rounded-xl border border-slate-300 p-3.5 text-sm sm:text-base text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-blue-600"
            ></textarea>
          </div>

          <div>
            <div class="mb-3 flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
              <div>
                <h3 class="text-sm sm:text-base font-bold text-slate-900">Misi Desa Timpik</h3>
                <p class="mt-1 text-xs text-slate-600">Tambah, ubah, atau hapus setiap misi. Perubahan tampil setelah disimpan.</p>
              </div>
              <button type="button" id="btn-add-misi" class="inline-flex min-h-11 items-center justify-center rounded-xl border border-blue-300 bg-blue-50 px-4 py-2 text-sm font-bold text-blue-900 transition hover:bg-blue-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-700 focus-visible:ring-offset-2">
                + Tambah Misi
              </button>
            </div>
            <div id="misi-list" class="space-y-3"></div>
            <p id="misi-empty" class="hidden rounded-xl border border-dashed border-slate-300 bg-slate-50 p-4 text-sm text-slate-600">
              Belum ada misi. Tekan “Tambah Misi” untuk menambahkan.
            </p>
          </div>

          <div class="border-t border-slate-100 pt-5 space-y-4">
            <h3 class="text-base font-bold text-slate-900">Alamat Lengkap & Kontak Resmi Balai Desa</h3>
            
            <div>
              <label for="input-alamat" class="block text-sm sm:text-base font-bold text-slate-900 mb-1.5">
                Alamat Kantor Desa
              </label>
              <input
                type="text"
                id="input-alamat"
                required
                class="w-full rounded-xl border border-slate-300 p-3.5 text-sm sm:text-base text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-600"
              />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="input-telepon" class="block text-sm font-bold text-slate-900 mb-1.5">
                  Nomor Telepon / WhatsApp
                </label>
                <input
                  type="text"
                  id="input-telepon"
                  class="w-full rounded-xl border border-slate-300 p-3 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-600"
                />
              </div>

              <div>
                <label for="input-email" class="block text-sm font-bold text-slate-900 mb-1.5">
                  Email Resmi Desa
                </label>
                <input
                  type="email"
                  id="input-email"
                  class="w-full rounded-xl border border-slate-300 p-3 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-600"
                />
              </div>
            </div>

            <div>
              <label for="input-jam" class="block text-sm font-bold text-slate-900 mb-1.5">
                Jam Pelayanan Warga
              </label>
              <input
                type="text"
                id="input-jam"
                class="w-full rounded-xl border border-slate-300 p-3 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-600"
              />
            </div>
          </div>
        </div>
      </div>

      <!-- ================= SECTION 2: DATA DUSUN INTERAKTIF ================= -->
      <div id="panel-dusun" role="tabpanel" aria-labelledby="tab-btn-dusun" tabindex="0" class="hidden space-y-6">
        <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-xs space-y-6">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-100 pb-4">
            <div>
              <h2 class="text-lg sm:text-xl font-bold text-slate-900">Data Dusun di Wilayah Desa Timpik</h2>
              <p class="text-xs sm:text-sm text-slate-500 mt-0.5">Kelola nama dusun, kepala dusun, wilayah RT/RW, dan potensi utama warga.</p>
            </div>
            <button
              type="button"
              id="btn-tambah-dusun"
              class="inline-flex min-h-[44px] items-center gap-2 rounded-xl bg-blue-700 px-4 py-2.5 text-sm font-bold text-white hover:bg-blue-800 transition-colors shadow-xs"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
              <span>Tambah Dusun Baru</span>
            </button>
          </div>

          <!-- Grid Daftar Card Dusun -->
          <div id="dusun-card-list" class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <!-- Render via JS -->
          </div>
        </div>
      </div>

      <!-- ================= SECTION 3: TOTAL WARGA PENDUDUK ================= -->
      <div id="panel-penduduk" role="tabpanel" aria-labelledby="tab-btn-penduduk" tabindex="0" class="hidden space-y-6">
        <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-xs space-y-6">
          <div>
            <h2 class="text-lg sm:text-xl font-bold text-slate-900 border-b border-slate-100 pb-3">Statistik Total Warga Desa Timpik</h2>
            <p class="text-xs sm:text-sm text-slate-500 mt-1">Data resmi: Laki-laki: 2.848 jiwa, Perempuan: 2.848 jiwa, Total Penduduk: 5.696 jiwa.</p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
            <div class="rounded-xl border border-blue-200 bg-blue-50/60 p-5 space-y-2">
              <label for="input-lk" class="block text-sm font-bold text-blue-950 uppercase tracking-wide">
                Penduduk Laki-Laki
              </label>
              <input
                type="text"
                id="input-lk"
                required
                placeholder="2.848"
                class="w-full rounded-xl border border-blue-300 bg-white p-3.5 text-lg font-bold text-blue-900 focus:outline-none focus:ring-2 focus:ring-blue-600"
              />
              <span class="text-xs text-blue-700 block">Ketik angka murni atau berformat ribuan</span>
            </div>

            <div class="rounded-xl border border-blue-200 bg-blue-50/60 p-5 space-y-2">
              <label for="input-pm" class="block text-sm font-bold text-blue-950 uppercase tracking-wide">
                Penduduk Perempuan
              </label>
              <input
                type="text"
                id="input-pm"
                required
                placeholder="2.848"
                class="w-full rounded-xl border border-blue-300 bg-white p-3.5 text-lg font-bold text-blue-900 focus:outline-none focus:ring-2 focus:ring-blue-600"
              />
              <span class="text-xs text-blue-700 block">Ketik angka murni atau berformat ribuan</span>
            </div>

            <div class="rounded-xl border border-emerald-300 bg-emerald-50/60 p-5 space-y-2">
              <div class="flex items-center justify-between">
                <label for="input-total" class="block text-sm font-bold text-emerald-950 uppercase tracking-wide">
                  Total Jumlah Warga
                </label>
                <span class="text-[11px] font-bold px-2 py-0.5 rounded bg-emerald-200 text-emerald-900">Otomatis (Lk + Pm)</span>
              </div>
              <input
                type="text"
                id="input-total"
                readonly
                class="w-full rounded-xl border border-emerald-300 bg-slate-100 p-3.5 text-lg font-black text-emerald-900 cursor-not-allowed"
              />
              <span class="text-xs text-emerald-700 block" id="total-calc-hint">Hasil penjumlahan otomatis: 5.696 Jiwa</span>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-3 border-t border-slate-100">
            <div>
              <label for="input-kk" class="block text-sm font-bold text-slate-800 mb-1">
                Jumlah Kepala Keluarga (KK)
              </label>
              <input
                type="text"
                id="input-kk"
                class="w-full rounded-xl border border-slate-300 p-3 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-600"
              />
            </div>
            <div>
              <label for="input-luas" class="block text-sm font-bold text-slate-800 mb-1">
                Total Luas Wilayah Desa
              </label>
              <input
                type="text"
                id="input-luas"
                class="w-full rounded-xl border border-slate-300 p-3 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-600"
              />
            </div>
          </div>
        </div>
      </div>

      <!-- ================= SECTION 4: STRUKTUR ORGANISASI DARI FOTO ================= -->
      <div id="panel-struktur" role="tabpanel" aria-labelledby="tab-btn-struktur" tabindex="0" class="hidden space-y-6">
        <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-xs space-y-6">
          <div class="border-b border-slate-100 pb-3">
            <h2 class="text-lg sm:text-xl font-bold text-slate-900">Foto Bagan Struktur Organisasi Desa</h2>
            <p class="text-xs sm:text-sm text-slate-500 mt-1">Sesuai ketentuan, bagan struktur organisasi perangkat desa ditampilkan langsung dari foto resmi.</p>
          </div>

          <div class="space-y-4">
            <div>
              <label class="block text-sm sm:text-base font-bold text-slate-900 mb-2">
                Pilih Berkas Foto Struktur Baru (JPG / PNG / WEBP)
              </label>
              <input
                id="input-foto"
                type="file"
                accept="image/*"
                class="block w-full text-sm text-slate-600 file:mr-4 file:py-2.5 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-bold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 cursor-pointer border border-slate-300 rounded-xl p-2"
              />
              <span class="mt-1.5 block text-xs text-slate-500">Maksimal ukuran berkas 3 MB. Gambar langsung disimpan ke memori sistem.</span>
            </div>

            <!-- Preview Foto Struktur -->
            <div class="pt-4 border-t border-slate-100 space-y-3">
              <span class="block text-xs font-bold uppercase tracking-wider text-slate-500">Pratinjau Foto Struktur Saat Ini:</span>
              <div class="max-w-2xl rounded-2xl border border-slate-200 overflow-hidden bg-slate-50 p-2 shadow-xs">
                <img
                  id="preview-foto-struktur"
                  src="/images/balai-desa-timpik.jpg"
                  alt="Struktur Organisasi Pemerintahan Desa Timpik"
                  class="w-full h-auto max-h-[450px] object-contain rounded-xl mx-auto"
                />
              </div>
              <div class="flex items-center gap-3">
                <button
                  type="button"
                  id="btn-reset-foto"
                  class="text-xs font-bold text-rose-600 hover:underline"
                >
                  Kembalikan ke foto bawaan
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div id="profile-save-actions" class="sticky bottom-4 z-20 rounded-2xl border border-blue-200 bg-white/95 backdrop-blur-md p-4 shadow-lg flex flex-wrap items-center justify-between gap-3">
        <p class="text-xs sm:text-sm text-slate-600">
          Klik tombol <strong>Simpan Pembaruan</strong> untuk memperbarui data di situs ini.
        </p>
        <button
          type="submit"
          class="inline-flex min-h-[48px] items-center gap-2 rounded-xl bg-blue-700 hover:bg-blue-800 px-7 py-3 text-base font-extrabold text-white shadow-md transition-all"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span>Simpan Seluruh Pembaruan</span>
        </button>
      </div>

    </form>

    <section id="panel-pengumuman" class="hidden space-y-6">

      <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-xs space-y-6">

        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-100 pb-5">
          <div>
            <span class="inline-flex items-center rounded-full bg-blue-100 px-3 py-1 text-[10px] font-bold uppercase tracking-wider text-blue-800">
              Informasi Publik Desa
            </span>

            <h2 class="mt-2 text-xl font-extrabold text-slate-900">
              Pengumuman Balai Desa Timpik
            </h2>

            <p class="mt-1 text-sm text-slate-500">
              Kelola informasi resmi yang ditampilkan kepada masyarakat Desa Timpik.
            </p>
          </div>

          <button type="button" id="btn-tambah-pengumuman" class="inline-flex min-h-11 items-center justify-center gap-2 rounded-xl bg-blue-800 px-5 py-3 text-sm font-bold text-white transition hover:bg-blue-900">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            Tambah Pengumuman
          </button>
        </div>

        <div id="pengumuman-notice" class="hidden rounded-xl border p-4 text-sm font-semibold" role="status" aria-live="polite"></div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">

          <article class="rounded-xl border border-slate-200 bg-slate-50 p-5">
            <p class="text-xs font-bold uppercase tracking-wide text-slate-500">Total Pengumuman</p>
            <p id="pengumuman-total" class="mt-2 text-3xl font-black text-slate-900">0</p>
            <span class="text-xs text-slate-500">Seluruh data informasi</span>
          </article>

          <article class="rounded-xl border border-emerald-200 bg-emerald-50 p-5">
            <p class="text-xs font-bold uppercase tracking-wide text-emerald-700">Telah Terbit</p>
            <p id="pengumuman-terbit" class="mt-2 text-3xl font-black text-emerald-900">0</p>
            <span class="text-xs text-emerald-700">Ditampilkan kepada warga</span>
          </article>

          <article class="rounded-xl border border-amber-200 bg-amber-50 p-5">
            <p class="text-xs font-bold uppercase tracking-wide text-amber-700">Draf</p>
            <p id="pengumuman-draf" class="mt-2 text-3xl font-black text-amber-900">0</p>
            <span class="text-xs text-amber-700">Belum ditampilkan</span>
          </article>

        </div>

        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">

          <div>
            <h3 class="text-lg font-bold text-slate-900">Daftar Pengumuman</h3>
            <p class="text-xs text-slate-500 mt-1">Informasi yang tersimpan dan status publikasinya.</p>
          </div>

          <div class="flex flex-col sm:flex-row gap-2">

            <input
              id="pengumuman-search"
              type="search"
              placeholder="Cari pengumuman..."
              class="min-h-10 rounded-xl border border-slate-300 px-3.5 py-2 text-sm outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100"
            />

            <select id="pengumuman-filter" class="min-h-10 rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-sm outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100">
              <option value="semua">Semua Status</option>
