              class="w-full rounded-xl border border-slate-300 px-3.5 py-3 text-sm leading-relaxed outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100"
            ></textarea>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

            <div>
              <label for="pengumuman-url" class="mb-1.5 block text-sm font-bold text-slate-800">
                Tautan Informasi (Opsional)
              </label>

              <input
                id="pengumuman-url"
                type="text"
                placeholder="/layanan-surat atau https://..."
                class="w-full min-h-11 rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm"
