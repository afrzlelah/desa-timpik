          </div>
        </div>

      </div>
    </section>

    <div id="modal-pengumuman" class="fixed inset-0 z-[90] hidden items-center justify-center overflow-y-auto bg-slate-950/60 p-3 backdrop-blur-sm sm:p-5" role="dialog" aria-modal="true" aria-labelledby="modal-pengumuman-title" aria-hidden="true">

      <div class="my-auto w-full max-w-2xl overflow-hidden rounded-2xl bg-white shadow-2xl">

