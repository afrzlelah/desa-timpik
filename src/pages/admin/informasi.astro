          </div>

          <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
            <label for="edit-dusun-foto-file" class="block text-sm font-bold text-slate-800">Foto dusun</label>
            <p class="mt-1 text-xs text-slate-600">Foto akan disimpan ke Supabase Storage dan tampil di halaman dusun.</p>
            <input id="edit-dusun-foto-file" type="file" accept="image/jpeg,image/png,image/webp,image/avif" class="mt-3 block w-full text-sm text-slate-700 file:mr-3 file:min-h-10 file:rounded-lg file:border-0 file:bg-blue-800 file:px-3 file:font-semibold file:text-white hover:file:bg-blue-900" />
            <p id="edit-dusun-foto-status" class="mt-2 text-xs text-slate-600" aria-live="polite">JPG, PNG, WebP, atau AVIF. Maksimal 4 MB.</p>
            <div id="edit-dusun-foto-preview-wrap" class="hidden mt-3 overflow-hidden rounded-xl border border-slate-200 bg-white">
              <img id="edit-dusun-foto-preview" alt="Pratinjau foto dusun" class="h-44 w-full object-cover" />
              <button type="button" id="edit-dusun-foto-remove" class="min-h-10 w-full border-t border-slate-200 px-3 text-sm font-semibold text-rose-700 hover:bg-rose-50">Hapus foto dusun</button>
            </div>
          </div>

          <div class="pt-3 border-t border-slate-100 flex items-center justify-end gap-2">
            <button type="button" id="btn-batal-dusun" class="px-4 py-2 rounded-lg border border-slate-300 text-sm font-semibold text-slate-700 hover:bg-slate-50">Batal</button>
            <button type="submit" class="px-5 py-2 rounded-lg bg-blue-700 hover:bg-blue-800 text-sm font-bold text-white shadow-xs">Simpan Dusun</button>
          </div>
        </form>
      </div>
    </div>

  </main>

  <script define:vars={{ defaultProfil: profil, defaultPengumuman: pengumumanAwal }}>
    const STORAGE_KEY = 'timpik_profil_data';
    let currentData = defaultProfil;

    // Load data from localStorage if exists
    try {
      const stored = localStorage.getItem(STORAGE_KEY);
      if (stored) {
        const parsed = JSON.parse(stored);
        if (parsed && typeof parsed === 'object') {
          currentData = { ...defaultProfil, ...parsed };
        }
      }
    } catch (e) {
      console.error('Error loading profil from storage', e);
    }

    // Tabs logic
    const tabs = [
      { btn: document.getElementById('tab-btn-umum'), panel: document.getElementById('panel-umum') },
      { btn: document.getElementById('tab-btn-dusun'), panel: document.getElementById('panel-dusun') },
      { btn: document.getElementById('tab-btn-penduduk'), panel: document.getElementById('panel-penduduk') },
      { btn: document.getElementById('tab-btn-struktur'), panel: document.getElementById('panel-struktur') },
      { btn: document.getElementById('tab-btn-pengumuman'), panel: document.getElementById('panel-pengumuman') }
    ];

    function activateTab(index) {
      tabs.forEach((t, i) => {
        if (i === index) {
          t.btn.className = 'min-h-11 rounded-xl border border-blue-700 bg-blue-700 px-4 py-2 text-white shadow-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-700 focus-visible:ring-offset-2';
          t.btn.setAttribute('aria-selected', 'true');
          t.btn.setAttribute('tabindex', '0');
          t.panel.classList.remove('hidden');
        } else {
          t.btn.className = 'min-h-11 rounded-xl border border-slate-300 bg-white px-4 py-2 text-slate-700 transition-colors hover:border-blue-400 hover:bg-blue-50 hover:text-blue-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-700 focus-visible:ring-offset-2';
          t.btn.setAttribute('aria-selected', 'false');
          t.btn.setAttribute('tabindex', '-1');
          t.panel.classList.add('hidden');
        }
      });
    }

    tabs.forEach((t, i) => {
      t.btn.addEventListener('click', () => activateTab(i));
      t.btn.addEventListener('keydown', (event) => {
        let nextIndex = i;
        if (event.key === 'ArrowRight') nextIndex = (i + 1) % tabs.length;
        else if (event.key === 'ArrowLeft') nextIndex = (i - 1 + tabs.length) % tabs.length;
        else if (event.key === 'Home') nextIndex = 0;
        else if (event.key === 'End') nextIndex = tabs.length - 1;
        else return;

        event.preventDefault();
        activateTab(nextIndex);
        tabs[nextIndex].btn.focus();
      });
    });

    // Populate Fields
    const inVisi = document.getElementById('input-visi');
    const misiListContainer = document.getElementById('misi-list');
    const misiEmptyState = document.getElementById('misi-empty');
    const addMisiButton = document.getElementById('btn-add-misi');
    const inAlamat = document.getElementById('input-alamat');
    const inTelepon = document.getElementById('input-telepon');
    const inEmail = document.getElementById('input-email');
    const inJam = document.getElementById('input-jam');

    const inLk = document.getElementById('input-lk');
    const inPm = document.getElementById('input-pm');
    const inTotal = document.getElementById('input-total');
    const inKk = document.getElementById('input-kk');
    const inLuas = document.getElementById('input-luas');

    const fotoPreview = document.getElementById('preview-foto-struktur');
    let fotoStrukturBase64 = currentData.foto_struktur || '';

    const profileActions = document.getElementById('profile-save-actions');

    if (profileActions) {
      profileActions.classList.toggle('hidden', index === 4);
    }

    inVisi.value = currentData.visi || '';
    const misiList = Array.isArray(currentData.misi) ? currentData.misi.map((item) => {
      if (typeof item === 'string') return item;
      if (!item || typeof item !== 'object') return '';
      const detail = [item.deskripsi, ...(Array.isArray(item.poin) ? item.poin : [])]
        .filter((value) => typeof value === 'string' && value.trim() && value.trim() !== item.judul)
        .join('; ');
      return [item.judul, detail].filter(Boolean).join(' — ');
    }).filter(Boolean) : [];

    const escapeMisiHtml = (value) => String(value ?? '').replace(/[&<>"']/g, (char) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    })[char]);

    function renderMisiList() {
      if (!misiListContainer) return;
      misiEmptyState?.classList.toggle('hidden', misiList.length > 0);
      misiListContainer.innerHTML = misiList.map((misi, index) =>
        '<div class="flex flex-col gap-2 rounded-xl border border-slate-200 bg-slate-50 p-3 sm:flex-row sm:items-center sm:p-4">' +
          '<label class="flex-1 space-y-1.5">' +
            '<span class="text-xs font-bold text-slate-700">Misi ' + (index + 1) + '</span>' +
            '<input type="text" data-misi-index="' + index + '" value="' + escapeMisiHtml(misi) + '" required maxlength="500" placeholder="Tuliskan satu misi desa" class="min-h-11 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-950 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-200" />' +
          '</label>' +
          '<button type="button" data-remove-misi="' + index + '" aria-label="Hapus misi ' + (index + 1) + '" class="min-h-11 rounded-lg border border-rose-200 bg-white px-4 text-sm font-bold text-rose-800 transition hover:bg-rose-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rose-600 focus-visible:ring-offset-2">Hapus</button>' +
        '</div>'
      ).join('');
    }

    renderMisiList();
    addMisiButton?.addEventListener('click', () => {
      misiList.push('');
      renderMisiList();
      misiListContainer?.lastElementChild?.querySelector('input')?.focus();
      (window).__timpikAdminToast('Misi ditambahkan. Simpan perubahan untuk menerbitkannya.');
    });
    misiListContainer?.addEventListener('input', (event) => {
      const input = event.target.closest('[data-misi-index]');
      if (input) misiList[Number(input.dataset.misiIndex)] = input.value;
    });
    misiListContainer?.addEventListener('click', async (event) => {
      const button = event.target.closest('[data-remove-misi]');
      if (!button) return;
      const index = Number(button.dataset.removeMisi);
      const mission = misiList[index];
      if (!(await (window).__timpikAdminConfirm('Hapus misi “' + (mission || 'Misi ' + (index + 1)) + '”?', 'Hapus misi'))) return;
      misiList.splice(index, 1);
      renderMisiList();
      (window).__timpikAdminToast('Misi dihapus. Simpan perubahan untuk menerbitkannya.');
    });
    inAlamat.value = currentData.alamat_kantor || '';
    inTelepon.value = currentData.telepon || '';
    inEmail.value = currentData.email || '';
    inJam.value = currentData.jam_layanan || '';

    // Statistik Warga (Default LK: 2.848, PM: 2.848, Total: 5.696)
    const stats = currentData.statistik || {};
    inLk.value = stats.laki_laki ? stats.laki_laki.replace(/[^0-9]/g, '') : '';
    inPm.value = stats.perempuan ? stats.perempuan.replace(/[^0-9]/g, '') : '';
    inKk.value = stats.total_kk || '';
    inLuas.value = stats.luas_wilayah || '';

    function formatNumber(num) {
      return num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ".");
    }

    function calculateTotal() {
      if (!inLk.value.trim() && !inPm.value.trim()) {
        inTotal.value = '';
        const hint = document.getElementById('total-calc-hint');
        if (hint) hint.textContent = 'Isi jumlah laki-laki dan perempuan untuk menghitung total warga.';
        return;
      }
      const lkVal = parseInt((inLk.value || '').replace(/[^0-9]/g, ''), 10) || 0;
      const pmVal = parseInt((inPm.value || '').replace(/[^0-9]/g, ''), 10) || 0;
      const totalVal = lkVal + pmVal;

      inTotal.value = formatNumber(totalVal) + ' Jiwa';
      const hint = document.getElementById('total-calc-hint');
      if (hint) {
        hint.textContent = `Penjumlahan otomatis: ${formatNumber(lkVal)} (Lk) + ${formatNumber(pmVal)} (Pm) = ${formatNumber(totalVal)} Jiwa`;
      }
    }

    inLk.addEventListener('input', calculateTotal);
    inPm.addEventListener('input', calculateTotal);
    calculateTotal();

    if (fotoStrukturBase64) {
      fotoPreview.src = fotoStrukturBase64;
    } else {
      fotoPreview.classList.add('hidden');
    }

    // Foto File Upload Handler
    const inFoto = document.getElementById('input-foto');
    inFoto.addEventListener('change', (e) => {
      const file = e.target.files?.[0];
      if (!file) return;
      if (file.size > 3145728) {
        alert('Ukuran file foto maksimal 3 MB.');
        e.target.value = '';
        return;
      }
      const reader = new FileReader();
      reader.onload = () => {
        fotoStrukturBase64 = reader.result;
        fotoPreview.src = fotoStrukturBase64;
        fotoPreview.classList.remove('hidden');
      };
      reader.readAsDataURL(file);
    });

    document.getElementById('btn-reset-foto').addEventListener('click', () => {
      fotoStrukturBase64 = '/images/struktur-organisasi-timpik.jpg';
      fotoPreview.src = fotoStrukturBase64;
      fotoPreview.classList.remove('hidden');
      inFoto.value = '';
    });

    // Dusun Data Manager
    let dusunList = Array.isArray(currentData.dusun) ? [...currentData.dusun] : [];
    const escapeDusunHtml = (value) => String(value ?? '').replace(/[&<>"']/g, (char) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    })[char]);

    function renderDusunCards() {
      const container = document.getElementById('dusun-card-list');
      const tabCount = document.getElementById('dusun-tab-count');
      if (tabCount) tabCount.textContent = dusunList.length;

      if (!container) return;
      if (dusunList.length === 0) {
        container.innerHTML = `
          <div class="col-span-2 py-8 text-center text-slate-400 bg-slate-50 rounded-xl border border-dashed border-slate-200">
            Belum ada data dusun. Klik "Tambah Dusun Baru" di atas.
          </div>
        `;
        return;
      }

      container.innerHTML = dusunList.map((d, index) => `
        <article class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-xs flex flex-col justify-between">
          ${d.foto ? `<img src="${escapeDusunHtml(d.foto)}" alt="Foto ${escapeDusunHtml(d.nama || 'dusun')}" class="h-40 w-full object-cover bg-slate-100" onerror="this.style.display='none'" />` : ''}
          <div class="p-5 space-y-3">
          <div>
            <div class="flex items-center justify-between pb-2 border-b border-slate-100">
              <span class="text-xs font-mono font-bold text-blue-700 uppercase">ID: ${escapeDusunHtml(d.id || '-')}</span>
              <span class="text-xs font-bold px-2 py-0.5 rounded bg-blue-50 text-blue-800 border border-blue-100">${escapeDusunHtml(d.jumlah_rt || 'RT/RW belum diisi')}</span>
            </div>
            <h4 class="text-base font-bold text-slate-900 mt-2">${escapeDusunHtml(d.nama || 'Tanpa Nama Dusun')}</h4>
            <p class="text-xs text-slate-600 mt-1"><strong>Kepala Dusun:</strong> ${escapeDusunHtml(d.kepala_dusun || 'Belum diisi')}</p>
            <p class="text-sm text-slate-700 mt-2 line-clamp-2">${escapeDusunHtml(d.deskripsi || 'Deskripsi belum diisi.')}</p>
            ${d.potensi_utama ? `<p class="text-xs text-emerald-800 font-semibold mt-2">🌱 ${escapeDusunHtml(d.potensi_utama)}</p>` : ''}
          </div>
          <div class="pt-3 border-t border-slate-100 flex items-center justify-end gap-2">
            <button
              type="button"
              onclick="window.editDusunItem(${index})"
              class="px-3 py-1.5 rounded-lg border border-slate-200 text-xs font-bold text-slate-700 hover:bg-slate-50 transition-colors"
            >
              Edit
            </button>
            <button
              type="button"
              onclick="window.deleteDusunItem(${index})"
              class="px-3 py-1.5 rounded-lg border border-rose-200 text-xs font-bold text-rose-600 hover:bg-rose-50 transition-colors"
            >
              Hapus
            </button>
          </div>
          </div>
        </article>
      `).join('');
    }

    async function persistProfil(updatedProfil) {
      await (window).__timpikSaveAdminContent(STORAGE_KEY, updatedProfil);
      currentData = updatedProfil;
    }

    function showProfileNotice(message) {
      const toast = document.getElementById('notice-toast');
      const toastText = document.getElementById('notice-text');
      if (toast && toastText) {
        toastText.textContent = message;
        toast.classList.remove('hidden');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
      (window).__timpikAdminToast(message);
    }

    renderDusunCards();

    // Dusun Modal Actions
    const modalDusun = document.getElementById('modal-dusun');
    const formEditDusun = document.getElementById('form-edit-dusun');
    const editIndex = document.getElementById('edit-dusun-index');
    const editId = document.getElementById('edit-dusun-id');
    const editNama = document.getElementById('edit-dusun-nama');
    const editKadus = document.getElementById('edit-dusun-kadus');
    const editRt = document.getElementById('edit-dusun-rt');
    const editLuas = document.getElementById('edit-dusun-luas');
    const editPotensi = document.getElementById('edit-dusun-potensi');
    const editDeskripsi = document.getElementById('edit-dusun-deskripsi');
    const editFotoFile = document.getElementById('edit-dusun-foto-file');
    const editFotoStatus = document.getElementById('edit-dusun-foto-status');
    const editFotoPreview = document.getElementById('edit-dusun-foto-preview');
    const editFotoPreviewWrap = document.getElementById('edit-dusun-foto-preview-wrap');
    let editFoto = '';
    let pendingDusunImage = null;
    let dusunPhotoPreviewUrl = '';

    function showDusunPhotoPreview(src) {
      if (dusunPhotoPreviewUrl) URL.revokeObjectURL(dusunPhotoPreviewUrl);
      dusunPhotoPreviewUrl = src?.startsWith('blob:') ? src : '';
      if (src) {
        editFotoPreview.src = src;
        editFotoPreviewWrap.classList.remove('hidden');
      } else {
        editFotoPreview.removeAttribute('src');
        editFotoPreviewWrap.classList.add('hidden');
      }
    }

    function resetDusunPhoto() {
      editFoto = '';
      pendingDusunImage = null;
      editFotoFile.value = '';
      editFotoStatus.textContent = 'JPG, PNG, WebP, atau AVIF. Maksimal 4 MB.';
      showDusunPhotoPreview('');
    }

    editFotoFile.addEventListener('change', () => {
      const file = editFotoFile.files?.[0];
      if (!file) return;
      if (file.size > 4 * 1024 * 1024) {
        editFotoFile.value = '';
        pendingDusunImage = null;
        showDusunPhotoPreview(editFoto);
        editFotoStatus.textContent = 'Ukuran gambar maksimal 4 MB.';
        return;
      }
      if (!['image/jpeg', 'image/png', 'image/webp', 'image/avif'].includes(file.type)) {
        editFotoFile.value = '';
        pendingDusunImage = null;
        showDusunPhotoPreview(editFoto);
        editFotoStatus.textContent = 'Pilih gambar JPG, PNG, WebP, atau AVIF.';
        return;
      }
      pendingDusunImage = file;
      editFotoStatus.textContent = `${file.name} dipilih. Foto diunggah saat tombol Simpan Dusun ditekan.`;
      showDusunPhotoPreview(URL.createObjectURL(file));
    });

    document.getElementById('edit-dusun-foto-remove').addEventListener('click', resetDusunPhoto);

    document.getElementById('btn-tambah-dusun').addEventListener('click', () => {
      document.getElementById('modal-dusun-title').textContent = 'Tambah Dusun Baru';
      editIndex.value = '-1';
      editId.value = '';
      editNama.value = '';
      editKadus.value = '';
      editRt.value = '';
      editLuas.value = '';
      editPotensi.value = '';
      editDeskripsi.value = '';
      resetDusunPhoto();
      modalDusun.classList.remove('hidden');
    });

    document.getElementById('close-modal-dusun').addEventListener('click', () => {
      modalDusun.classList.add('hidden');
      resetDusunPhoto();
    });
    document.getElementById('btn-batal-dusun').addEventListener('click', () => {
      modalDusun.classList.add('hidden');
      resetDusunPhoto();
    });

    window.editDusunItem = (idx) => {
      const d = dusunList[idx];
      if (!d) return;
      document.getElementById('modal-dusun-title').textContent = 'Edit Data Dusun: ' + (d.nama || '');
      editIndex.value = String(idx);
      editId.value = d.id || '';
      editNama.value = d.nama || '';
      editKadus.value = d.kepala_dusun || '';
      editRt.value = d.jumlah_rt || '';
      editLuas.value = d.luas || '';
      editPotensi.value = d.potensi_utama || '';
      editDeskripsi.value = d.deskripsi || '';
      editFoto = d.foto || '';
      pendingDusunImage = null;
      editFotoFile.value = '';
      editFotoStatus.textContent = 'Pilih foto baru untuk mengganti foto saat ini.';
      showDusunPhotoPreview(editFoto);
      modalDusun.classList.remove('hidden');
    };

    window.deleteDusunItem = async (idx) => {
      const d = dusunList[idx];
      if (!d) return;
      if (await (window).__timpikAdminConfirm(`Apakah Anda yakin ingin menghapus data "${d.nama}"?`)) {
        const updatedDusunList = dusunList.filter((_, itemIndex) => itemIndex !== idx);
        try {
          await persistProfil({ ...currentData, dusun: updatedDusunList });
          dusunList = updatedDusunList;
          renderDusunCards();
          showProfileNotice('Data dusun berhasil dihapus dan tersimpan ke Supabase.');
        } catch (error) {
          alert(error instanceof Error ? `Data dusun gagal dihapus: ${error.message}` : 'Data dusun gagal dihapus.');
        }
      }
    };

    formEditDusun.addEventListener('submit', async (e) => {
      e.preventDefault();
      const saveButton = formEditDusun.querySelector('button[type="submit"]');
      saveButton.disabled = true;
      saveButton.textContent = pendingDusunImage ? 'Mengunggah foto...' : 'Menyimpan...';

      try {
      const idx = parseInt(editIndex.value, 10);
      const newId = editId.value.trim().toLowerCase()
        .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
      if (!newId) throw new Error('ID dusun harus berisi huruf atau angka.');
      if (dusunList.some((item, itemIndex) => itemIndex !== idx && item.id === newId)) {
        throw new Error('ID dusun sudah digunakan. Pilih ID yang berbeda.');
      }
      if (pendingDusunImage) {
        const response = await fetch('/api/admin/berita-image?folder=dusun', {
          method: 'POST',
          headers: { 'Content-Type': pendingDusunImage.type },
          credentials: 'same-origin',
          body: pendingDusunImage,
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok) {
          const message = response.status === 404
            ? 'API upload belum aktif. Jalankan npm run dev agar Vercel Functions ikut berjalan.'
            : result.error || 'Foto dusun gagal diunggah.';
          throw new Error(message);
        }
        editFoto = result.publicUrl;
        pendingDusunImage = null;
        editFotoStatus.textContent = 'Foto berhasil diunggah ke Supabase.';
      }

      const newDusun = {
        id: newId,
        nama: editNama.value.trim(),
        panggilan: editNama.value.replace(/dusun/i, '').trim(),
        kepala_dusun: editKadus.value.trim(),
        jumlah_rt: editRt.value.trim(),
        luas: editLuas.value.trim(),
        potensi_utama: editPotensi.value.trim(),
        deskripsi: editDeskripsi.value.trim(),
        foto: editFoto
      };

      const updatedDusunList = [...dusunList];
      if (idx >= 0 && idx < updatedDusunList.length) {
        updatedDusunList[idx] = newDusun;
      } else {
        updatedDusunList.push(newDusun);
      }

      await persistProfil({ ...currentData, dusun: updatedDusunList });
      dusunList = updatedDusunList;
      modalDusun.classList.add('hidden');
      renderDusunCards();
      showProfileNotice('Data dusun berhasil disimpan ke Supabase dan diperbarui di halaman publik.');
      } catch (error) {
        editFotoStatus.textContent = error instanceof Error ? error.message : 'Data dusun gagal disimpan.';
        alert(editFotoStatus.textContent);
      } finally {
        saveButton.disabled = false;
        saveButton.textContent = 'Simpan Dusun';
      }
    });

    // Form Submit Main (Save all)
    const formMain = document.getElementById('form-info');
    formMain.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitButton = formMain.querySelector('button[type="submit"]');
      submitButton.disabled = true;
      submitButton.querySelector('span').textContent = 'Menyimpan...';

      try {
      const lkNum = parseInt((inLk.value || '').replace(/[^0-9]/g, ''), 10) || 0;
      const pmNum = parseInt((inPm.value || '').replace(/[^0-9]/g, ''), 10) || 0;
      const totalNum = lkNum + pmNum;

      const formattedLk = formatNumber(lkNum) + ' Jiwa';
      const formattedPm = formatNumber(pmNum) + ' Jiwa';
      const formattedTotal = formatNumber(totalNum) + ' Jiwa';

      const updatedProfil = {
        ...currentData,
        visi: inVisi.value.trim(),
        misi: misiList.map((item) => item.trim()).filter(Boolean),
        alamat_kantor: inAlamat.value.trim(),
        telepon: inTelepon.value.trim(),
        email: inEmail.value.trim(),
        jam_layanan: inJam.value.trim(),
        foto_struktur: fotoStrukturBase64,
        dusun: dusunList,
        statistik: {
          ...currentData.statistik,
          laki_laki: formattedLk,
          perempuan: formattedPm,
          total_penduduk: formattedTotal,
          total_kk: inKk.value.trim(),
          luas_wilayah: inLuas.value.trim()
        }
      };

      await persistProfil(updatedProfil);
      showProfileNotice('Pembaruan profil, data dusun, statistik, dan foto berhasil disimpan ke Supabase.');
      } catch (error) {
        alert(error instanceof Error ? `Pembaruan profil gagal disimpan: ${error.message}` : 'Pembaruan profil gagal disimpan.');
      } finally {
        submitButton.disabled = false;
        submitButton.querySelector('span').textContent = 'Simpan Seluruh Pembaruan';
      }
    });

    const ANNOUNCEMENT_STORAGE_KEY = 'timpik_pengumuman_list';

    let announcementItems = Array.isArray(defaultPengumuman)
      ? defaultPengumuman.map(item => ({ ...item }))
      : [];

    const announcementList = document.getElementById('pengumuman-list');
    const announcementModal = document.getElementById('modal-pengumuman');
    const announcementForm = document.getElementById('form-pengumuman');
    const announcementNotice = document.getElementById('pengumuman-notice');

    const announcementFields = {
      id: document.getElementById('pengumuman-id'),
      judul: document.getElementById('pengumuman-judul'),
      kategori: document.getElementById('pengumuman-kategori'),
      tanggal: document.getElementById('pengumuman-tanggal'),
      ringkasan: document.getElementById('pengumuman-ringkasan'),
      isi: document.getElementById('pengumuman-isi'),
      url: document.getElementById('pengumuman-url'),
      label: document.getElementById('pengumuman-label-link'),
      status: document.getElementById('pengumuman-status'),
      prioritas: document.getElementById('pengumuman-prioritas')
    };

    let announcementSearch = '';
    let announcementFilter = 'semua';

    const escapeAnnouncement = (value) => String(value ?? '').replace(/[&<>"']/g, char => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#39;'
    })[char]);

    const generateAnnouncementId = () => {
      return `pengumuman-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`;
    };

    function showAnnouncementNotice(message, type = 'success') {
      if (!announcementNotice) return;

      announcementNotice.textContent = message;

      announcementNotice.className = `rounded-xl border p-4 text-sm font-semibold ${
        type === 'error'
          ? 'border-rose-300 bg-rose-50 text-rose-900'
          : type === 'warning'
            ? 'border-amber-300 bg-amber-50 text-amber-900'
            : 'border-emerald-300 bg-emerald-50 text-emerald-900'
      }`;

      window.clearTimeout(showAnnouncementNotice.timer);

      showAnnouncementNotice.timer = window.setTimeout(() => {
        announcementNotice.classList.add('hidden');
      }, 5000);
    }

    function formatAnnouncementDate(value) {
      if (!value) return 'Tanggal belum ditentukan';

      const date = new Date(`${value}T00:00:00`);

      if (Number.isNaN(date.getTime())) return value;

      return new Intl.DateTimeFormat('id-ID', {
        day: 'numeric',
        month: 'long',
        year: 'numeric'
      }).format(date);
    }

    function updateAnnouncementStats() {
      document.getElementById('pengumuman-total').textContent = announcementItems.length;

      document.getElementById('pengumuman-terbit').textContent =
        announcementItems.filter(item => item.status === 'terbit').length;

      document.getElementById('pengumuman-draf').textContent =
        announcementItems.filter(item => item.status === 'draf' || item.status === 'draft').length;
    }

    function renderAnnouncementList() {
      if (!announcementList) return;

      updateAnnouncementStats();

      const filtered = announcementItems.filter(item => {
        const status = item.status === 'draft' ? 'draf' : item.status;

        const searchable = [
          item.judul,
          item.kategori,
          item.ringkasan,
          item.isi
        ].join(' ').toLowerCase();

        const matchSearch = searchable.includes(announcementSearch);

        const matchFilter = announcementFilter === 'semua'
          || status === announcementFilter;

        return matchSearch && matchFilter;
      }).sort((a, b) => String(b.tanggal || '').localeCompare(String(a.tanggal || '')));

      if (!filtered.length) {
        announcementList.innerHTML = `
          <div class="rounded-xl border border-dashed border-slate-300 bg-slate-50 p-10 text-center">
            <p class="text-sm font-bold text-slate-800">Belum ada pengumuman</p>
            <p class="mt-1 text-xs text-slate-500">Tambahkan informasi baru melalui tombol Tambah Pengumuman.</p>
          </div>
        `;

        return;
      }

      announcementList.innerHTML = filtered.map(item => {
        const published = item.status === 'terbit';

        return `
          <article class="rounded-xl border border-slate-200 bg-white p-4 transition hover:border-blue-200 hover:shadow-sm sm:p-5">

            <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">

              <div class="min-w-0 flex-1">

                <div class="flex flex-wrap items-center gap-2">

                  <span class="rounded-lg bg-blue-50 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-blue-900">
                    ${escapeAnnouncement(item.kategori)}
                  </span>

                  <span class="rounded-full px-2.5 py-1 text-[10px] font-bold ${
                    published
                      ? 'bg-emerald-100 text-emerald-800'
                      : 'bg-amber-100 text-amber-900'
                  }">
                    ${published ? 'Terbit' : 'Draf'}
                  </span>

                  ${item.prioritas === 'penting'
                    ? '<span class="rounded-full bg-rose-100 px-2.5 py-1 text-[10px] font-bold text-rose-800">Penting</span>'
                    : ''
                  }

                </div>

                <h3 class="mt-3 text-base font-extrabold leading-snug text-slate-950">
                  ${escapeAnnouncement(item.judul)}
                </h3>

                <p class="mt-1 text-xs text-slate-400">
                  ${escapeAnnouncement(formatAnnouncementDate(item.tanggal))}
                </p>

                <p class="mt-3 line-clamp-2 text-sm leading-relaxed text-slate-600">
                  ${escapeAnnouncement(item.ringkasan)}
                </p>

              </div>

              <div class="flex shrink-0 flex-wrap gap-2">

                <button
                  type="button"
                  data-announcement-action="edit"
                  data-id="${escapeAnnouncement(item.id)}"
                  class="min-h-9 rounded-lg border border-slate-300 px-3 py-2 text-xs font-bold text-slate-700 hover:bg-slate-50"
                >
                  Edit
                </button>

                <button
                  type="button"
                  data-announcement-action="toggle"
                  data-id="${escapeAnnouncement(item.id)}"
                  class="min-h-9 rounded-lg border px-3 py-2 text-xs font-bold ${
                    published
                      ? 'border-amber-300 text-amber-800 hover:bg-amber-50'
                      : 'border-emerald-300 text-emerald-800 hover:bg-emerald-50'
                  }"
                >
                  ${published ? 'Jadikan Draf' : 'Terbitkan'}
                </button>

                <button
                  type="button"
                  data-announcement-action="delete"
                  data-id="${escapeAnnouncement(item.id)}"
                  class="min-h-9 rounded-lg border border-rose-200 px-3 py-2 text-xs font-bold text-rose-700 hover:bg-rose-50"
                >
                  Hapus
                </button>

              </div>

            </div>

          </article>
        `;
      }).join('');
    }

    function openAnnouncementModal(item = null) {
      announcementForm.reset();

      announcementFields.id.value = item?.id || '';
      announcementFields.judul.value = item?.judul || '';
      announcementFields.kategori.value = item?.kategori || 'Pemerintahan';
      announcementFields.tanggal.value = item?.tanggal || '';
      announcementFields.ringkasan.value = item?.ringkasan || '';
      announcementFields.isi.value = item?.isi || '';
      announcementFields.url.value = item?.url || '';
      announcementFields.label.value = item?.label_tautan || '';
      announcementFields.status.value = item
        ? (item.status === 'draft' ? 'draf' : item.status || 'draf')
        : 'draf';
      announcementFields.prioritas.value = item?.prioritas || 'normal';

      document.getElementById('modal-pengumuman-title').textContent =
        item ? 'Edit Pengumuman' : 'Tambah Pengumuman';

      document.getElementById('btn-simpan-pengumuman').textContent =
        item ? 'Simpan Perubahan' : 'Simpan Pengumuman';

      document.getElementById('pengumuman-char-count').textContent =
        announcementFields.ringkasan.value.length;

      announcementModal.classList.remove('hidden');
      announcementModal.classList.add('flex');
      announcementModal.setAttribute('aria-hidden', 'false');

      document.body.classList.add('overflow-hidden');

      announcementFields.judul.focus();
    }

    function closeAnnouncementModal() {
      announcementModal.classList.add('hidden');
      announcementModal.classList.remove('flex');
      announcementModal.setAttribute('aria-hidden', 'true');

      document.body.classList.remove('overflow-hidden');
    }

    async function persistAnnouncementData() {
      const saveFunction = (window as any).__timpikSaveAdminContent;

      if (typeof saveFunction === 'function') {
        await saveFunction(ANNOUNCEMENT_STORAGE_KEY, announcementItems);

        localStorage.setItem(
          ANNOUNCEMENT_STORAGE_KEY,
          JSON.stringify(announcementItems)
        );

        window.dispatchEvent(new CustomEvent('timpik-supabase-content', {
          detail: {
            pengumuman: announcementItems
          }
        }));

        return 'server';
      }

      localStorage.setItem(
        ANNOUNCEMENT_STORAGE_KEY,
        JSON.stringify(announcementItems)
      );

      window.dispatchEvent(new CustomEvent('timpik-supabase-content', {
        detail: {
          pengumuman: announcementItems
        }
      }));

      return 'local';
    }

    document.getElementById('btn-tambah-pengumuman')
      .addEventListener('click', () => openAnnouncementModal());

    document.getElementById('btn-close-pengumuman')
      .addEventListener('click', closeAnnouncementModal);

    document.getElementById('btn-batal-pengumuman')
      .addEventListener('click', closeAnnouncementModal);

    announcementModal.addEventListener('click', event => {
      if (event.target === announcementModal) {
        closeAnnouncementModal();
      }
    });

    document.addEventListener('keydown', event => {
      if (
        event.key === 'Escape'
        && !announcementModal.classList.contains('hidden')
      ) {
        closeAnnouncementModal();
      }
    });

    announcementFields.ringkasan.addEventListener('input', () => {
      document.getElementById('pengumuman-char-count').textContent =
        announcementFields.ringkasan.value.length;
    });

    document.getElementById('pengumuman-search').addEventListener('input', event => {
      announcementSearch = event.target.value.trim().toLowerCase();
      renderAnnouncementList();
    });

    document.getElementById('pengumuman-filter').addEventListener('change', event => {
      announcementFilter = event.target.value;
      renderAnnouncementList();
    });

    announcementList.addEventListener('click', async event => {
      const button = (event.target as HTMLElement).closest('[data-announcement-action]');

      if (!button) return;

      const id = button.dataset.id;

      const item = announcementItems.find(entry => String(entry.id) === String(id));

      if (!item) return;

      const action = button.dataset.announcementAction;

      if (action === 'edit') {
        openAnnouncementModal(item);
        return;
      }

      if (action === 'delete') {
        const confirmed = window.confirm(
          `Hapus pengumuman "${item.judul}"? Tindakan ini tidak dapat dibatalkan.`
        );

        if (!confirmed) return;
      }

      const previousItems = announcementItems.map(entry => ({ ...entry }));

      if (action === 'delete') {
        announcementItems = announcementItems.filter(
          entry => String(entry.id) !== String(id)
        );
      }

      if (action === 'toggle') {
        item.status = item.status === 'terbit' ? 'draf' : 'terbit';
      }

      try {
        const destination = await persistAnnouncementData();

        renderAnnouncementList();

        showAnnouncementNotice(
          destination === 'server'
            ? 'Perubahan pengumuman berhasil disimpan.'
            : 'Pengumuman tersimpan di browser ini. Sinkronisasi lintas perangkat belum tersedia.',
          destination === 'server' ? 'success' : 'warning'
        );

      } catch (error) {
        announcementItems = previousItems;
        renderAnnouncementList();

        showAnnouncementNotice(
          error instanceof Error ? error.message : 'Perubahan pengumuman gagal disimpan.',
          'error'
        );
      }
    });

    announcementForm.addEventListener('submit', async event => {
      event.preventDefault();

      if (!announcementForm.reportValidity()) return;

      const saveButton = document.getElementById('btn-simpan-pengumuman');
      const previousLabel = saveButton.textContent;

      saveButton.disabled = true;
      saveButton.textContent = 'Menyimpan...';

      const id = announcementFields.id.value || generateAnnouncementId();

      const existing = announcementItems.find(
        item => String(item.id) === String(id)
      );

      const record = {
        id,
        kategori: announcementFields.kategori.value,
        judul: announcementFields.judul.value.trim(),
        ringkasan: announcementFields.ringkasan.value.trim(),
        isi: announcementFields.isi.value.trim(),
        tanggal: announcementFields.tanggal.value,
        url: announcementFields.url.value.trim(),
        label_tautan: announcementFields.label.value.trim(),
        status: announcementFields.status.value,
        prioritas: announcementFields.prioritas.value,
        dibuat_pada: existing?.dibuat_pada || new Date().toISOString(),
        diperbarui_pada: new Date().toISOString()
      };

      if (
        record.url
        && !record.url.startsWith('/')
        && !/^https?:\/\//i.test(record.url)
      ) {
        showAnnouncementNotice(
          'Tautan harus berupa alamat halaman lokal atau URL HTTP/HTTPS.',
          'error'
        );

        saveButton.disabled = false;
        saveButton.textContent = previousLabel;
        return;
      }

      const previousItems = announcementItems.map(item => ({ ...item }));

      if (existing) {
        announcementItems = announcementItems.map(item =>
          String(item.id) === String(id) ? record : item
        );
      } else {
        announcementItems.unshift(record);
      }

      try {
        const destination = await persistAnnouncementData();

        closeAnnouncementModal();
        renderAnnouncementList();

        showAnnouncementNotice(
          destination === 'server'
            ? 'Pengumuman berhasil disimpan.'
            : 'Pengumuman tersimpan di browser ini. Hubungkan penyimpanan server agar dapat diakses dari perangkat lain.',
          destination === 'server' ? 'success' : 'warning'
        );

      } catch (error) {
        announcementItems = previousItems;
        renderAnnouncementList();

        showAnnouncementNotice(
          error instanceof Error ? error.message : 'Pengumuman gagal disimpan.',
          'error'
        );
      } finally {
        saveButton.disabled = false;
        saveButton.textContent = previousLabel;
      }
    });

    try {
      const storedAnnouncements = localStorage.getItem(ANNOUNCEMENT_STORAGE_KEY);

      if (storedAnnouncements) {
        const parsed = JSON.parse(storedAnnouncements);

        if (Array.isArray(parsed)) {
          announcementItems = parsed;
        }
      }
    } catch (error) {
      console.warn('Data pengumuman lokal tidak dapat dibaca.', error);
    }

    const remoteAnnouncements = (window as any).__timpikSupabaseContent?.pengumuman;

    if (Array.isArray(remoteAnnouncements)) {
      announcementItems = remoteAnnouncements;
    }

    window.addEventListener('timpik-supabase-content', event => {
      const remote = (event as CustomEvent).detail?.pengumuman;

      if (Array.isArray(remote)) {
        announcementItems = remote;
        localStorage.setItem(ANNOUNCEMENT_STORAGE_KEY, JSON.stringify(remote));
        renderAnnouncementList();
      }
    });

    renderAnnouncementList();
    document.getElementById('btn-clear-all-profil').addEventListener('click', async (event) => {
      if (!(await (window ).__timpikAdminConfirm('Kosongkan semua informasi profil, statistik, foto, visi-misi, dan data dusun? Data akan hilang dari halaman publik dan tidak dapat dipulihkan.', 'Kosongkan seluruh informasi desa', 'Ya, kosongkan'))) return;
      const button = event.currentTarget;
      button.disabled = true;
      const emptyProfile = (value) => {
        if (Array.isArray(value)) return [];
        if (value && typeof value === 'object') {
          return Object.fromEntries(Object.entries(value).map(([key, nestedValue]) => [key, emptyProfile(nestedValue)]));
        }
        return typeof value === 'string' ? '' : value;
      };
      try {
        await (window).__timpikSaveAdminContent(STORAGE_KEY, emptyProfile(currentData));
        window.location.reload();
      } catch (error) {
        alert(error instanceof Error ? `Data profil gagal dikosongkan: ${error.message}` : 'Data profil gagal dikosongkan.');
        button.disabled = false;
      }
    });

  </script>
</AdminLayout>
