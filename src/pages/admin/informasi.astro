              </label>

              <input
                id="pengumuman-label-link"
                type="text"
                maxlength="60"
                placeholder="Baca informasi lebih lanjut"
                class="w-full min-h-11 rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm"
              />
            </div>

          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

            <div>
              <label for="pengumuman-status" class="mb-1.5 block text-sm font-bold text-slate-800">
                Status Publikasi
              </label>

              <select id="pengumuman-status" class="w-full min-h-11 rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-sm">
                <option value="draf">Simpan sebagai Draf</option>
                <option value="terbit">Terbitkan Sekarang</option>
              </select>
            </div>

            <div>
              <label for="pengumuman-prioritas" class="mb-1.5 block text-sm font-bold text-slate-800">
                Prioritas
              </label>

              <select id="pengumuman-prioritas" class="w-full min-h-11 rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-sm">
                <option value="normal">Normal</option>
                <option value="penting">Penting</option>
