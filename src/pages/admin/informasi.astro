---
import AdminLayout from '../../layouts/AdminLayout.astro';
import profil from '../../data/profil.json';

const pengumumanAwal = [
  {
    id: 'pengumuman-surat',
    kategori: 'Administrasi Surat',
    judul: 'Permohonan Dokumen Administrasi Warga Kini Dapat Diajukan Online',
    ringkasan: 'Warga dapat mengurus SKU, SKTM, pengantar SKCK, surat domisili, dan surat kematian secara online.',
    isi: 'Pemerintah Desa Timpik menyediakan layanan pengajuan dokumen administrasi secara online. Warga dapat mengajukan SKU, SKTM, pengantar SKCK, surat domisili, dan surat kematian melalui formulir layanan yang tersedia.',
    tanggal: '',
    url: '/layanan-surat',
    label_tautan: 'Buka Katalog Layanan Surat',
    status: 'terbit',
    prioritas: 'normal'
  },
  {
    id: 'pengumuman-irigasi',
    kategori: 'Pertanian & Irigasi',
    judul: 'Jadwal Pembagian Giliran Aliran Air Irigasi P3A Bogo Wastro',
    ringkasan: 'Pengurus P3A Bogo Wastro menetapkan rotasi debit air sawah untuk pemerataan suplai air.',
    isi: 'Informasi mengenai jadwal pembagian aliran air irigasi P3A Bogo Wastro untuk wilayah Dusun Bogo, Dusun Sumber, dan wilayah terkait. Warga dapat menghubungi pengurus P3A untuk memperoleh informasi jadwal pelaksanaan.',
    tanggal: '',
    url: '/kelembagaan/p3a',
    label_tautan: 'Lihat Detail P3A',
    status: 'terbit',
    prioritas: 'normal'
  },
  {
    id: 'pengumuman-apbdes',
    kategori: 'Transparansi Anggaran',
    judul: 'Publikasi Rincian APBDes dan Alokasi Pembangunan Fisik',
    ringkasan: 'Warga dapat memantau informasi penggunaan anggaran desa dan alokasi pembangunan.',
    isi: 'Pemerintah Desa Timpik menyediakan informasi transparansi anggaran sebagai bagian dari keterbukaan penyelenggaraan pemerintahan desa. Rincian anggaran dan alokasi pembangunan dapat dilihat melalui halaman transparansi.',
    tanggal: '',
    url: '/transparansi',
    label_tautan: 'Buka Laporan APBDes',
    status: 'terbit',
    prioritas: 'normal'
  }
];
---

<AdminLayout title="Kelola Informasi & Profil Desa" activeMenu="informasi">

  <main class="mx-auto max-w-6xl space-y-8 pb-16">

    <!-- HEADER -->
    <header class="flex flex-col justify-between gap-4 border-b border-slate-200 pb-5 sm:flex-row sm:items-center">
      <div>
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">
          Pengelolaan Informasi Profil Desa
        </h1>
        <p class="mt-1 text-sm text-slate-600 sm:text-base">
          Kelola profil, data wilayah, statistik penduduk, struktur organisasi, dan pengumuman Desa Timpik.
        </p>
      </div>

      <div class="flex flex-wrap gap-2">
        <button type="button" id="btn-clear-all-profil" class="inline-flex min-h-11 items-center gap-2 rounded-xl border border-rose-300 bg-rose-50 px-4 py-2 text-sm font-bold text-rose-800 hover:bg-rose-100">
          Kosongkan Semua Data
        </button>

        <a href="/profil" target="_blank" class="inline-flex min-h-11 items-center rounded-xl bg-blue-700 px-4 py-2 text-sm font-bold text-white hover:bg-blue-800">
          Buka Profil Publik ↗
        </a>
      </div>
    </header>

    <!-- GLOBAL NOTICE -->
    <div id="notice-toast" class="hidden items-center justify-between rounded-xl border border-emerald-300 bg-emerald-50 p-4 text-emerald-950">
      <span id="notice-text" class="text-sm font-semibold"></span>
      <button type="button" id="btn-close-global-notice" class="text-xl font-bold">&times;</button>
    </div>

    <!-- TABS -->
    <div role="tablist" aria-label="Bagian informasi profil" class="flex flex-wrap gap-2 rounded-2xl border border-slate-200 bg-slate-100 p-2 text-sm font-bold">

      <button type="button" role="tab" aria-selected="true" aria-controls="panel-umum" id="tab-btn-umum" class="admin-tab active">
        1. Visi, Misi & Alamat
      </button>

      <button type="button" role="tab" aria-selected="false" tabindex="-1" aria-controls="panel-dusun" id="tab-btn-dusun" class="admin-tab">
        2. Data Dusun (<span id="dusun-tab-count">0</span>)
      </button>

      <button type="button" role="tab" aria-selected="false" tabindex="-1" aria-controls="panel-penduduk" id="tab-btn-penduduk" class="admin-tab">
        3. Data Total Warga
      </button>

      <button type="button" role="tab" aria-selected="false" tabindex="-1" aria-controls="panel-struktur" id="tab-btn-struktur" class="admin-tab">
        4. Struktur Organisasi
      </button>

      <button type="button" role="tab" aria-selected="false" tabindex="-1" aria-controls="panel-pengumuman" id="tab-btn-pengumuman" class="admin-tab">
        5. Pengumuman Balai Desa
      </button>

    </div>

    <!-- =====================================================
         FORM PROFIL DESA
    ====================================================== -->

    <form id="form-info" class="space-y-8">

      <!-- VISI MISI -->
      <section id="panel-umum" role="tabpanel" aria-labelledby="tab-btn-umum" class="space-y-6">

        <div class="space-y-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-xs sm:p-8">

          <h2 class="border-b border-slate-100 pb-3 text-xl font-bold text-slate-900">
            Visi, Misi & Alamat Kantor Desa
          </h2>

          <div>
            <label for="input-visi" class="mb-2 block text-sm font-bold text-slate-900">
              Visi Desa Timpik
            </label>
            <textarea id="input-visi" rows="3" required class="admin-input"></textarea>
          </div>

          <!-- SEJARAH DESA -->
          <div class="space-y-5 border-t border-slate-100 pt-6">
            <div>
              <h3 class="text-base font-bold text-slate-900">Sejarah dan Letak Geografis Desa</h3>
              <p class="mt-1 text-xs text-slate-500">Kelola informasi sejarah dan gambaran wilayah Desa Timpik yang ditampilkan pada halaman profil publik.</p>
            </div>

            <div>
              <label for="input-sejarah-judul" class="mb-1.5 block text-sm font-bold text-slate-900">
                Judul Sejarah
              </label>
              <input id="input-sejarah-judul" type="text" maxlength="150" class="w-full rounded-xl border border-slate-300 p-3.5 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-600" placeholder="Desa Timpik, Kecamatan Susukan" />
            </div>

            <div>
              <label for="input-sejarah-1" class="mb-1.5 block text-sm font-bold text-slate-900">
                Paragraf Sejarah Pertama
              </label>
              <textarea id="input-sejarah-1" rows="5" class="w-full rounded-xl border border-slate-300 p-3.5 text-sm leading-relaxed text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-600" placeholder="Tuliskan sejarah dan gambaran geografis Desa Timpik..."></textarea>
            </div>

            <div>
              <label for="input-sejarah-2" class="mb-1.5 block text-sm font-bold text-slate-900">
                Paragraf Sejarah Kedua
              </label>
              <textarea id="input-sejarah-2" rows="5" class="w-full rounded-xl border border-slate-300 p-3.5 text-sm leading-relaxed text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-600" placeholder="Tuliskan informasi kehidupan masyarakat dan wilayah dusun..."></textarea>
            </div>
          </div>
          <div>
            <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
              <div>
                <h3 class="font-bold text-slate-900">Misi Desa Timpik</h3>
                <p class="mt-1 text-xs text-slate-500">Kelola daftar misi desa.</p>
              </div>
              <button type="button" id="btn-add-misi" class="admin-button-secondary">
                + Tambah Misi
              </button>
            </div>

            <div id="misi-list" class="space-y-3"></div>

            <p id="misi-empty" class="hidden rounded-xl border border-dashed border-slate-300 bg-slate-50 p-4 text-sm text-slate-500">
              Belum ada misi.
            </p>
          </div>

          <div class="space-y-4 border-t border-slate-100 pt-5">

            <h3 class="font-bold text-slate-900">
              Alamat Lengkap & Kontak Resmi Balai Desa
            </h3>

            <div>
              <label for="input-alamat" class="admin-label">Alamat Kantor Desa</label>
              <input type="text" id="input-alamat" required class="admin-input" />
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label for="input-telepon" class="admin-label">Nomor Telepon / WhatsApp</label>
                <input type="text" id="input-telepon" class="admin-input" />
              </div>

              <div>
                <label for="input-email" class="admin-label">Email Resmi Desa</label>
                <input type="email" id="input-email" class="admin-input" />
              </div>
            </div>

            <div>
              <label for="input-jam" class="admin-label">Jam Pelayanan Warga</label>
              <input type="text" id="input-jam" class="admin-input" />
            </div>

          </div>
        </div>

      </section>

      <!-- DATA DUSUN -->
      <section id="panel-dusun" role="tabpanel" aria-labelledby="tab-btn-dusun" tabindex="0" class="hidden space-y-6">

        <div class="space-y-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-xs sm:p-8">

          <div class="flex flex-wrap items-center justify-between gap-4 border-b border-slate-100 pb-4">
            <div>
              <h2 class="text-xl font-bold text-slate-900">Data Dusun Desa Timpik</h2>
              <p class="mt-1 text-sm text-slate-500">Kelola wilayah dan informasi setiap dusun.</p>
            </div>

            <button type="button" id="btn-tambah-dusun" class="admin-button-primary">
              + Tambah Dusun
            </button>
          </div>

          <div id="dusun-card-list" class="grid gap-4 md:grid-cols-2"></div>

        </div>

      </section>

      <!-- STATISTIK PENDUDUK -->
      <section id="panel-penduduk" role="tabpanel" aria-labelledby="tab-btn-penduduk" tabindex="0" class="hidden space-y-6">

        <div class="space-y-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-xs sm:p-8">

          <div class="border-b border-slate-100 pb-3">
            <h2 class="text-xl font-bold text-slate-900">Statistik Penduduk Desa Timpik</h2>
            <p class="mt-1 text-sm text-slate-500">Total penduduk dihitung otomatis.</p>
          </div>

          <div class="grid gap-5 sm:grid-cols-3">

            <div class="rounded-xl border border-blue-200 bg-blue-50 p-5">
              <label for="input-lk" class="admin-label">Penduduk Laki-Laki</label>
              <input type="text" id="input-lk" required placeholder="2848" class="admin-input text-lg font-bold" />
            </div>

            <div class="rounded-xl border border-blue-200 bg-blue-50 p-5">
              <label for="input-pm" class="admin-label">Penduduk Perempuan</label>
              <input type="text" id="input-pm" required placeholder="2848" class="admin-input text-lg font-bold" />
            </div>

            <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-5">
              <label for="input-total" class="admin-label">Total Penduduk</label>
              <input type="text" id="input-total" readonly class="admin-input bg-slate-100 text-lg font-black" />
              <p id="total-calc-hint" class="mt-2 text-xs text-emerald-800"></p>
            </div>

          </div>

          <div class="grid gap-4 border-t border-slate-100 pt-4 sm:grid-cols-2">
            <div>
              <label for="input-kk" class="admin-label">Jumlah Kepala Keluarga</label>
              <input type="text" id="input-kk" class="admin-input" />
            </div>

            <div>
              <label for="input-luas" class="admin-label">Luas Wilayah Desa</label>
              <input type="text" id="input-luas" class="admin-input" />
            </div>
          </div>

        </div>

      </section>

      <!-- STRUKTUR ORGANISASI -->
      <section id="panel-struktur" role="tabpanel" aria-labelledby="tab-btn-struktur" tabindex="0" class="hidden space-y-6">

        <div class="space-y-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-xs sm:p-8">

          <div class="border-b border-slate-100 pb-3">
            <h2 class="text-xl font-bold text-slate-900">Foto Struktur Organisasi Desa</h2>
            <p class="mt-1 text-sm text-slate-500">Upload foto bagan organisasi resmi Desa Timpik.</p>
          </div>

          <div>
            <label for="input-foto" class="admin-label">Pilih Foto Struktur</label>
            <input id="input-foto" type="file" accept="image/jpeg,image/png,image/webp" class="admin-input" />
            <p class="mt-2 text-xs text-slate-500">Maksimal 3 MB.</p>
          </div>

          <div class="space-y-3 border-t border-slate-100 pt-4">
            <p class="text-xs font-bold uppercase tracking-wide text-slate-500">Pratinjau Foto</p>

            <div class="max-w-2xl overflow-hidden rounded-xl border border-slate-200 bg-slate-50 p-2">
              <img id="preview-foto-struktur" src="/images/struktur-organisasi-timpik.jpg" alt="Struktur organisasi Desa Timpik" class="mx-auto max-h-[450px] w-full rounded-lg object-contain" />
            </div>

            <button type="button" id="btn-reset-foto" class="text-xs font-bold text-rose-600 hover:underline">
              Kembalikan ke foto bawaan
            </button>
          </div>

        </div>

      </section>

      <!-- SIMPAN PROFIL -->
      <div id="profile-save-actions" class="sticky bottom-4 z-20 flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-blue-200 bg-white/95 p-4 shadow-lg backdrop-blur-md">

        <p class="text-xs text-slate-600">
          Simpan perubahan informasi profil desa.
        </p>

        <button type="submit" class="admin-button-primary min-h-12 px-7">
          <span>Simpan Seluruh Pembaruan</span>
        </button>

      </div>

    </form>

    <!-- =====================================================
         PENGELOLAAN PENGUMUMAN
    ====================================================== -->

    <section id="panel-pengumuman" role="tabpanel" aria-labelledby="tab-btn-pengumuman" tabindex="0" class="hidden space-y-6">

      <div class="space-y-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-xs sm:p-8">

        <header class="flex flex-col justify-between gap-4 border-b border-slate-100 pb-5 sm:flex-row sm:items-center">

          <div>
            <span class="rounded-full bg-blue-100 px-3 py-1 text-[10px] font-bold uppercase tracking-wide text-blue-800">
              Informasi Publik Desa
            </span>

            <h2 class="mt-3 text-xl font-extrabold text-slate-900">
              Pengumuman Balai Desa Timpik
            </h2>

            <p class="mt-1 text-sm text-slate-500">
              Kelola pengumuman resmi yang akan ditampilkan kepada masyarakat.
            </p>
          </div>

          <button type="button" id="btn-tambah-pengumuman" class="admin-button-primary">
            + Tambah Pengumuman
          </button>

        </header>

        <div id="pengumuman-notice" class="hidden rounded-xl border p-4 text-sm font-semibold" role="status" aria-live="polite"></div>

        <!-- STATISTIK PENGUMUMAN -->
        <div class="grid gap-4 sm:grid-cols-3">

          <article class="rounded-xl border border-slate-200 bg-slate-50 p-5">
            <p class="text-xs font-bold uppercase text-slate-500">Total Pengumuman</p>
            <p id="pengumuman-total" class="mt-2 text-3xl font-black text-slate-900">0</p>
            <p class="text-xs text-slate-500">Seluruh data</p>
          </article>

          <article class="rounded-xl border border-emerald-200 bg-emerald-50 p-5">
            <p class="text-xs font-bold uppercase text-emerald-700">Telah Terbit</p>
            <p id="pengumuman-terbit" class="mt-2 text-3xl font-black text-emerald-900">0</p>
            <p class="text-xs text-emerald-700">Ditampilkan ke publik</p>
          </article>

          <article class="rounded-xl border border-amber-200 bg-amber-50 p-5">
            <p class="text-xs font-bold uppercase text-amber-700">Draf</p>
            <p id="pengumuman-draf" class="mt-2 text-3xl font-black text-amber-900">0</p>
            <p class="text-xs text-amber-700">Belum diterbitkan</p>
          </article>

        </div>

        <!-- SEARCH AND FILTER -->
        <div class="flex flex-col justify-between gap-3 sm:flex-row sm:items-center">

          <div>
            <h3 class="font-bold text-slate-900">Daftar Pengumuman</h3>
            <p class="mt-1 text-xs text-slate-500">Kelola data yang sudah tersimpan.</p>
          </div>

          <div class="flex flex-col gap-2 sm:flex-row">

            <input id="pengumuman-search" type="search" placeholder="Cari pengumuman..." class="admin-input sm:min-w-56" />

            <select id="pengumuman-filter" class="admin-input sm:min-w-36">
              <option value="semua">Semua Status</option>
              <option value="terbit">Terbit</option>
              <option value="draf">Draf</option>
            </select>

          </div>

        </div>

        <!-- ANNOUNCEMENT LIST -->
        <div id="pengumuman-list" class="space-y-3">

          <div class="rounded-xl border border-dashed border-slate-300 bg-slate-50 p-10 text-center text-sm text-slate-500">
            Memuat pengumuman...
          </div>

        </div>

      </div>

    </section>

    <!-- =====================================================
         MODAL PENGUMUMAN
    ====================================================== -->

    <div id="modal-pengumuman" class="fixed inset-0 z-[90] hidden items-center justify-center overflow-y-auto bg-slate-950/60 p-3 backdrop-blur-sm sm:p-5" role="dialog" aria-modal="true" aria-labelledby="modal-pengumuman-title" aria-hidden="true">

      <div class="my-auto w-full max-w-2xl overflow-hidden rounded-2xl bg-white shadow-2xl">

        <header class="flex items-start justify-between gap-4 border-b border-slate-100 px-5 py-4 sm:px-7">

          <div>
            <p class="text-[11px] font-bold uppercase tracking-wider text-blue-700">
              Informasi Desa
            </p>

            <h3 id="modal-pengumuman-title" class="mt-1 text-xl font-extrabold text-slate-900">
              Tambah Pengumuman
            </h3>

            <p class="mt-1 text-xs text-slate-500">
              Lengkapi informasi pengumuman yang akan disampaikan kepada warga.
            </p>
          </div>

          <button type="button" id="btn-close-pengumuman" class="flex h-10 w-10 items-center justify-center rounded-xl text-2xl text-slate-500 hover:bg-slate-100">
            &times;
          </button>

        </header>

        <form id="form-pengumuman" class="max-h-[75vh] space-y-5 overflow-y-auto p-5 sm:p-7">

          <input type="hidden" id="pengumuman-id" />

          <div>
            <label for="pengumuman-judul" class="admin-label">
              Judul Pengumuman *
            </label>

            <input id="pengumuman-judul" type="text" maxlength="120" required placeholder="Contoh: Jadwal Pelayanan Administrasi Desa" class="admin-input" />
          </div>

          <div class="grid gap-4 sm:grid-cols-2">

            <div>
              <label for="pengumuman-kategori" class="admin-label">Kategori</label>

              <select id="pengumuman-kategori" class="admin-input">
                <option>Administrasi Surat</option>
                <option>Pertanian & Irigasi</option>
                <option>Kesehatan</option>
                <option>Kebudayaan</option>
                <option>Pemerintahan</option>
                <option>Bansos</option>
                <option>Transparansi Anggaran</option>
                <option>Lainnya</option>
              </select>
            </div>

            <div>
              <label for="pengumuman-tanggal" class="admin-label">Tanggal Pengumuman</label>
              <input id="pengumuman-tanggal" type="date" class="admin-input" />
            </div>

          </div>

          <div>
            <label for="pengumuman-ringkasan" class="admin-label">
              Ringkasan Pengumuman *
            </label>

            <textarea id="pengumuman-ringkasan" rows="3" maxlength="280" required placeholder="Tuliskan ringkasan singkat pengumuman." class="admin-input"></textarea>

            <p class="mt-1 text-right text-xs text-slate-400">
              <span id="pengumuman-char-count">0</span>/280 karakter
            </p>
          </div>

          <div>
            <label for="pengumuman-isi" class="admin-label">
              Isi Lengkap Pengumuman *
            </label>

            <textarea id="pengumuman-isi" rows="6" required placeholder="Tuliskan informasi lengkap pengumuman." class="admin-input"></textarea>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">

            <div>
              <label for="pengumuman-url" class="admin-label">Tautan Informasi</label>
              <input id="pengumuman-url" type="text" placeholder="/layanan-surat atau https://..." class="admin-input" />
            </div>

            <div>
              <label for="pengumuman-label-link" class="admin-label">Teks Tombol</label>
              <input id="pengumuman-label-link" type="text" maxlength="60" placeholder="Baca selengkapnya" class="admin-input" />
            </div>

          </div>

          <div class="grid gap-4 sm:grid-cols-2">

            <div>
              <label for="pengumuman-status" class="admin-label">Status Publikasi</label>

              <select id="pengumuman-status" class="admin-input">
                <option value="draf">Simpan sebagai Draf</option>
                <option value="terbit">Terbitkan Sekarang</option>
              </select>
            </div>

            <div>
              <label for="pengumuman-prioritas" class="admin-label">Prioritas</label>

              <select id="pengumuman-prioritas" class="admin-input">
                <option value="normal">Normal</option>
                <option value="penting">Penting</option>
              </select>
            </div>

          </div>

          <footer class="flex flex-col-reverse justify-end gap-2 border-t border-slate-100 pt-5 sm:flex-row">

            <button type="button" id="btn-batal-pengumuman" class="admin-button-secondary">
              Batal
            </button>

            <button type="submit" id="btn-simpan-pengumuman" class="admin-button-primary">
              Simpan Pengumuman
            </button>

          </footer>

        </form>

      </div>

    </div>

    <!-- =====================================================
         MODAL DUSUN
    ====================================================== -->

    <div id="modal-dusun" class="fixed inset-0 z-[80] hidden items-center justify-center bg-slate-950/70 p-4 backdrop-blur-sm">

      <div class="max-h-[90vh] w-full max-w-lg overflow-y-auto rounded-2xl border border-slate-200 bg-white p-6 shadow-2xl sm:p-8">

        <header class="flex items-start justify-between border-b border-slate-100 pb-3">
          <div>
            <h3 id="modal-dusun-title" class="font-bold text-slate-900">Tambah Dusun Baru</h3>
            <p class="text-xs text-slate-500">Lengkapi informasi dusun.</p>
          </div>

          <button type="button" id="close-modal-dusun" class="text-xl text-slate-400">&times;</button>
        </header>

        <form id="form-edit-dusun" class="space-y-4 py-4">

          <input type="hidden" id="edit-dusun-index" value="-1" />

          <div>
            <label for="edit-dusun-id" class="admin-label">ID Dusun</label>
            <input id="edit-dusun-id" type="text" required placeholder="bogo" class="admin-input" />
          </div>

          <div>
            <label for="edit-dusun-nama" class="admin-label">Nama Dusun</label>
            <input id="edit-dusun-nama" type="text" required placeholder="Dusun Bogo" class="admin-input" />
          </div>

          <div>
            <label for="edit-dusun-kadus" class="admin-label">Nama Kepala Dusun</label>
            <input id="edit-dusun-kadus" type="text" required class="admin-input" />
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="edit-dusun-rt" class="admin-label">Wilayah RT/RW</label>
              <input id="edit-dusun-rt" type="text" class="admin-input" />
            </div>

            <div>
              <label for="edit-dusun-luas" class="admin-label">Estimasi Luas</label>
              <input id="edit-dusun-luas" type="text" class="admin-input" />
            </div>
          </div>

          <div>
            <label for="edit-dusun-potensi" class="admin-label">Potensi Utama</label>
            <input id="edit-dusun-potensi" type="text" class="admin-input" />
          </div>

          <div>
            <label for="edit-dusun-deskripsi" class="admin-label">Deskripsi</label>
            <textarea id="edit-dusun-deskripsi" rows="3" class="admin-input"></textarea>
          </div>

          <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
            <label for="edit-dusun-foto-file" class="admin-label">Foto Dusun</label>

            <input id="edit-dusun-foto-file" type="file" accept="image/jpeg,image/png,image/webp,image/avif" class="admin-input" />

            <p id="edit-dusun-foto-status" class="mt-2 text-xs text-slate-500">
              JPG, PNG, WebP, atau AVIF. Maksimal 4 MB.
            </p>

            <div id="edit-dusun-foto-preview-wrap" class="mt-3 hidden overflow-hidden rounded-xl border border-slate-200 bg-white">
              <img id="edit-dusun-foto-preview" alt="Pratinjau foto dusun" class="h-44 w-full object-cover" />

              <button type="button" id="edit-dusun-foto-remove" class="w-full border-t border-slate-200 p-3 text-sm font-semibold text-rose-700">
                Hapus foto
              </button>
            </div>
          </div>

          <footer class="flex justify-end gap-2 border-t border-slate-100 pt-4">
            <button type="button" id="btn-batal-dusun" class="admin-button-secondary">Batal</button>
            <button type="submit" class="admin-button-primary">Simpan Dusun</button>
          </footer>

        </form>

      </div>

    </div>

  </main>

  <style>
    .admin-tab {
      min-height: 44px;
      border: 1px solid #cbd5e1;
      border-radius: 0.75rem;
      background: white;
      padding: 0.625rem 1rem;
      color: #334155;
      transition: all 180ms ease;
    }

    .admin-tab:hover {
      border-color: #60a5fa;
      background: #eff6ff;
      color: #1e3a8a;
    }

    .admin-tab.active {
      border-color: #1d4ed8;
      background: #1d4ed8;
      color: white;
    }

    .admin-input {
      display: block;
      width: 100%;
      min-height: 44px;
      border: 1px solid #cbd5e1;
      border-radius: 0.75rem;
      background: white;
      padding: 0.75rem 0.875rem;
      font-size: 0.875rem;
      color: #0f172a;
      outline: none;
    }

    .admin-input:focus {
      border-color: #2563eb;
      box-shadow: 0 0 0 3px rgb(37 99 235 / 12%);
    }

    .admin-label {
      display: block;
      margin-bottom: 0.5rem;
      font-size: 0.875rem;
      font-weight: 700;
      color: #1e293b;
    }

    .admin-button-primary {
      display: inline-flex;
      min-height: 44px;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      border-radius: 0.75rem;
      background: #1e40af;
      padding: 0.625rem 1.25rem;
      font-size: 0.875rem;
      font-weight: 700;
      color: white;
      transition: background 180ms ease;
    }

    .admin-button-primary:hover {
      background: #1e3a8a;
    }

    .admin-button-primary:disabled {
      cursor: not-allowed;
      opacity: 0.6;
    }

    .admin-button-secondary {
      display: inline-flex;
      min-height: 44px;
      align-items: center;
      justify-content: center;
      border: 1px solid #cbd5e1;
      border-radius: 0.75rem;
      background: white;
      padding: 0.625rem 1.25rem;
      font-size: 0.875rem;
      font-weight: 700;
      color: #334155;
    }

    .admin-button-secondary:hover {
      background: #f8fafc;
    }
  </style>

  <script define:vars={{ defaultProfil: profil }}>
  (async function initInformasiAdmin() {
    const PROFILE_KEY = 'timpik_profil_data';
    const ANNOUNCEMENT_KEY = 'timpik_pengumuman_list';
    const $ = (id) => document.getElementById(id);

    const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, char => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#39;'
    })[char]);

    const generateId = () => {
      return `pengumuman-${Date.now()}-${Math.random().toString(36).slice(2, 9)}`;
    };

    function normalizeStatus(status) {
      return status === 'draft' ? 'draf' : status;
    }

    function normalizeAnnouncement(item) {
      return {
        id: String(item.id || generateId()),
        kategori: String(item.kategori || 'Pemerintahan'),
        judul: String(item.judul || ''),
        ringkasan: String(item.ringkasan || ''),
        isi: String(item.isi || ''),
        tanggal: String(item.tanggal || ''),
        url: String(item.url || ''),
        label_tautan: String(item.label_tautan || ''),
        status: normalizeStatus(item.status) === 'terbit' ? 'terbit' : 'draf',
        prioritas: item.prioritas === 'penting' ? 'penting' : 'normal',
        dibuat_pada: item.dibuat_pada || new Date().toISOString(),
        diperbarui_pada: item.diperbarui_pada || item.dibuat_pada || new Date().toISOString()
      };
    }

    $('btn-close-global-notice').addEventListener('click', () => {
      $('notice-toast').classList.add('hidden');
    });

    function showProfileNotice(message) {
      $('notice-text').textContent = message;
      $('notice-toast').classList.remove('hidden');
      window.scrollTo({ top: 0, behavior: 'smooth' });

      if (typeof window.__timpikAdminToast === 'function') {
        window.__timpikAdminToast(message);
      }
    }

    function mergeProfileData(base, incoming) {
      const source = incoming && typeof incoming === 'object' && !Array.isArray(incoming)
        ? incoming
        : {};

      return {
        ...base,
        ...source,
        statistik: {
          ...(base?.statistik || {}),
          ...(source.statistik && typeof source.statistik === 'object' ? source.statistik : {})
        }
      };
    }

    async function loadInitialProfile() {
      let cachedProfile = {};

      try {
        const stored = localStorage.getItem(PROFILE_KEY);
        const parsed = stored ? JSON.parse(stored) : null;

        if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {
          cachedProfile = parsed;
        }
      } catch (error) {
        console.warn('Gagal membaca cache profil:', error);
      }

      const fallbackProfile = mergeProfileData(defaultProfil, cachedProfile);

      try {
        const response = await fetch('/api/content?key=profil', {
          method: 'GET',
          cache: 'no-store',
          credentials: 'same-origin',
          headers: {
            Accept: 'application/json'
          }
        });

        if (!response.ok) {
          throw new Error(`API profil mengembalikan status ${response.status}.`);
        }

        const result = await response.json();

        const remoteRecord = result?.content_key === 'profil'
          ? result
          : result?.contents?.profil;

        const remoteProfile = remoteRecord?.data && typeof remoteRecord.data === 'object'
          ? remoteRecord.data
          : remoteRecord;

        if (!remoteProfile || typeof remoteProfile !== 'object' || Array.isArray(remoteProfile)) {
          throw new Error('Respons API profil tidak memiliki objek data profil yang valid.');
        }

        const latestProfile = mergeProfileData(defaultProfil, remoteProfile);

        localStorage.setItem(PROFILE_KEY, JSON.stringify(latestProfile));

        return latestProfile;
      } catch (error) {
        console.error(
          'Gagal mengambil profil terbaru dari Supabase. Menggunakan cache sementara:',
          error
        );

        return fallbackProfile;
      }
    }

    let currentData = await loadInitialProfile();

    const tabDefinitions = [
      { btn: $('tab-btn-umum'), panel: $('panel-umum') },
      { btn: $('tab-btn-dusun'), panel: $('panel-dusun') },
      { btn: $('tab-btn-penduduk'), panel: $('panel-penduduk') },
      { btn: $('tab-btn-struktur'), panel: $('panel-struktur') },
      { btn: $('tab-btn-pengumuman'), panel: $('panel-pengumuman') }
    ];

    const profileActions = $('profile-save-actions');

    function activateTab(index) {
      tabDefinitions.forEach((tab, currentIndex) => {
        const active = index === currentIndex;

        tab.btn.classList.toggle('active', active);
        tab.btn.setAttribute('aria-selected', String(active));
        tab.btn.setAttribute('tabindex', active ? '0' : '-1');
        tab.panel.classList.toggle('hidden', !active);
      });

      profileActions.classList.toggle('hidden', index === 4);
    }

    tabDefinitions.forEach((tab, index) => {
      tab.btn.addEventListener('click', () => activateTab(index));

      tab.btn.addEventListener('keydown', event => {
        let next = index;

        if (event.key === 'ArrowRight') next = (index + 1) % tabDefinitions.length;
        else if (event.key === 'ArrowLeft') next = (index - 1 + tabDefinitions.length) % tabDefinitions.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = tabDefinitions.length - 1;
        else return;

        event.preventDefault();
        activateTab(next);
        tabDefinitions[next].btn.focus();
      });
    });

    const inVisi = $('input-visi');
    const inSejarahJudul = $('input-sejarah-judul');
    const inSejarah1 = $('input-sejarah-1');
    const inSejarah2 = $('input-sejarah-2');

    const inAlamat = $('input-alamat');
    const inTelepon = $('input-telepon');
    const inEmail = $('input-email');
    const inJam = $('input-jam');

    const inLk = $('input-lk');
    const inPm = $('input-pm');
    const inTotal = $('input-total');
    const inKk = $('input-kk');
    const inLuas = $('input-luas');

    const misiContainer = $('misi-list');
    const misiEmpty = $('misi-empty');

    inVisi.value = currentData.visi || '';

    inSejarahJudul.value =
      currentData.sejarah_judul || 'Desa Timpik, Kecamatan Susukan';

    inSejarah1.value =
      currentData.sejarah_paragraf_1 || '';

    inSejarah2.value =
      currentData.sejarah_paragraf_2 || '';

    inAlamat.value = currentData.alamat_kantor || '';
    inTelepon.value = currentData.telepon || '';
    inEmail.value = currentData.email || '';
    inJam.value = currentData.jam_layanan || '';

    let misiList = Array.isArray(currentData.misi)
      ? currentData.misi.map(item => {
          if (typeof item === 'string') return item;
          if (!item || typeof item !== 'object') return '';

          const detail = [
            item.deskripsi,
            ...(Array.isArray(item.poin) ? item.poin : [])
          ].filter(Boolean).join('; ');

          return [item.judul, detail].filter(Boolean).join(' — ');
        }).filter(Boolean)
      : [];

    function renderMisi() {
      misiEmpty.classList.toggle('hidden', misiList.length > 0);

      misiContainer.innerHTML = misiList.map((item, index) => `
        <div class="flex flex-col gap-2 rounded-xl border border-slate-200 bg-slate-50 p-3 sm:flex-row sm:items-center">
          <label class="flex-1">
            <span class="mb-1 block text-xs font-bold text-slate-700">Misi ${index + 1}</span>
            <input
              type="text"
              data-misi-index="${index}"
              maxlength="500"
              required
              value="${escapeHtml(item)}"
              class="admin-input"
              placeholder="Tuliskan misi desa"
            />
          </label>
          <button type="button" data-remove-misi="${index}" class="min-h-11 rounded-lg border border-rose-200 bg-white px-4 text-sm font-bold text-rose-700">
            Hapus
          </button>
        </div>
      `).join('');
    }

    $('btn-add-misi').addEventListener('click', () => {
      misiList.push('');
      renderMisi();
      misiContainer.lastElementChild?.querySelector('input')?.focus();
    });

    misiContainer.addEventListener('input', event => {
      const input = event.target.closest('[data-misi-index]');

      if (input) {
        misiList[Number(input.dataset.misiIndex)] = input.value;
      }
    });

    misiContainer.addEventListener('click', async event => {
      const button = event.target.closest('[data-remove-misi]');

      if (!button) return;

      const index = Number(button.dataset.removeMisi);

      if (!await window.__timpikAdminConfirm(
        'Hapus misi ini?',
        'Hapus misi'
      )) return;

      misiList.splice(index, 1);
      renderMisi();
    });

    renderMisi();

    const stats = currentData.statistik || {};

    inLk.value = String(stats.laki_laki ?? '').replace(/[^0-9]/g, '');
    inPm.value = String(stats.perempuan ?? '').replace(/[^0-9]/g, '');
    inKk.value = stats.total_kk || '';
    inLuas.value = stats.luas_wilayah || '';

    function formatNumber(value) {
      return String(value).replace(/\B(?=(\d{3})+(?!\d))/g, '.');
    }

    function calculateTotal() {
      const lk = parseInt(inLk.value.replace(/[^0-9]/g, ''), 10) || 0;
      const pm = parseInt(inPm.value.replace(/[^0-9]/g, ''), 10) || 0;

      if (!inLk.value.trim() && !inPm.value.trim()) {
        inTotal.value = '';
        $('total-calc-hint').textContent = 'Masukkan jumlah penduduk.';
        return;
      }

      const total = lk + pm;

      inTotal.value = `${formatNumber(total)} Jiwa`;

      $('total-calc-hint').textContent =
        `${formatNumber(lk)} + ${formatNumber(pm)} = ${formatNumber(total)} Jiwa`;
    }

    inLk.addEventListener('input', calculateTotal);
    inPm.addEventListener('input', calculateTotal);

    calculateTotal();

    const fotoPreview = $('preview-foto-struktur');
    const inFoto = $('input-foto');

    let fotoStruktur = currentData.foto_struktur || '/images/struktur-organisasi-timpik.jpg';

    fotoPreview.src = fotoStruktur;

    inFoto.addEventListener('change', event => {
      const file = event.target.files?.[0];

      if (!file) return;

      if (!['image/jpeg', 'image/png', 'image/webp'].includes(file.type)) {
        alert('Pilih gambar JPG, PNG, atau WebP.');
        inFoto.value = '';
        return;
      }

      if (file.size > 3 * 1024 * 1024) {
        alert('Ukuran gambar maksimal 3 MB.');
        inFoto.value = '';
        return;
      }

      const reader = new FileReader();

      reader.onload = () => {
        fotoStruktur = reader.result;
        fotoPreview.src = fotoStruktur;
      };

      reader.readAsDataURL(file);
    });

    $('btn-reset-foto').addEventListener('click', () => {
      fotoStruktur = '/images/struktur-organisasi-timpik.jpg';
      fotoPreview.src = fotoStruktur;
      inFoto.value = '';
    });

    async function persistProfil(updatedProfil) {
      if (typeof window.__timpikSaveAdminContent !== 'function') {
        throw new Error('Layanan penyimpanan server tidak tersedia.');
      }

      await window.__timpikSaveAdminContent(PROFILE_KEY, updatedProfil);

      currentData = updatedProfil;

      localStorage.setItem(PROFILE_KEY, JSON.stringify(updatedProfil));
    }

    let dusunList = Array.isArray(currentData.dusun)
      ? [...currentData.dusun]
      : [];

    const modalDusun = $('modal-dusun');
    const formDusun = $('form-edit-dusun');

    const dusunFields = {
      index: $('edit-dusun-index'),
      id: $('edit-dusun-id'),
      nama: $('edit-dusun-nama'),
      kadus: $('edit-dusun-kadus'),
      rt: $('edit-dusun-rt'),
      luas: $('edit-dusun-luas'),
      potensi: $('edit-dusun-potensi'),
      deskripsi: $('edit-dusun-deskripsi'),
      foto: $('edit-dusun-foto-file'),
      status: $('edit-dusun-foto-status'),
      preview: $('edit-dusun-foto-preview'),
      previewWrap: $('edit-dusun-foto-preview-wrap')
    };

    let editFoto = '';
    let pendingDusunImage = null;
    let dusunPhotoPreviewUrl = '';

    function showDusunPhoto(src) {
      if (dusunPhotoPreviewUrl) {
        URL.revokeObjectURL(dusunPhotoPreviewUrl);
        dusunPhotoPreviewUrl = '';
      }

      if (!src) {
        dusunFields.preview.removeAttribute('src');
        dusunFields.previewWrap.classList.add('hidden');
        return;
      }

      if (src.startsWith('blob:')) {
        dusunPhotoPreviewUrl = src;
      }

      dusunFields.preview.src = src;
      dusunFields.previewWrap.classList.remove('hidden');
    }

    function resetDusunPhoto() {
      editFoto = '';
      pendingDusunImage = null;
      dusunFields.foto.value = '';
      dusunFields.status.textContent = 'JPG, PNG, WebP, AVIF. Maksimal 4 MB.';
      showDusunPhoto('');
    }

    function renderDusunCards() {
      $('dusun-tab-count').textContent = dusunList.length;

      const container = $('dusun-card-list');

      if (!dusunList.length) {
        container.innerHTML = `
          <div class="col-span-full rounded-xl border border-dashed border-slate-300 bg-slate-50 p-8 text-center text-sm text-slate-500">
            Belum ada data dusun.
          </div>
        `;

        return;
      }

      container.innerHTML = dusunList.map((d, index) => `
        <article class="overflow-hidden rounded-xl border border-slate-200 bg-white">
          ${d.foto ? `
            <img
              src="${escapeHtml(d.foto)}"
              alt="${escapeHtml(d.nama)}"
              class="h-40 w-full bg-slate-100 object-cover"
              onerror="this.style.display='none'"
            />
          ` : ''}
          <div class="space-y-3 p-5">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span class="text-xs font-bold uppercase text-blue-700">
                ${escapeHtml(d.id)}
              </span>
              <span class="rounded-lg bg-blue-50 px-2 py-1 text-xs text-blue-800">
                ${escapeHtml(d.jumlah_rt || 'RT/RW belum diisi')}
              </span>
            </div>
            <div>
              <h3 class="font-bold text-slate-900">${escapeHtml(d.nama)}</h3>
              <p class="mt-1 text-xs text-slate-600">
                Kepala Dusun: ${escapeHtml(d.kepala_dusun || '-')}
              </p>
              <p class="mt-2 text-sm text-slate-600">
                ${escapeHtml(d.deskripsi || 'Belum ada deskripsi.')}
              </p>
              <p class="mt-2 text-xs font-semibold text-emerald-800">
                ${escapeHtml(d.potensi_utama || '')}
              </p>
            </div>
            <div class="flex justify-end gap-2 border-t border-slate-100 pt-3">
              <button type="button" data-dusun-edit="${index}" class="rounded-lg border border-slate-300 px-3 py-2 text-xs font-bold text-slate-700">
                Edit
              </button>
              <button type="button" data-dusun-delete="${index}" class="rounded-lg border border-rose-200 px-3 py-2 text-xs font-bold text-rose-700">
                Hapus
              </button>
            </div>
          </div>
        </article>
      `).join('');
    }

    renderDusunCards();

    $('dusun-card-list').addEventListener('click', event => {
      const editButton = event.target.closest('[data-dusun-edit]');
      const deleteButton = event.target.closest('[data-dusun-delete]');

      if (editButton) {
        openDusunEdit(Number(editButton.dataset.dusunEdit));
      }

      if (deleteButton) {
        deleteDusun(Number(deleteButton.dataset.dusunDelete));
      }
    });

    function openDusunModal() {
      modalDusun.classList.remove('hidden');
      modalDusun.classList.add('flex');
    }

    function closeDusunModal() {
      modalDusun.classList.add('hidden');
      modalDusun.classList.remove('flex');
      resetDusunPhoto();
    }

    function openDusunEdit(index) {
      const d = dusunList[index];

      if (!d) return;

      $('modal-dusun-title').textContent = 'Edit Data Dusun';

      dusunFields.index.value = index;
      dusunFields.id.value = d.id || '';
      dusunFields.nama.value = d.nama || '';
      dusunFields.kadus.value = d.kepala_dusun || '';
      dusunFields.rt.value = d.jumlah_rt || '';
      dusunFields.luas.value = d.luas || '';
      dusunFields.potensi.value = d.potensi_utama || '';
      dusunFields.deskripsi.value = d.deskripsi || '';

      editFoto = d.foto || '';
      pendingDusunImage = null;
      dusunFields.foto.value = '';

      dusunFields.status.textContent = 'Pilih foto baru jika ingin mengganti foto saat ini.';

      showDusunPhoto(editFoto);
      openDusunModal();
    }

    $('btn-tambah-dusun').addEventListener('click', () => {
      $('modal-dusun-title').textContent = 'Tambah Dusun Baru';

      Object.values(dusunFields).forEach(field => {
        if (field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement) {
          if (field.type !== 'file' && field.type !== 'hidden') {
            field.value = '';
          }
        }
      });

      dusunFields.index.value = '-1';

      resetDusunPhoto();
      openDusunModal();
    });

    $('close-modal-dusun').addEventListener('click', closeDusunModal);
    $('btn-batal-dusun').addEventListener('click', closeDusunModal);

    dusunFields.foto.addEventListener('change', () => {
      const file = dusunFields.foto.files?.[0];

      if (!file) return;

      if (!['image/jpeg', 'image/png', 'image/webp', 'image/avif'].includes(file.type)) {
        dusunFields.foto.value = '';
        dusunFields.status.textContent = 'Format gambar tidak didukung.';
        return;
      }

      if (file.size > 4 * 1024 * 1024) {
        dusunFields.foto.value = '';
        dusunFields.status.textContent = 'Ukuran gambar maksimal 4 MB.';
        return;
      }

      pendingDusunImage = file;

      dusunFields.status.textContent = `${file.name} dipilih.`;

      showDusunPhoto(URL.createObjectURL(file));
    });

    $('edit-dusun-foto-remove').addEventListener('click', resetDusunPhoto);

    async function uploadDusunPhoto(file) {
      const response = await fetch('/api/admin/berita-image?folder=dusun', {
        method: 'POST',
        headers: {
          'Content-Type': file.type
        },
        credentials: 'same-origin',
        body: file
      });

      const result = await response.json().catch(() => ({}));

      if (!response.ok) {
        throw new Error(result.error || 'Upload foto dusun gagal.');
      }

      if (!result.publicUrl) {
        throw new Error('Server tidak mengembalikan URL foto.');
      }

      return result.publicUrl;
    }

    async function deleteDusun(index) {
      const item = dusunList[index];

      if (!item) return;

      if (!await window.__timpikAdminConfirm(
        `Hapus data ${item.nama}?`,
        'Hapus dusun',
        'Ya, hapus'
      )) return;

      const previous = [...dusunList];

      dusunList = dusunList.filter((_, i) => i !== index);

      try {
        await persistProfil({
          ...currentData,
          dusun: dusunList
        });

        renderDusunCards();
        showProfileNotice('Data dusun berhasil dihapus.');
      } catch (error) {
        dusunList = previous;
        renderDusunCards();
        alert(error.message || 'Gagal menghapus dusun.');
      }
    }

    formDusun.addEventListener('submit', async event => {
      event.preventDefault();

      const saveButton = formDusun.querySelector('button[type="submit"]');

      if (saveButton.disabled) return;

      saveButton.disabled = true;
      saveButton.textContent = 'Menyimpan...';

      const previous = [...dusunList];

      try {
        const index = Number(dusunFields.index.value);

        const id = dusunFields.id.value.trim().toLowerCase()
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/(^-|-$)/g, '');

        if (!id) throw new Error('ID dusun wajib diisi.');

        if (dusunList.some((item, i) => i !== index && item.id === id)) {
          throw new Error('ID dusun sudah digunakan.');
        }

        let foto = editFoto;

        if (pendingDusunImage) {
          foto = await uploadDusunPhoto(pendingDusunImage);
        }

        const record = {
          id,
          nama: dusunFields.nama.value.trim(),
          panggilan: dusunFields.nama.value.replace(/dusun/i, '').trim(),
          kepala_dusun: dusunFields.kadus.value.trim(),
          jumlah_rt: dusunFields.rt.value.trim(),
          luas: dusunFields.luas.value.trim(),
          potensi_utama: dusunFields.potensi.value.trim(),
          deskripsi: dusunFields.deskripsi.value.trim(),
          foto
        };

        if (index >= 0 && index < dusunList.length) {
          dusunList[index] = record;
        } else {
          dusunList.push(record);
        }

        await persistProfil({
          ...currentData,
          dusun: dusunList
        });

        closeDusunModal();
        renderDusunCards();

        showProfileNotice('Data dusun berhasil disimpan.');
      } catch (error) {
        dusunList = previous;
        renderDusunCards();
        alert(error.message || 'Data dusun gagal disimpan.');
      } finally {
        saveButton.disabled = false;
        saveButton.textContent = 'Simpan Dusun';
      }
    });

    $('form-info').addEventListener('submit', async event => {
      event.preventDefault();

      const button = $('form-info').querySelector('button[type="submit"]');
      const label = button.querySelector('span');

      button.disabled = true;
      label.textContent = 'Menyimpan...';

      try {
        const lk = parseInt(inLk.value.replace(/[^0-9]/g, ''), 10) || 0;
        const pm = parseInt(inPm.value.replace(/[^0-9]/g, ''), 10) || 0;

        const updatedProfil = {
          ...currentData,
          visi: inVisi.value.trim(),
          misi: misiList.map(item => item.trim()).filter(Boolean),
          sejarah_judul: inSejarahJudul.value.trim(),
          sejarah_paragraf_1: inSejarah1.value.trim(),
          sejarah_paragraf_2: inSejarah2.value.trim(),
          alamat_kantor: inAlamat.value.trim(),
          telepon: inTelepon.value.trim(),
          email: inEmail.value.trim(),
          jam_layanan: inJam.value.trim(),
          foto_struktur: fotoStruktur,
          dusun: dusunList,
          statistik: {
            ...(currentData.statistik || {}),
            laki_laki: `${formatNumber(lk)} Jiwa`,
            perempuan: `${formatNumber(pm)} Jiwa`,
            total_penduduk: `${formatNumber(lk + pm)} Jiwa`,
            total_kk: inKk.value.trim(),
            luas_wilayah: inLuas.value.trim()
          }
        };

        await persistProfil(updatedProfil);

        showProfileNotice('Informasi profil desa berhasil diperbarui.');
      } catch (error) {
        alert(error.message || 'Gagal menyimpan profil.');
      } finally {
        button.disabled = false;
        label.textContent = 'Simpan Seluruh Pembaruan';
      }
    });

    const announcementList = $('pengumuman-list');
    const announcementModal = $('modal-pengumuman');
    const announcementForm = $('form-pengumuman');
    const announcementNotice = $('pengumuman-notice');
    const announcementSaveButton = $('btn-simpan-pengumuman');

    const announcementFields = {
      id: $('pengumuman-id'),
      judul: $('pengumuman-judul'),
      kategori: $('pengumuman-kategori'),
      tanggal: $('pengumuman-tanggal'),
      ringkasan: $('pengumuman-ringkasan'),
      isi: $('pengumuman-isi'),
      url: $('pengumuman-url'),
      label: $('pengumuman-label-link'),
      status: $('pengumuman-status'),
      prioritas: $('pengumuman-prioritas')
    };

    let announcementItems = [];
    let announcementSearch = '';
    let announcementFilter = 'semua';
    let announcementSaving = false;

    function showAnnouncementNotice(message, type = 'success') {
      const styles = {
        success: 'border-emerald-300 bg-emerald-50 text-emerald-900',
        error: 'border-rose-300 bg-rose-50 text-rose-900',
        warning: 'border-amber-300 bg-amber-50 text-amber-900'
      };

      announcementNotice.textContent = message;

      announcementNotice.className =
        `rounded-xl border p-4 text-sm font-semibold ${styles[type] || styles.success}`;

      announcementNotice.classList.remove('hidden');

      clearTimeout(showAnnouncementNotice.timer);

      showAnnouncementNotice.timer = setTimeout(() => {
        announcementNotice.classList.add('hidden');
      }, 5000);
    }

    function updateAnnouncementStats() {
      $('pengumuman-total').textContent = announcementItems.length;

      $('pengumuman-terbit').textContent =
        announcementItems.filter(item => item.status === 'terbit').length;

      $('pengumuman-draf').textContent =
        announcementItems.filter(item => item.status === 'draf').length;
    }

    function formatAnnouncementDate(value) {
      if (!value) return 'Tanggal belum ditentukan';

      const date = new Date(`${value}T00:00:00`);

      if (Number.isNaN(date.getTime())) return value;

      return new Intl.DateTimeFormat('id-ID', {
        day: 'numeric',
        month: 'long',
        year: 'numeric'
      }).format(date);
    }

    function renderAnnouncementList() {
      updateAnnouncementStats();

      const filtered = announcementItems
        .filter(item => {
          const searchContent = [
            item.judul,
            item.kategori,
            item.ringkasan,
            item.isi
          ].join(' ').toLowerCase();

          return searchContent.includes(announcementSearch) &&
            (announcementFilter === 'semua' || item.status === announcementFilter);
        })
        .sort((a, b) => {
          return String(b.tanggal || '').localeCompare(String(a.tanggal || ''));
        });

      if (!filtered.length) {
        announcementList.innerHTML = `
          <div class="rounded-xl border border-dashed border-slate-300 bg-slate-50 p-10 text-center">
            <p class="font-bold text-slate-800">Belum ada pengumuman</p>
            <p class="mt-1 text-xs text-slate-500">
              Gunakan tombol Tambah Pengumuman untuk membuat informasi baru.
            </p>
          </div>
        `;

        return;
      }

      announcementList.innerHTML = filtered.map(item => `
        <article class="rounded-xl border border-slate-200 bg-white p-4 transition hover:border-blue-200 hover:shadow-sm sm:p-5">
          <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-start">
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-center gap-2">
                <span class="rounded-lg bg-blue-50 px-2.5 py-1 text-[10px] font-bold uppercase text-blue-900">
                  ${escapeHtml(item.kategori)}
                </span>
                <span class="rounded-full px-2.5 py-1 text-[10px] font-bold ${
                  item.status === 'terbit'
                    ? 'bg-emerald-100 text-emerald-800'
                    : 'bg-amber-100 text-amber-900'
                }">
                  ${item.status === 'terbit' ? 'Terbit' : 'Draf'}
                </span>
                ${item.prioritas === 'penting' ? `
                  <span class="rounded-full bg-rose-100 px-2.5 py-1 text-[10px] font-bold text-rose-800">
                    Penting
                  </span>
                ` : ''}
              </div>
              <h3 class="mt-3 text-base font-extrabold text-slate-950">
                ${escapeHtml(item.judul)}
              </h3>
              <p class="mt-1 text-xs text-slate-400">
                ${escapeHtml(formatAnnouncementDate(item.tanggal))}
              </p>
              <p class="mt-3 line-clamp-2 text-sm leading-relaxed text-slate-600">
                ${escapeHtml(item.ringkasan)}
              </p>
            </div>
            <div class="flex shrink-0 flex-wrap gap-2">
              <button type="button" data-announcement-action="edit" data-id="${escapeHtml(item.id)}" class="min-h-9 rounded-lg border border-slate-300 px-3 py-2 text-xs font-bold text-slate-700 hover:bg-slate-50">
                Edit
              </button>
              <button type="button" data-announcement-action="toggle" data-id="${escapeHtml(item.id)}" class="min-h-9 rounded-lg border px-3 py-2 text-xs font-bold ${
                item.status === 'terbit'
                  ? 'border-amber-300 text-amber-800 hover:bg-amber-50'
                  : 'border-emerald-300 text-emerald-800 hover:bg-emerald-50'
              }">
                ${item.status === 'terbit' ? 'Jadikan Draf' : 'Terbitkan'}
              </button>
              <button type="button" data-announcement-action="delete" data-id="${escapeHtml(item.id)}" class="min-h-9 rounded-lg border border-rose-200 px-3 py-2 text-xs font-bold text-rose-700 hover:bg-rose-50">
                Hapus
              </button>
            </div>
          </div>
        </article>
      `).join('');
    }

    async function persistAnnouncementData() {
      if (typeof window.__timpikSaveAdminContent !== 'function') {
        throw new Error(
          'Layanan penyimpanan belum tersedia. Periksa AdminLayout.'
        );
      }

      const payload = announcementItems.map(normalizeAnnouncement);

      await window.__timpikSaveAdminContent(
        ANNOUNCEMENT_KEY,
        payload
      );

      announcementItems = payload;

      return true;
    }

    function getRemoteAnnouncements(data) {
      if (!data || typeof data !== 'object') return null;

      if (Array.isArray(data[ANNOUNCEMENT_KEY])) {
        return data[ANNOUNCEMENT_KEY];
      }

      if (Array.isArray(data.pengumuman)) {
        return data.pengumuman;
      }

      return null;
    }

    function loadInitialAnnouncements() {
      const remote = getRemoteAnnouncements(
        window.__timpikSupabaseContent
      );

      if (remote !== null) {
        announcementItems = remote.map(normalizeAnnouncement);
      } else {
        announcementItems = Array.isArray(defaultProfil.pengumuman)
          ? defaultProfil.pengumuman.map(normalizeAnnouncement)
          : [];
      }

      renderAnnouncementList();
    }

    function openAnnouncementModal(item = null) {
      announcementForm.reset();

      announcementFields.id.value = item?.id || '';
      announcementFields.judul.value = item?.judul || '';
      announcementFields.kategori.value = item?.kategori || 'Pemerintahan';
      announcementFields.tanggal.value = item?.tanggal || '';
      announcementFields.ringkasan.value = item?.ringkasan || '';
      announcementFields.isi.value = item?.isi || '';
      announcementFields.url.value = item?.url || '';
      announcementFields.label.value = item?.label_tautan || '';
      announcementFields.status.value = item?.status || 'draf';
      announcementFields.prioritas.value = item?.prioritas || 'normal';

      $('modal-pengumuman-title').textContent =
        item ? 'Edit Pengumuman' : 'Tambah Pengumuman';

      announcementSaveButton.textContent =
        item ? 'Simpan Perubahan' : 'Simpan Pengumuman';

      $('pengumuman-char-count').textContent =
        announcementFields.ringkasan.value.length;

      announcementModal.classList.remove('hidden');
      announcementModal.classList.add('flex');
      announcementModal.setAttribute('aria-hidden', 'false');

      document.body.classList.add('overflow-hidden');

      announcementFields.judul.focus();
    }

    function closeAnnouncementModal() {
      announcementModal.classList.add('hidden');
      announcementModal.classList.remove('flex');
      announcementModal.setAttribute('aria-hidden', 'true');

      document.body.classList.remove('overflow-hidden');
    }

    announcementForm.addEventListener('submit', async event => {
      event.preventDefault();

      if (announcementSaving) return;

      if (!announcementForm.reportValidity()) return;

      const url = announcementFields.url.value.trim();

      if (url && !url.startsWith('/') && !/^https?:\/\/\S+$/i.test(url)) {
        showAnnouncementNotice(
          'Tautan harus berupa halaman lokal atau URL HTTP/HTTPS.',
          'error'
        );

        return;
      }

      const id = announcementFields.id.value || generateId();

      const existingIndex = announcementItems.findIndex(
        item => String(item.id) === String(id)
      );

      const existing = existingIndex >= 0
        ? announcementItems[existingIndex]
        : null;

      const now = new Date().toISOString();

      const record = normalizeAnnouncement({
        id,
        judul: announcementFields.judul.value.trim(),
        kategori: announcementFields.kategori.value,
        tanggal: announcementFields.tanggal.value,
        ringkasan: announcementFields.ringkasan.value.trim(),
        isi: announcementFields.isi.value.trim(),
        url,
        label_tautan: announcementFields.label.value.trim(),
        status: announcementFields.status.value,
        prioritas: announcementFields.prioritas.value,
        dibuat_pada: existing?.dibuat_pada || now,
        diperbarui_pada: now
      });

      if (!record.judul || !record.ringkasan || !record.isi) {
        showAnnouncementNotice(
          'Judul, ringkasan, dan isi wajib diisi.',
          'error'
        );

        return;
      }

      const previous = announcementItems.map(item => ({ ...item }));

      announcementSaving = true;
      announcementSaveButton.disabled = true;
      announcementSaveButton.textContent = 'Menyimpan...';

      try {
        if (existingIndex >= 0) {
          announcementItems[existingIndex] = record;
        } else {
          announcementItems.unshift(record);
        }

        await persistAnnouncementData();

        closeAnnouncementModal();
        renderAnnouncementList();

        showAnnouncementNotice(
          existing
            ? 'Pengumuman berhasil diperbarui dan disimpan.'
            : 'Pengumuman berhasil ditambahkan dan disimpan.',
          'success'
        );
      } catch (error) {
        announcementItems = previous;
        renderAnnouncementList();

        showAnnouncementNotice(
          error.message || 'Pengumuman gagal disimpan.',
          'error'
        );
      } finally {
        announcementSaving = false;
        announcementSaveButton.disabled = false;
        announcementSaveButton.textContent = 'Simpan Pengumuman';
      }
    });

    announcementList.addEventListener('click', async event => {
      const button = event.target.closest('[data-announcement-action]');

      if (!button || announcementSaving) return;

      const id = button.dataset.id;

      const item = announcementItems.find(
        entry => String(entry.id) === String(id)
      );

      if (!item) return;

      const action = button.dataset.announcementAction;

      if (action === 'edit') {
        openAnnouncementModal(item);
        return;
      }

      if (action === 'delete') {
        const confirmDelete = await window.__timpikAdminConfirm(
          `Hapus pengumuman "${item.judul}"?`,
          'Hapus pengumuman',
          'Ya, hapus'
        );

        if (!confirmDelete) return;
      }

      const previous = announcementItems.map(entry => ({ ...entry }));

      announcementSaving = true;
      button.disabled = true;

      try {
        if (action === 'delete') {
          announcementItems = announcementItems.filter(
            entry => String(entry.id) !== String(id)
          );
        }

        if (action === 'toggle') {
          item.status = item.status === 'terbit' ? 'draf' : 'terbit';
          item.diperbarui_pada = new Date().toISOString();
        }

        await persistAnnouncementData();

        renderAnnouncementList();

        showAnnouncementNotice(
          action === 'delete'
            ? 'Pengumuman berhasil dihapus.'
            : item.status === 'terbit'
              ? 'Pengumuman berhasil diterbitkan.'
              : 'Pengumuman berhasil dijadikan draf.',
          'success'
        );
      } catch (error) {
        announcementItems = previous;
        renderAnnouncementList();

        showAnnouncementNotice(
          error.message || 'Perubahan pengumuman gagal disimpan.',
          'error'
        );
      } finally {
        announcementSaving = false;
      }
    });

    $('pengumuman-search').addEventListener('input', event => {
      announcementSearch = event.target.value.trim().toLowerCase();
      renderAnnouncementList();
    });

    $('pengumuman-filter').addEventListener('change', event => {
      announcementFilter = event.target.value;
      renderAnnouncementList();
    });

    announcementFields.ringkasan.addEventListener('input', () => {
      $('pengumuman-char-count').textContent =
        announcementFields.ringkasan.value.length;
    });

    $('btn-tambah-pengumuman').addEventListener('click', () => {
      openAnnouncementModal();
    });

    $('btn-close-pengumuman').addEventListener('click', closeAnnouncementModal);
    $('btn-batal-pengumuman').addEventListener('click', closeAnnouncementModal);

    announcementModal.addEventListener('click', event => {
      if (event.target === announcementModal) {
        closeAnnouncementModal();
      }
    });

    document.addEventListener('keydown', event => {
      if (
        event.key === 'Escape' &&
        !announcementModal.classList.contains('hidden')
      ) {
        closeAnnouncementModal();
      }
    });

    window.addEventListener('timpik-supabase-content', event => {
      const remote = getRemoteAnnouncements(event.detail);

      if (remote === null || announcementSaving) return;

      announcementItems = remote.map(normalizeAnnouncement);

      renderAnnouncementList();
    });

    loadInitialAnnouncements();

    $('btn-clear-all-profil').addEventListener('click', async event => {
      const confirmed = await window.__timpikAdminConfirm(
        'Kosongkan seluruh informasi profil, statistik, foto, visi-misi, dan data dusun? Pengumuman tidak akan ikut dihapus.',
        'Kosongkan informasi profil',
        'Ya, kosongkan'
      );

      if (!confirmed) return;

      const button = event.currentTarget;

      button.disabled = true;

      function emptyProfile(value) {
        if (Array.isArray(value)) return [];

        if (value && typeof value === 'object') {
          return Object.fromEntries(
            Object.entries(value).map(([key, nested]) => [
              key,
              emptyProfile(nested)
            ])
          );
        }

        return typeof value === 'string' ? '' : value;
      }

      try {
        const emptyData = emptyProfile(currentData);

        await window.__timpikSaveAdminContent(
          PROFILE_KEY,
          emptyData
        );

        localStorage.removeItem(PROFILE_KEY);

        window.location.reload();
      } catch (error) {
        alert(error.message || 'Data profil gagal dikosongkan.');
        button.disabled = false;
      }
    });
  })();
  </script>

</AdminLayout>
