            </div>

          </div>

          <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-2 border-t border-slate-100 pt-5">

            <button type="button" id="btn-batal-pengumuman" class="min-h-11 rounded-xl border border-slate-300 px-5 py-2.5 text-sm font-bold text-slate-700 hover:bg-slate-50">
              Batal
            </button>

            <button type="submit" id="btn-simpan-pengumuman" class="min-h-11 rounded-xl bg-blue-800 px-5 py-2.5 text-sm font-bold text-white hover:bg-blue-900">
              Simpan Pengumuman
