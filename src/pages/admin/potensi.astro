---
import AdminLayout from '../../layouts/AdminLayout.astro';
import defaultPotensi from '../../data/potensi.json';
---

<AdminLayout title="Kelola Potensi Desa & Budaya" activeMenu="potensi">
  <main class="mx-auto max-w-7xl space-y-7 pb-28">

    <!-- PAGE HEADER -->
    <header class="flex flex-col gap-5 border-b border-slate-200 pb-6 lg:flex-row lg:items-end lg:justify-between">
      <div class="space-y-2">
        <div class="flex items-center gap-2">
          <span class="size-2 rounded-full bg-emerald-500"></span>
          <span class="text-xs font-extrabold uppercase tracking-[0.18em] text-emerald-800">
            Manajemen Konten Desa
          </span>
        </div>

        <h1 class="text-2xl font-black tracking-tight text-slate-950 sm:text-3xl">
          Potensi Desa & Budaya
        </h1>

        <p class="max-w-2xl text-sm leading-6 text-slate-500">
          Kelola potensi agraris, komoditas unggulan, kesenian, dan warisan budaya Desa Timpik.
        </p>
      </div>

      <div class="flex flex-wrap gap-2">
        <button
          id="clear-potensi"
          type="button"
          class="inline-flex min-h-11 items-center justify-center gap-2 rounded-xl border border-rose-200 bg-white px-4 py-2.5 text-sm font-bold text-rose-700 transition hover:border-rose-300 hover:bg-rose-50"
        >
          <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M6 7h12m-10 0V5a1 1 0 011-1h6a1 1 0 011 1v2m2 0-.8 13H6.8L6 7m4 4v5m4-5v5"/>
          </svg>
          Kosongkan Data
        </button>

        <a
          href="/potensi"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-11 items-center justify-center gap-2 rounded-xl bg-slate-950 px-4 py-2.5 text-sm font-bold text-white transition hover:bg-slate-800"
        >
          Lihat Halaman Publik
          <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M14 5h5v5m-8 3 8-8M19 13v5a1 1 0 01-1 1H6a1 1 0 01-1-1V6a1 1 0 011-1h5"/>
          </svg>
        </a>
      </div>
    </header>

    <!-- NOTIFICATION -->
    <div
      id="potensi-admin-notice"
      role="status"
      aria-live="polite"
      class="hidden rounded-xl border p-4 text-sm font-semibold"
    ></div>

    <form id="potensi-admin-form" class="space-y-8">

      <!-- ==========================================
           SEKTOR AGRARIS
      =========================================== -->
      <section class="overflow-hidden rounded-3xl border border-emerald-200 bg-white shadow-sm">

        <!-- AGRARIS HEADER -->
        <div class="relative isolate overflow-hidden bg-gradient-to-br from-emerald-950 via-emerald-900 to-teal-800 px-5 py-7 text-white sm:px-8 sm:py-9">
          <div class="absolute -right-12 -top-20 -z-10 size-64 rounded-full border border-white/10"></div>
          <div class="absolute -right-2 -top-10 -z-10 size-44 rounded-full border border-white/10"></div>

          <div class="relative flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
            <div class="max-w-2xl space-y-3">
              <div class="inline-flex items-center gap-2 rounded-full border border-emerald-300/20 bg-white/10 px-3 py-1.5">
                <svg class="size-4 text-emerald-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 21c4.5-2.5 7-6 7-10.5V5l-7-2-7 2v5.5C5 15 7.5 18.5 12 21Z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 13c1-3 3-5 6-6m-5 9c0-2 1-4 4-6"/>
                </svg>
                <span class="text-[10px] font-extrabold uppercase tracking-[0.18em] text-emerald-100">
                  Sektor Unggulan Desa
                </span>
              </div>

              <div>
                <h2 class="text-2xl font-black tracking-tight sm:text-3xl">
                  Potensi Agraris
                </h2>

                <p class="mt-2 max-w-xl text-sm leading-6 text-emerald-100/85">
                  Gambaran sektor pertanian, sumber daya lahan, dan mata pencaharian masyarakat Desa Timpik.
                </p>
              </div>
            </div>

            <div class="hidden shrink-0 sm:block">
              <div class="flex size-20 items-center justify-center rounded-3xl border border-white/15 bg-white/10 shadow-inner backdrop-blur">
                <svg class="size-11 text-emerald-100" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 21c4.5-2.5 7-6 7-10.5V5l-7-2-7 2v5.5C5 15 7.5 18.5 12 21Z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 13c1-3 3-5 6-6m-5 9c0-2 1-4 4-6"/>
                </svg>
              </div>
            </div>
          </div>
        </div>

        <!-- AGRARIS CONTENT -->
        <div class="space-y-7 p-5 sm:p-8">

          <div class="flex items-start gap-3">
            <div class="flex size-9 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700">
              <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 5h16M4 12h16M4 19h16"/>
              </svg>
            </div>

            <div>
              <h3 class="text-base font-extrabold text-slate-950">
                Gambaran Umum Pertanian
              </h3>
              <p class="mt-1 text-xs leading-5 text-slate-500">
                Informasi utama yang menjelaskan karakteristik sektor agraris desa.
              </p>
            </div>
          </div>

          <div class="grid gap-5 lg:grid-cols-2">

            <!-- JUDUL -->
            <label class="space-y-2 lg:col-span-2">
              <span class="text-sm font-bold text-slate-800">
                Judul informasi
              </span>

              <input
                id="agraris-judul"
                data-agraris-field="judul"
                placeholder="Contoh: Potensi Pertanian Desa Timpik"
                class="min-h-12 w-full rounded-xl border border-slate-200 bg-slate-50/70 px-4 text-sm font-semibold text-slate-900 outline-none transition placeholder:font-normal placeholder:text-slate-400 hover:border-emerald-300 focus:border-emerald-600 focus:bg-white focus:ring-4 focus:ring-emerald-100"
              />

              <span class="text-xs text-slate-400">
                Judul yang akan ditampilkan pada halaman publik.
              </span>
            </label>

            <!-- DESKRIPSI -->
            <label class="space-y-2 lg:col-span-2">
              <span class="text-sm font-bold text-slate-800">
                Deskripsi sektor agraris
              </span>

              <textarea
                id="agraris-deskripsi"
                data-agraris-field="deskripsi"
                rows="5"
                placeholder="Jelaskan kondisi pertanian, karakteristik lahan, aktivitas petani, dan potensi pengembangan sektor agraris Desa Timpik..."
                class="w-full rounded-xl border border-slate-200 bg-slate-50/70 px-4 py-3 text-sm leading-7 text-slate-800 outline-none transition placeholder:text-slate-400 hover:border-emerald-300 focus:border-emerald-600 focus:bg-white focus:ring-4 focus:ring-emerald-100"
              ></textarea>

              <span class="text-xs text-slate-400">
                Gunakan deskripsi informatif yang menggambarkan kondisi pertanian desa.
              </span>
            </label>

            <!-- LUAS WILAYAH -->
            <label class="space-y-2">
              <span class="text-sm font-bold text-slate-800">
                Luas wilayah
              </span>

              <div class="relative">
                <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-emerald-700">
                  <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 7V4a1 1 0 011-1h3m10 0h3a1 1 0 011 1v3m0 10v3a1 1 0 01-1 1h-3M7 21H4a1 1 0 01-1-1v-3"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 8h8v8H8z"/>
                  </svg>
                </div>

                <input
                  id="agraris-luas"
                  data-agraris-field="luas_wilayah"
                  placeholder="Contoh: 189 Ha"
                  class="min-h-12 w-full rounded-xl border border-slate-200 bg-slate-50/70 py-2 pl-12 pr-4 text-sm font-semibold text-slate-900 outline-none transition placeholder:font-normal placeholder:text-slate-400 hover:border-emerald-300 focus:border-emerald-600 focus:bg-white focus:ring-4 focus:ring-emerald-100"
                />
              </div>

              <span class="text-xs text-slate-400">
                Masukkan luas lahan atau wilayah sesuai data desa.
              </span>
            </label>

            <!-- MATA PENCAHARIAN -->
            <label class="space-y-2">
              <span class="text-sm font-bold text-slate-800">
                Mata pencaharian utama
              </span>

              <div class="relative">
                <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-emerald-700">
                  <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 20h18M5 20V9l7-5 7 5v11M9 20v-6h6v6"/>
                  </svg>
                </div>

                <input
                  id="agraris-pekerjaan"
                  data-agraris-field="mayoritas_mata_pencaharian"
                  placeholder="Contoh: Petani"
                  class="min-h-12 w-full rounded-xl border border-slate-200 bg-slate-50/70 py-2 pl-12 pr-4 text-sm font-semibold text-slate-900 outline-none transition placeholder:font-normal placeholder:text-slate-400 hover:border-emerald-300 focus:border-emerald-600 focus:bg-white focus:ring-4 focus:ring-emerald-100"
                />
              </div>

              <span class="text-xs text-slate-400">
                Mata pencaharian yang paling dominan di masyarakat.
              </span>
            </label>
          </div>

          <!-- DIVIDER -->
          <div class="border-t border-slate-100"></div>

          <!-- KOMODITAS -->
          <div class="space-y-5">

            <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
              <div class="flex items-start gap-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-amber-50 text-amber-700">
                  <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 21V11m0 0c-5 0-8-3-8-7 5 0 8 3 8 7Zm0 0c0-4 3-7 8-7 0 4-3 7-8 7Z"/>
                  </svg>
                </div>

                <div>
                  <h3 class="text-base font-extrabold text-slate-950">
                    Komoditas Unggulan
                  </h3>

                  <p class="mt-1 text-xs leading-5 text-slate-500">
                    Kelola hasil pertanian dan komoditas yang menjadi potensi desa.
                  </p>
                </div>
              </div>

              <button
                type="button"
                id="add-komoditas"
                class="inline-flex min-h-11 items-center justify-center gap-2 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-2.5 text-sm font-bold text-emerald-800 transition hover:border-emerald-300 hover:bg-emerald-100"
              >
                <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v14m-7-7h14"/>
                </svg>
                Tambah Komoditas
              </button>
            </div>

            <div
              id="komoditas-list"
              class="grid gap-4 sm:grid-cols-2"
            ></div>
          </div>
        </div>
      </section>

      <!-- ==========================================
           SENI DAN BUDAYA
      =========================================== -->
      <section class="overflow-hidden rounded-3xl border border-purple-200 bg-white shadow-sm">

        <div class="flex flex-col gap-4 border-b border-purple-100 bg-gradient-to-r from-purple-50 via-white to-white p-5 sm:flex-row sm:items-center sm:justify-between sm:px-8 sm:py-6">
          <div class="flex items-center gap-3">
            <div class="flex size-12 shrink-0 items-center justify-center rounded-2xl bg-purple-100 text-purple-800">
              <svg class="size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M12 3v18m-6-14h12M6 7c-2 0-3 2-3 4s1 4 3 4h12c2 0 3-2 3-4s-1-4-3-4"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M8 15v3m8-3v3"/>
              </svg>
            </div>

            <div>
              <span class="text-[10px] font-extrabold uppercase tracking-[0.16em] text-purple-700">
                Identitas Lokal
              </span>

              <h2 class="mt-0.5 text-xl font-extrabold text-slate-950">
                Seni & Budaya
              </h2>

              <p class="mt-1 text-xs text-slate-500">
                Informasi warisan budaya dan tradisi masyarakat.
              </p>
            </div>
          </div>

          <span class="inline-flex w-fit items-center rounded-full border border-purple-200 bg-white px-3 py-1.5 text-xs font-bold text-purple-800">
            Pelestarian Budaya
          </span>
        </div>

        <div class="space-y-7 p-5 sm:p-8">

          <!-- INFORMASI BUDAYA -->
          <div class="space-y-4">
            <div class="flex items-center gap-2">
              <span class="size-1.5 rounded-full bg-purple-500"></span>
              <h3 class="text-sm font-extrabold text-slate-900">
                Gambaran Umum Budaya
              </h3>
            </div>

            <div class="grid gap-5">
              <label class="space-y-2">
                <span class="text-sm font-bold text-slate-800">
                  Judul bagian
                </span>

                <input
                  id="budaya-judul"
                  data-budaya-field="judul"
                  placeholder="Contoh: Warisan Seni dan Budaya Desa Timpik"
                  class="min-h-12 w-full rounded-xl border border-slate-200 bg-slate-50/70 px-4 text-sm font-semibold text-slate-900 outline-none transition placeholder:font-normal placeholder:text-slate-400 hover:border-purple-300 focus:border-purple-600 focus:bg-white focus:ring-4 focus:ring-purple-100"
                />
              </label>

              <label class="space-y-2">
                <span class="text-sm font-bold text-slate-800">
                  Deskripsi budaya
                </span>

                <textarea
                  id="budaya-deskripsi"
                  data-budaya-field="deskripsi"
                  rows="4"
                  placeholder="Jelaskan kesenian, tradisi, nilai budaya, dan kegiatan pelestarian budaya masyarakat Desa Timpik..."
                  class="w-full rounded-xl border border-slate-200 bg-slate-50/70 px-4 py-3 text-sm leading-7 text-slate-800 outline-none transition placeholder:text-slate-400 hover:border-purple-300 focus:border-purple-600 focus:bg-white focus:ring-4 focus:ring-purple-100"
                ></textarea>
              </label>
            </div>
          </div>

          <div class="border-t border-slate-100"></div>

          <!-- DAFTAR KESENIAN -->
          <div class="space-y-5">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
              <div class="flex items-start gap-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-purple-50 text-purple-700">
                  <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 19V5m0 14h16M8 15l3-4 3 3 5-7"/>
                  </svg>
                </div>

                <div>
                  <h3 class="text-base font-extrabold text-slate-950">
                    Daftar Kesenian & Tradisi
                  </h3>

                  <p class="mt-1 text-xs leading-5 text-slate-500">
                    Tambahkan kesenian, kelompok budaya, dan tradisi lokal.
                  </p>
                </div>
              </div>

              <button
                type="button"
                id="add-kesenian"
                class="inline-flex min-h-11 items-center justify-center gap-2 rounded-xl border border-purple-200 bg-purple-50 px-4 py-2.5 text-sm font-bold text-purple-800 transition hover:border-purple-300 hover:bg-purple-100"
              >
                <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v14m-7-7h14"/>
                </svg>
                Tambah Kesenian
              </button>
            </div>

            <div
              id="kesenian-list"
              class="space-y-4"
            ></div>
          </div>
        </div>
      </section>

      <!-- ==========================================
           SAVE ACTION
      =========================================== -->
      <div class="sticky bottom-4 z-30">
        <div class="flex flex-col gap-3 rounded-2xl border border-slate-200 bg-white/95 p-4 shadow-xl shadow-slate-900/10 backdrop-blur-xl sm:flex-row sm:items-center sm:justify-between sm:px-6">
          <div class="flex items-start gap-3">
            <div class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700">
              <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 12l4 4L19 6"/>
              </svg>
            </div>

            <div>
              <p class="text-sm font-extrabold text-slate-900">
                Perubahan Potensi Desa
              </p>
              <p class="mt-0.5 text-xs text-slate-500">
                Simpan untuk memperbarui informasi pada halaman publik.
              </p>
            </div>
          </div>

          <button
            id="save-potensi"
            type="submit"
            class="inline-flex min-h-12 items-center justify-center gap-2 rounded-xl bg-emerald-700 px-7 py-3 text-sm font-extrabold text-white shadow-lg shadow-emerald-900/10 transition hover:-translate-y-0.5 hover:bg-emerald-800 hover:shadow-emerald-900/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-700 focus-visible:ring-offset-2"
          >
            <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12l4 4L19 6"/>
            </svg>
            Simpan Perubahan
          </button>
        </div>
      </div>

    </form>
  </main>
</AdminLayout>

<script define:vars={{ defaultPotensi }}>
  const STORAGE_KEY = 'timpik_potensi_data';
  const deepCopy = (value) => JSON.parse(JSON.stringify(value));
  let potensiState = deepCopy(defaultPotensi);

  try {
    const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null');
    if (saved && typeof saved === 'object') {
      potensiState = {
        ...potensiState,
        ...saved,
        agraris: {
          ...potensiState.agraris,
          ...(saved.agraris || {}),
          komoditas_utama: Array.isArray(saved.agraris?.komoditas_utama) ? saved.agraris.komoditas_utama : potensiState.agraris.komoditas_utama,
        },
        kebudayaan: {
          ...potensiState.kebudayaan,
          ...(saved.kebudayaan || {}),
          kesenian: Array.isArray(saved.kebudayaan?.kesenian) ? saved.kebudayaan.kesenian : potensiState.kebudayaan.kesenian,
        },
      };
    }
  } catch (error) {
    console.warn('Data potensi tersimpan tidak dapat dibaca.', error);
  }

  const escapePotensiAdmin = (value) => String(value ?? '').replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char]);
  const komoditasList = document.getElementById('komoditas-list');
  const kesenianList = document.getElementById('kesenian-list');

  const setFieldValues = () => {
    document.querySelectorAll('[data-agraris-field]').forEach((field) => {
      field.value = potensiState.agraris[field.dataset.agrarisField] || '';
    });
    document.querySelectorAll('[data-budaya-field]').forEach((field) => {
      field.value = potensiState.kebudayaan[field.dataset.budayaField] || '';
    });
  };

  const renderKomoditas = () => {
    komoditasList.innerHTML = potensiState.agraris.komoditas_utama.length ? potensiState.agraris.komoditas_utama.map((item, index) => `
      <article class="rounded-xl border border-slate-200 bg-slate-50 p-4 sm:p-5">
        <div class="mb-3 flex items-center justify-between gap-3">
          <h3 class="font-bold text-slate-900">Komoditas ${index + 1}</h3>
          <button type="button" data-delete-komoditas="${index}" class="min-h-10 rounded-lg border border-rose-200 bg-rose-50 px-3 text-xs font-bold text-rose-800 hover:bg-rose-100">Hapus</button>
        </div>
        <label class="mb-3 block space-y-1.5"><span class="text-xs font-bold text-slate-700">Nama komoditas</span><input data-komoditas-index="${index}" data-field="nama" value="${escapePotensiAdmin(item.nama)}" class="min-h-10 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-950 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-200" /></label>
        <label class="mb-3 block space-y-1.5"><span class="text-xs font-bold text-slate-700">Deskripsi</span><textarea data-komoditas-index="${index}" data-field="deskripsi" rows="3" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm leading-5 text-slate-950 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-200">${escapePotensiAdmin(item.deskripsi)}</textarea></label>
        <label class="block space-y-1.5"><span class="text-xs font-bold text-slate-700">Kode ikon (opsional)</span><input data-komoditas-index="${index}" data-field="icon" value="${escapePotensiAdmin(item.icon)}" class="min-h-10 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-950 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-200" /></label>
      </article>
    `).join('') : '<p class="rounded-xl border border-dashed border-slate-300 p-6 text-center text-sm text-slate-600 lg:col-span-2">Belum ada komoditas. Tambahkan komoditas untuk ditampilkan.</p>';
  };

  const renderKesenian = () => {
    kesenianList.innerHTML = potensiState.kebudayaan.kesenian.length ? potensiState.kebudayaan.kesenian.map((item, index) => `
      <article class="rounded-xl border border-slate-200 bg-slate-50 p-4 sm:p-5">
        <div class="mb-3 flex items-center justify-between gap-3">
          <h3 class="font-bold text-slate-900">Kesenian / Tradisi ${index + 1}</h3>
          <button type="button" data-delete-kesenian="${index}" class="min-h-10 rounded-lg border border-rose-200 bg-rose-50 px-3 text-xs font-bold text-rose-800 hover:bg-rose-100">Hapus</button>
        </div>
        <label class="mb-3 block space-y-1.5"><span class="text-xs font-bold text-slate-700">Nama</span><input data-kesenian-index="${index}" data-field="nama" value="${escapePotensiAdmin(item.nama)}" class="min-h-10 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-950 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-200" /></label>
        <label class="mb-3 block space-y-1.5"><span class="text-xs font-bold text-slate-700">Lokasi</span><input data-kesenian-index="${index}" data-field="lokasi" value="${escapePotensiAdmin(item.lokasi)}" class="min-h-10 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-950 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-200" /></label>
        <label class="mb-3 block space-y-1.5"><span class="text-xs font-bold text-slate-700">Deskripsi</span><textarea data-kesenian-index="${index}" data-field="deskripsi" rows="3" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm leading-5 text-slate-950 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-200">${escapePotensiAdmin(item.deskripsi)}</textarea></label>
        <label class="block space-y-1.5"><span class="text-xs font-bold text-slate-700">Keunikan</span><textarea data-kesenian-index="${index}" data-field="keunikan" rows="2" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm leading-5 text-slate-950 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-200">${escapePotensiAdmin(item.keunikan)}</textarea></label>
      </article>
    `).join('') : '<p class="rounded-xl border border-dashed border-slate-300 p-6 text-center text-sm text-slate-600">Belum ada kesenian atau tradisi. Tambahkan data untuk ditampilkan.</p>';
  };

  setFieldValues();
  renderKomoditas();
  renderKesenian();

  document.querySelectorAll('[data-agraris-field]').forEach((field) => field.addEventListener('input', () => {
    potensiState.agraris[field.dataset.agrarisField] = field.value;
  }));
  document.querySelectorAll('[data-budaya-field]').forEach((field) => field.addEventListener('input', () => {
    potensiState.kebudayaan[field.dataset.budayaField] = field.value;
  }));

  komoditasList.addEventListener('input', (event) => {
    const field = event.target.closest('[data-komoditas-index]');
    if (field) potensiState.agraris.komoditas_utama[Number(field.dataset.komoditasIndex)][field.dataset.field] = field.value;
  });
  komoditasList.addEventListener('click', async (event) => {
    const button = event.target.closest('[data-delete-komoditas]');
    if (!button) return;
    const item = potensiState.agraris.komoditas_utama[Number(button.dataset.deleteKomoditas)];
    if (!(await window.__timpikAdminConfirm(`Hapus komoditas "${item?.nama || 'tanpa nama'}" dari daftar?`, 'Hapus komoditas'))) return;
    potensiState.agraris.komoditas_utama.splice(Number(button.dataset.deleteKomoditas), 1);
    renderKomoditas();
  });
  kesenianList.addEventListener('input', (event) => {
    const field = event.target.closest('[data-kesenian-index]');
    if (field) potensiState.kebudayaan.kesenian[Number(field.dataset.kesenianIndex)][field.dataset.field] = field.value;
  });
  kesenianList.addEventListener('click', async (event) => {
    const button = event.target.closest('[data-delete-kesenian]');
    if (!button) return;
    const item = potensiState.kebudayaan.kesenian[Number(button.dataset.deleteKesenian)];
    if (!(await window.__timpikAdminConfirm(`Hapus kesenian atau tradisi "${item?.nama || 'tanpa nama'}" dari daftar?`, 'Hapus kesenian'))) return;
    potensiState.kebudayaan.kesenian.splice(Number(button.dataset.deleteKesenian), 1);
    renderKesenian();
  });

  document.getElementById('add-komoditas').addEventListener('click', () => {
    potensiState.agraris.komoditas_utama.push({ nama: '', deskripsi: '', icon: '' });
    renderKomoditas();
    komoditasList.lastElementChild?.querySelector('input')?.focus();
    window.__timpikAdminToast('Komoditas ditambahkan. Simpan perubahan untuk menerbitkannya.');
  });
  document.getElementById('add-kesenian').addEventListener('click', () => {
    potensiState.kebudayaan.kesenian.push({ nama: '', lokasi: '', deskripsi: '', keunikan: '' });
    renderKesenian();
    kesenianList.lastElementChild?.querySelector('input')?.focus();
    window.__timpikAdminToast('Kesenian ditambahkan. Simpan perubahan untuk menerbitkannya.');
  });

  document.getElementById('clear-potensi').addEventListener('click', async () => {
    if (!(await window.__timpikAdminConfirm('Kosongkan seluruh data potensi agraris, komoditas, seni, dan budaya? Data akan dihapus dari halaman publik.', 'Kosongkan data potensi desa', 'Ya, kosongkan'))) return;
    const clearButton = document.getElementById('clear-potensi');
    const emptyPotensi = {
      agraris: { judul: '', deskripsi: '', luas_wilayah: '', mayoritas_mata_pencaharian: '', komoditas_utama: [] },
      kebudayaan: { judul: '', deskripsi: '', kesenian: [] },
    };
    clearButton.disabled = true;
    try {
      await (window).__timpikSaveAdminContent(STORAGE_KEY, emptyPotensi);
      window.location.reload();
    } catch (error) {
      const notice = document.getElementById('potensi-admin-notice');
      notice.textContent = error instanceof Error ? `Data gagal dikosongkan: ${error.message}` : 'Data gagal dikosongkan.';
      notice.className = 'rounded-xl border border-rose-300 bg-rose-50 p-4 text-sm font-semibold text-rose-950';
      notice.classList.remove('hidden');
      clearButton.disabled = false;
    }
  });

  document.getElementById('potensi-admin-form').addEventListener('submit', async (event) => {
    event.preventDefault();
    const saveButton = document.getElementById('save-potensi');
    const notice = document.getElementById('potensi-admin-notice');
    saveButton.disabled = true;
    saveButton.textContent = 'Menyimpan...';
    try {
      await (window).__timpikSaveAdminContent(STORAGE_KEY, potensiState);
      notice.textContent = 'Perubahan berhasil disimpan dan sudah diperbarui di halaman publik.';
      notice.className = 'rounded-xl border border-emerald-300 bg-emerald-50 p-4 text-sm font-semibold text-emerald-950';
      window.__timpikAdminToast('Potensi desa dan budaya berhasil disimpan.');
    } catch (error) {
      notice.textContent = error instanceof Error ? `Perubahan gagal disimpan: ${error.message}` : 'Perubahan gagal disimpan.';
      notice.className = 'rounded-xl border border-rose-300 bg-rose-50 p-4 text-sm font-semibold text-rose-950';
    } finally {
      notice.classList.remove('hidden');
      saveButton.disabled = false;
      saveButton.textContent = 'Simpan Perubahan';
    }
  });
</script>
