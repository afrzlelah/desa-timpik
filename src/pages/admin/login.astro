---
import "../../styles/global.css";
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Masuk Sesi &bull; Administrator Desa Timpik</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body
    class="bg-civic-navy text-slate-100 min-h-screen flex flex-col justify-between antialiased selection:bg-blue-600 selection:text-white font-sans"
  >
    <!-- Top Header Bar -->
    <header
      class="sticky top-0 z-50 w-full border-b border-blue-800 bg-blue-900 shadow-sm"
    >
      <div
        class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3.5 sm:px-6 lg:px-8"
      >
        <!-- Government Identity -->
        <div class="flex min-w-0 items-center gap-3 sm:gap-4">
          <!-- Logo -->
          <div
            class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg border border-blue-700 bg-blue-800 text-base font-bold tracking-tight text-white shadow-sm"
          >
            DT
          </div>

          <!-- Identity Information -->
          <div class="min-w-0">
            <span
              class="block truncate text-sm font-bold tracking-wide text-white sm:text-base"
            >
              Pemerintah Desa Timpik
            </span>

            <span
              class="mt-1 block truncate text-[10px] font-medium tracking-wide text-blue-200 sm:text-xs"
            >
              Kecamatan Susukan · Kabupaten Semarang
            </span>
          </div>
        </div>

        <!-- Public Website Navigation -->
        <a
          href="/"
          class="group inline-flex shrink-0 items-center gap-2 rounded-lg border border-blue-700 bg-blue-800/60 px-3 py-2 text-xs font-semibold text-blue-100 transition-all hover:border-blue-500 hover:bg-blue-700 hover:text-white sm:px-4 sm:py-2.5"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="transition-transform group-hover:-translate-x-0.5"
          >
            <path d="m15 18-6-6 6-6"></path>
            <path d="M20 12H9"></path>
          </svg>

          <span class="hidden sm:inline">Website Publik</span>
          <span class="sm:hidden">Kembali</span>
        </a>
      </div>
    </header>

    <main class="flex min-h-[75svh] w-full items-center justify-center bg-[#F3F6FB] px-4 py-8 sm:px-6 sm:py-12 lg:px-8">
      <!-- Login Card -->
      <div class="w-full min-w-0 max-w-md rounded-xl border border-slate-100 bg-white p-5 shadow-[0_8px_35px_rgba(15,23,42,0.06)] sm:p-7 md:p-9" >
        <!-- Header -->
        <div class="mb-6 sm:mb-7">
          <span class="mb-2 block text-[10px] font-bold uppercase tracking-[0.15em] text-blue-700 sm:text-xs">
            Portal Khusus Aparatur
          </span>

          <h1 class="text-xl font-bold tracking-tight text-slate-900 sm:text-2xl" >
            Login Administrator
          </h1>

          <p class="mt-2 text-sm leading-relaxed text-slate-500">
            Masuk untuk mengelola administrasi desa.
          </p>
        </div>

        <!-- Error -->
        <div
          id="login-error"
          role="alert"
          aria-live="polite"
          class="mb-4 hidden rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700"
        >
          Nama pengguna atau kata sandi tidak cocok.
        </div>

        <!-- Form -->
        <form id="form-login" class="space-y-4 sm:space-y-5">
          <!-- Username -->
          <div class="min-w-0">
            <label
              for="username"
              class="mb-2 block text-sm font-medium text-slate-700"
            >
              Nama Pengguna
            </label>

            <div class="relative">
              <span
                class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-slate-400"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle cx="12" cy="8" r="4"></circle>
                  <path d="M5 21v-2a7 7 0 0 1 14 0v2"></path>
                </svg>
              </span>

              <input
                type="text"
                id="username"
                value="admin"
                required
                autocomplete="username"
                class="h-12 w-full rounded-lg border border-slate-200 bg-white pl-10 pr-4 text-base text-slate-800 outline-none transition placeholder:text-slate-400 focus:border-blue-600 focus:ring-2 focus:ring-blue-100 sm:text-sm"
                placeholder="Masukkan username"
              />
            </div>
          </div>

          <!-- Password -->
          <div class="min-w-0">
            <label
              for="password"
              class="mb-2 block text-sm font-medium text-slate-700"
            >
              Kata Sandi
            </label>

            <div class="relative">
              <span
                class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-slate-400"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect x="3" y="11" width="18" height="11" rx="2"></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
              </span>

              <input
                type="password"
                id="password"
                required
                autocomplete="current-password"
                class="h-12 w-full rounded-lg border border-slate-200 bg-white pl-10 pr-4 text-base text-slate-800 outline-none transition placeholder:text-slate-400 focus:border-blue-600 focus:ring-2 focus:ring-blue-100 sm:text-sm"
                placeholder="Masukkan kata sandi"
              />
            </div>
          </div>

          <!-- Button -->
          <button
            type="submit"
            class="flex min-h-12 w-full items-center justify-center gap-2 rounded-lg bg-blue-900 px-4 py-3 text-sm font-semibold text-white transition hover:bg-blue-800 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-blue-200 active:bg-blue-950"
          >
            <span>Masuk ke Panel Admin</span>

            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="17"
              height="17"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </button>
        </form>

        <!-- Demo Credentials -->
        <div
          class="mt-6 rounded-lg border border-slate-100 bg-slate-50 p-3.5 sm:p-4"
        >
          <span
            class="mb-3 block text-[10px] font-bold uppercase tracking-wider text-slate-500"
          >
            Kredensial Uji Coba
          </span>

          <div
            class="flex items-center justify-between gap-3 text-xs sm:text-sm"
          >
            <span class="text-slate-600">Username</span>
            <strong class="font-mono text-slate-800">admin</strong>
          </div>

          <div
            class="mt-2 flex items-center justify-between gap-3 text-xs sm:text-sm"
          >
            <span class="text-slate-600">Password</span>
            <strong class="font-mono text-slate-800">admin123</strong>
          </div>
        </div>
      </div>
    </main>

    <!-- Footer -->
    <footer
      class="border-t border-civic-border/30 px-6 py-4 text-center text-xs font-mono text-slate-500"
    >
      &copy; {new Date().getFullYear()} Pemerintah Desa Timpik &bull; Sistem Administrasi
      Resmi
    </footer>

    <script>
      const form = document.getElementById("form-login") as HTMLFormElement;
      const userInput = document.getElementById("username") as HTMLInputElement;
      const passInput = document.getElementById("password") as HTMLInputElement;
      const errBox = document.getElementById("login-error");

      if (form) {
        form.addEventListener("submit", (e) => {
          e.preventDefault();
          const u = userInput ? userInput.value.trim().toLowerCase() : "";
          const p = passInput ? passInput.value.trim() : "";

          if (
            (u === "admin" || u === "timpik") &&
            (p === "admin123" || p === "123456" || p === "timpik2026")
          ) {
            sessionStorage.setItem(
              "timpik_admin_user",
              JSON.stringify({
                role: "Admin",
                name: "Administrator Desa Timpik",
                loginAt: new Date().toISOString(),
              }),
            );
            window.location.href = "/admin/dashboard";
          } else {
            if (errBox) errBox.classList.remove("hidden");
          }
        });
      }
    </script>
  </body>
</html>
