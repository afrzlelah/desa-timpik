---
import AdminLayout from '../../layouts/AdminLayout.astro';
import trackingData from '../../data/tracking.json';
import profilData from '../../data/profil.json';
---

<AdminLayout title="Dashboard Utama" activeMenu="dashboard">
  
  <div class="space-y-8 max-w-7xl mx-auto">
    
    <!-- Welcome Header Card (Clean Solid Deep Navy) -->
    <div class="bg-[#0B1E36] text-white p-6 sm:p-8 rounded-2xl border border-slate-800 shadow-sm flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div class="space-y-2">
        <span class="text-[10px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded bg-blue-900 text-blue-200 border border-blue-700/60">
          Pusat Kendali Pemerintahan Desa
        </span>
        <h1 class="text-2xl sm:text-3xl font-black tracking-tight">Portal Administrasi Desa Timpik</h1>
        <p class="text-xs sm:text-sm text-slate-300 max-w-2xl leading-relaxed">
          Kelola katalog dan link Google Form surat warga, publikasi portal berita kegiatan desa, serta jadwal agenda kalender kegiatan 4 dusun.
        </p>
      </div>

      <div class="shrink-0 flex flex-wrap gap-2">
        <a
          href="/admin/surat"
          class="px-3.5 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs shadow-sm transition-all flex items-center gap-1.5"
        >
          <span>Surat & GForm</span>
        </a>
        <a
          href="/admin/berita"
          class="px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs border border-slate-700 transition-all flex items-center gap-1.5"
        >
          <span>Berita Desa</span>
        </a>
        <a
          href="/admin/agenda"
          class="px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs border border-slate-700 transition-all flex items-center gap-1.5"
        >
          <span>Agenda</span>
        </a>
        <a
          href="/admin/apbdes"
          class="px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs border border-slate-700 transition-all flex items-center gap-1.5"
        >
          <span>APBDes</span>
        </a>
        <a
          href="/admin/kontak"
          class="px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs border border-slate-700 transition-all flex items-center gap-1.5"
        >
          <span>Kontak & Hotline</span>
        </a>
      </div>
    </div>

    <!-- 4 Indikator Statistik Kinerja Pelayanan -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
      
      <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Surat Masuk Hari Ini</span>
          <span class="w-8 h-8 rounded-lg bg-blue-50 text-blue-700 flex items-center justify-center font-bold text-xs">✉</span>
        </div>
        <h3 class="text-3xl font-black text-slate-900 mt-2">{trackingData.length}</h3>
        <p class="text-[11px] text-slate-500 mt-1">4 pengajuan dalam antrean</p>
      </div>

      <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Siap Diambil</span>
          <span class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-700 flex items-center justify-center font-bold text-xs">✓</span>
        </div>
        <h3 class="text-3xl font-black text-emerald-600 mt-2">1</h3>
        <p class="text-[11px] text-slate-500 mt-1">Sudah berstempel basah</p>
      </div>

      <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Aduan Warga</span>
          <span class="w-8 h-8 rounded-lg bg-blue-50 text-blue-700 flex items-center justify-center font-bold text-xs">⚡</span>
        </div>
        <h3 class="text-3xl font-black text-blue-700 mt-2">2</h3>
        <p class="text-[11px] text-slate-500 mt-1">1 butuh disposisi Kadus</p>
      </div>

      <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Biaya Pelayanan</span>
          <span class="w-8 h-8 rounded-lg bg-blue-50 text-blue-700 flex items-center justify-center font-bold text-xs">Rp</span>
        </div>
        <h3 class="text-3xl font-black text-slate-900 mt-2">Rp 0,-</h3>
        <p class="text-[11px] text-emerald-600 font-bold mt-1">100% Bebas Pungli</p>
      </div>

    </div>

    <!-- Quick Table: Surat Butuh Verifikasi Segera -->
    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="p-6 border-b border-slate-100 flex items-center justify-between">
        <div>
          <h2 class="text-base font-bold text-slate-900">Antrean Terkini Permohonan Surat Warga</h2>
          <p class="text-xs text-slate-500 mt-0.5">Sinkronisasi langsung dengan formulir Google Form warga Desa Timpik</p>
        </div>
        <a href="/admin/surat" class="text-xs font-bold text-blue-700 hover:text-blue-900">
          Lihat Semua &rarr;
        </a>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-50 text-slate-400 uppercase tracking-wider text-[10px] border-b border-slate-100">
            <tr>
              <th class="p-4">Tiket</th>
              <th class="p-4">Nama Pemohon</th>
              <th class="p-4">Jenis Surat</th>
              <th class="p-4">Dusun</th>
              <th class="p-4">Status</th>
              <th class="p-4 text-right">Aksi Cepat</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-slate-700 font-medium">
            {trackingData.map((item) => (
              <tr class="hover:bg-slate-50/80 transition-colors">
                <td class="p-4 font-mono font-bold text-blue-700">{item.id}</td>
                <td class="p-4 font-bold text-slate-900">{item.nama_pemohon_masked}</td>
                <td class="p-4">{item.jenis_surat}</td>
                <td class="p-4 text-slate-500">{item.dusun}</td>
                <td class="p-4">
                  <span class={`px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider ${
                    item.status === 'siap_diambil' ? 'bg-emerald-100 text-emerald-800' :
                    item.status === 'diproses' ? 'bg-blue-100 text-blue-800' :
                    item.status === 'verifikasi' ? 'bg-sky-100 text-sky-800' :
                    'bg-slate-100 text-slate-700'
                  }`}>
                    {item.status_label}
                  </span>
                </td>
                <td class="p-4 text-right">
                  <a
                    href={`/admin/surat`}
                    class="px-3 py-1.5 rounded-lg bg-blue-50 text-blue-700 hover:bg-blue-100 font-bold text-[11px] transition-colors"
                  >
                    Proses
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

  </div>

</AdminLayout>

