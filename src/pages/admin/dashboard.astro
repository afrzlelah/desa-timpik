---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Ringkasan" activeMenu="dashboard">
  <div class="mx-auto max-w-7xl space-y-6">
    <header><p class="text-sm font-semibold text-blue-800">PANEL DESA TIMPIK</p><h1 class="mt-1 text-2xl font-bold text-slate-950">Ringkasan admin</h1><p class="mt-1 text-base text-slate-600">Pilih informasi desa yang ingin dikelola.</p></header>
    <nav aria-label="Akses cepat" class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
      <a href="/admin/surat" class="glass-panel rounded-2xl p-6 transition hover:-translate-y-1 hover:shadow-lg"><span class="text-sm font-bold text-blue-900">LAYANAN</span><h2 class="mt-2 text-xl font-bold text-slate-950">Layanan surat</h2><p class="mt-2 text-sm text-slate-700">Kelola nama, keterangan, dan tautan formulir.</p><span class="mt-4 inline-block font-bold text-blue-900">Buka pengelolaan →</span></a>
      <a href="/admin/informasi" class="glass-panel rounded-2xl p-6 transition hover:-translate-y-1 hover:shadow-lg"><span class="text-sm font-bold text-blue-900">PROFIL</span><h2 class="mt-2 text-xl font-bold text-slate-950">Profil dan dusun</h2><p class="mt-2 text-sm text-slate-700">Kelola data wilayah, penduduk, visi, dan misi.</p><span class="mt-4 inline-block font-bold text-blue-900">Buka pengelolaan →</span></a>
      <a href="/admin/kontak" class="glass-panel rounded-2xl p-6 transition hover:-translate-y-1 hover:shadow-lg"><span class="text-sm font-bold text-blue-900">KONTAK</span><h2 class="mt-2 text-xl font-bold text-slate-950">Alamat dan kontak</h2><p class="mt-2 text-sm text-slate-700">Perbarui alamat kantor dan saluran pelayanan.</p><span class="mt-4 inline-block font-bold text-blue-900">Buka pengelolaan →</span></a>
      <a href="/admin/agenda" class="glass-panel rounded-2xl p-6 transition hover:-translate-y-1 hover:shadow-lg"><span class="text-sm font-bold text-blue-900">KEGIATAN</span><h2 class="mt-2 text-xl font-bold text-slate-950">Agenda desa</h2><p class="mt-2 text-sm text-slate-700">Tambah dan perbarui kegiatan warga.</p><span class="mt-4 inline-block font-bold text-blue-900">Buka pengelolaan →</span></a>
      <a href="/admin/berita" class="glass-panel rounded-2xl p-6 transition hover:-translate-y-1 hover:shadow-lg"><span class="text-sm font-bold text-blue-900">PUBLIKASI</span><h2 class="mt-2 text-xl font-bold text-slate-950">Berita desa</h2><p class="mt-2 text-sm text-slate-700">Kelola berita dan informasi untuk warga.</p><span class="mt-4 inline-block font-bold text-blue-900">Buka pengelolaan →</span></a>
    </nav>
  </div>
</AdminLayout>
