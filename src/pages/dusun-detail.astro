---
import Layout from '../layouts/Layout.astro';
import profilData from '../data/profil.json';
import beritaData from '../data/berita.json';
import kelembagaanData from '../data/kelembagaan.json';
---

<Layout
  title="Profil Dusun Desa Timpik"
  description="Informasi wilayah dusun di Desa Timpik, Kecamatan Susukan, Kabupaten Semarang."
>
  <main class="flex-grow bg-gray-100">
    <section class="bg-gradient-to-br from-blue-950 via-blue-900 to-blue-800 text-white">
      <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-12 lg:px-8">
        <nav class="mb-6 flex flex-wrap items-center gap-2 text-sm font-medium text-blue-100" aria-label="Breadcrumb">
          <a href="/" class="rounded hover:text-white focus:outline-none focus:ring-2 focus:ring-white">Beranda</a>
          <span aria-hidden="true">/</span>
          <a href="/profil#dusun" class="rounded hover:text-white focus:outline-none focus:ring-2 focus:ring-white">Daftar Dusun</a>
          <span aria-hidden="true">/</span>
          <span id="dusun-breadcrumb-name" class="font-semibold text-white">Profil Dusun</span>
        </nav>

        <div id="dusun-loading" class="py-8" role="status" aria-live="polite">
          <p class="text-lg font-semibold">Memuat informasi dusun...</p>
        </div>

        <div id="dusun-hero" class="hidden grid items-center gap-8 lg:grid-cols-2">
          <div class="max-w-2xl">
            <p class="inline-flex rounded-full border border-blue-300/40 bg-blue-950/40 px-3 py-1 text-sm font-semibold text-blue-100">Wilayah Desa Timpik</p>
            <h1 id="dusun-name" class="mt-4 text-3xl font-extrabold leading-tight text-white sm:text-4xl lg:text-5xl"></h1>
            <p id="dusun-description" class="mt-4 max-w-xl text-base leading-7 text-blue-50 sm:text-lg"></p>
            <div id="dusun-potensi-tags" class="mt-5 flex flex-wrap gap-2"></div>
          </div>
          <figure class="overflow-hidden rounded-2xl border border-white/20 bg-blue-950/40 shadow-xl">
            <img id="dusun-photo" src="/images/gapura-desa-timpik.jpg" alt="" class="h-60 w-full object-cover sm:h-80 lg:h-[22rem]" />
            <figcaption class="px-4 py-3 text-sm text-blue-100">Wilayah Desa Timpik</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <div id="dusun-body" class="hidden mx-auto max-w-7xl space-y-8 px-4 py-8 sm:px-6 sm:py-12 lg:px-8">
      <section id="dusun-facts" class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4" aria-label="Ringkasan dusun"></section>

      <section class="grid gap-6 lg:grid-cols-3">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7 lg:col-span-2">
          <p class="text-sm font-bold uppercase tracking-wide text-blue-800">Tentang wilayah</p>
          <h2 class="mt-1 text-xl font-bold text-slate-950">Mengenal dusun ini</h2>
          <p id="dusun-about" class="mt-4 whitespace-pre-line text-base leading-7 text-slate-700"></p>
        </div>
        <aside id="dusun-head-card" class="hidden rounded-2xl border border-blue-200 bg-blue-50 p-5 sm:p-7">
          <p class="text-sm font-bold uppercase tracking-wide text-blue-800">Perangkat wilayah</p>
          <h2 class="mt-1 text-xl font-bold text-slate-950">Kepala dusun</h2>
          <p id="dusun-head-name" class="mt-4 text-lg font-semibold text-slate-800"></p>
          <p class="mt-1 text-sm leading-6 text-slate-600">Pengelola wilayah dan penghubung warga dengan Pemerintah Desa.</p>
        </aside>
      </section>

      <!-- <section id="dusun-institutions-section" class="hidden rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7" aria-labelledby="dusun-institutions-title">
        <div class="flex flex-col gap-2 border-b border-slate-200 pb-4 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="text-sm font-bold uppercase tracking-wide text-blue-800">Layanan dan kelembagaan</p>
            <h2 id="dusun-institutions-title" class="mt-1 text-xl font-bold text-slate-950">Lembaga terkait</h2>
          </div>
        </div>
        <div id="dusun-institutions" class="mt-5 grid gap-4 md:grid-cols-2 lg:grid-cols-3"></div>
      </section> -->

      <section id="dusun-news-section" class="hidden rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7" aria-labelledby="dusun-news-title">
        <div class="border-b border-slate-200 pb-4">
          <p class="text-sm font-bold uppercase tracking-wide text-blue-800">Kabar wilayah</p>
          <h2 id="dusun-news-title" class="mt-1 text-xl font-bold text-slate-950">Berita terkait dusun</h2>
        </div>
        <div id="dusun-news" class="mt-5 grid gap-4 md:grid-cols-2 lg:grid-cols-3"></div>
      </section>

      <a href="/profil#dusun" class="inline-flex min-h-11 items-center rounded-xl border border-slate-300 bg-white px-5 py-2.5 font-bold text-slate-800 hover:border-blue-700 hover:text-blue-900 focus:outline-none focus:ring-2 focus:ring-blue-700">&larr; Kembali ke daftar dusun</a>
    </div>

    <section id="dusun-error" class="hidden mx-auto max-w-3xl px-4 py-16 text-center" role="alert">
      <h1 class="text-2xl font-bold text-slate-950">Informasi dusun tidak ditemukan</h1>
      <p id="dusun-error-message" class="mt-3 text-slate-700">Dusun mungkin sudah dihapus atau tautan tidak sesuai.</p>
      <a href="/profil#dusun" class="mt-6 inline-flex min-h-11 items-center rounded-xl bg-blue-900 px-5 py-2.5 font-bold text-white hover:bg-blue-950">Lihat daftar dusun</a>
    </section>
  </main>
</Layout>

<script is:inline define:vars={{ initialProfil: profilData, initialBerita: beritaData, initialKelembagaan: kelembagaanData }}>
  const escapeDusun = (value) => String(value ?? '').replace(/[&<>"']/g, (char) => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
  })[char]);

  const show = (id) => document.getElementById(id);

  function renderDusun(dusun, allNews, allInstitutions) {
    show('dusun-loading').classList.add('hidden');
    show('dusun-error').classList.add('hidden');
    show('dusun-hero').classList.remove('hidden');
    show('dusun-body').classList.remove('hidden');

    const name = dusun.nama || `Dusun ${dusun.panggilan || ''}`.trim();
    const description = dusun.deskripsi || `Informasi wilayah ${name} di Desa Timpik.`;
    document.title = `${name} | Profil Dusun Desa Timpik`;
    const canonicalUrl = new URL(`/dusun/${encodeURIComponent(dusun.id)}`, window.location.origin).href;
    const summary = String(description).replace(/\s+/g, ' ').trim().slice(0, 160);
    document.querySelector('meta[name="description"]')?.setAttribute('content', summary);
    document.querySelector('link[rel="canonical"]')?.setAttribute('href', canonicalUrl);
    document.querySelector('meta[property="og:url"]')?.setAttribute('content', canonicalUrl);
    document.querySelector('meta[property="og:title"]')?.setAttribute('content', `${name} | Profil Dusun Desa Timpik`);
    document.querySelector('meta[property="og:description"]')?.setAttribute('content', summary);
    document.querySelector('meta[name="twitter:title"]')?.setAttribute('content', `${name} | Profil Dusun Desa Timpik`);
    document.querySelector('meta[name="twitter:description"]')?.setAttribute('content', summary);
    let dusunSchema = document.getElementById('dusun-jsonld');
    if (!dusunSchema) {
      dusunSchema = document.createElement('script');
      dusunSchema.id = 'dusun-jsonld';
      dusunSchema.type = 'application/ld+json';
      document.head.append(dusunSchema);
    }
    dusunSchema.textContent = JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Place',
      '@id': canonicalUrl,
      name,
      description: summary,
      url: canonicalUrl,
      containedInPlace: {
        '@type': 'AdministrativeArea',
        name: 'Desa Timpik, Kecamatan Susukan, Kabupaten Semarang, Jawa Tengah',
      },
    }).replace(/</g, '\\u003c');
    show('dusun-breadcrumb-name').textContent = name;
    show('dusun-name').textContent = name;
    show('dusun-description').textContent = description;
    show('dusun-about').textContent = description;

    const photo = show('dusun-photo');
    const photoUrl = String(dusun.foto || dusun.gambar || '');
    photo.src = /^(https?:\/\/|\/)/i.test(photoUrl) ? photoUrl : '/images/gapura-desa-timpik.jpg';
    photo.alt = `Foto ${name}`;
    photo.onerror = () => { photo.src = '/images/gapura-desa-timpik.jpg'; };
    document.querySelector('meta[property="og:image"]')?.setAttribute('content', photo.src);
    document.querySelector('meta[name="twitter:image"]')?.setAttribute('content', photo.src);

    const potentials = String(dusun.potensi_utama || '').split(/[,;\n]/).map((item) => item.trim()).filter(Boolean);
    show('dusun-potensi-tags').innerHTML = potentials.map((item) => `<span class="rounded-full border border-white/30 bg-white/10 px-3 py-1 text-sm font-semibold text-white">${escapeDusun(item)}</span>`).join('');

    const facts = [
      ['Wilayah RT / RW', dusun.jumlah_rt],
      ['Luas wilayah', dusun.luas],
      ['Jumlah penduduk', dusun.jumlah_penduduk],
      ['Nama wilayah', dusun.panggilan],
    ].filter(([, value]) => String(value || '').trim());
    show('dusun-facts').innerHTML = facts.map(([label, value]) => `
      <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <p class="text-sm font-semibold text-slate-600">${escapeDusun(label)}</p>
        <p class="mt-2 text-xl font-bold text-slate-950">${escapeDusun(value)}</p>
      </article>
    `).join('');

    if (dusun.kepala_dusun) {
      show('dusun-head-name').textContent = dusun.kepala_dusun;
      show('dusun-head-card').classList.remove('hidden');
    }

    const relatedInstitutions = allInstitutions.filter((item) => item.dusun_terkait === dusun.id);
    if (relatedInstitutions.length) {
      show('dusun-institutions').innerHTML = relatedInstitutions.map((item) => `
        <a href="/kelembagaan/${encodeURIComponent(item.id)}" class="rounded-xl border border-slate-200 bg-gray-50 p-4 transition hover:border-blue-500 hover:bg-blue-50 focus:outline-none focus:ring-2 focus:ring-blue-700">
          <span class="text-xs font-bold uppercase tracking-wide text-blue-800">${escapeDusun(item.singkatan || item.kategori || 'Lembaga')}</span>
          <span class="mt-2 block text-base font-bold text-slate-950">${escapeDusun(item.nama)}</span>
          <span class="mt-2 block text-sm leading-6 text-slate-700">${escapeDusun(item.deskripsi || '')}</span>
        </a>
      `).join('');
      show('dusun-institutions-section').classList.remove('hidden');
    }

    const relatedNews = allNews.filter((item) => item.dusun_id === dusun.id || item.dusun?.id === dusun.id);
    if (relatedNews.length) {
      show('dusun-news').innerHTML = relatedNews.map((item) => `
        <article class="overflow-hidden rounded-xl border border-slate-200 bg-white">
          <img src="${escapeDusun(item.gambar || '/images/balai-desa-timpik.jpg')}" alt="${escapeDusun(item.judul)}" class="h-40 w-full object-cover bg-slate-100" onerror="this.src='/images/balai-desa-timpik.jpg'" />
          <div class="p-4">
            <p class="text-xs font-semibold text-blue-800">${escapeDusun(item.tanggal || item.kategori || 'Berita Desa')}</p>
            <a href="/berita/${encodeURIComponent(item.id)}" class="mt-2 block text-base font-bold leading-6 text-slate-950 hover:text-blue-800">${escapeDusun(item.judul)}</a>
            <p class="mt-2 text-sm leading-6 text-slate-700">${escapeDusun(item.ringkasan || '')}</p>
          </div>
        </article>
      `).join('');
      show('dusun-news-section').classList.remove('hidden');
    }
  }

  function showDusunError(message) {
    show('dusun-loading').classList.add('hidden');
    show('dusun-error-message').textContent = message;
    show('dusun-error').classList.remove('hidden');
  }

  async function loadDusun() {
    const pathMatch = window.location.pathname.match(/^\/dusun\/([^/]+)\/?$/);
    const id = new URLSearchParams(window.location.search).get('id') || (pathMatch ? decodeURIComponent(pathMatch[1]) : '');
    if (!id) return showDusunError('Alamat dusun tidak mencantumkan ID wilayah.');

    let profile = initialProfil;
    let news = initialBerita;
    let institutions = initialKelembagaan;
    try {
      const response = await fetch('/api/content?keys=profil,berita,kelembagaan', { cache: 'no-store' });
      if (response.ok) {
        const { contents = {} } = await response.json();
        if (contents.profil && Array.isArray(contents.profil.dusun)) profile = contents.profil;
        if (Array.isArray(contents.berita)) news = contents.berita;
        if (Array.isArray(contents.kelembagaan)) institutions = contents.kelembagaan;
      }
    } catch (error) {
      console.warn('Menggunakan data dusun bawaan karena Supabase belum dapat dimuat.', error);
    }

    const dusun = (profile.dusun || []).find((item) => String(item.id) === id);
    if (!dusun) return showDusunError('Dusun belum tersimpan di Supabase atau sudah dihapus.');
    renderDusun(dusun, news || [], institutions || []);
  }

  loadDusun();
</script>
