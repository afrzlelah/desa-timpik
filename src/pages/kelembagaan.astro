---
import Layout from '../layouts/Layout.astro';
import kelembagaanData from '../data/kelembagaan.json';
---

<Layout
  title="14 Kelembagaan Resmi Desa Timpik"
  description="Daftar lengkap 14 kelembagaan resmi masyarakat di Desa Timpik, Kecamatan Susukan, Kabupaten Semarang: BPD, PKK, LPMD, Karang Taruna, Gapoktan, P3A, BUMDes, Babinsa, dll."
>
  <!-- Architectural Civic Header -->
  <section class="bg-gradient-to-r from-black to-blue-900 text-white border-b border-civic-border/30 pt-14 pb-12 sm:pt-16 sm:pb-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs  uppercase tracking-wider text-slate-400 mb-5" aria-label="Breadcrumb">
        <a href="/" class="hover:text-blue-300 transition-colors">Beranda</a>
        <span class="text-slate-600">/</span>
        <span class="text-blue-300 font-bold">Kelembagaan Desa</span>
      </nav>

      <div class="max-w-3xl space-y-3">
        <div class="flex items-center gap-2.5">
        </div>
        
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-black tracking-tight text-white leading-tight">
          14 Kelembagaan Resmi Desa
        </h1>
        
        <!-- <p class="text-slate-300 text-sm sm:text-base leading-relaxed pt-1">
          Sinergi kelembagaan desa dalam mengawal pembangunan fisik jalan, pengairan sawah Gapoktan & P3A, pembinaan keluarga PKK, keamanan teritorial, hingga pelestarian kesenian wayang orang.
        </p> -->
      </div>

    </div>
  </section>

  <!-- Content Section -->
  <section class="py-14 sm:py-16 bg-civic-cream flex-grow">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        
        <!-- Papan Plang Foto Asli & Penjelasan Singkat (Sticky Panel) -->
        <div class="lg:col-span-4 lg:sticky lg:top-24 space-y-6">
          <div class="bg-white border border-civic-border p-5 shadow-xs">
            <!-- <span class="text-[10px]  uppercase tracking-widest text-blue-700 font-bold block mb-2">
              Dokumentasi Arsip Lapangan
            </span> -->
            <div class="border border-civic-border overflow-hidden mb-3">
              <img
                src="/images/kelembagaan-desa-timpik.jpg"
                alt="Plang Resmi 14 Kelembagaan Desa Timpik"
                class="w-full h-auto object-cover hover:scale-105 transition-transform duration-500"
              />
            </div>
            <h3 class=" font-bold text-civic-navy text-sm">Papan Totem Kelembagaan Resmi</h3>
            <p class="text-xs text-civic-muted mt-1 leading-relaxed font-sans">
              Daftar kelembagaan ini merupakan rujukan resmi yang terpasang di pelataran halaman Balai Desa Timpik, Kecamatan Susukan, Kabupaten Semarang.
            </p>
            <div class="mt-4 pt-3 border-t border-civic-border text-xs  text-civic-navy flex items-center justify-between">
              <span>Total Lembaga Aktif:</span>
              <strong class="font-bold">14 Lembaga</strong>
            </div>
          </div>

          <div class="border border-slate-700 bg-blue-900 text-white p-5 rounded-xl shadow-xs space-y-2">
            <h4 class=" font-bold text-sm text-white">Butuh Rekomendasi Lembaga?</h4>
            <p class="text-xs text-slate-300 leading-relaxed font-sans">
              Beberapa pengurusan surat desa (seperti surat keterangan usaha tani atau izin keramaian kesenian) membutuhkan pengantar kelembagaan terkait.
            </p>
            <a href="/layanan-surat" class="inline-block mt-2 px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white  text-xs uppercase tracking-wider font-bold transition-colors rounded-lg shadow-sm">
              Buka Layanan Surat &rarr;
            </a>
          </div>
        </div>

        <!-- 14 Lembaga Registry Directory -->
        <div class="lg:col-span-8 space-y-4">
          {kelembagaanData.map((lembaga, idx) => (
            <div class="bg-white border border-civic-border p-6 shadow-xs hover:border-blue-500 transition-all group">
              <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
                <div class="flex items-center gap-2.5">
                  <span class=" text-xs text-blue-700 font-bold">
                    {idx < 9 ? `0${idx + 1}` : idx + 1}
                  </span>
                  <span class="text-xs  uppercase tracking-wider px-2 py-0.5 border border-civic-border bg-civic-sand text-civic-navy font-bold">
                    {lembaga.singkatan}
                  </span>
                </div>
                <span class="text-xs  text-civic-muted">
                  {lembaga.kategori}
                </span>
              </div>

              <h2 class="text-base sm:text-lg  font-bold text-civic-navy group-hover:text-blue-700 transition-colors mt-1">
                <a href={`/kelembagaan/${lembaga.id}`}>
                  {lembaga.nama}
                </a>
              </h2>

              <p class="text-xs sm:text-sm text-civic-muted mt-2 leading-relaxed font-sans">
                {lembaga.deskripsi}
              </p>

              <!-- Fokus Kerja Tags & Link Detail -->
              <div class="mt-4 pt-3 border-t border-civic-border/60 flex flex-wrap items-center justify-between gap-3">
                <div class="flex flex-wrap items-center gap-1.5">
                  <span class="text-[10px]  uppercase text-civic-muted mr-1">Fokus:</span>
                  {lembaga.fokus.map((fokus) => (
                    <span class="text-[11px]  bg-civic-sand/40 text-civic-navy px-2 py-0.5 border border-civic-border">
                      {fokus}
                    </span>
                  ))}
                </div>
                <a
                  href={`/kelembagaan/${lembaga.id}`}
                  class="text-xs  font-bold text-blue-700 hover:text-blue-900 uppercase tracking-wider inline-flex items-center gap-1 group-hover:translate-x-1 transition-all"
                >
                  <span>Detail Lembaga &rarr;</span>
                </a>
              </div>
            </div>
          ))}
        </div>

      </div>

    </div>
  </section>
</Layout>
