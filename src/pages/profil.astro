---
import Layout from '../layouts/Layout.astro';
import profilData from '../data/profil.json';
---

<Layout
  title="Profil Wilayah & Pemerintahan Desa Timpik"
  description="Profil lengkap Desa Timpik, Kecamatan Susukan, Kabupaten Semarang: sejarah, visi misi, letak geografis, demografi, dan fasilitas balai desa."
>
  <!-- Architectural Civic Header -->
  <section class="bg-gradient-to-r from-black/90 to-blue-800 text-white border-b border-civic-border/30 pt-14 pb-12 sm:pt-16 sm:pb-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs uppercase tracking-wider text-slate-400 mb-5" aria-label="Breadcrumb">
        <a href="/" class="hover:text-blue-300 transition-colors">Beranda</a>
        <span class="text-slate-600">/</span>
        <span class="text-blue-300 font-bold">Profil Wilayah</span>
      </nav>

      <div class="max-w-3xl space-y-3">
        <div class="flex items-center gap-2.5">
          <span class="h-px w-6 bg-blue-400"></span>
          <span class="text-xs   uppercase tracking-widest text-blue-300 font-bold">Monografi & Identitas Kewilayahan</span>
        </div>
        
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-serif   font-black tracking-tight text-white leading-tight">
          Profil & Tata Kelola Desa Timpik
        </h1>
        
        <p class="text-slate-300 text-sm sm:text-base leading-relaxed pt-1">
          Mengenal bentang alam agraris seluas 243 Hektar di lereng Gunung Merbabu, sejarah gotong royong 4 dusun, serta arah visi misi pembangunan Desa Timpik, Kecamatan Susukan.
        </p>
      </div>

    </div>
  </section>

  <!-- Sejarah Singkat & Batas Wilayah -->
  <section id="sejarah" class="py-14 sm:py-16 bg-white border-b border-civic-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
        
        <div class="lg:col-span-7 space-y-6">
          <div class="border-b border-civic-border pb-3">
            <span class="text-[10px]   uppercase tracking-widest text-civic-gold block">Sejarah & Wilayah</span>
            <h2 class="text-2xl sm:text-3xl    font-black text-civic-navy mt-1">
              Bentang Alam Agraris di Kaki Merbabu
            </h2>
          </div>

          <p class="text-civic-ink text-sm sm:text-base leading-relaxed">
            <strong>Desa Timpik</strong> merupakan salah satu sentra ketahanan pangan agraris di wilayah Kecamatan Susukan, Kabupaten Semarang, Jawa Tengah. Membentang seluas kurang lebih <strong>243 Hektar (± 7,2 – 7,3 km²)</strong> dengan kontur perbukitan subur beriklim sejuk, desa ini dialiri jaringan irigasi terpadu yang bersumber dari mata air alami pegunungan.
          </p>

          <p class="text-civic-ink text-sm sm:text-base leading-relaxed">
            Secara sosio-kultural, masyarakat Desa Timpik merawat filosofi luhur <em>"Guyub Rukun Mbangun Desa"</em>. Kehidupan bertani bersanding erat dengan pelestarian seni budaya tradisional Jawa, seperti pagelaran Wayang Orang di Dusun Bogo dan kesenian Angguk di Dusun Sumber yang diwariskan turun-temurun antargenerasi.
          </p>

          <!-- Batas Wilayah Administratif Ledger -->
          <div class="border border-civic-border bg-civic-sand/20 mt-6">
            <div class="p-4 border-b border-civic-border bg-civic-sand/40">
              <span class="text-xs   uppercase tracking-widest text-civic-navy font-bold">
                Batas Wilayah Administratif
              </span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 divide-y sm:divide-y-0 sm:divide-x divide-civic-border text-xs">
              <div class="p-4 space-y-3">
                <div>
                  <span class="text-civic-muted   uppercase text-[10px] block">Sebelah Utara:</span>
                  <strong class="   text-sm text-civic-navy font-bold">Desa Kemetul & Kenteng</strong>
                </div>
                <div class="pt-2 border-t border-civic-border/60">
                  <span class="text-civic-muted   uppercase text-[10px] block">Sebelah Timur:</span>
                  <strong class="   text-sm text-civic-navy font-bold">Desa Ketapang & Koripan</strong>
                </div>
              </div>
              <div class="p-4 space-y-3">
                <div>
                  <span class="text-civic-muted   uppercase text-[10px] block">Sebelah Selatan:</span>
                  <strong class="   text-sm text-civic-navy font-bold">Kecamatan Kaliwungu</strong>
                </div>
                <div class="pt-2 border-t border-civic-border/60">
                  <span class="text-civic-muted   uppercase text-[10px] block">Sebelah Barat:</span>
                  <strong class="   text-sm text-civic-navy font-bold">Desa Badran & Bakalrejo</strong>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="lg:col-span-5 space-y-4">
          <div class="border border-civic-border bg-black overflow-hidden shadow-xs">
            <img
              src="/images/balai-desa-timpik.jpg"
              alt="Kantor Balai Desa Timpik"
              class="w-full h-auto object-cover"
            />
            <div class="p-4 bg-civic-navy text-white text-xs space-y-1">
              <p class="   font-bold text-xl text-white">Kompleks Balai Desa & Pendopo Pertemuan</p>
              <p class="text-slate-300 text-[11px] leading-relaxed">Pusat pelayanan administrasi kependudukan, musyawarah pembangunan desa (Musrenbangdes), dan pertemuan warga.</p>
            </div>
          </div>

          <div class="p-5 border border-civic-border bg-white text-xs space-y-2">
            <span class="text-[10px]   uppercase tracking-widest text-blue-700 font-bold block">Status Tata Praja</span>
            <div class="flex items-center justify-between text-civic-navy">
              <span>Klasifikasi Desa:</span>
              <strong class=" ">Swasembada / Agraris</strong>
            </div>
            <div class="flex items-center justify-between text-civic-navy">
              <span>Jumlah Dusun:</span>
              <strong class=" ">4 Wilayah Kadus</strong>
            </div>
            <div class="flex items-center justify-between text-civic-navy">
              <span>Kelembagaan Lembaga:</span>
              <strong class=" ">14 Lembaga Resmi</strong>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Visi & Misi Pembangunan -->
  <section id="visi-misi" class="py-14 sm:py-16 bg-civic-cream border-b border-civic-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      
      <div class="max-w-2xl">
        <div class="flex items-center gap-2 mb-2">
          <span class="h-px w-6 bg-blue-600"></span>
          <!-- <span class="text-xs   uppercase tracking-widest text-blue-700 font-bold">Rencana Pembangunan Jangka Menengah (RPJMDes)</span> -->
        </div>
        <h2 class="text-2xl sm:text-3xl    font-black text-civic-navy">
          Visi & Misi Pembangunan Desa
        </h2>
      </div>

      <!-- Visi Frame -->
      <div class="border border-civic-navy bg-white p-8 sm:p-10 shadow-xs relative">
        <span class="text-[10px]   uppercase tracking-widest px-2.5 py-1 bg-civic-navy text-white font-bold inline-block mb-3">
          Visi Resmi Desa Timpik
        </span>
        <blockquote class="text-xl sm:text-2xl lg:text-3xl    font-bold text-civic-navy italic leading-snug">
          "{profilData.visi}"
        </blockquote>
      </div>

      <!-- Misi Proclamation List -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {profilData.misi.map((misi, idx) => (
          <div class="bg-white border border-civic-border p-6 shadow-xs flex flex-col justify-between space-y-4">
            <span class="  text-2xl font-black text-blue-700">
              0{idx + 1}
            </span>
            <p class="text-xs sm:text-sm text-civic-ink leading-relaxed font-medium">
              {misi}
            </p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Wilayah 4 Dusun di Desa Timpik -->
  <section id="dusun" class="py-14 sm:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
          <span class="text-xs   uppercase tracking-widest text-blue-700 font-bold block mb-1">Struktur Kewilayahan</span>
          <h2 class="text-2xl sm:text-3xl    font-black text-civic-navy">Empat Dusun Naungan Desa Timpik</h2>
        </div>
     
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {profilData.dusun.map((dusun, idx) => (
          <a
            href={`/dusun/${dusun.id}`}
            class="group bg-white border border-civic-border hover:border-blue-500 p-6 shadow-xs flex flex-col justify-between transition-all"
          >
            <div>
              <div class="flex items-center justify-between pb-3 border-b border-civic-border/60 mb-3">
                <span class="text-[10px]   uppercase text-civic-muted font-bold">{dusun.jumlah_rt || 'RT/RW'}</span>
              </div>
              <h3 class="   font-bold text-lg text-civic-navy group-hover:text-blue-700 transition-colors">{dusun.nama}</h3>
              <p class="text-xs text-civic-muted mt-2 leading-relaxed line-clamp-3">{dusun.deskripsi}</p>
            </div>
            <div class="mt-6 pt-3 border-t border-civic-border flex items-center justify-between text-xs   font-bold text-blue-700">
              <span class="uppercase tracking-wider">Buka Profil Dusun</span>
              <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>
</Layout>
