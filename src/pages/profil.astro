---
import Layout from '../layouts/Layout.astro';
import profilData from '../data/profil.json';
---

<Layout
  title="Profil Wilayah & Visi Misi Desa Timpik"
  description="Profil lengkap Desa Timpik, Kecamatan Susukan, Kabupaten Semarang: sejarah, visi misi, kependudukan 5.696 jiwa, alamat kantor desa, dan struktur organisasi."
>
  <!-- Architectural Civic Header -->
  <section class="bg-gradient-to-br from-blue-950 via-blue-900 to-blue-700 text-white border-b border-white/20 pt-14 pb-12 sm:pt-16 sm:pb-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm uppercase tracking-wider text-slate-300 mb-5" aria-label="Breadcrumb">
        <a href="/" class="hover:text-blue-300 transition-colors">Beranda</a>
        <span class="text-slate-500">/</span>
        <span class="text-blue-300 font-bold">Profil Wilayah</span>
      </nav>

      <div class="max-w-3xl space-y-3">
        <div class="flex items-center gap-2.5">
          <span class="h-1 w-8 bg-blue-400 rounded-full"></span>
          <span class="text-sm font-bold uppercase tracking-widest text-blue-300">Monografi & Identitas Desa</span>
        </div>
        
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white leading-tight">
          Profil Desa Timpik
        </h1>
        
        <p class="text-slate-200 text-base sm:text-lg leading-relaxed pt-1">
          Mengenal bentang alam agraris seluas 243 Hektar di lereng Gunung Merbabu, sejarah gotong royong 13 dusun, serta arah visi misi pembangunan Desa Timpik, Kecamatan Susukan.
        </p>
      </div>

    </div>
  </section>

  <!-- Total Warga & Statistik Utama (Highlight LK: 2.848, PM: 2.848, Total: 5.696) -->
  <section class="py-10 bg-gray-100 border-b border-white/70">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="border-b border-slate-200 pb-4 mb-6">
        <span class="text-xs sm:text-sm font-bold uppercase tracking-widest text-blue-700 block mb-1">Data Resmi Kependudukan</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900">Demografi & Total Warga Desa</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        
        <!-- Total Warga -->
        <div class="glass-panel rounded-2xl p-6">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-500 block">Total Jumlah Warga</span>
          <div id="stat-total" class="text-3xl sm:text-4xl font-black text-blue-900 mt-2">
            {profilData.statistik.total_penduduk || '5.696 Jiwa'}
          </div>
          <span class="text-xs text-blue-700 font-semibold mt-1 block">Warga terdaftar di Desa Timpik</span>
        </div>

        <!-- Laki-laki -->
        <div class="glass-panel rounded-2xl p-6">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-500 block">Laki-Laki</span>
          <div id="stat-lk" class="text-3xl sm:text-4xl font-black text-slate-800 mt-2">
            {profilData.statistik.laki_laki || '2.848 Jiwa'}
          </div>
          <span class="text-xs text-slate-500 mt-1 block">Penduduk pria</span>
        </div>

        <!-- Perempuan -->
        <div class="glass-panel rounded-2xl p-6">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-500 block">Perempuan</span>
          <div id="stat-pm" class="text-3xl sm:text-4xl font-black text-slate-800 mt-2">
            {profilData.statistik.perempuan || '2.848 Jiwa'}
          </div>
          <span class="text-xs text-slate-500 mt-1 block">Penduduk wanita</span>
        </div>

        <!-- Luas Wilayah -->
        <div class="glass-panel rounded-2xl p-6">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-500 block">Luas Wilayah</span>
          <div id="stat-luas" class="text-3xl sm:text-4xl font-black text-emerald-800 mt-2">
            {profilData.statistik.luas_wilayah || '243 Ha'}
          </div>
          <span class="text-xs text-emerald-700 font-semibold mt-1 block">Mayoritas persawahan subur</span>
        </div>

      </div>
    </div>
  </section>

  <!-- Sejarah & Alamat Lengkap Kantor Desa -->
  <section id="sejarah" class="py-12 sm:py-16 bg-gray-100 border-b border-white/70">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
        
        <div class="lg:col-span-7 space-y-6">
          <div class="border-b border-slate-200 pb-3">
            <span class="text-xs sm:text-sm font-bold uppercase tracking-widest text-blue-700 block">Sejarah & Letak Geografis</span>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-1">
              Desa Timpik, Kecamatan Susukan
            </h2>
          </div>

          <p class="text-base sm:text-lg text-slate-700 leading-relaxed">
            Desa Timpik merupakan salah satu desa di wilayah Kecamatan Susukan, Kabupaten Semarang, Jawa Tengah. Dikelilingi panorama perbukitan di lereng Gunung Merbabu, wilayah ini dikenal sebagai pusat agraris yang subur serta lumbung pelestarian seni budaya Wayang Orang dan Angguk.
          </p>

          <p class="text-base sm:text-lg text-slate-700 leading-relaxed">
            Masyarakat Desa Timpik hidup rukun bergotong-royong yang tersebar di empat dusun utama: Dusun Timpik Krajan, Dusun Bogo, Dusun Sumber, dan Dusun Kencana.
          </p>

          <!-- Alamat Lengkap Kantor Desa -->
          <div class="rounded-2xl border border-blue-200 bg-blue-50/60 p-6 space-y-3">
            <span class="text-xs font-bold uppercase tracking-wider text-blue-800 block">Alamat Lengkap Kantor Balai Desa:</span>
            <p id="profil-alamat" class="text-base sm:text-lg font-bold text-slate-900 leading-relaxed">
              {profilData.alamat_kantor || 'Jl. Raya Balai Desa Timpik, Kec. Susukan, Kab. Semarang, Jawa Tengah 50774'}
            </p>
            <div class="pt-3 border-t border-blue-200/60 flex flex-wrap gap-4 text-sm text-slate-700">
              <span id="profil-jam"><strong>Jam Buka:</strong> {profilData.jam_layanan || 'Senin - Kamis: 08.00 - 15.00 WIB | Jumat: 08.00 - 11.30 WIB'}</span>
              <span id="profil-telepon"><strong>Hotline:</strong> {profilData.telepon || '6285166439180'}</span>
            </div>
          </div>
        </div>

        <div class="lg:col-span-5 space-y-4">
          <div class="rounded-2xl border border-slate-200 overflow-hidden shadow-sm bg-white">
            <img
              src="/images/balai-desa-timpik.jpg"
              alt="Kantor Balai Desa Timpik"
              class="w-full h-auto object-cover max-h-[320px]"
            />
            <div class="p-5 bg-slate-900 text-white space-y-1">
              <p class="font-bold text-lg text-white">Kompleks Balai Desa & Pendopo Pertemuan</p>
              <p class="text-slate-300 text-xs sm:text-sm leading-relaxed">Pusat pelayanan administrasi kependudukan dan musyawarah warga.</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Visi & Misi Pembangunan Desa -->
  <section id="visi-misi" class="py-14 sm:py-16 bg-gray-100 border-b border-white/70">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">

      <!-- Section Header -->
      <div class="border-b border-slate-200 pb-4">
        <span class="text-xs sm:text-sm font-bold uppercase tracking-widest text-blue-700 block mb-1">
          Arah Pembangunan Desa
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900">
          Visi & Misi Desa Timpik
        </h2>
        <p class="text-sm sm:text-base text-slate-600 mt-1">
          Pedoman pelaksanaan pemerintahan dan pembangunan kemasyarakatan.
        </p>
      </div>

      <!-- Visi -->
      <div class="glass-panel-blue rounded-2xl p-8 sm:p-10 text-white relative overflow-hidden">
        <div class="absolute -right-10 -top-10 w-48 h-48 rounded-full bg-white/10"></div>

        <div class="relative z-10">
          <span class="text-xs font-bold uppercase tracking-widest px-3 py-1.5 bg-white/15 text-white rounded-full inline-block mb-5">
            Visi Resmi Desa Timpik
          </span>

          <blockquote id="profil-visi" class="text-xl sm:text-2xl lg:text-3xl font-extrabold text-white leading-snug max-w-4xl">
            "{profilData.visi}"
          </blockquote>
        </div>
      </div>

      <!-- Misi -->
      <div class="space-y-5">
        <div>
          <span class="text-xs font-bold uppercase tracking-widest text-blue-700">
            Arah Kebijakan
          </span>
          <h3 class="text-xl sm:text-2xl font-extrabold text-slate-900 mt-1">
            Misi Pembangunan Desa
          </h3>
          <p class="text-sm text-slate-600 mt-1">
            Empat misi utama Pemerintah Desa Timpik dalam mewujudkan visi pembangunan desa.
          </p>
        </div>

        <div id="profil-misi" class="grid grid-cols-1 md:grid-cols-2 gap-5">

          {profilData.misi.map((misi) => (
            <article class="glass-panel rounded-2xl p-6 sm:p-7 flex flex-col gap-4">

              <!-- Kode dan Judul -->
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 shrink-0 rounded-xl bg-blue-700 text-white flex items-center justify-center text-xl font-black">
                  {misi.kode}
                </div>

                <div class="pt-1">
                  <h4 class="text-base sm:text-lg font-extrabold text-slate-900 leading-snug">
                    {misi.judul}
                  </h4>
                </div>
              </div>

              <!-- Deskripsi -->
              <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
                {misi.deskripsi}
              </p>

              <!-- Subpoin -->
              {misi.poin && misi.poin.length > 0 && (
                <div class="space-y-3 border-t border-slate-200 pt-4">
                  {misi.poin.map((poin, index) => (
                    <div class="flex items-start gap-3">
                      <span class="w-6 h-6 shrink-0 rounded-full bg-blue-50 text-blue-700 flex items-center justify-center text-xs font-bold">
                        {index + 1}
                      </span>

                      <p class="text-sm text-slate-700 leading-relaxed font-medium">
                        {poin}
                      </p>
                    </div>
                  ))}
                </div>
              )}

            </article>
          ))}

        </div>
      </div>

    </div>
  </section>
  <!-- Wilayah 4 Dusun di Desa Timpik -->
  <section id="dusun" class="py-14 sm:py-16 bg-gray-100 border-b border-white/70">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      
      <div class="border-b border-slate-200 pb-4">
        <span class="text-xs sm:text-sm font-bold uppercase tracking-widest text-blue-700 block mb-1">Struktur Kewilayahan</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900">Dusun di Desa Timpik</h2>
        <p class="text-sm sm:text-base text-slate-600 mt-1">Informasi wilayah, potensi, dan kepala dusun yang bertugas.</p>
      </div>

      <div id="profil-dusun-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {profilData.dusun.map((dusun) => (
          <a
            href={`/dusun/${dusun.id}`}
            class="glass-panel group overflow-hidden rounded-2xl hover:border-blue-500 hover:-translate-y-1 hover:shadow-lg flex flex-col justify-between transition-all"
          >
            {dusun.foto ? (
              <img src={dusun.foto} alt={`Foto ${dusun.nama}`} class="h-40 w-full object-cover bg-slate-200" loading="lazy" />
            ) : (
              <div class="flex h-40 items-center justify-center bg-gradient-to-br from-blue-100 to-slate-200 text-sm font-semibold text-slate-600">Foto dusun belum tersedia</div>
            )}
            <div class="flex flex-1 flex-col justify-between p-5 sm:p-6">
            <div>
              <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-3">
                <span class="text-xs font-bold text-blue-700 px-2 py-0.5 rounded bg-blue-50 border border-blue-100">
                  {dusun.panggilan || 'Wilayah Desa Timpik'}
                </span>
                <span class="text-xs text-slate-500">Desa Timpik</span>
              </div>

              <h3 class="font-extrabold text-lg sm:text-xl text-slate-900 group-hover:text-blue-700 transition-colors">
                {dusun.nama}
              </h3>

              <p class="text-xs sm:text-sm text-slate-600 mt-3 leading-relaxed line-clamp-3">
                {dusun.deskripsi || 'Informasi wilayah belum tersedia.'}
              </p>
            </div>
            <div class="mt-6 pt-3 border-t border-slate-100 flex items-center justify-between text-xs sm:text-sm font-bold text-blue-700">
              <span class="uppercase tracking-wider">Buka Informasi Dusun</span>
              <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
            </div>
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>

  <!-- Struktur Organisasi Desa (Berdasarkan Arahan: Diambil dari Foto Saja) -->
  <section id="struktur-organisasi" class="py-14 sm:py-16 bg-gray-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      
      <div class="border-b border-slate-200 pb-4">
        <span class="text-xs sm:text-sm font-bold uppercase tracking-widest text-blue-700 block mb-1">
          Bagan Resmi
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900">
          Struktur Organisasi Pemerintahan Desa
        </h2>
        <p class="text-sm sm:text-base text-slate-600 mt-1">
          Bagan kepengurusan perangkat desa ditampilkan langsung dari foto resmi Pemerintah Desa Timpik.
        </p>
      </div>

      <div class="rounded-2xl border border-slate-200 bg-white p-4 sm:p-6 shadow-sm space-y-4">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100 flex-wrap gap-2">
          <span class="text-xs sm:text-sm font-bold text-slate-700">Foto Dokumen Bagan Resmi SOTK</span>
          <button
            type="button"
            id="profil-btn-lightbox"
            class="inline-flex min-h-[40px] items-center gap-2 px-4 py-2 rounded-xl bg-blue-50 text-blue-900 hover:bg-blue-100 text-sm font-bold transition-colors border border-blue-200 shadow-2xs"
          >
            <svg class="w-4 h-4 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7"/></svg>
            <span>Klik untuk Perbesar Foto</span>
          </button>
        </div>

        <div class="rounded-xl overflow-hidden bg-slate-50 border border-slate-200 p-2 cursor-zoom-in flex items-center justify-center min-h-[350px]" id="profil-container-click">
          <img
            id="profil-foto-struktur"
            src="/images/struktur-organisasi-timpik.jpg"
            alt="Struktur Organisasi Pemerintah Desa Timpik"
            class="w-full h-auto max-h-[700px] object-contain rounded-lg mx-auto transition-transform hover:scale-[1.01]"
            loading="lazy"
            onerror="this.src='/images/balai-desa-timpik.jpg'"
          />
        </div>
      </div>

    </div>
  </section>

  <!-- Lightbox Modal Fullscreen untuk Profil -->
  <div id="profil-lightbox-modal" class="fixed inset-0 z-50 hidden bg-slate-950/90 backdrop-blur-md flex flex-col p-4 sm:p-6 overflow-hidden">
    <div class="flex items-center justify-between pb-3 text-white border-b border-white/20">
      <span class="text-sm sm:text-base font-bold">Bagan Struktur Organisasi Pemerintah Desa Timpik</span>
      <button
        type="button"
        id="profil-btn-close-lightbox"
        class="min-h-[44px] min-w-[44px] flex items-center justify-center rounded-xl bg-white/20 hover:bg-white/30 text-white font-bold text-lg transition-colors"
        aria-label="Tutup Pratinjau"
      >
        &times;
      </button>
    </div>
    <div class="flex-grow overflow-auto flex items-center justify-center p-2">
      <img
        id="profil-lightbox-img"
        src="/images/struktur-organisasi-timpik.jpg"
        alt="Struktur Organisasi Fullscreen"
        class="max-w-none w-auto max-h-[88vh] object-contain rounded-xl shadow-2xl transition-transform"
      />
    </div>
  </div>

</Layout>

<script is:inline define:vars={{ defaultProfil: profilData }}>
  (() => {
    const STORAGE_KEY = 'timpik_profil_data';

    let data = defaultProfil;

    // ==========================================
    // LOAD DATA LOCAL STORAGE
    // ==========================================
    try {
      const stored = localStorage.getItem(STORAGE_KEY);

      if (stored) {
        const parsed = JSON.parse(stored);

        if (parsed && typeof parsed === 'object') {
          data = {
            ...defaultProfil,
            ...parsed,

            statistik: {
              ...defaultProfil.statistik,
              ...(parsed.statistik || {})
            },

            sosial_media: {
              ...defaultProfil.sosial_media,
              ...(parsed.sosial_media || {})
            },

            transparansi_apbdes: {
              ...defaultProfil.transparansi_apbdes,
              ...(parsed.transparansi_apbdes || {})
            }
          };
        }
      }
    } catch (error) {
      console.error('Gagal membaca data profil:', error);
      data = defaultProfil;
    }

    // ==========================================
    // HELPER ESCAPE HTML
    // ==========================================
    const escapeHTML = (value) => {
      return String(value ?? '').replace(/[&<>"']/g, (char) => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#039;'
      })[char]);
    };

    // ==========================================
    // UPDATE VISI
    // ==========================================
    const visiEl = document.getElementById('profil-visi');

    if (visiEl && data.visi) {
      visiEl.textContent = `"${data.visi}"`;
    }

    // ==========================================
    // UPDATE MISI
    // ==========================================
    const misiContainer = document.getElementById('profil-misi');

    if (
      misiContainer &&
      Array.isArray(data.misi) &&
      data.misi.length > 0
    ) {
      misiContainer.innerHTML = data.misi.map((misi) => {
        const kode = escapeHTML(misi.kode);
        const judul = escapeHTML(misi.judul);
        const deskripsi = escapeHTML(misi.deskripsi);

        const poinHTML = Array.isArray(misi.poin) && misi.poin.length > 0
          ? `
            <div class="space-y-3 border-t border-slate-200 pt-4">
              ${misi.poin.map((poin, index) => `
                <div class="flex items-start gap-3">
                  <span class="w-6 h-6 shrink-0 rounded-full bg-blue-50 text-blue-700 flex items-center justify-center text-xs font-bold">
                    ${index + 1}
                  </span>

                  <p class="text-sm text-slate-700 leading-relaxed font-medium">
                    ${escapeHTML(poin)}
                  </p>
                </div>
              `).join('')}
            </div>
          `
          : '';

        return `
          <article class="glass-panel rounded-2xl p-6 sm:p-7 flex flex-col gap-4">

            <div class="flex items-start gap-4">
              <div class="w-12 h-12 shrink-0 rounded-xl bg-blue-700 text-white flex items-center justify-center text-xl font-black">
                ${kode}
              </div>

              <div class="pt-1">
                <h4 class="text-base sm:text-lg font-extrabold text-slate-900 leading-snug">
                  ${judul}
                </h4>
              </div>
            </div>

            <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
              ${deskripsi}
            </p>

            ${poinHTML}

          </article>
        `;
      }).join('');
    }

    // ==========================================
    // UPDATE ALAMAT KANTOR
    // ==========================================
    const alamatEl = document.getElementById('profil-alamat');

    if (alamatEl && data.alamat_kantor) {
      alamatEl.textContent = data.alamat_kantor;
    }

    // ==========================================
    // UPDATE JAM LAYANAN
    // ==========================================
    const jamEl = document.getElementById('profil-jam');

    if (jamEl && data.jam_layanan) {
      jamEl.innerHTML = `<strong>Jam Buka:</strong> ${escapeHTML(data.jam_layanan)}`;
    }

    // ==========================================
    // UPDATE TELEPON
    // ==========================================
    const telEl = document.getElementById('profil-telepon');

    if (telEl && data.telepon) {
      telEl.innerHTML = `<strong>Hotline:</strong> ${escapeHTML(data.telepon)}`;
    }

    // ==========================================
    // UPDATE STATISTIK
    // ==========================================
    const stats = data.statistik || {};

    const statElements = {
      'stat-total': stats.total_penduduk,
      'stat-lk': stats.laki_laki,
      'stat-pm': stats.perempuan,
      'stat-luas': stats.luas_wilayah
    };

    Object.entries(statElements).forEach(([id, value]) => {
      const element = document.getElementById(id);

      if (element && value) {
        element.textContent = value;
      }
    });

    // ==========================================
    // UPDATE DUSUN
    // ==========================================
    const dusunGrid = document.getElementById('profil-dusun-grid');

    if (
      dusunGrid &&
      Array.isArray(data.dusun) &&
      data.dusun.length > 0
    ) {
      dusunGrid.innerHTML = data.dusun.map((dusun) => `
        <a
          href="/dusun/${encodeURIComponent(dusun.id)}"
          class="glass-panel group overflow-hidden rounded-2xl hover:border-blue-500 hover:-translate-y-1 hover:shadow-lg flex flex-col justify-between transition-all"
        >
          ${dusun.foto ? `<img src="${escapeHTML(dusun.foto)}" alt="Foto ${escapeHTML(dusun.nama)}" class="h-40 w-full object-cover bg-slate-200" loading="lazy" />` : `<div class="flex h-40 items-center justify-center bg-gradient-to-br from-blue-100 to-slate-200 text-sm font-semibold text-slate-600">Foto dusun belum tersedia</div>`}
          <div class="flex flex-1 flex-col justify-between p-5 sm:p-6">
          <div>
            <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-3">
              <span class="text-xs font-bold text-blue-700 px-2 py-0.5 rounded bg-blue-50 border border-blue-100">
                ${escapeHTML(dusun.jumlah_rt || 'RT/RW')}
              </span>

              <span class="text-xs text-slate-500">
                ${escapeHTML(dusun.luas || '')}
              </span>
            </div>

            <h3 class="font-extrabold text-lg sm:text-xl text-slate-900 group-hover:text-blue-700 transition-colors">
              ${escapeHTML(dusun.nama)}
            </h3>

            <p class="text-xs sm:text-sm text-slate-500 mt-1">
              <strong>Kadus:</strong> ${escapeHTML(dusun.kepala_dusun || '-')}
            </p>

            <p class="text-xs sm:text-sm text-slate-600 mt-3 leading-relaxed line-clamp-3">
              ${escapeHTML(dusun.deskripsi || '-')}
            </p>

            ${dusun.potensi_utama ? `
              <p class="text-xs text-emerald-700 font-semibold mt-2">
                🌱 ${escapeHTML(dusun.potensi_utama)}
              </p>
            ` : ''}
          </div>

          <div class="mt-6 pt-3 border-t border-slate-100 flex items-center justify-between text-xs sm:text-sm font-bold text-blue-700">
            <span class="uppercase tracking-wider">Buka Informasi Dusun</span>
            <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
          </div>
          </div>
        </a>
      `).join('');
    }

    // ==========================================
    // UPDATE FOTO STRUKTUR
    // ==========================================
    const fotoSrc = data.foto_struktur || '/images/struktur-organisasi-timpik.jpg';

    const fotoImg = document.getElementById('profil-foto-struktur');
    const lightboxImg = document.getElementById('profil-lightbox-img');

    const lightboxModal = document.getElementById('profil-lightbox-modal');
    const btnOpen = document.getElementById('profil-btn-lightbox');
    const containerClick = document.getElementById('profil-container-click');
    const btnClose = document.getElementById('profil-btn-close-lightbox');

    if (fotoImg) fotoImg.src = fotoSrc;
    if (lightboxImg) lightboxImg.src = fotoSrc;

    // ==========================================
    // LIGHTBOX FUNCTIONS
    // ==========================================
    function openLightbox() {
      if (lightboxModal) {
        lightboxModal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }
    }

    function closeLightbox() {
      if (lightboxModal) {
        lightboxModal.classList.add('hidden');
        document.body.style.overflow = '';
      }
    }

    if (btnOpen) {
      btnOpen.addEventListener('click', openLightbox);
    }

    if (containerClick) {
      containerClick.addEventListener('click', openLightbox);
    }

    if (btnClose) {
      btnClose.addEventListener('click', closeLightbox);
    }

    if (lightboxModal) {
      lightboxModal.addEventListener('click', (event) => {
        if (event.target === lightboxModal) {
          closeLightbox();
        }
      });
    }

    // Tutup lightbox dengan tombol Escape
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        closeLightbox();
      }
    });

  })();
</script>
