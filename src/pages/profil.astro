---
import Layout from '../layouts/Layout.astro';
import profilData from '../data/profil.json';
---

<Layout
  title="Profil Wilayah & Visi Misi Desa Timpik"
  description="Profil lengkap Desa Timpik, Kecamatan Susukan, Kabupaten Semarang: sejarah, visi misi, kependudukan 5.696 jiwa, alamat kantor desa, dan struktur organisasi."
>
  <!-- Architectural Civic Header -->
  <section class="bg-gradient-to-r from-slate-950 via-blue-900 to-blue-800 text-white border-b border-blue-900/40 pt-14 pb-12 sm:pt-16 sm:pb-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm uppercase tracking-wider text-slate-300 mb-5" aria-label="Breadcrumb">
        <a href="/" class="hover:text-blue-300 transition-colors">Beranda</a>
        <span class="text-slate-500">/</span>
        <span class="text-blue-300 font-bold">Profil Wilayah</span>
      </nav>

      <div class="max-w-3xl space-y-3">
        <div class="flex items-center gap-2.5">
          <span class="h-1 w-8 bg-blue-400 rounded-full"></span>
          <span class="text-sm font-bold uppercase tracking-widest text-blue-300">Monografi & Identitas Desa</span>
        </div>
        
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white leading-tight">
          Profil Desa Timpik
        </h1>
        
        <p class="text-slate-200 text-base sm:text-lg leading-relaxed pt-1">
          Mengenal bentang alam agraris seluas 243 Hektar di lereng Gunung Merbabu, sejarah gotong royong 4 dusun, serta arah visi misi pembangunan Desa Timpik, Kecamatan Susukan.
        </p>
      </div>

    </div>
  </section>

  <!-- Total Warga & Statistik Utama (Highlight LK: 2.848, PM: 2.848, Total: 5.696) -->
  <section class="py-10 bg-sky-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="border-b border-slate-200 pb-4 mb-6">
        <span class="text-xs sm:text-sm font-bold uppercase tracking-widest text-blue-700 block mb-1">Data Resmi Kependudukan</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900">Demografi & Total Warga Desa</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        
        <!-- Total Warga -->
        <div class="rounded-2xl border border-blue-200 bg-white p-6 shadow-sm">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-500 block">Total Jumlah Warga</span>
          <div id="stat-total" class="text-3xl sm:text-4xl font-black text-blue-900 mt-2">
            {profilData.statistik.total_penduduk || '5.696 Jiwa'}
          </div>
          <span class="text-xs text-blue-700 font-semibold mt-1 block">Warga terdaftar di Desa Timpik</span>
        </div>

        <!-- Laki-laki -->
        <div class="rounded-2xl border border-blue-200 bg-white p-6 shadow-sm">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-500 block">Laki-Laki</span>
          <div id="stat-lk" class="text-3xl sm:text-4xl font-black text-slate-800 mt-2">
            {profilData.statistik.laki_laki || '2.848 Jiwa'}
          </div>
          <span class="text-xs text-slate-500 mt-1 block">Penduduk pria</span>
        </div>

        <!-- Perempuan -->
        <div class="rounded-2xl border border-blue-200 bg-white p-6 shadow-sm">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-500 block">Perempuan</span>
          <div id="stat-pm" class="text-3xl sm:text-4xl font-black text-slate-800 mt-2">
            {profilData.statistik.perempuan || '2.848 Jiwa'}
          </div>
          <span class="text-xs text-slate-500 mt-1 block">Penduduk wanita</span>
        </div>

        <!-- Luas Wilayah -->
        <div class="rounded-2xl border border-blue-200 bg-white p-6 shadow-sm">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-500 block">Luas Wilayah</span>
          <div id="stat-luas" class="text-3xl sm:text-4xl font-black text-emerald-800 mt-2">
            {profilData.statistik.luas_wilayah || '243 Ha'}
          </div>
          <span class="text-xs text-emerald-700 font-semibold mt-1 block">Mayoritas persawahan subur</span>
        </div>

      </div>
    </div>
  </section>

  <!-- Sejarah & Alamat Lengkap Kantor Desa -->
  <section id="sejarah" class="py-12 sm:py-16 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
        
        <div class="lg:col-span-7 space-y-6">
          <div class="border-b border-slate-200 pb-3">
            <span class="text-xs sm:text-sm font-bold uppercase tracking-widest text-blue-700 block">Sejarah & Letak Geografis</span>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-1">
              Desa Timpik, Kecamatan Susukan
            </h2>
          </div>

          <p class="text-base sm:text-lg text-slate-700 leading-relaxed">
            Desa Timpik merupakan salah satu desa di wilayah Kecamatan Susukan, Kabupaten Semarang, Jawa Tengah. Dikelilingi panorama perbukitan di lereng Gunung Merbabu, wilayah ini dikenal sebagai pusat agraris yang subur serta lumbung pelestarian seni budaya Wayang Orang dan Angguk.
          </p>

          <p class="text-base sm:text-lg text-slate-700 leading-relaxed">
            Masyarakat Desa Timpik hidup rukun bergotong-royong yang tersebar di empat dusun utama: Dusun Timpik Krajan, Dusun Bogo, Dusun Sumber, dan Dusun Kencana.
          </p>

          <!-- Alamat Lengkap Kantor Desa -->
          <div class="rounded-2xl border border-blue-200 bg-blue-50/60 p-6 space-y-3">
            <span class="text-xs font-bold uppercase tracking-wider text-blue-800 block">Alamat Lengkap Kantor Balai Desa:</span>
            <p id="profil-alamat" class="text-base sm:text-lg font-bold text-slate-900 leading-relaxed">
              {profilData.alamat_kantor || 'Jl. Raya Balai Desa Timpik, Kec. Susukan, Kab. Semarang, Jawa Tengah 50774'}
            </p>
            <div class="pt-3 border-t border-blue-200/60 flex flex-wrap gap-4 text-sm text-slate-700">
              <span id="profil-jam"><strong>Jam Buka:</strong> {profilData.jam_layanan || 'Senin - Kamis: 08.00 - 15.00 WIB | Jumat: 08.00 - 11.30 WIB'}</span>
              <span id="profil-telepon"><strong>Hotline:</strong> {profilData.telepon || '0812-3456-7890'}</span>
            </div>
          </div>
        </div>

        <div class="lg:col-span-5 space-y-4">
          <div class="rounded-2xl border border-slate-200 overflow-hidden shadow-sm bg-white">
            <img
              src="/images/balai-desa-timpik.jpg"
              alt="Kantor Balai Desa Timpik"
              class="w-full h-auto object-cover max-h-[320px]"
            />
            <div class="p-5 bg-slate-900 text-white space-y-1">
              <p class="font-bold text-lg text-white">Kompleks Balai Desa & Pendopo Pertemuan</p>
              <p class="text-slate-300 text-xs sm:text-sm leading-relaxed">Pusat pelayanan administrasi kependudukan dan musyawarah warga.</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Visi & Misi Pembangunan Desa -->
  <section id="visi-misi" class="py-14 sm:py-16 bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      
      <div class="border-b border-slate-200 pb-4">
        <span class="text-xs sm:text-sm font-bold uppercase tracking-widest text-blue-700 block mb-1">Arah Pembangunan Desa</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900">
          Visi & Misi Desa Timpik
        </h2>
        <p class="text-sm sm:text-base text-slate-600 mt-1">Pedoman pelaksanaan pemerintahan dan pembangunan kemasyarakatan.</p>
      </div>

      <!-- Visi Frame -->
      <div class="rounded-2xl border-2 border-blue-700 bg-white p-8 sm:p-10 shadow-sm relative">
        <span class="text-xs font-bold uppercase tracking-widest px-3 py-1 bg-blue-700 text-white rounded-md inline-block mb-3">
          Visi Resmi Desa Timpik
        </span>
        <blockquote id="profil-visi" class="text-xl sm:text-2xl lg:text-3xl font-extrabold text-slate-900 leading-snug">
          "{profilData.visi}"
        </blockquote>
      </div>

      <!-- Misi List (Poin-Poin Rapi & Jelas) -->
      <div>
        <h3 class="text-lg sm:text-xl font-bold text-slate-900 mb-4">Poin Misi Pembangunan:</h3>
        <div id="profil-misi" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          {profilData.misi.map((misi, idx) => (
            <div class="rounded-2xl bg-white border border-slate-200 p-6 shadow-sm flex flex-col justify-between space-y-3">
              <span class="text-2xl font-black text-blue-700">
                0{idx + 1}
              </span>
              <p class="text-sm sm:text-base text-slate-800 leading-relaxed font-medium">
                {misi}
              </p>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>

  <!-- Wilayah 4 Dusun di Desa Timpik -->
  <section id="dusun" class="py-14 sm:py-16 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      
      <div class="border-b border-slate-200 pb-4">
        <span class="text-xs sm:text-sm font-bold uppercase tracking-widest text-blue-700 block mb-1">Struktur Kewilayahan</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900">Empat Dusun Naungan Desa Timpik</h2>
        <p class="text-sm sm:text-base text-slate-600 mt-1">Data dusun dan kepala kewilayahan yang bertugas.</p>
      </div>

      <div id="profil-dusun-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {profilData.dusun.map((dusun) => (
          <a
            href={`/dusun/${dusun.id}`}
            class="group bg-white rounded-2xl border border-slate-200 hover:border-blue-500 p-6 shadow-sm hover:shadow-md flex flex-col justify-between transition-all"
          >
            <div>
              <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-3">
                <span class="text-xs font-bold text-blue-700 px-2 py-0.5 rounded bg-blue-50 border border-blue-100">{dusun.jumlah_rt || 'RT/RW'}</span>
                <span class="text-xs text-slate-500">{dusun.luas || ''}</span>
              </div>
              <h3 class="font-extrabold text-lg sm:text-xl text-slate-900 group-hover:text-blue-700 transition-colors">{dusun.nama}</h3>
              <p class="text-xs sm:text-sm text-slate-500 mt-1"><strong>Kadus:</strong> {dusun.kepala_dusun || '-'}</p>
              <p class="text-xs sm:text-sm text-slate-600 mt-3 leading-relaxed line-clamp-3">{dusun.deskripsi}</p>
              {dusun.potensi_utama && (
                <p class="text-xs text-emerald-700 font-semibold mt-2">🌱 {dusun.potensi_utama}</p>
              )}
            </div>
            <div class="mt-6 pt-3 border-t border-slate-100 flex items-center justify-between text-xs sm:text-sm font-bold text-blue-700">
              <span class="uppercase tracking-wider">Buka Informasi Dusun</span>
              <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>

  <!-- Struktur Organisasi Desa (Berdasarkan Arahan: Diambil dari Foto Saja) -->
  <section id="struktur-organisasi" class="py-14 sm:py-16 bg-slate-50">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      
      <div class="border-b border-slate-200 pb-4">
        <span class="text-xs sm:text-sm font-bold uppercase tracking-widest text-blue-700 block mb-1">
          Bagan Resmi
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900">
          Struktur Organisasi Pemerintahan Desa
        </h2>
        <p class="text-sm sm:text-base text-slate-600 mt-1">
          Bagan kepengurusan perangkat desa ditampilkan langsung dari foto resmi Pemerintah Desa Timpik.
        </p>
      </div>

      <div class="rounded-2xl border border-slate-200 bg-white p-4 sm:p-6 shadow-sm space-y-4">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100 flex-wrap gap-2">
          <span class="text-xs sm:text-sm font-bold text-slate-700">Foto Dokumen Bagan Resmi</span>
          <a
            id="profil-unduh-foto"
            href="/images/balai-desa-timpik.jpg"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-blue-50 text-blue-700 hover:bg-blue-100 text-xs sm:text-sm font-bold transition-colors"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            <span>Buka Foto Ukuran Penuh</span>
          </a>
        </div>

        <div class="rounded-xl overflow-hidden bg-slate-100 border border-slate-200 p-2">
          <img
            id="profil-foto-struktur"
            src="/images/balai-desa-timpik.jpg"
            alt="Struktur Organisasi Pemerintah Desa Timpik"
            class="w-full h-auto max-h-[700px] object-contain rounded-lg mx-auto"
            loading="lazy"
          />
        </div>
      </div>

    </div>
  </section>

</Layout>

<script is:inline define:vars={{ defaultProfil: profilData }}>
  (() => {
    const STORAGE_KEY = 'timpik_profil_data';
    let data = defaultProfil;

    try {
      const stored = localStorage.getItem(STORAGE_KEY);
      if (stored) {
        const parsed = JSON.parse(stored);
        if (parsed && typeof parsed === 'object') {
          data = { ...defaultProfil, ...parsed };
        }
      }
    } catch (e) {
      console.error(e);
    }

    // Update Visi
    const visiEl = document.getElementById('profil-visi');
    if (visiEl && data.visi) {
      visiEl.textContent = `"${data.visi}"`;
    }

    // Update Misi
    const misiContainer = document.getElementById('profil-misi');
    if (misiContainer && Array.isArray(data.misi) && data.misi.length > 0) {
      misiContainer.innerHTML = data.misi.map((m, idx) => `
        <div class="rounded-2xl bg-white border border-slate-200 p-6 shadow-sm flex flex-col justify-between space-y-3">
          <span class="text-2xl font-black text-blue-700">0${idx + 1}</span>
          <p class="text-sm sm:text-base text-slate-800 leading-relaxed font-medium">${m}</p>
        </div>
      `).join('');
    }

    // Update Alamat
    const alamatEl = document.getElementById('profil-alamat');
    if (alamatEl && data.alamat_kantor) {
      alamatEl.textContent = data.alamat_kantor;
    }

    // Update Jam & Telepon
    const jamEl = document.getElementById('profil-jam');
    if (jamEl && data.jam_layanan) {
      jamEl.innerHTML = `<strong>Jam Buka:</strong> ${data.jam_layanan}`;
    }
    const telEl = document.getElementById('profil-telepon');
    if (telEl && data.telepon) {
      telEl.innerHTML = `<strong>Hotline:</strong> ${data.telepon}`;
    }

    // Update Total Warga & Statistik
    const stats = data.statistik || {};
    const statTotal = document.getElementById('stat-total');
    if (statTotal && stats.total_penduduk) statTotal.textContent = stats.total_penduduk;
    const statLk = document.getElementById('stat-lk');
    if (statLk && stats.laki_laki) statLk.textContent = stats.laki_laki;
    const statPm = document.getElementById('stat-pm');
    if (statPm && stats.perempuan) statPm.textContent = stats.perempuan;
    const statLuas = document.getElementById('stat-luas');
    if (statLuas && stats.luas_wilayah) statLuas.textContent = stats.luas_wilayah;

    // Update Dusun Grid
    const dusunGrid = document.getElementById('profil-dusun-grid');
    if (dusunGrid && Array.isArray(data.dusun) && data.dusun.length > 0) {
      dusunGrid.innerHTML = data.dusun.map((d) => `
        <a
          href="/dusun/${d.id}"
          class="group bg-white rounded-2xl border border-slate-200 hover:border-blue-500 p-6 shadow-sm hover:shadow-md flex flex-col justify-between transition-all"
        >
          <div>
            <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-3">
              <span class="text-xs font-bold text-blue-700 px-2 py-0.5 rounded bg-blue-50 border border-blue-100">${d.jumlah_rt || 'RT/RW'}</span>
              <span class="text-xs text-slate-500">${d.luas || ''}</span>
            </div>
            <h3 class="font-extrabold text-lg sm:text-xl text-slate-900 group-hover:text-blue-700 transition-colors">${d.nama}</h3>
            <p class="text-xs sm:text-sm text-slate-500 mt-1"><strong>Kadus:</strong> ${d.kepala_dusun || '-'}</p>
            <p class="text-xs sm:text-sm text-slate-600 mt-3 leading-relaxed line-clamp-3">${d.deskripsi || '-'}</p>
            ${d.potensi_utama ? `<p class="text-xs text-emerald-700 font-semibold mt-2">🌱 ${d.potensi_utama}</p>` : ''}
          </div>
          <div class="mt-6 pt-3 border-t border-slate-100 flex items-center justify-between text-xs sm:text-sm font-bold text-blue-700">
            <span class="uppercase tracking-wider">Buka Informasi Dusun</span>
            <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
          </div>
        </a>
      `).join('');
    }

    // Update Foto Struktur
    const fotoSrc = data.foto_struktur || '/images/balai-desa-timpik.jpg';
    const fotoImg = document.getElementById('profil-foto-struktur');
    const fotoLink = document.getElementById('profil-unduh-foto');
    if (fotoImg && fotoSrc) fotoImg.src = fotoSrc;
    if (fotoLink && fotoSrc) fotoLink.href = fotoSrc;
  })();
</script>
