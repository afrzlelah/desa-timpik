---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Dokumen Tidak Ditemukan (404) - Desa Timpik">
  <div class="py-24 sm:py-32 flex items-center justify-center text-center px-4 bg-civic-cream flex-grow">
    <div class="max-w-md bg-white border border-civic-border p-8 sm:p-10 shadow-xs space-y-5">
      <div class="font-mono text-xs uppercase tracking-widest text-blue-700 font-bold">
        Kode Status 404
      </div>
      <h1 class="text-3xl font-serif font-black text-civic-navy">Arsip Tidak Ditemukan</h1>
      <p class="text-xs text-civic-muted leading-relaxed font-sans">
        Mohon maaf, halaman atau berkas dokumen yang Anda tuju tidak terdaftar dalam indeks sistem informasi Desa Timpik.
      </p>
      <div class="pt-2 flex flex-col sm:flex-row justify-center gap-3 font-mono text-xs uppercase tracking-wider font-bold">
        <a href="/" class="px-5 py-2.5 bg-blue-700 hover:bg-blue-800 text-white rounded transition-colors shadow-xs">
          Kembali ke Beranda
        </a>
        <a href="/layanan-surat" class="px-5 py-2.5 border border-civic-border bg-civic-sand hover:bg-slate-200 text-civic-navy rounded transition-colors">
          Katalog Layanan Surat
        </a>
      </div>
    </div>
  </div>
</Layout>
