---
import Layout from '../layouts/Layout.astro';
import suratData from '../data/surat.json';
import kelembagaanData from '../data/kelembagaan.json';
import potensiData from '../data/potensi.json';
import profilData from '../data/profil.json';
import beritaData from '../data/berita.json';

const featuredSurat = suratData.slice(0, 4);

// Carousel Slides
const heroSlides = [
  {
    image: '/images/gapura-desa-timpik.jpg',
    caption: 'Gapura Balai Desa Timpik',
    subcaption: 'Arsitektur Khas Bertatahkan Patung Wayang Punokawan — Ikon Pelestarian Budaya Jawa'
  },
  {
    image: '/images/balai-desa-timpik.jpg',
    caption: 'Kantor Balai Desa & Pendopo Pertemuan',
    subcaption: 'Pusat Tata Kelola Pelayanan Administrasi Warga, Musrenbangdes & Pagelaran Budaya'
  },
  {
    image: '/images/kelembagaan-desa-timpik.jpg',
    caption: '14 Kelembagaan Masyarakat Desa Timpik',
    subcaption: 'Pilar Sinergi Pertanian Gapoktan, P3A, BPD, PKK, BUMDes & Karang Taruna'
  }
];
---

<Layout title="Portal Resmi Desa Timpik">
  
  <!-- HERO SECTION: MAJESTIK, EDITORIAL, RESMI -->
  <section class="relative bg-[#0C1C30] text-white overflow-hidden min-h-[640px] lg:min-h-[720px] flex items-center justify-center">
    
    <!-- Background Carousel Container -->
    <div class="absolute inset-0 z-0 overflow-hidden" id="hero-carousel">
      {heroSlides.map((slide, idx) => (
        <div
          class={`carousel-slide absolute inset-0 transition-opacity duration-1000 ease-in-out ${idx === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'}`}
          data-slide-index={idx}
        >
          <img
            src={slide.image}
            alt={slide.caption}
            class="w-full h-full object-cover object-center transform scale-100 transition-transform duration-[8000ms] ease-out animate-kenburns brightness-[0.72] contrast-[1.05]"
          />
          <!-- Dignified Dark Vignette Gradient -->
          {/* <div class="absolute inset-0 bg-gradient-to-t from-[#0C1C30] via-black/35 to-black/55"></div> */}
        </div>
      ))}
    </div>

    <!-- Centered Hero Content -->
    <div class="relative z-20 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center flex flex-col items-center">
      
      <!-- Top Civic Marker -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-white/10 border border-white/20 text-slate-200 text-xs font-semibold uppercase tracking-wider mb-5">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
        <span>Kabupaten Semarang &bull; Kecamatan Susukan</span>
      </div>

      <!-- Main Village Title -->
      <h1 class="text-4xl sm:text-6xl md:text-7xl font-black tracking-tight text-white leading-tight mb-4 drop-shadow-md">
        Pemerintah Desa Timpik
      </h1>

      <!-- Editorial Subtitle (Bahasa Sederhana & Ramah Warga 40+) -->
      <p class="text-base sm:text-lg md:text-xl text-slate-100 max-w-3xl mx-auto leading-relaxed font-normal mb-8 drop-shadow">
        Website Resmi Pemerintah Desa Timpik, Kecamatan Susukan, Kabupaten Semarang. Melayani pengurusan surat menyurat warga secara online, penyampaian pengumuman resmi desa, dan transparansi pembangunan masyarakat.
      </p>

      <!-- Action Gateways (Tombol Besar & Mudah Diklik) -->
      <div class="flex flex-wrap items-center justify-center gap-3.5">
        <a
          href="/layanan-surat"
          class="px-7 py-3.5 rounded-xl font-black text-sm sm:text-base text-white bg-blue-600 hover:bg-blue-500 shadow-lg shadow-blue-950/40 transition-all flex items-center gap-2.5 min-h-[48px]"
        >
          <svg class="w-5 h-5 text-blue-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          <span>Ajukan Surat Online</span>
        </a>

        <a
          href="/info-desa"
          class="px-6 py-3.5 rounded-xl font-bold text-sm sm:text-base text-white bg-slate-900/90 hover:bg-slate-900 border border-white/30 transition-all flex items-center gap-2 min-h-[48px]"
        >
          <span>Pengumuman Desa</span>
          <span class="text-blue-300">&rarr;</span>
        </a>

        <a
          href="/kontak"
          class="px-6 py-3.5 rounded-xl font-bold text-sm sm:text-base text-white hover:bg-white/20 border border-white/30 transition-colors min-h-[48px] flex items-center"
        >
          Hubungi Balai Desa
        </a>
      </div>

      <!-- Horizontal Civic Ledger Metric Bar -->
      <div class="mt-14 w-full max-w-4xl border-t border-white/20 pt-6 grid grid-cols-2 sm:grid-cols-4 gap-4 text-center">
        <div class="px-3">
          <span class="text-2xl sm:text-3xl font-black text-blue-300 block font-mono">4</span>
          <p class="text-xs sm:text-sm font-bold text-white uppercase tracking-wider mt-0.5">Wilayah Dusun</p>
          <span class="text-xs text-slate-200">Bogo • Sumber • Krajan • Kencana</span>
        </div>

        <div class="px-3 border-l border-white/15">
          <span class="text-2xl sm:text-3xl font-black text-blue-300 block font-mono" id="hero-total-warga">5.696</span>
          <p class="text-xs sm:text-sm font-bold text-slate-200 uppercase tracking-wider mt-0.5">Jiwa Warga</p>
          <span class="text-xs text-slate-200" id="hero-detail-warga">LK 2.848 &bull; PM 2.848</span>
        </div>

        <div class="px-3 border-l border-white/15">
          <span class="text-2xl sm:text-3xl font-black text-blue-300 block font-mono">243 Ha</span>
          <p class="text-xs sm:text-sm font-bold text-white uppercase tracking-wider mt-0.5">Luas Wilayah</p>
          <span class="text-xs text-slate-200">78% Lahan Pertanian Subur</span>
        </div>

        <div class="px-3 border-l border-white/15">
          <span class="text-2xl sm:text-3xl font-black text-emerald-400 block font-mono">Rp 0,-</span>
          <p class="text-xs sm:text-sm font-bold text-slate-200 uppercase tracking-wider mt-0.5">Biaya Surat</p>
          <span class="text-xs text-emerald-300 font-semibold">100% Bebas Pungutan Liar</span>
        </div>
      </div>

    </div>

    <!-- Carousel Nav Controls (Next/Prev & Indicators) -->
    <div class="absolute right-6 bottom-6 z-20 hidden md:flex items-center gap-3">
      <div class="flex items-center gap-1.5 bg-black/50 px-2.5 py-1 rounded-full border border-white/10 text-xs" id="carousel-dots">
        {heroSlides.map((_, idx) => (
          <button
            type="button"
            class={`carousel-dot w-2 h-2 rounded-full transition-all duration-300 ${idx === 0 ? 'bg-sky-400 w-5' : 'bg-white/40 hover:bg-white/70'}`}
            data-target-slide={idx}
            aria-label={`Slide ${idx + 1}`}
          ></button>
        ))}
      </div>

      <div class="flex items-center gap-1">
        <button
          type="button"
          id="carousel-prev-btn"
          aria-label="Slide Sebelumnya"
          class="p-1.5 rounded-lg bg-black/40 hover:bg-black/70 border border-white/15 text-white transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        </button>
        <button
          type="button"
          id="carousel-next-btn"
          aria-label="Slide Selanjutnya"
          class="p-1.5 rounded-lg bg-black/40 hover:bg-black/70 border border-white/15 text-white transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </button>
      </div>
    </div>
  </section>

  <!-- PINTASAN CEPAT 4 PILAR PELAYANAN DESA -->
  <section class="py-10 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 divide-y sm:divide-y-0 sm:divide-x divide-slate-200">
        
        <a href="/layanan-surat" class="p-7 group hover:bg-blue-50/70 transition-colors flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            </div>
            <h3 class="text-lg font-extrabold text-slate-900 group-hover:text-blue-700 transition-colors">Layanan Surat Online</h3>
            <p class="text-sm text-slate-600 mt-2 leading-relaxed">Pengajuan SKU, SKD, SKCK, dan SKTM praktis lewat Google Form tanpa antre.</p>
          </div>
          <span class="mt-5 text-sm font-bold text-blue-700 group-hover:text-blue-900 flex items-center gap-1.5">
            <span>Buka Layanan Surat</span>
            <span>&rarr;</span>
          </span>
        </a>

        <a href="/layanan-surat/lacak" class="p-7 group hover:bg-blue-50/70 transition-colors flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
            </div>
            <h3 class="text-lg font-extrabold text-slate-900 group-hover:text-blue-700 transition-colors">Lacak Berkas Surat</h3>
            <p class="text-sm text-slate-600 mt-2 leading-relaxed">Periksa proses verifikasi dan kesiapan surat Anda dengan nomor tiket.</p>
          </div>
          <span class="mt-5 text-sm font-bold text-blue-700 group-hover:text-blue-900 flex items-center gap-1.5">
            <span>Cek Status Dokumen</span>
            <span>&rarr;</span>
          </span>
        </a>

        <a href="/agenda" class="p-7 group hover:bg-blue-50/70 transition-colors flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3M4 11h16M5 21h14a1 1 0 001-1V7a2 2 0 00-2-2H6a2 2 0 00-2 2v13a1 1 0 001 1z"/></svg>
            </div>
            <h3 class="text-lg font-extrabold text-slate-900 group-hover:text-blue-700 transition-colors">Jadwal & Agenda Desa</h3>
            <p class="text-sm text-slate-600 mt-2 leading-relaxed">Jadwal posyandu, giliran air tani P3A, dan pertemuan warga desa.</p>
          </div>
          <span class="mt-5 text-sm font-bold text-blue-700 group-hover:text-blue-900 flex items-center gap-1.5">
            <span>Lihat Kalender</span>
            <span>&rarr;</span>
          </span>
        </a>

        <a href="/layanan-aduan" class="p-7 group hover:bg-blue-50/70 transition-colors flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-purple-100 text-purple-700 flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
            </div>
            <h3 class="text-lg font-extrabold text-slate-900 group-hover:text-blue-700 transition-colors">Aduan & Aspirasi</h3>
            <p class="text-sm text-slate-600 mt-2 leading-relaxed">Sampaikan kendala jalan, penerangan, irigasi atau usulan langsung ke aparat desa.</p>
          </div>
          <span class="mt-5 text-sm font-bold text-blue-700 group-hover:text-blue-900 flex items-center gap-1.5">
            <span>Kirim Aduan</span>
            <span>&rarr;</span>
          </span>
        </a>

      </div>
    </div>
  </section>

  <!-- SECTION BALAI DESA & PELAYANAN PUBLIK: EDITORIAL & HUMAN -->
  <section class="py-16 sm:py-20 bg-slate-50/70 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-6 space-y-4">
          <div class="border border-slate-200 rounded-2xl overflow-hidden bg-white shadow-xs">
            <img
              src="/images/balai-desa-timpik.jpg"
              alt="Kantor Balai Desa Timpik dan Pendopo Pertemuan"
              class="w-full h-80 object-cover object-center"
            />
            <div class="p-4 bg-white border-t border-slate-200 flex items-center justify-between text-xs text-slate-500">
              <span class="font-medium text-slate-800">Kantor Balai Desa & Pendopo Pertemuan Warga</span>
            </div>
          </div>
        </div>

        <div class="lg:col-span-6 space-y-6">
          <div>
            <!-- <span class="text-[10px] font-bold uppercase tracking-wider text-blue-700 block mb-1">Tata Kelola & Birokrasi</span> -->
            <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-950 tracking-tight leading-tight">
              Pelayanan Cepat, Transparan, Bebas Pungutan Liar
            </h2>
          </div>

          <p class="text-slate-700 text-sm sm:text-base leading-relaxed">
            Pemerintah Desa Timpik berkomitmen menghadirkan tata kelola birokrasi yang dekat dengan warga. Dengan mengedepankan nilai gotong royong dan pemanfaatan sistem formulir digital, pengurusan surat-menyurat dan perizinan kini dapat diajukan langsung dari rumah tanpa hambatan.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
            <div class="p-4 rounded-xl bg-white border border-slate-400">
              <h4 class="font-bold text-slate-900 text-xs uppercase tracking-wider">Jam Pelayanan Kantor:</h4>
              <p class="text-xs text-slate-600 mt-1 leading-relaxed" id="home-jam-kerja">
                Senin - Kamis: 08.00 - 15.00 WIB<br/>Jumat: 08.00 - 11.30 WIB
              </p>
            </div>

            <div class="p-4 rounded-xl bg-white border border-slate-400">
              <h4 class="font-bold text-slate-900 text-xs uppercase tracking-wider">Pendopo Warga:</h4>
              <p class="text-xs text-slate-600 mt-1 leading-relaxed">
                Kapasitas hingga 300 warga untuk musyawarah pembangunan, rembuk tani, dan budaya.
              </p>
            </div>
          </div>

          <div class="pt-2 flex items-center gap-4 text-xs font-bold">
            <a href="/kontak" class="text-blue-700 hover:text-blue-800 flex items-center gap-1">
              <span>Detail Jam Buka & Lokasi Google Maps</span>
              <span>&rarr;</span>
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- SECTION PORTAL BERITA (GAZETTE EDITORIAL STYLE) -->
  <section id="portal-berita" class="py-16 sm:py-20 bg-white border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-6 border-b border-slate-200">
        <div>
          <!-- <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block mb-1">
            Warta Resmi Pemerintahan
          </span> -->
          <h2 class="text-2xl sm:text-3xl font-black text-slate-950 tracking-tight">
            Berita Terbaru
          </h2>
          <p class="text-xs sm:text-sm text-slate-600 max-w-2xl mt-1">
          Update Terbaru Desa Timpik
          </p>
        </div>

        <div class="flex items-center gap-3">
          <a
            href="/berita"
            class="px-4 py-2 rounded-lg bg-blue-700 hover:bg-blue-800 text-white font-bold text-xs transition-colors flex items-center gap-1.5"
          >
            <span>Seluruh Arsip Berita ({beritaData.length})</span>
            <svg class="w-3.5 h-3.5 text-blue-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
        </div>
      </div>

      <!-- Grid Berita (Hydrated from Admin timpik_berita_list) -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6" id="home-berita-grid">
        {beritaData.slice(0, 4).map((berita) => (
          <article class="bg-white rounded-xl border border-slate-200 overflow-hidden flex flex-col justify-between group hover:border-blue-400 hover:shadow-sm transition-all">
            <div>
              <div class="relative h-44 overflow-hidden bg-slate-100">
                <img
                  src={berita.gambar}
                  alt={berita.judul}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  onerror="this.src='/images/balai-desa-timpik.jpg'"
                />
                <span class="absolute top-2.5 left-2.5 text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-blue-900/90 text-white">
                  {berita.kategori}
                </span>
              </div>

              <div class="p-6">
                <div class="flex items-center gap-2 text-xs text-slate-500 mb-2 font-medium">
                  <span>{berita.tanggal}</span>
                </div>

                <h3 class="text-base sm:text-lg font-bold text-slate-900 group-hover:text-blue-700 transition-colors line-clamp-2 leading-snug">
                  <a href={`/berita/${berita.id}`} class="hover:underline">
                    {berita.judul}
                  </a>
                </h3>

                <p class="text-sm text-slate-600 mt-2 line-clamp-3 leading-relaxed">
                  {berita.ringkasan}
                </p>
              </div>
            </div>

            <div class="p-6 pt-0">
              <button
                type="button"
                class="btn-baca-berita w-full py-3 px-4 rounded-xl text-sm font-bold text-blue-700 bg-blue-50 hover:bg-blue-100 border border-blue-200 transition-colors flex items-center justify-center gap-2 min-h-[44px]"
                data-berita-id={berita.id}
                data-berita-judul={berita.judul}
                data-berita-kategori={berita.kategori}
                data-berita-tanggal={berita.tanggal}
                data-berita-konten={berita.konten}
                data-berita-gambar={berita.gambar}
              >
                <span>Baca Selengkapnya</span>
                <span class="text-blue-600 font-bold">&rarr;</span>
              </button>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

  <!-- SECTION DIREKTORI 4 DUSUN: GEOGRAFIS & KULTURAL -->
  <section id="dusun" class="py-16 sm:py-20 bg-slate-50/60 border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      
      <div class="max-w-2xl">

        <h2 class="text-2xl sm:text-3xl font-black text-slate-950 tracking-tight">
          4 Dusun Desa Timpik
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 mt-1 leading-relaxed">
          Setiap dusun di Desa Timpik menyimpan peran strategis dan karakter unik dalam kesenian adiluhung, konservasi air, pusat pemerintahan, serta lumbung ketahanan pangan.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {profilData.dusun.map((dusun) => (
          <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-7 flex flex-col justify-between hover:border-blue-400 hover:shadow-md transition-all">
            <div>
              <div class="flex items-center justify-between mb-3 pb-2 border-b border-slate-100">
                <span class="text-xs font-bold text-blue-700 px-2.5 py-1 rounded-md bg-blue-50 border border-blue-100">
                  {dusun.jumlah_rt}
                </span>
                <span class="text-xs font-medium text-slate-500">{dusun.luas || ''}</span>
              </div>

              <h3 class="text-xl font-extrabold text-slate-900">
                {dusun.nama}
              </h3>

              <p class="text-sm text-slate-600 mt-2.5 leading-relaxed line-clamp-3">
                {dusun.deskripsi}
              </p>
            </div>

            <div class="mt-6 pt-3 border-t border-slate-100 flex items-center justify-between text-sm">
              <span class="text-slate-500 font-medium text-xs">{dusun.kepala_dusun || ''}</span>
              <a href={`/dusun/${dusun.id}`} class="font-extrabold text-blue-700 hover:text-blue-900 transition-colors flex items-center gap-1">
                <span>Info Dusun</span>
                <span>&rarr;</span>
              </a>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- SECTION KEKAYAAN AGRARIS & KEBUDAYAAN NUSANTARA -->
  <section class="py-16 sm:py-20 bg-white border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
        
        <!-- Sektor Pertanian & Irigasi (8 cols) -->
        <div class="lg:col-span-8 p-8 sm:p-10 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col justify-between space-y-6">
          <div class="space-y-4">
            <span class="text-[10px] font-bold uppercase tracking-wider text-blue-800 bg-blue-100/70 px-2.5 py-1 rounded border border-blue-200 inline-block">
              Butuh surat keterangan?
            </span>
            <h3 class="text-2xl sm:text-3xl font-black text-slate-950 tracking-tight">
              Ajukan pelayanan surat menyurat desa secara online, tanpa perlu antre.            </h3>
            <p class="text-slate-700 text-sm leading-relaxed max-w-2xl">
Dengan memanfaatkan sistem formulir digital, pengajuan dokumen seperti SKU, SKD, SKCK, dan SKTM dapat dilakukan dari rumah. Warga dapat melacak status berkas secara transparan melalui nomor tiket yang diberikan.
            </p>

          </div>

          <div class="pt-4 border-t border-slate-200">
            <a href="/layanan-surat" class="text-xs font-bold text-blue-700 hover:text-blue-900 flex items-center gap-1.5">
              <span>Layanan Surat</span>
              <span>&rarr;</span>
            </a>
          </div>
        </div>

        <!-- Sektor Seni Budaya Wayang & Angguk (4 cols) -->
        <div class="lg:col-span-4 p-8 rounded-2xl bg-gradient-to-br from-black to-blue-900 text-white flex flex-col justify-between space-y-6 shadow-md border border-slate-800">
          <div class="space-y-4 ">
            <h3 class="text-xl sm:text-2xl font-black text-white tracking-tight">
              Atau Hubungi Daftar Kontak Desa untuk Layanan Desa
            </h3>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
              Tim admin desa siap membantu menjawab pertanyaan terkait layanan surat, pengaduan warga, dan informasi kegiatan desa. Silakan hubungi melalui WhatsApp atau telepon resmi desa.
            </p>
          </div>

          <div class="pt-4 border-t border-slate-800">
            <a href="/kontak" class="text-xs font-bold text-sky-400 hover:text-sky-300 flex items-center gap-1.5">
              <span>Daftar Kontak Desa</span>
              <span>&rarr;</span>
            </a>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- Modal Baca Berita Detail -->
  <div id="berita-modal" class="fixed inset-0 z-50 hidden bg-slate-950/70 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-2xl w-full p-6 sm:p-8 shadow-2xl relative modal-enter max-h-[90vh] overflow-y-auto border border-slate-200">
      <button id="close-berita-modal-btn" class="absolute top-5 right-5 p-2 rounded-full text-slate-400 hover:text-slate-700 hover:bg-slate-100 transition-colors" aria-label="Tutup Berita">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>

      <div class="space-y-4">
        <div class="flex items-center gap-2">
          <span id="modal-berita-kategori" class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-blue-900 text-white font-mono">
            Kategori
          </span>
          <span id="modal-berita-tanggal" class="text-xs text-slate-500 font-mono">
            Tanggal
          </span>
        </div>

        <h3 id="modal-berita-judul" class="text-xl sm:text-2xl font-black text-slate-950 leading-snug">
          Judul Berita
        </h3>

        <div class="rounded-xl overflow-hidden h-56 sm:h-72 w-full bg-slate-100 border border-slate-200">
          <img id="modal-berita-gambar" src="" alt="Gambar Berita" class="w-full h-full object-cover"/>
        </div>

        <div class="pt-2">
          <p id="modal-berita-konten" class="text-xs sm:text-sm text-slate-700 leading-relaxed">
            Konten lengkap berita...
          </p>
        </div>

        <div class="pt-4 border-t border-slate-100 flex flex-wrap items-center justify-between gap-3 text-xs text-slate-500">
          <span>Penulis: <strong id="modal-berita-penulis" class="text-slate-800">Tim KKN / Pemdes Timpik</strong></span>
          <div class="flex items-center gap-2">
            <a id="modal-berita-permalink" href="/berita" class="px-4 py-2 rounded-lg bg-[#0C1C30] hover:bg-[#163B66] text-white font-bold transition-colors">
              Halaman Artikel &rarr;
            </a>
            <button id="close-berita-bottom-btn" class="px-4 py-2 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold transition-colors">
              Tutup
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

</Layout>

<!-- Carousel & News Modal Script -->
<script>
  // 1. CAROUSEL SCRIPT
  const slides = document.querySelectorAll('.carousel-slide') as NodeListOf<HTMLElement>;
  const dots = document.querySelectorAll('.carousel-dot') as NodeListOf<HTMLElement>;
  const prevBtn = document.getElementById('carousel-prev-btn');
  const nextBtn = document.getElementById('carousel-next-btn');

  let currentSlide = 0;
  let carouselInterval: any;

  function showSlide(index: number) {
    if (slides.length === 0) return;

    if (index >= slides.length) currentSlide = 0;
    else if (index < 0) currentSlide = slides.length - 1;
    else currentSlide = index;

    slides.forEach((slide, i) => {
      if (i === currentSlide) {
        slide.classList.remove('opacity-0', 'z-0');
        slide.classList.add('opacity-100', 'z-10');
      } else {
        slide.classList.remove('opacity-100', 'z-10');
        slide.classList.add('opacity-0', 'z-0');
      }
    });

    dots.forEach((dot, i) => {
      if (i === currentSlide) {
        dot.classList.add('bg-sky-400', 'w-5');
        dot.classList.remove('bg-white/40');
      } else {
        dot.classList.remove('bg-sky-400', 'w-5');
        dot.classList.add('bg-white/40');
      }
    });
  }

  function startAutoSlide() {
    stopAutoSlide();
    carouselInterval = setInterval(() => {
      showSlide(currentSlide + 1);
    }, 6000);
  }

  function stopAutoSlide() {
    if (carouselInterval) clearInterval(carouselInterval);
  }

  if (nextBtn) {
    nextBtn.addEventListener('click', () => {
      stopAutoSlide();
      showSlide(currentSlide + 1);
      startAutoSlide();
    });
  }

  if (prevBtn) {
    prevBtn.addEventListener('click', () => {
      stopAutoSlide();
      showSlide(currentSlide - 1);
      startAutoSlide();
    });
  }

  dots.forEach(dot => {
    dot.addEventListener('click', (e) => {
      const target = parseInt((e.currentTarget as HTMLElement).getAttribute('data-target-slide') || '0', 10);
      stopAutoSlide();
      showSlide(target);
      startAutoSlide();
    });
  });

  startAutoSlide();

  // 2. NEWS MODAL SCRIPT & DYNAMIC HYDRATION
  const beritaModal = document.getElementById('berita-modal');
  const closeBeritaModalBtn = document.getElementById('close-berita-modal-btn');
  const closeBeritaBottomBtn = document.getElementById('close-berita-bottom-btn');
  const modalKategori = document.getElementById('modal-berita-kategori');
  const modalTanggal = document.getElementById('modal-berita-tanggal');
  const modalJudul = document.getElementById('modal-berita-judul');
  const modalGambar = document.getElementById('modal-berita-gambar') as HTMLImageElement | null;
  const modalKonten = document.getElementById('modal-berita-konten');
  const modalPenulis = document.getElementById('modal-berita-penulis');
  const modalPermalink = document.getElementById('modal-berita-permalink') as HTMLAnchorElement | null;

  function bindBeritaModalEvents() {
    const buttons = document.querySelectorAll('.btn-baca-berita');
    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-berita-id') || '';
        const judul = btn.getAttribute('data-berita-judul') || '';
        const kategori = btn.getAttribute('data-berita-kategori') || '';
        const tanggal = btn.getAttribute('data-berita-tanggal') || '';
        const penulis = btn.getAttribute('data-berita-penulis') || '';
        let konten = btn.getAttribute('data-berita-konten') || '';
        try {
          if (konten.includes('%')) konten = decodeURIComponent(konten);
        } catch (e) {}
        const gambar = btn.getAttribute('data-berita-gambar') || '/images/balai-desa-timpik.jpg';

        if (modalKategori) modalKategori.textContent = kategori;
        if (modalTanggal) modalTanggal.textContent = tanggal;
        if (modalJudul) modalJudul.textContent = judul;
        if (modalGambar) modalGambar.src = gambar;
        if (modalKonten) modalKonten.textContent = konten;
        if (modalPenulis) modalPenulis.textContent = penulis || 'Pemdes Timpik';
        if (modalPermalink) modalPermalink.href = `/berita/${id}`;

        if (beritaModal) {
          beritaModal.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
        }
      });
    });
  }

  function hydrateHomeNews() {
    const STORAGE_KEY = 'timpik_berita_list';
    try {
      const stored = localStorage.getItem(STORAGE_KEY);
      if (stored) {
        const parsed = JSON.parse(stored);
        if (Array.isArray(parsed) && parsed.length > 0) {
          const grid = document.getElementById('home-berita-grid');
          if (grid) {
            grid.innerHTML = parsed.slice(0, 4).map((b: any) => `
              <article class="bg-white rounded-xl border border-slate-200 overflow-hidden flex flex-col justify-between group hover:border-blue-400 hover:shadow-sm transition-all">
                <div>
                  <div class="relative h-44 overflow-hidden bg-slate-100">
                    <img
                      src="${b.gambar || '/images/balai-desa-timpik.jpg'}"
                      alt="${b.judul}"
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      onerror="this.src='/images/balai-desa-timpik.jpg'"
                    />
                    <span class="absolute top-2.5 left-2.5 text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-blue-900/90 text-white font-mono">
                      ${b.kategori}
                    </span>
                  </div>

                  <div class="p-6">
                    <div class="flex items-center gap-2 text-xs text-slate-500 mb-2 font-medium">
                      <span>${b.tanggal}</span>
                      <span>&bull;</span>
                      <span class="font-medium text-slate-700">${b.penulis || 'Pemdes Timpik'}</span>
                    </div>

                    <h3 class="text-base sm:text-lg font-bold text-slate-900 group-hover:text-blue-700 transition-colors line-clamp-2 leading-snug">
                      <a href="/berita/${b.id}" class="hover:underline">
                        ${b.judul}
                      </a>
                    </h3>

                    <p class="text-sm text-slate-600 mt-2 line-clamp-3 leading-relaxed">
                      ${b.ringkasan || b.konten || ''}
                    </p>
                  </div>
                </div>

                <div class="p-6 pt-0">
                  <button
                    type="button"
                    class="btn-baca-berita w-full py-3 px-4 rounded-xl text-sm font-bold text-blue-700 bg-blue-50 hover:bg-blue-100 border border-blue-200 transition-colors flex items-center justify-center gap-2 min-h-[44px]"
                    data-berita-id="${b.id}"
                    data-berita-judul="${b.judul}"
                    data-berita-kategori="${b.kategori}"
                    data-berita-tanggal="${b.tanggal}"
                    data-berita-penulis="${b.penulis || 'Pemdes Timpik'}"
                    data-berita-konten="${encodeURIComponent(b.konten || b.ringkasan || '')}"
                    data-berita-gambar="${b.gambar || '/images/balai-desa-timpik.jpg'}"
                  >
                    <span>Baca Selengkapnya</span>
                    <span class="text-blue-600 font-bold">&rarr;</span>
                  </button>
                </div>
              </article>
            `).join('');
          }
        }
      }
    } catch (e) {
      console.warn('Gagal hidrasi berita beranda', e);
    }
    bindBeritaModalEvents();
  }

  hydrateHomeNews();

  // Hydrate working hours from timpik_kontak_data
  try {
    const rawKontak = localStorage.getItem('timpik_kontak_data');
    if (rawKontak) {
      const parsedKontak = JSON.parse(rawKontak);
      if (parsedKontak && parsedKontak.operasional) {
        const homeJam = document.getElementById('home-jam-kerja');
        if (homeJam && parsedKontak.operasional.jam_senin_kamis && parsedKontak.operasional.jam_jumat) {
          homeJam.innerHTML = `Senin - Kamis: ${parsedKontak.operasional.jam_senin_kamis}<br/>Jumat: ${parsedKontak.operasional.jam_jumat}`;
        }
      }
    }
  } catch (e) {
    console.warn('Gagal hidrasi jam kerja beranda', e);
  }

  // Hydrate total warga from timpik_profil_data
  try {
    const rawProfil = localStorage.getItem('timpik_profil_data');
    if (rawProfil) {
      const parsedProfil = JSON.parse(rawProfil);
      if (parsedProfil && parsedProfil.statistik) {
        const elTotal = document.getElementById('hero-total-warga');
        const elDetail = document.getElementById('hero-detail-warga');
        if (elTotal && parsedProfil.statistik.total_penduduk) {
          elTotal.textContent = parsedProfil.statistik.total_penduduk.replace(/[^0-9.]/g, '') || parsedProfil.statistik.total_penduduk;
        }
        if (elDetail && parsedProfil.statistik.laki_laki && parsedProfil.statistik.perempuan) {
          elDetail.innerHTML = `LK ${parsedProfil.statistik.laki_laki.replace(/[^0-9.]/g, '')} &bull; PM ${parsedProfil.statistik.perempuan.replace(/[^0-9.]/g, '')}`;
        }
      }
    }
  } catch (e) {
    console.warn('Gagal hidrasi data warga beranda', e);
  }

  function closeBeritaModal() {
    if (beritaModal) {
      beritaModal.classList.add('hidden');
      document.body.style.overflow = '';
    }
  }

  if (closeBeritaModalBtn) closeBeritaModalBtn.addEventListener('click', closeBeritaModal);
  if (closeBeritaBottomBtn) closeBeritaBottomBtn.addEventListener('click', closeBeritaModal);
  if (beritaModal) {
    beritaModal.addEventListener('click', (e) => {
      if (e.target === beritaModal) closeBeritaModal();
    });
  }
</script>
