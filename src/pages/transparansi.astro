---
import Layout from '../layouts/Layout.astro';
import profilData from '../data/profil.json';

const apbdes = profilData.transparansi_apbdes;
---

<Layout
  title="Transparansi APBDes & Akuntabilitas Anggaran Desa Timpik"
  description="Keterbukaan informasi publik dan laporan transparansi Anggaran Pendapatan dan Belanja Desa (APBDes) Desa Timpik, Kecamatan Susukan, Kabupaten Semarang."
>
  <!-- Architectural Civic Header -->
  <section class="bg-gradient-to-r from-black/90 to-blue-800 text-white border-b border-civic-border/30 pt-14 pb-12 sm:pt-16 sm:pb-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs uppercase tracking-wider text-slate-400 mb-5" aria-label="Breadcrumb">
        <a href="/" class="hover:text-blue-300 transition-colors">Beranda</a>
        <span class="text-slate-600">/</span>
        <span class="text-blue-300 font-bold">Transparansi APBDes</span>
      </nav>

      <div class="max-w-3xl space-y-3">

        <h1 class="text-3xl sm:text-4xl lg:text-5xl  font-black tracking-tight text-white leading-tight" id="view-tahun-title">
          Transparansi APBDes Desa Timpik {apbdes.tahun}
        </h1>

        <p class="text-slate-300 text-sm sm:text-base leading-relaxed pt-1">
          Laporan pertanggungjawaban realisasi penerimaan Dana Desa (APBN Pusat), Alokasi Dana Desa (ADD Pemkab Semarang), Pendapatan Asli Desa, serta penyaluran pembiayaan irigasi sawah 243 Ha dan infrastruktur dusun.
        </p>
      </div>

    </div>
  </section>

  <!-- Total Summary Ledger Bar -->
  <section class="py-10 bg-civic-sand/30 border-b border-civic-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-civic-border bg-white border border-civic-border shadow-xs">
        
        <div class="p-6 sm:p-8 space-y-2">
          <span class="text-[10px]  uppercase tracking-widest text-civic-muted block" id="view-tahun-card">
            Total Penerimaan Kas Desa {apbdes.tahun}
          </span>
          <h2 class="text-3xl sm:text-4xl  font-black text-civic-navy tracking-tight" id="view-total-pendapatan-card">
            {apbdes.total_pendapatan}
          </h2>
          <p class="text-xs text-civic-muted font-sans pt-1">
            Dana Desa (APBN), ADD Kab. Semarang, PAD & Bagi Hasil Pajak.
          </p>
        </div>

        <div class="p-6 sm:p-8 space-y-2 bg-slate-50/40">
          <span class="text-[10px]  uppercase tracking-widest text-emerald-800 font-bold block">
            Alokasi Pembangunan & Irigasi
          </span>
          <h2 class="text-3xl sm:text-4xl  font-black text-emerald-900 tracking-tight" id="view-belanja-pembangunan-card">
            {apbdes.belanja_pembangunan}
          </h2>
          <p class="text-xs text-civic-muted font-sans pt-1">
            Normalisasi saluran P3A Bogo Wastro, jalan usaha tani & infrastruktur.
          </p>
        </div>

        <div class="p-6 sm:p-8 space-y-2">
          <span class="text-[10px]  uppercase tracking-widest text-blue-700 font-bold block">
            Biaya Pengurusan Surat Warga
          </span>
          <h2 class="text-3xl sm:text-4xl  font-black text-civic-navy tracking-tight" id="view-biaya-pelayanan-card">
            {apbdes.biaya_pelayanan_warga || "Rp 0,- (Gratis)"}
          </h2>
          <p class="text-xs text-civic-muted font-sans pt-1">
            100% Bebas Biaya Administrasi & Pungli bagi seluruh warga.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- Rincian Neraca APBDes (Dual-Column Accounting Ledger) -->
  <section class="py-14 sm:py-16 bg-civic-cream flex-grow">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-start">
        
        <!-- Tabel Penerimaan Desa -->
        <div class="bg-white border border-civic-border shadow-xs">
          <div class="p-6 sm:p-8 border-b border-civic-border flex items-center justify-between gap-4">
            <div>
              <span class="text-[10px]  uppercase tracking-widest text-blue-700 font-bold block">Buku Kas Masuk</span>
              <h3 class="text-xl  font-black text-civic-navy mt-0.5">Struktur Penerimaan Kas Desa</h3>
              <p class="text-xs text-civic-muted mt-0.5">Komponen pendapatan APBDes berdasarkan sumber anggaran resmi.</p>
            </div>
            <span class="text-[10px]  uppercase tracking-wider px-2 py-1 bg-civic-sand text-civic-navy border border-civic-border font-bold">
              Penerimaan
            </span>
          </div>

          <div class="divide-y divide-civic-border text-xs sm:text-sm">
            <div class="p-4 sm:p-5 flex items-center justify-between gap-4 hover:bg-civic-sand/20 transition-colors">
              <div>
                <span class="font-bold text-civic-navy block">1. Dana Desa (Transfer APBN Pusat)</span>
                <span class="text-xs text-civic-muted">Alokasi pemerintah pusat untuk pembangunan & BLT</span>
              </div>
              <strong class=" text-civic-navy font-bold text-right shrink-0" id="view-dana-desa">{apbdes.dana_desa}</strong>
            </div>

            <div class="p-4 sm:p-5 flex items-center justify-between gap-4 hover:bg-civic-sand/20 transition-colors">
              <div>
                <span class="font-bold text-civic-navy block">2. Alokasi Dana Desa (ADD Kab. Semarang)</span>
                <span class="text-xs text-civic-muted">Penghasilan tetap aparatur dan operasional balai desa</span>
              </div>
              <strong class=" text-civic-navy font-bold text-right shrink-0" id="view-add">{apbdes.alokasi_dana_desa}</strong>
            </div>

            <div class="p-4 sm:p-5 flex items-center justify-between gap-4 hover:bg-civic-sand/20 transition-colors">
              <div>
                <span class="font-bold text-civic-navy block">3. Bagi Hasil Pajak & Retribusi Daerah</span>
                <span class="text-xs text-civic-muted">Pajak bumi bangunan & retribusi Pemerintah Daerah</span>
              </div>
              <strong class=" text-civic-navy font-bold text-right shrink-0" id="view-lain-lain">{apbdes.lain_lain}</strong>
            </div>

            <div class="p-4 sm:p-5 flex items-center justify-between gap-4 hover:bg-civic-sand/20 transition-colors">
              <div>
                <span class="font-bold text-civic-navy block">4. Pendapatan Asli Desa (PADes & BUMDes)</span>
                <span class="text-xs text-civic-muted">Hasil pengelolaan aset tanah kas desa & unit usaha</span>
              </div>
              <strong class=" text-civic-navy font-bold text-right shrink-0" id="view-pad">{apbdes.pad_desa}</strong>
            </div>

            <div class="p-5 bg-civic-navy text-white flex items-center justify-between  text-sm sm:text-base">
              <span class="uppercase tracking-wider font-bold">Total Penerimaan:</span>
              <strong class="text-blue-300 font-bold text-base sm:text-lg" id="view-total-penerimaan">{apbdes.total_pendapatan}</strong>
            </div>
          </div>
        </div>

        <!-- Tabel Belanja Desa -->
        <div class="bg-white border border-civic-border shadow-xs">
          <div class="p-6 sm:p-8 border-b border-civic-border flex items-center justify-between gap-4">
            <div>
              <span class="text-[10px]  uppercase tracking-widest text-blue-700 font-bold block">Buku Realisasi Pengeluaran</span>
              <h3 class="text-xl  font-black text-civic-navy mt-0.5">Alokasi Belanja & Kegiatan Warga</h3>
              <p class="text-xs text-civic-muted mt-0.5">Penyaluran anggaran untuk program fisik, sosial, dan ketahanan pangan.</p>
            </div>
            <span class="text-[10px]  uppercase tracking-wider px-2 py-1 bg-emerald-50 text-emerald-800 border border-emerald-200 font-bold">
              Penyaluran
            </span>
          </div>

          <div class="divide-y divide-civic-border text-xs sm:text-sm">
            <div class="p-4 sm:p-5 flex items-center justify-between gap-4 hover:bg-civic-sand/20 transition-colors">
              <div>
                <span class="font-bold text-civic-navy block">1. Pembangunan Fisik, Jalan & Irigasi Sawah</span>
                <span class="text-xs text-civic-muted">Pemeliharaan saluran air tani 243 Ha & jalan 4 dusun</span>
              </div>
              <strong class=" text-emerald-900 font-bold text-right shrink-0" id="view-belanja-pembangunan">{apbdes.belanja_pembangunan}</strong>
            </div>

            <div class="p-4 sm:p-5 flex items-center justify-between gap-4 hover:bg-civic-sand/20 transition-colors">
              <div>
                <span class="font-bold text-civic-navy block">2. Penyelenggaraan Pemerintahan Desa</span>
                <span class="text-xs text-civic-muted">Honorarium perangkat, operasional kantor & IT layanan</span>
              </div>
              <strong class=" text-civic-navy font-bold text-right shrink-0" id="view-belanja-pemerintahan">{apbdes.belanja_pemerintahan}</strong>
            </div>

            <div class="p-4 sm:p-5 flex items-center justify-between gap-4 hover:bg-civic-sand/20 transition-colors">
              <div>
                <span class="font-bold text-civic-navy block">3. Pemberdayaan Petani & BUMDes</span>
                <span class="text-xs text-civic-muted">Dukungan Gapoktan, bibit unggul padi, dan ketahanan pangan</span>
              </div>
              <strong class=" text-civic-navy font-bold text-right shrink-0" id="view-belanja-pemberdayaan">{apbdes.pemberdayaan_masyarakat}</strong>
            </div>

            <div class="p-4 sm:p-5 flex items-center justify-between gap-4 hover:bg-civic-sand/20 transition-colors">
              <div>
                <span class="font-bold text-civic-navy block">4. Pembinaan Seni Budaya & Keagamaan</span>
                <span class="text-xs text-civic-muted">Pelestarian Wayang Orang Badoyo, Angguk, dan kerukunan</span>
              </div>
              <strong class=" text-civic-navy font-bold text-right shrink-0" id="view-belanja-pembinaan">{apbdes.pembinaan_budaya}</strong>
            </div>

            <div class="p-5 bg-emerald-900 text-white flex items-center justify-between  text-sm sm:text-base">
              <span class="uppercase tracking-wider font-bold">Status Audit:</span>
              <strong class="text-emerald-200 font-bold text-sm sm:text-base">Akuntabel & Tepat Sasaran</strong>
            </div>
          </div>
        </div>

      </div>

      <!-- Maklumat Integritas & Bebas Pungutan Liar -->
      <section class="relative overflow-hidden rounded-xl bg-[#0B1E36] p-2 sm:p-3">

        <!-- Main Banner -->
        <div class="relative overflow-hidden rounded-lg border-2 border-white/80 bg-gradient-to-br from-[#15543D] via-[#104B3B] to-[#063B30] px-5 py-12 text-center shadow-inner sm:px-10 sm:py-16">

          <!-- Subtle Background Decoration -->
          <div class="pointer-events-none absolute -right-20 -top-24 h-64 w-64 rounded-full bg-emerald-300/10 blur-3xl"></div>
          <div class="pointer-events-none absolute -bottom-24 -left-20 h-64 w-64 rounded-full bg-emerald-400/10 blur-3xl"></div>

          <div class="relative mx-auto max-w-3xl space-y-5">

            <!-- Heading -->
            <h3 class="text-2xl  font-black leading-tight tracking-tight text-white sm:text-3xl lg:text-4xl">
              Pakta Integritas Pelayanan Publik
              <span class="block text-emerald-300">Desa Timpik</span>
            </h3>

            <!-- Description -->
            <p class="mx-auto max-w-2xl text-xs leading-relaxed text-emerald-50/80 sm:text-sm sm:leading-relaxed">
              Pemerintah Desa Timpik berkomitmen menjunjung tinggi asas transparansi anggaran dan menjamin bahwa seluruh proses permohonan surat administrasi kependudukan (SKU, SKTM, Pengantar SKCK, Domisili, dan lainnya)
              <strong class="font-bold text-white">100% BEBAS BIAYA (Rp 0,-).</strong>
              Apabila warga menemukan indikasi pungutan liar atau penyimpangan anggaran, silakan gunakan kanal pengaduan resmi.
            </p>

            <!-- CTA -->
            <div class="flex flex-col items-center justify-center gap-3 pt-3 sm:flex-row">

              <a href="/layanan-aduan" class="inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-md bg-white px-5 py-3 text-xs font-bold text-[#0B1E36] shadow-sm transition hover:bg-emerald-50 sm:w-auto">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 9v4m0 4h.01M10.3 3.9L2.8 17a2 2 0 001.7 3h15a2 2 0 001.7-3l-7.5-13.1a2 2 0 00-3.4 0z"/>
                </svg>
                Lapor Pungutan Liar / Aduan Anggaran
                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14m-6-6l6 6-6 6"/>
                </svg>
              </a>

              <a href="/layanan-surat" class="inline-flex min-h-11 w-full items-center justify-center rounded-md border border-white/50 bg-white/5 px-5 py-3 text-xs font-bold text-white transition hover:bg-white/10 sm:w-auto">
                Katalog Surat Online Bebas Pungli
              </a>

            </div>

          </div>
        </div>
      </section>

    </div>
  </section>
</Layout>

<script>
  // Dynamic client-side hydration from localStorage (Admin updates)
  try {
    const raw = localStorage.getItem('timpik_apbdes_data');
    if (raw) {
      const data = JSON.parse(raw);
      if (data && data.total_pendapatan) {
        const setTxt = (id: string, val: string | undefined) => {
          const el = document.getElementById(id);
          if (el && val) el.textContent = val;
        };

        if (data.tahun) {
          setTxt('view-tahun-title', `Transparansi APBDes Desa Timpik ${data.tahun}`);
          setTxt('view-tahun-card', `Total Penerimaan Kas Desa ${data.tahun}`);
        }
        setTxt('view-total-pendapatan-card', data.total_pendapatan);
        setTxt('view-belanja-pembangunan-card', data.belanja_pembangunan);
        setTxt('view-biaya-pelayanan-card', data.biaya_pelayanan_warga || 'Rp 0,- (Gratis)');
        setTxt('view-dana-desa', data.dana_desa);
        setTxt('view-add', data.alokasi_dana_desa);
        setTxt('view-lain-lain', data.lain_lain);
        setTxt('view-pad', data.pad_desa);
        setTxt('view-total-penerimaan', data.total_pendapatan);
        setTxt('view-belanja-pembangunan', data.belanja_pembangunan);
        setTxt('view-belanja-pemerintahan', data.belanja_pemerintahan);
        setTxt('view-belanja-pemberdayaan', data.pemberdayaan_masyarakat);
        setTxt('view-belanja-pembinaan', data.pembinaan_budaya);
      }
    }
  } catch (err) {
    console.warn('Gagal hidrasi APBDes publik:', err);
  }
</script>
