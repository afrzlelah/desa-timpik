---
import Layout from '../layouts/Layout.astro';
import profilData from '../data/profil.json';
---

<Layout
  title="Statistik & Demografi Publik Desa Timpik"
  description="Informasi statistik kependudukan Desa Timpik, Kecamatan Susukan, Kabupaten Semarang, termasuk jumlah warga dan ringkasan data wilayah desa."
>
  <!-- Architectural Civic Header -->
  <section class="bg-gradient-to-r from-black to-blue-900 text-white border-b border-civic-border/30 pt-14 pb-12 sm:pt-16 sm:pb-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs  uppercase tracking-wider text-slate-400 mb-5" aria-label="Breadcrumb">
        <a href="/" class="hover:text-blue-300 transition-colors">Beranda</a>
        <span class="text-slate-600">/</span>
        <span class="text-blue-300 font-bold">Statistik Kependudukan</span>
      </nav>

      <div class="max-w-3xl space-y-3">
        
        <h1 class="text-3xl sm:text-4xl lg:text-5xl  font-black tracking-tight text-white leading-tight">
          Statistik & Demografi Desa Timpik
        </h1>
        
        <p class="text-slate-300 text-sm sm:text-base leading-relaxed pt-1">
          Penyajian data agregat kependudukan resmi, sebaran demografi 4 dusun, rasio gender, serta struktur mata pencaharian sektor agraris Desa Timpik, Kecamatan Susukan tahun 2026.
        </p>
      </div>

    </div>
  </section>

  <!-- 4 Monographic Indicator Bar -->
  <section class="py-10 bg-civic-sand/30 border-b border-civic-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 lg:grid-cols-4 divide-y sm:divide-y-0 sm:divide-x divide-civic-border bg-white border border-civic-border shadow-xs">
        
        <div class="p-6 sm:p-8 space-y-2">
          <span class="text-[10px]  uppercase tracking-widest text-civic-muted block">Total Penduduk</span>
            <h2 id="stat-total-penduduk" class="text-3xl sm:text-4xl font-black text-civic-navy tracking-tight">
              {profilData.statistik.total_penduduk}
            </h2>
          <p class="text-xs text-civic-muted font-sans">Tersebar di 4 wilayah kadus</p>
        </div>

        <div class="p-6 sm:p-8 space-y-2">
          <span class="text-[10px]  uppercase tracking-widest text-civic-muted block">Kepala Keluarga</span>
          <h2 id="stat-total-kk" class="text-3xl sm:text-4xl font-black text-civic-navy tracking-tight">
            {profilData.statistik.total_kk}
          </h2>
          <p class="text-xs text-civic-muted font-sans">Tercatat dalam administrasi KK</p>
        </div>

        <div class="p-6 sm:p-8 space-y-2">
          <span class="text-[10px]  uppercase tracking-widest text-civic-muted block">Luas Wilayah</span>
            <h2 id="stat-luas-wilayah" class="text-3xl sm:text-4xl font-black text-civic-navy tracking-tight">
              {profilData.statistik.luas_wilayah}
            </h2>
          <p class="text-xs text-civic-muted font-sans">± 7,2 hingga 7,3 km² daratan</p>
        </div>

        <div class="p-6 sm:p-8 space-y-2 bg-slate-50/40">
          <span class="text-[10px]  uppercase tracking-widest text-emerald-800 font-bold block">Lahan Pertanian</span>
          <h2 id="stat-lahan-pertanian" class="text-3xl sm:text-4xl font-black text-emerald-900 tracking-tight">
            {profilData.statistik.lahan_pertanian}
          </h2>
          <p class="text-xs text-civic-muted font-sans">Padi sawah irigasi & palawija</p>
        </div>

      </div>
    </div>
  </section>

  <!-- Data Gender & Mata Pencaharian (Dual-Column Ledger) -->
  <section class="py-14 sm:py-16 bg-civic-cream border-b border-civic-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-start">
        
        <!-- Komposisi Jenis Kelamin -->
        <div class="bg-white border border-civic-border shadow-xs">
          <div class="p-6 sm:p-8 border-b border-civic-border flex items-center justify-between gap-4">
            <div>
              <span class="text-[10px]  uppercase tracking-widest text-civic-gold block">Demografi</span>
              <h3 class="text-xl  font-black text-civic-navy mt-0.5">Komposisi Jenis Kelamin</h3>
              <p class="text-xs text-civic-muted mt-0.5">Perbandingan seimbang penduduk laki-laki dan perempuan.</p>
            </div>
            <span class="text-[10px]  uppercase tracking-wider px-2 py-1 bg-civic-sand text-civic-navy border border-civic-border font-bold">
              Tahun 2026
            </span>
          </div>

          <div class="p-6 sm:p-8 space-y-6">
            <div class="space-y-2">
              <div class="flex justify-between text-xs sm:text-sm font-bold">
                <span class="text-slate-900 flex items-center gap-2" id="stat-laki-laki">
                  <span class="w-3 h-3 bg-blue-700 rounded-sm inline-block"></span> Laki-laki ({profilData.statistik.laki_laki})
                </span>
                <span id="stat-persen-lk" class="text-blue-900 font-bold">50.0%</span>
              </div>
              <div class="w-full h-3 rounded-full bg-slate-100 overflow-hidden border border-slate-200">
                <div id="stat-bar-lk" class="h-full bg-blue-700 rounded-full" style="width: 50%"></div>
              </div>
            </div>

            <div class="space-y-2">
              <div class="flex justify-between text-xs sm:text-sm font-bold">
                <span class="text-slate-900 flex items-center gap-2" id="stat-perempuan">
                  <span class="w-3 h-3 bg-indigo-700 rounded-sm inline-block"></span> Perempuan ({profilData.statistik.perempuan})
                </span>
                <span id="stat-persen-pm" class="text-indigo-900 font-bold">50.0%</span>
              </div>
              <div class="w-full h-3 rounded-full bg-slate-100 overflow-hidden border border-slate-200">
                <div id="stat-bar-pm" class="h-full bg-indigo-700 rounded-full" style="width: 50%"></div>
              </div>
            </div>

            <div class="p-4 rounded-xl border border-blue-200 bg-blue-50/60 text-xs sm:text-sm text-slate-800 leading-relaxed font-medium">
              Data resmi kependudukan Desa Timpik mencatat perbandingan seimbang antara warga laki-laki (2.848 jiwa) dan perempuan (2.848 jiwa) dengan total penduduk keseluruhan 5.696 jiwa.
            </div>
          </div>
        </div>

        <!-- Mata Pencaharian Utama -->
        <!-- <div class="bg-white border border-civic-border shadow-xs">
          <div class="p-6 sm:p-8 border-b border-civic-border flex items-center justify-between gap-4">
            <div>
              <span class="text-[10px]  uppercase tracking-widest text-emerald-800 block">Ketenagakerjaan</span>
              <h3 class="text-xl  font-black text-civic-navy mt-0.5">Struktur Mata Pencaharian</h3>
              <p class="text-xs text-civic-muted mt-0.5">Sebaran profesi dan urat nadi perekonomian warga desa.</p>
            </div>
            <span class="text-[10px]  uppercase tracking-wider px-2 py-1 bg-emerald-50 text-emerald-800 border border-emerald-200 font-bold">
              Agraris
            </span>
          </div>

          <div class="p-6 sm:p-8 space-y-6">
            <div class="space-y-2">
              <div class="flex justify-between text-xs  font-bold">
                <span class="text-civic-navy">Petani & Peternak Sawah (76%)</span>
                <span class="text-emerald-900 font-bold">{profilData.statistik.pekerjaan_petani}</span>
              </div>
              <div class="w-full h-2.5 bg-civic-sand border border-civic-border/60">
                <div class="h-full bg-emerald-800" style="width: 76%"></div>
              </div>
            </div>

            <div class="space-y-2">
              <div class="flex justify-between text-xs  font-bold">
                <span class="text-civic-navy">Pedagang, UMKM & Jasa (14%)</span>
                <span class="text-blue-700 font-bold">{profilData.statistik.pekerjaan_wiraswasta}</span>
              </div>
              <div class="w-full h-2.5 bg-civic-sand border border-civic-border/60">
                <div class="h-full bg-blue-600" style="width: 14%"></div>
              </div>
            </div>

            <div class="space-y-2">
              <div class="flex justify-between text-xs  font-bold">
                <span class="text-civic-navy">Pegawai Swasta, ASN & Lainnya (10%)</span>
                <span class="text-civic-muted font-bold">{profilData.statistik.pekerjaan_lainnya}</span>
              </div>
              <div class="w-full h-2.5 bg-civic-sand border border-civic-border/60">
                <div class="h-full bg-slate-400" style="width: 10%"></div>
              </div>
            </div>

            <div class="p-4 border-l-2 border-emerald-800 bg-emerald-50/40 text-xs text-civic-ink leading-relaxed">
              Dominasi 76% pada sektor pertanian menempatkan koordinasi GAPOKTAN Putri Kencana dan P3A Bogo Wastro sebagai urat nadi ketahanan pangan utama masyarakat Desa Timpik.
            </div>
          </div>
        </div> -->

      </div>

    </div>
  </section>

  <!-- Sebaran Penduduk per Dusun (Civic Ledger Table) -->
  <section class="py-14 sm:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
          <!-- <span class="text-xs  uppercase tracking-widest text-blue-700 font-bold block mb-1">Distribusi Teritorial</span> -->
          <h2 class="text-2xl sm:text-3xl  font-black text-civic-navy">Sebaran Penduduk & Dusun</h2>
        </div>
        <p class="text-xs text-civic-muted max-w-md">
          Rincian pembagian rukun tetangga dan fokus keunggulan masing-masing dusun di Desa Timpik.
        </p>
      </div>

      <div class="border border-civic-border overflow-x-auto">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead class="bg-civic-navy text-white text-[10px]  uppercase tracking-wider">
            <tr>
              <th class="p-4 sm:p-5">Wilayah Dusun</th>
              <th class="p-4 sm:p-5">Jumlah RT / RW</th>
              <th class="p-4 sm:p-5">Keunggulan & Potensi</th>
              <th class="p-4 sm:p-5">Karakteristik Wilayah</th>
              <th class="p-4 sm:p-5 text-right">Aksi</th>
            </tr>
          </thead>
          <tbody id="stat-dusun-list" class="divide-y divide-civic-border text-civic-ink font-sans">
            {profilData.dusun.map((dusun, idx) => (
              <tr class="hover:bg-civic-sand/20 transition-colors">
                <td class="p-4 sm:p-5 font-bold text-civic-navy text-sm sm:text-base">
                  <span class="text-xs text-blue-700 font-bold mr-2">0{idx + 1}</span>
                  <a href={`/dusun/${dusun.id}`} class="hover:text-blue-700">
                    {dusun.nama}
                  </a>
                </td>
                <td class="p-4 sm:p-5 text-civic-navy font-bold">
                  {dusun.jumlah_rt}
                </td>
                <td class="p-4 sm:p-5">
                  <span class="inline-block px-2 py-0.5 border border-emerald-300 bg-emerald-50 text-emerald-900 text-xs font-bold">
                    {dusun.potensi_utama}
                  </span>
                </td>
                <td class="p-4 sm:p-5 text-civic-muted text-xs">
                  {dusun.deskripsi}
                </td>
                <td class="p-4 sm:p-5 text-right">
                  <a href={`/dusun/${dusun.id}`} class="text-xs font-bold text-blue-700 hover:text-blue-900 uppercase tracking-wider">
                    Detail &rarr;
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

    </div>
  </section>

<script is:inline define:vars={{ defaultProfil: profilData }}>
(() => {
  const PROFILE_KEY = 'timpik_profil_data';
  const PROFILE_API = '/api/content?key=profil';

  const $ = (id) => document.getElementById(id);

  function setText(id, value) {
    const element = $(id);

    if (!element || value === null || value === undefined) return;

    element.textContent = String(value);
  }

  function getNumber(value) {
    const number = String(value ?? '').replace(/[^0-9]/g, '');
    return Number.parseInt(number, 10) || 0;
  }

  function createGenderLabel(id, label, value, color) {
    const element = $(id);

    if (!element) return;

    const indicator = document.createElement('span');
    indicator.className = `w-3 h-3 ${color} rounded-sm inline-block`;

    element.replaceChildren(
      indicator,
      document.createTextNode(` ${label} (${value})`)
    );
  }

  function escapeHtml(value) {
    return String(value ?? '').replace(/[&<>"']/g, char => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#39;'
    })[char]);
  }

  function renderDusun(dusunList) {
    const container = $('stat-dusun-list');

    if (!container || !Array.isArray(dusunList)) return;

    if (!dusunList.length) {
      container.innerHTML = `
        <tr>
          <td colspan="5" class="p-6 text-center text-slate-500">
            Belum ada data dusun.
          </td>
        </tr>
      `;

      return;
    }

    container.innerHTML = dusunList.map((dusun, index) => {
      const id = encodeURIComponent(String(dusun.id || ''));

      return `
        <tr class="hover:bg-civic-sand/20 transition-colors">
          <td class="p-4 sm:p-5 font-bold text-civic-navy text-sm sm:text-base">
            <span class="text-xs text-blue-700 font-bold mr-2">
              ${String(index + 1).padStart(2, '0')}
            </span>
            <a href="/dusun/${id}" class="hover:text-blue-700">
              ${escapeHtml(dusun.nama || '-')}
            </a>
          </td>

          <td class="p-4 sm:p-5 text-civic-navy font-bold">
            ${escapeHtml(dusun.jumlah_rt || '-')}
          </td>

          <td class="p-4 sm:p-5">
            <span class="inline-block px-2 py-0.5 border border-emerald-300 bg-emerald-50 text-emerald-900 text-xs font-bold">
              ${escapeHtml(dusun.potensi_utama || '-')}
            </span>
          </td>

          <td class="p-4 sm:p-5 text-civic-muted text-xs">
            ${escapeHtml(dusun.deskripsi || '-')}
          </td>

          <td class="p-4 sm:p-5 text-right">
            <a href="/dusun/${id}" class="text-xs font-bold text-blue-700 hover:text-blue-900 uppercase tracking-wider">
              Detail &rarr;
            </a>
          </td>
        </tr>
      `;
    }).join('');
  }

  function applyProfile(profile) {
    if (!profile || typeof profile !== 'object') return;

    const stats = profile.statistik || {};

    setText('stat-total-penduduk', stats.total_penduduk);
    setText('stat-total-kk', stats.total_kk);
    setText('stat-luas-wilayah', stats.luas_wilayah);
    setText('stat-lahan-pertanian', stats.lahan_pertanian);

    const lk = stats.laki_laki ?? '';
    const pm = stats.perempuan ?? '';

    if (lk !== '') {
      createGenderLabel(
        'stat-laki-laki',
        'Laki-laki',
        lk,
        'bg-blue-700'
      );
    }

    if (pm !== '') {
      createGenderLabel(
        'stat-perempuan',
        'Perempuan',
        pm,
        'bg-indigo-700'
      );
    }

    const totalLk = getNumber(lk);
    const totalPm = getNumber(pm);
    const total = totalLk + totalPm;

    if (total > 0) {
      const percentageLk = (totalLk / total) * 100;
      const percentagePm = (totalPm / total) * 100;

      setText(
        'stat-persen-lk',
        `${percentageLk.toFixed(1)}%`
      );

      setText(
        'stat-persen-pm',
        `${percentagePm.toFixed(1)}%`
      );

      const barLk = $('stat-bar-lk');
      const barPm = $('stat-bar-pm');

      if (barLk) barLk.style.width = `${percentageLk}%`;
      if (barPm) barPm.style.width = `${percentagePm}%`;

      setText(
        'stat-gender-summary',
        `Data kependudukan Desa Timpik mencatat ${lk} penduduk laki-laki dan ${pm} penduduk perempuan dengan total ${stats.total_penduduk || `${total.toLocaleString('id-ID')} Jiwa`}.`
      );
    }

    if (Array.isArray(profile.dusun)) {
      renderDusun(profile.dusun);
    }
  }

  function extractProfile(detail) {
    const candidate = detail?.contents?.profil ?? detail?.profil;

    if (!candidate) return null;

    if (candidate.content_key === 'profil' && candidate.data) {
      return candidate.data;
    }

    return candidate.data && !candidate.statistik
      ? candidate.data
      : candidate;
  }

  async function loadLatestProfile() {
    try {
      const response = await fetch(PROFILE_API, {
        method: 'GET',
        cache: 'no-store',
        credentials: 'same-origin',
        headers: {
          Accept: 'application/json'
        }
      });

      if (!response.ok) {
        throw new Error(`Gagal mengambil profil: HTTP ${response.status}`);
      }

      const result = await response.json();

      if (
        result?.content_key !== 'profil' ||
        !result?.data ||
        typeof result.data !== 'object'
      ) {
        throw new Error('Format data profil dari API tidak sesuai.');
      }

      const latestProfile = result.data;

      localStorage.setItem(
        PROFILE_KEY,
        JSON.stringify(latestProfile)
      );

      applyProfile(latestProfile);

      console.info('Statistik desa berhasil diperbarui dari Supabase.');
    } catch (error) {
      console.error('Gagal memperbarui statistik desa:', error);
    }
  }

  applyProfile(defaultProfil);

  const globalProfile = window.__timpikSupabaseContent?.profil;

  if (globalProfile) {
    applyProfile(globalProfile.data || globalProfile);
  }

  window.addEventListener('timpik-supabase-content', event => {
    const profile = extractProfile(event.detail);

    if (profile) {
      applyProfile(profile);
    }
  });

  window.addEventListener('storage', event => {
    if (event.key !== PROFILE_KEY || !event.newValue) return;

    try {
      const profile = JSON.parse(event.newValue);
      applyProfile(profile);
    } catch (error) {
      console.warn('Gagal membaca pembaruan profil:', error);
    }
  });

  loadLatestProfile();
})();
</script>
</Layout>
