---
import Layout from '../layouts/Layout.astro';
import profilData from '../data/profil.json';
import agendaData from '../data/agenda.json';
import kontakData from '../data/kontak.json';

const dusun = profilData.dusun as Array<
  (typeof profilData.dusun)[number] & {
    foto?: string;
    potensi_utama?: string;
    jumlah_penduduk?: string;
    jumlah_rt?: string;
  }
>;

const pengumumanAwal = Array.isArray(profilData.pengumuman)
  ? profilData.pengumuman
  : [];

const categories = [
  'Semua Kategori',
  'Pertanian',
  'Kesehatan',
  'Kebudayaan',
  'Pemerintahan'
];
---

<Layout
  title="Informasi & Pengumuman Desa Timpik"
  description="Pusat informasi resmi Pemerintah Desa Timpik, Kecamatan Susukan, Kabupaten Semarang. Temukan pengumuman desa, agenda kegiatan, dan informasi wilayah."
>
  <!-- =====================================================
       HERO SECTION
  ====================================================== -->
  <section class="relative isolate overflow-hidden bg-slate-950 text-white">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top_right,rgba(59,130,246,0.24),transparent_55%),linear-gradient(135deg,#0f172a,#172554_60%,#1e3a8a)]"></div>

    <div class="absolute -right-24 -top-32 -z-10 h-96 w-96 rounded-full border border-white/10"></div>
    <div class="absolute -right-12 -top-20 -z-10 h-72 w-72 rounded-full border border-white/10"></div>

    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
      <nav class="mb-8 flex items-center gap-2 text-xs font-medium text-blue-200/70" aria-label="Breadcrumb">
        <a href="/" class="transition-colors hover:text-white">Beranda</a>
        <span class="text-white/30">/</span>
        <span class="text-white">Pusat Informasi</span>
      </nav>

      <div class="max-w-3xl">
        

        <h1 class="text-3xl font-black leading-tight tracking-tight sm:text-4xl lg:text-5xl">
          Informasi & Pengumuman
          <span class="block text-blue-300">Desa Timpik</span>
        </h1>

        <p class="mt-5 max-w-2xl text-sm leading-7 text-slate-300 sm:text-base">
          Temukan informasi terbaru mengenai pelayanan pemerintahan,
          kegiatan masyarakat, pertanian, dan perkembangan Desa Timpik
          dalam satu pusat informasi.
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="#pengumuman"
            class="inline-flex min-h-12 items-center justify-center gap-2 rounded-xl bg-blue-600 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-blue-950/30 transition hover:bg-blue-500"
          >
            Lihat Pengumuman
            <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
            </svg>
          </a>

          <a
            href="/kontak"
            class="inline-flex min-h-12 items-center justify-center gap-2 rounded-xl border border-white/20 bg-white/5 px-5 py-3 text-sm font-bold text-white transition hover:bg-white/10"
          >
            Hubungi Pemerintah Desa
            <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================
       PENGUMUMAN DESA
  ====================================================== -->
  <section id="pengumuman" class="scroll-mt-20 bg-slate-50 py-16 sm:py-20">
    <div class="mx-auto max-w-7xl space-y-8 px-4 sm:px-6 lg:px-8">

      <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
        <div class="max-w-2xl">
          <div class="mb-3 inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.16em] text-blue-700">
            <span class="h-px w-7 bg-blue-600"></span>
            Informasi Pemerintahan
          </div>

          <h2 class="text-2xl font-black tracking-tight text-slate-900 sm:text-3xl">
            Pengumuman Balai Desa
          </h2>

          <p class="mt-3 text-sm leading-6 text-slate-500 sm:text-base">
            Informasi resmi dan pemberitahuan terbaru dari Pemerintah Desa
            Timpik untuk seluruh masyarakat.
          </p>
        </div>

        <a
          href="/kontak"
          class="inline-flex min-h-11 shrink-0 items-center justify-center gap-2 self-start rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 shadow-sm transition hover:border-blue-200 hover:bg-blue-50 hover:text-blue-800 sm:self-auto"
        >
          <svg class="size-4 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a2 2 0 01.948.684l1.498 4.493a2 2 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a2 2 0 011.21-.502l4.493 1.498a2 2 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          Pusat Bantuan
        </a>
      </div>

      <!-- Pengumuman Dinamis -->
      <div
        id="info-pengumuman-grid"
        class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3"
        aria-live="polite"
      >
        {
          pengumumanAwal.filter((item) => item.status === 'terbit').length > 0
            ? pengumumanAwal
                .filter((item) => item.status === 'terbit')
                .map((item) => (
                  <article class="group flex min-h-full flex-col overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:border-blue-200 hover:shadow-xl hover:shadow-slate-200/60">
                    <div class="h-1 w-full bg-gradient-to-r from-blue-600 via-blue-500 to-cyan-400"></div>

                    <div class="flex flex-1 flex-col p-6 sm:p-7">
                      <div class="mb-5 flex items-center justify-between gap-3">
                        <span class="inline-flex max-w-[70%] items-center rounded-lg bg-blue-50 px-3 py-1.5 text-[10px] font-bold uppercase tracking-wider text-blue-800">
                          {item.kategori || 'Informasi Desa'}
                        </span>

                        {item.prioritas === 'penting' ? (
                          <span class="inline-flex items-center gap-1.5 text-[10px] font-bold text-rose-600">
                            <span class="size-1.5 rounded-full bg-rose-500"></span>
                            Penting
                          </span>
                        ) : (
                          <span class="text-[10px] font-semibold text-slate-400">
                            Informasi Desa
                          </span>
                        )}
                      </div>

                      <h3 class="text-lg font-extrabold leading-snug tracking-tight text-slate-900 transition-colors group-hover:text-blue-800">
                        {item.judul}
                      </h3>

                      <p class="mt-3 line-clamp-4 text-sm leading-7 text-slate-500">
                        {item.ringkasan || item.isi}
                      </p>

                      <div class="mt-auto flex items-center justify-between gap-3 border-t border-slate-100 pt-5">
                        <span class="text-xs font-medium text-slate-400">
                          {item.tanggal || 'Pemerintah Desa Timpik'}
                        </span>

                        {item.url && (
                          <a
                            href={item.url}
                            class="inline-flex min-h-10 items-center gap-1.5 text-xs font-bold text-blue-700 transition hover:gap-2.5 hover:text-blue-900"
                          >
                            {item.label_tautan || 'Selengkapnya'}
                            <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                            </svg>
                          </a>
                        )}
                      </div>
                    </div>
                  </article>
                ))
            : (
              <div class="col-span-full rounded-2xl border border-dashed border-slate-300 bg-white px-6 py-16 text-center">
                <div class="mx-auto flex size-14 items-center justify-center rounded-2xl bg-slate-100 text-slate-400">
                  <svg class="size-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2h-3l-2-2H8a2 2 0 00-2 2v4"/>
                  </svg>
                </div>

                <h3 class="mt-5 text-base font-bold text-slate-800">
                  Belum Ada Pengumuman
                </h3>

                <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-slate-500">
                  Informasi terbaru dari Pemerintah Desa Timpik akan ditampilkan di halaman ini.
                </p>
              </div>
            )
        }
      </div>
    </div>
  </section>

  <!-- =====================================================
       KALENDER AGENDA DESA
  ====================================================== -->
  <section id="agenda" class="border-t border-slate-200 bg-white py-16 sm:py-20">
    <div class="mx-auto max-w-7xl space-y-8 px-4 sm:px-6 lg:px-8">

      <div class="flex flex-col justify-between gap-5 lg:flex-row lg:items-end">
        <div class="max-w-2xl">
          <div class="mb-3 inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.16em] text-blue-700">
            <span class="h-px w-7 bg-blue-600"></span>
            Aktivitas Masyarakat
          </div>

          <h2 class="text-2xl font-black tracking-tight text-slate-900 sm:text-3xl">
            Kalender Agenda Desa
          </h2>

          <p class="mt-3 text-sm leading-6 text-slate-500 sm:text-base">
            Jadwal kegiatan masyarakat, posyandu, pertemuan warga,
            kegiatan pertanian, dan agenda pemerintahan desa.
          </p>
        </div>

        <a
          href="/agenda"
          class="inline-flex min-h-11 items-center justify-center gap-2 self-start rounded-xl bg-blue-700 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-blue-900/10 transition hover:bg-blue-800 lg:self-auto"
        >
          Buka Kalender Lengkap
          <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M7 7h10v10"/>
          </svg>
        </a>
      </div>

      <!-- Pencarian dan Filter -->
      <div class="flex flex-col gap-4 rounded-2xl border border-slate-200 bg-slate-50 p-4 sm:p-5 lg:flex-row lg:items-center lg:justify-between">
        <div class="relative w-full lg:max-w-sm">
          <svg class="absolute left-3.5 top-1/2 size-4 -translate-y-1/2 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>

          <input
            type="search"
            id="info-agenda-search"
            placeholder="Cari kegiatan atau lokasi..."
            class="min-h-11 w-full rounded-xl border border-slate-200 bg-white py-2.5 pl-10 pr-4 text-sm text-slate-800 outline-none transition placeholder:text-slate-400 focus:border-blue-400 focus:ring-4 focus:ring-blue-500/10"
          />
        </div>

        <div id="info-agenda-filters" class="flex gap-2 overflow-x-auto pb-1">
          {
            categories.map((cat, idx) => (
              <button
                type="button"
                data-category={cat}
                aria-pressed={idx === 0 ? 'true' : 'false'}
                class={`info-filter-btn min-h-10 shrink-0 rounded-lg px-4 py-2 text-xs font-bold transition ${
                  idx === 0
                    ? 'bg-blue-700 text-white shadow-sm'
                    : 'border border-slate-200 bg-white text-slate-600 hover:border-blue-200 hover:text-blue-700'
                }`}
              >
                {cat}
              </button>
            ))
          }
        </div>
      </div>

      <!-- Grid Agenda -->
      <div id="info-agenda-grid" class="grid grid-cols-1 gap-5 md:grid-cols-2">
        {
          agendaData.map((item) => {
            const badgeColor =
              item.kategori === 'Pertanian'
                ? 'bg-teal-50 text-teal-800 border-teal-200'
                : item.kategori === 'Kesehatan'
                  ? 'bg-emerald-50 text-emerald-800 border-emerald-200'
                  : item.kategori === 'Kebudayaan'
                    ? 'bg-indigo-50 text-indigo-800 border-indigo-200'
                    : item.kategori === 'Pemerintahan'
                      ? 'bg-purple-50 text-purple-800 border-purple-200'
                      : 'bg-blue-50 text-blue-800 border-blue-200';

            return (
              <article class="flex flex-col justify-between rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-blue-200 hover:shadow-lg">
                <div>
                  <div class="flex flex-wrap items-center justify-between gap-3">
                    <span class={`rounded-lg border px-3 py-1.5 text-[10px] font-bold uppercase tracking-wider ${badgeColor}`}>
                      {item.kategori}
                    </span>

                    <span class="rounded-lg bg-slate-50 px-3 py-1.5 text-xs font-bold text-slate-600">
                      {item.tanggal}
                    </span>
                  </div>

                  <h3 class="mt-5 text-lg font-extrabold leading-snug text-slate-900">
                    {item.nama}
                  </h3>

                  <p class="mt-3 text-sm leading-7 text-slate-500">
                    {item.deskripsi}
                  </p>

                  <div class="mt-5 grid grid-cols-1 gap-3 border-t border-slate-100 pt-4 text-xs text-slate-500 sm:grid-cols-2">
                    <div class="flex items-center gap-2">
                      <svg class="size-4 shrink-0 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                      </svg>
                      <span>{item.waktu}</span>
                    </div>

                    <div class="flex items-center gap-2">
                      <svg class="size-4 shrink-0 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                      </svg>
                      <span class="truncate">{item.lokasi}</span>
                    </div>
                  </div>
                </div>

                <div class="mt-5 flex flex-wrap items-center justify-between gap-2 border-t border-slate-100 pt-4 text-xs">
                  <span class="text-slate-500">
                    Penyelenggara:
                    <strong class="text-slate-800">{item.penyelenggara}</strong>
                  </span>

                  <span class="font-bold text-blue-700">
                    {item.peserta}
                  </span>
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- =====================================================
       DIREKTORI DUSUN
  ====================================================== -->
  <section class="border-t border-slate-200 bg-slate-50 py-16 sm:py-20">
    <div class="mx-auto max-w-7xl space-y-9 px-4 sm:px-6 lg:px-8">

      <div class="mx-auto max-w-2xl text-center">
        <div class="mb-3 inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.16em] text-blue-700">
          <span class="h-px w-7 bg-blue-600"></span>
          Wilayah Kependudukan
          <span class="h-px w-7 bg-blue-600"></span>
        </div>

        <h2 class="text-2xl font-black tracking-tight text-slate-900 sm:text-3xl">
          Mengenal Dusun Desa Timpik
        </h2>

        <p class="mt-3 text-sm leading-7 text-slate-500 sm:text-base">
          Desa Timpik memiliki 13 dusun dengan karakteristik,
          potensi wilayah, dan kehidupan masyarakat yang beragam.
        </p>
      </div>

      <div id="info-dusun-grid" class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {
          dusun.map((d) => (
            <article class="group overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-1 hover:border-blue-200 hover:shadow-xl">
              <div class="relative aspect-[16/9] overflow-hidden bg-gradient-to-br from-blue-100 to-slate-200">
                <div class="absolute inset-0 flex items-center justify-center text-xs font-semibold text-slate-500">
                  Foto dusun belum tersedia
                </div>

                {d.foto && (
                  <img
                    src={d.foto}
                    alt={`Foto wilayah ${d.nama}`}
                    width="640"
                    height="360"
                    loading="lazy"
                    decoding="async"
                    class="relative z-10 h-full w-full object-cover transition duration-500 group-hover:scale-105"
                  />
                )}
              </div>

              <div class="p-5">
                <div class="mb-4 flex size-11 items-center justify-center rounded-xl bg-blue-50 text-sm font-black text-blue-800">
                  {d.panggilan.slice(0, 2).toUpperCase()}
                </div>

                <h3 class="text-lg font-extrabold text-slate-900">
                  {d.nama}
                </h3>

                <p class="mt-2 line-clamp-3 text-sm leading-6 text-slate-500">
                  {d.deskripsi}
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- =====================================================
       CTA LAYANAN
  ====================================================== -->
  <section class="relative isolate overflow-hidden bg-slate-950 py-16 text-white sm:py-20">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top_left,rgba(59,130,246,0.25),transparent_55%),linear-gradient(120deg,#0f172a,#172554)]"></div>

    <div class="mx-auto max-w-5xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mx-auto flex size-14 items-center justify-center rounded-2xl border border-blue-300/20 bg-blue-400/10 text-blue-300">
        <svg class="size-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-4l-3 3-3-3z"/>
        </svg>
      </div>

      <h2 class="mt-6 text-2xl font-black tracking-tight sm:text-4xl">
        Ada yang Bisa Kami Bantu?
      </h2>

      <p class="mx-auto mt-4 max-w-2xl text-sm leading-7 text-slate-300 sm:text-base">
        Pemerintah Desa Timpik menyediakan berbagai layanan administrasi
        dan informasi untuk membantu kebutuhan masyarakat.
      </p>

      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a
          href="/layanan-surat"
          class="inline-flex min-h-12 items-center justify-center gap-2 rounded-xl bg-blue-600 px-6 py-3 text-sm font-bold text-white shadow-lg shadow-blue-950/30 transition hover:bg-blue-500"
        >
          <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 011.414 0L19 8v11a2 2 0 01-2 2z"/>
          </svg>
          Layanan Surat Online
        </a>

        <a
          href="/kontak"
          class="inline-flex min-h-12 items-center justify-center gap-2 rounded-xl border border-white/15 bg-white/5 px-6 py-3 text-sm font-bold text-white transition hover:bg-white/10"
        >
          <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a2 2 0 01.948.684l1.498 4.493a2 2 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a2 2 0 011.21-.502l4.493 1.498a2 2 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          Hubungi Balai Desa
        </a>
      </div>
    </div>
  </section>
</Layout>

<!-- =====================================================
     PENGUMUMAN: SUPABASE SYNCHRONIZATION
====================================================== -->
<script is:inline define:vars={{ initialPengumuman: pengumumanAwal }}>
  (() => {
    const STORAGE_KEY = 'timpik_pengumuman_list';
    const grid = document.getElementById('info-pengumuman-grid');

    if (!grid) return;

    const escapeHTML = (value) => String(value ?? '').replace(/[&<>"']/g, (char) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#39;'
    })[char]);

    const safeURL = (value) => {
      const raw = String(value ?? '').trim();
      if (!raw) return '';

      try {
        const parsed = new URL(raw, window.location.origin);

        if (!['http:', 'https:'].includes(parsed.protocol)) return '';

        return parsed.href;
      } catch {
        return '';
      }
    };

    const getAnnouncements = (data) => {
      if (!data || typeof data !== 'object') return null;

      if (Array.isArray(data[STORAGE_KEY])) {
        return data[STORAGE_KEY];
      }

      if (Array.isArray(data.pengumuman)) {
        return data.pengumuman;
      }

      if (Array.isArray(data.data)) {
        return data.data;
      }

      if (data.contents && Array.isArray(data.contents.pengumuman)) {
        return data.contents.pengumuman;
      }

      return null;
    };

    const getCategoryStyle = (category) => {
      const styles = {
        'Pertanian': 'bg-teal-50 text-teal-800',
        'Kesehatan': 'bg-emerald-50 text-emerald-800',
        'Kebudayaan': 'bg-indigo-50 text-indigo-800',
        'Pemerintahan': 'bg-purple-50 text-purple-800',
        'Administrasi Surat': 'bg-blue-50 text-blue-800',
        'Transparansi Anggaran': 'bg-amber-50 text-amber-800'
      };

      return styles[category] || 'bg-blue-50 text-blue-800';
    };

    const renderEmpty = () => {
      grid.innerHTML = `
        <div class="col-span-full rounded-2xl border border-dashed border-slate-300 bg-white px-6 py-16 text-center">
          <div class="mx-auto flex size-14 items-center justify-center rounded-2xl bg-slate-100 text-slate-400">
            <svg class="size-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2h-3l-2-2H8a2 2 0 00-2 2v4"/>
            </svg>
          </div>
          <h3 class="mt-5 text-base font-bold text-slate-800">Belum Ada Pengumuman</h3>
          <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-slate-500">
            Informasi terbaru dari Pemerintah Desa Timpik akan ditampilkan di halaman ini.
          </p>
        </div>
      `;
    };

    const renderAnnouncements = (items) => {
      const published = Array.isArray(items)
        ? items.filter(item => {
            const status = String(item?.status || '').toLowerCase();
            return status === 'terbit' || status === 'published';
          })
        : [];

      if (published.length === 0) {
        renderEmpty();
        return;
      }

      const sorted = [...published].sort((a, b) => {
        const priority = (String(b.prioritas).toLowerCase() === 'penting' ? 1 : 0)
          - (String(a.prioritas).toLowerCase() === 'penting' ? 1 : 0);

        return priority || String(b.tanggal || b.dibuat_pada || '')
          .localeCompare(String(a.tanggal || a.dibuat_pada || ''));
      });

      grid.innerHTML = sorted.map(item => {
        const category = escapeHTML(item.kategori || 'Informasi Desa');
        const categoryClass = getCategoryStyle(item.kategori);
        const title = escapeHTML(item.judul || 'Pengumuman Desa');
        const description = escapeHTML(item.ringkasan || item.isi || '');
        const date = escapeHTML(item.tanggal || 'Pemerintah Desa Timpik');
        const isImportant = String(item.prioritas || '').toLowerCase() === 'penting';
        const url = safeURL(item.url);
        const linkLabel = escapeHTML(item.label_tautan || 'Selengkapnya');

        return `
          <article class="group flex min-h-full flex-col overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:border-blue-200 hover:shadow-xl hover:shadow-slate-200/60">
            <div class="h-1 w-full bg-gradient-to-r from-blue-600 via-blue-500 to-cyan-400"></div>

            <div class="flex flex-1 flex-col p-6 sm:p-7">
              <div class="mb-5 flex items-center justify-between gap-3">
                <span class="inline-flex max-w-[70%] items-center rounded-lg px-3 py-1.5 text-[10px] font-bold uppercase tracking-wider ${categoryClass}">
                  ${category}
                </span>

                ${isImportant
                  ? `<span class="inline-flex items-center gap-1.5 text-[10px] font-bold text-rose-600"><span class="size-1.5 rounded-full bg-rose-500"></span>Penting</span>`
                  : `<span class="text-[10px] font-semibold text-slate-400">Informasi Desa</span>`
                }
              </div>

              <h3 class="text-lg font-extrabold leading-snug tracking-tight text-slate-900 transition-colors group-hover:text-blue-800">
                ${title}
              </h3>

              <p class="mt-3 line-clamp-4 text-sm leading-7 text-slate-500">
                ${description}
              </p>

              <div class="mt-auto flex items-center justify-between gap-3 border-t border-slate-100 pt-5">
                <span class="text-xs font-medium text-slate-400">
                  ${date}
                </span>

                ${url ? `
                  <a href="${escapeHTML(url)}" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-10 items-center gap-1.5 text-xs font-bold text-blue-700 transition hover:gap-2.5 hover:text-blue-900">
                    ${linkLabel}
                    <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                  </a>
                ` : ''}
              </div>
            </div>
          </article>
        `;
      }).join('');

      console.info(`[Pengumuman] ${published.length} pengumuman berhasil ditampilkan.`);
    };

    // 1. Tampilkan data awal dari profil.json.
    renderAnnouncements(initialPengumuman);

    // 2. Baca data Supabase yang mungkin sudah dimuat Layout.
    const remoteData = getAnnouncements(window.__timpikSupabaseContent);

    if (remoteData !== null) {
      renderAnnouncements(remoteData);
    }

    // 3. Dengarkan pembaruan dari Layout.
    window.addEventListener('timpik-supabase-content', (event) => {
      const updatedData = getAnnouncements(event.detail);

      if (updatedData !== null) {
        renderAnnouncements(updatedData);
      }
    });

    // 4. Ambil data terbaru langsung dari endpoint.
    const loadPublicAnnouncements = async () => {
      try {
        const response = await fetch('/api/content?key=pengumuman', {
          method: 'GET',
          cache: 'no-store'
        });

        if (!response.ok) {
          throw new Error(`HTTP ${response.status}: Gagal mengambil pengumuman.`);
        }

        const result = await response.json();
        const announcements = getAnnouncements(result);

        if (announcements === null) {
          console.error('[Pengumuman] Format respons tidak dikenali:', result);
          return;
        }

        // Simpan cache dan render data terbaru.
        localStorage.setItem(STORAGE_KEY, JSON.stringify(announcements));
        renderAnnouncements(announcements);

        console.info(`[Pengumuman] ${announcements.length} data berhasil dimuat dari Supabase.`);
      } catch (error) {
        console.error('[Pengumuman] Gagal memuat data:', error);
      }
    };

    loadPublicAnnouncements();
  })();
</script>

<!-- =====================================================
     DIREKTORI DUSUN: SUPABASE SYNCHRONIZATION
====================================================== -->
<script>
  const escapeInfoDusun = (value: unknown) => {
    return String(value ?? '').replace(/[&<>"']/g, (char) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#39;'
    })[char]);
  };

  const safeInfoDusunPhoto = (value: unknown) => {
    try {
      const url = new URL(String(value ?? ''));

      return url.protocol === 'https:' &&
        url.hostname.endsWith('.supabase.co') &&
        url.pathname.startsWith('/storage/v1/object/public/dusun/')
        ? url.href
        : '';
    } catch {
      return '';
    }
  };

  const renderInfoDusun = (items: unknown) => {
    const grid = document.getElementById('info-dusun-grid');

    if (!grid || !Array.isArray(items)) return;

    if (items.length === 0) {
      grid.innerHTML = `
        <div class="col-span-full rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center text-sm text-slate-500">
          Informasi wilayah dusun belum tersedia.
        </div>
      `;
      return;
    }

    grid.innerHTML = items.map((dusun: any) => {
      const name = escapeInfoDusun(
        dusun?.nama || 'Wilayah Desa Timpik'
      );

      const photo = safeInfoDusunPhoto(dusun?.foto);
      const id = String(dusun?.id ?? '').trim();

      return `
        <article class="group overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-1 hover:border-blue-200 hover:shadow-xl">
          <div class="relative aspect-[16/9] overflow-hidden bg-gradient-to-br from-blue-100 to-slate-200">
            <div class="absolute inset-0 flex items-center justify-center text-xs font-semibold text-slate-500">
              Foto dusun belum tersedia
            </div>

            ${photo ? `
              <img src="${escapeInfoDusun(photo)}" alt="Foto wilayah ${name}" width="640" height="360" loading="lazy" decoding="async" class="relative z-10 h-full w-full object-cover transition duration-500 group-hover:scale-105" />
            ` : ''}
          </div>

          <div class="p-5">
            <div class="mb-4 flex size-11 items-center justify-center rounded-xl bg-blue-50 text-sm font-black text-blue-800">
              ${escapeInfoDusun(String(dusun?.panggilan || name).slice(0, 2).toUpperCase())}
            </div>

            <h3 class="text-lg font-extrabold text-slate-900">${name}</h3>

            ${dusun?.potensi_utama ? `
              <p class="mt-2 text-xs font-bold text-blue-800">
                ${escapeInfoDusun(dusun.potensi_utama)}
              </p>
            ` : ''}

            <p class="mt-2 line-clamp-3 text-sm leading-6 text-slate-500">
              ${escapeInfoDusun(dusun?.deskripsi || '')}
            </p>

            <div class="mt-5 space-y-2 border-t border-slate-100 pt-4 text-xs text-slate-600">
              <div class="flex items-center justify-between gap-3">
                <span>Penduduk</span>
                <strong class="text-slate-900">${escapeInfoDusun(dusun?.jumlah_penduduk || '-')}</strong>
              </div>

              <div class="flex items-center justify-between gap-3">
                <span>Wilayah RT/RW</span>
                <strong class="text-slate-900">${escapeInfoDusun(dusun?.jumlah_rt || '-')}</strong>
              </div>
            </div>

            ${id ? `
              <a href="/dusun/${encodeURIComponent(id)}" class="mt-4 flex min-h-11 items-center justify-center rounded-xl border border-blue-200 bg-blue-50 px-3 py-2.5 text-center text-xs font-bold text-blue-900 transition hover:bg-blue-100">
                Detail Dusun ${escapeInfoDusun(dusun?.panggilan || '')} →
              </a>
            ` : ''}
          </div>
        </article>
      `;
    }).join('');
  };

  const existingProfil = (window as any).__timpikSupabaseContent?.profil;

  if (Array.isArray(existingProfil?.dusun)) {
    renderInfoDusun(existingProfil.dusun);
  }

  window.addEventListener('timpik-supabase-content', (event: Event) => {
    const profil = (event as CustomEvent).detail?.profil;

    if (Array.isArray(profil?.dusun)) {
      renderInfoDusun(profil.dusun);
    }
  });
</script>

<!-- =====================================================
     AGENDA: SEARCH, FILTER, AND LOCAL DATA
====================================================== -->
<script is:inline define:vars={{ initialAgenda: agendaData }}>
  (() => {
    const STORAGE_KEY = 'timpik_agenda_list';

    const grid = document.getElementById('info-agenda-grid');
    const searchInput = document.getElementById('info-agenda-search');
    const filterBtns = document.querySelectorAll('.info-filter-btn');

    if (!grid) return;

    let agendaList = Array.isArray(initialAgenda)
      ? initialAgenda
      : [];

    let activeCategory = 'Semua Kategori';
    let searchTerm = '';

    // Ambil data agenda terbaru dari penyimpanan lokal.
    try {
      const storedAgenda = localStorage.getItem(STORAGE_KEY);

      if (storedAgenda) {
        const parsed = JSON.parse(storedAgenda);

        if (Array.isArray(parsed)) {
          agendaList = parsed;
        }
      }
    } catch (error) {
      console.warn('Gagal membaca data agenda:', error);
    }

    const escapeHTML = (value) => {
      return String(value ?? '').replace(/[&<>"']/g, (char) => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;'
      })[char]);
    };

    const categoryStyle = (category) => {
      const styles = {
        'Pertanian': 'bg-teal-50 text-teal-800 border-teal-200',
        'Kesehatan': 'bg-emerald-50 text-emerald-800 border-emerald-200',
        'Kebudayaan': 'bg-indigo-50 text-indigo-800 border-indigo-200',
        'Pemerintahan': 'bg-purple-50 text-purple-800 border-purple-200'
      };

      return styles[category] || 'bg-blue-50 text-blue-800 border-blue-200';
    };

    const renderAgenda = () => {
      const filtered = agendaList.filter((item) => {
        const matchCategory =
          activeCategory === 'Semua Kategori' ||
          item.kategori === activeCategory;

        const searchableText = [
          item.nama,
          item.deskripsi,
          item.lokasi,
          item.penyelenggara
        ].join(' ').toLowerCase();

        const matchSearch =
          !searchTerm || searchableText.includes(searchTerm);

        return matchCategory && matchSearch;
      });

      if (filtered.length === 0) {
        grid.innerHTML = `
          <div class="col-span-full rounded-2xl border border-dashed border-slate-300 bg-slate-50 px-6 py-14 text-center">
            <div class="mx-auto flex size-12 items-center justify-center rounded-xl bg-white text-slate-400 shadow-sm">
              <svg class="size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
              </svg>
            </div>

            <p class="mt-4 text-sm font-bold text-slate-700">
              Tidak ada agenda yang ditemukan.
            </p>

            <p class="mt-1 text-xs text-slate-400">
              Coba gunakan kata kunci lain atau pilih kategori berbeda.
            </p>
          </div>
        `;

        return;
      }

      grid.innerHTML = filtered.map((item) => `
        <article class="flex flex-col justify-between rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-blue-200 hover:shadow-lg">
          <div>
            <div class="flex flex-wrap items-center justify-between gap-3">
              <span class="rounded-lg border px-3 py-1.5 text-[10px] font-bold uppercase tracking-wider ${categoryStyle(item.kategori)}">
                ${escapeHTML(item.kategori)}
              </span>

              <span class="rounded-lg bg-slate-50 px-3 py-1.5 text-xs font-bold text-slate-600">
                ${escapeHTML(item.tanggal)}
              </span>
            </div>

            <h3 class="mt-5 text-lg font-extrabold leading-snug text-slate-900">
              ${escapeHTML(item.nama)}
            </h3>

            <p class="mt-3 text-sm leading-7 text-slate-500">
              ${escapeHTML(item.deskripsi)}
            </p>

            <div class="mt-5 grid grid-cols-1 gap-3 border-t border-slate-100 pt-4 text-xs text-slate-500 sm:grid-cols-2">
              <div class="flex items-center gap-2">
                <svg class="size-4 shrink-0 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <span>${escapeHTML(item.waktu)}</span>
              </div>

              <div class="flex items-center gap-2">
                <svg class="size-4 shrink-0 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                </svg>
                <span class="truncate">${escapeHTML(item.lokasi)}</span>
              </div>
            </div>
          </div>

          <div class="mt-5 flex flex-wrap items-center justify-between gap-2 border-t border-slate-100 pt-4 text-xs">
            <span class="text-slate-500">
              Penyelenggara:
              <strong class="text-slate-800">${escapeHTML(item.penyelenggara)}</strong>
            </span>

            <span class="font-bold text-blue-700">
              ${escapeHTML(item.peserta)}
            </span>
          </div>
        </article>
      `).join('');
    };

    // Pencarian agenda.
    searchInput?.addEventListener('input', (event) => {
      searchTerm = event.target.value.trim().toLowerCase();
      renderAgenda();
    });

    // Filter kategori agenda.
    filterBtns.forEach((button) => {
      button.addEventListener('click', () => {
        filterBtns.forEach((btn) => {
          btn.className = 'info-filter-btn min-h-10 shrink-0 rounded-lg border border-slate-200 bg-white px-4 py-2 text-xs font-bold text-slate-600 transition hover:border-blue-200 hover:text-blue-700';
          btn.setAttribute('aria-pressed', 'false');
        });

        button.className = 'info-filter-btn min-h-10 shrink-0 rounded-lg bg-blue-700 px-4 py-2 text-xs font-bold text-white shadow-sm transition';
        button.setAttribute('aria-pressed', 'true');

        activeCategory = button.getAttribute('data-category') || 'Semua Kategori';

        renderAgenda();
      });
    });

    renderAgenda();
  })();
</script>