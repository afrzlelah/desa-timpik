---
import Layout from '../layouts/Layout.astro';
import profilData from '../data/profil.json';
import agendaData from '../data/agenda.json';
import kontakData from '../data/kontak.json';

const dusun = profilData.dusun as Array<(typeof profilData.dusun)[number] & { foto?: string }>;
const { statistik } = profilData;
const { operasional } = kontakData;

const categories = [
  'Semua Kategori',
  'Pertanian',
  'Kesehatan',
  'Kebudayaan',
  'Pemerintahan'
];
---

<Layout
  title="Pusat Informasi & Pengumuman Resmi Desa Timpik"
  description="Pusat informasi terpadu Pemerintah Desa Timpik, Kecamatan Susukan, Kabupaten Semarang: pengumuman balai desa, kalender agenda kegiatan warga, jam pelayanan, dan profil 13 dusun."
>
  <section class="relative overflow-hidden border-b border-white/10 bg-gradient-to-br from-blue-950 via-blue-900 to-blue-800 py-14 text-white lg:py-20">
    <div class="absolute -right-20 -top-24 h-80 w-80 rounded-full bg-blue-400/10 blur-3xl"></div>
    <div class="absolute -bottom-32 left-1/3 h-72 w-72 rounded-full bg-indigo-400/10 blur-3xl"></div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <nav class="mb-6 flex items-center gap-2 text-xs text-blue-200/70" aria-label="Breadcrumb">
        <a href="/" class="transition-colors hover:text-white">Beranda</a>
        <span>/</span>
        <span class="font-semibold text-blue-200">Pusat Informasi Desa</span>
      </nav>

      <div class="max-w-3xl space-y-5">
        <div class="inline-flex items-center gap-2 rounded-full border border-blue-400/20 bg-blue-800/50 px-3 py-1.5 text-xs font-semibold text-blue-100">
          <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
          Informasi Resmi Pemerintah Desa
        </div>

        <h1 class="text-3xl font-black leading-tight tracking-tight text-white sm:text-4xl lg:text-5xl">
          Informasi & Pengumuman Desa Timpik
        </h1>

        <p class="max-w-2xl text-sm leading-relaxed text-blue-100/80 sm:text-base">
          Pusat informasi terpadu untuk mengetahui pengumuman resmi, agenda kegiatan, dan informasi wilayah Desa Timpik.
        </p>

        <div class="flex flex-wrap gap-3 pt-2">
          <a href="#pengumuman" class="inline-flex min-h-11 items-center justify-center rounded-xl bg-white px-5 py-2.5 text-sm font-bold text-blue-950 transition-colors hover:bg-blue-50">
            Lihat Pengumuman
          </a>
          <a href="#agenda" class="inline-flex min-h-11 items-center justify-center rounded-xl border border-white/20 bg-white/10 px-5 py-2.5 text-sm font-bold text-white transition-colors hover:bg-white/15">
            Kalender Kegiatan
          </a>
        </div>
      </div>
    </div>
  </section>

  <section id="pengumuman" class="bg-gray-100 py-14 sm:py-16">
    <div class="mx-auto max-w-7xl space-y-8 px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
        <div class="max-w-2xl">
          <div class="mb-3 inline-flex items-center gap-2 rounded-full bg-blue-100 px-3 py-1 text-xs font-bold uppercase tracking-wider text-blue-900">
            <span class="h-1.5 w-1.5 rounded-full bg-blue-700"></span>
            Papan Informasi
          </div>

          <h2 class="text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">
            Pengumuman Balai Desa Timpik
          </h2>

          <p class="mt-2 text-sm leading-relaxed text-slate-600 sm:text-base">
            Informasi resmi mengenai pelayanan administrasi, kegiatan masyarakat, pertanian, dan kebijakan pemerintah desa.
          </p>
        </div>

        <a href="/kontak" class="inline-flex min-h-11 shrink-0 items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-5 py-2.5 text-sm font-bold text-slate-800 shadow-sm transition-all hover:border-blue-200 hover:bg-blue-50 hover:text-blue-900">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          Pusat Bantuan Balai Desa
        </a>
      </div>

      <div class="flex flex-col gap-3 sm:flex-row">
        <div class="relative flex-1">
          <svg class="absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <input
            id="info-pengumuman-search"
            type="search"
            placeholder="Cari judul atau isi pengumuman..."
            class="min-h-12 w-full rounded-xl border border-slate-200 bg-white py-3 pl-11 pr-4 text-sm text-slate-900 outline-none transition-all placeholder:text-slate-400 focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10"
          />
        </div>

        <div class="relative sm:w-60">
          <select id="info-pengumuman-filter" class="min-h-12 w-full appearance-none rounded-xl border border-slate-200 bg-white px-4 py-3 pr-10 text-sm font-medium text-slate-700 outline-none transition-all focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10">
            <option value="Semua Kategori">Semua Kategori</option>
            <option value="Pertanian">Pertanian</option>
            <option value="Kesehatan">Kesehatan</option>
            <option value="Kebudayaan">Kebudayaan</option>
            <option value="Pemerintahan">Pemerintahan</option>
            <option value="Administrasi">Administrasi</option>
            <option value="Sosial">Sosial</option>
            <option value="Lainnya">Lainnya</option>
          </select>
          <svg class="pointer-events-none absolute right-4 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19 9-7 7-7-7"/>
          </svg>
        </div>
      </div>

      <div class="flex items-center justify-between gap-3">
        <p id="info-pengumuman-count" class="text-xs font-medium text-slate-500">
          Memuat pengumuman...
        </p>
        <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-700">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
          Informasi publik
        </span>
      </div>

      <div id="info-pengumuman-grid" class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
        <div class="col-span-full rounded-2xl border border-slate-200 bg-white p-10 text-center">
          <div class="mx-auto mb-3 h-7 w-7 animate-spin rounded-full border-2 border-blue-200 border-t-blue-700"></div>
          <p class="text-sm font-medium text-slate-500">Memuat informasi pengumuman...</p>
        </div>
      </div>
    </div>
  </section>

  <section id="agenda" class="border-t border-white/70 bg-gray-100 py-14 sm:py-16">
    <div class="mx-auto max-w-7xl space-y-8 px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <div>
          <div class="mb-3 inline-flex items-center gap-2 rounded-full bg-indigo-100 px-3 py-1 text-xs font-bold uppercase tracking-wider text-indigo-900">
            Kalender Desa
          </div>

          <h2 class="text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">
            Kalender Agenda Kegiatan Desa
          </h2>

          <p class="mt-2 text-sm leading-relaxed text-slate-600 sm:text-base">
            Jadwal kegiatan warga, posyandu dusun, rembuk warga, dan agenda desa terkini.
          </p>
        </div>

        <a href="/agenda" class="inline-flex min-h-11 items-center justify-center gap-2 rounded-xl bg-blue-900 px-5 py-2.5 text-sm font-bold text-white shadow-sm transition-all hover:bg-blue-950">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          Buka Kalender Lengkap
        </a>
      </div>

      <div class="space-y-4">
        <div class="relative max-w-md">
          <svg class="absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <input
            type="search"
            id="info-agenda-search"
            placeholder="Cari kegiatan atau lokasi..."
            class="min-h-11 w-full rounded-xl border border-slate-300 bg-white py-2.5 pl-11 pr-4 text-sm text-slate-900 outline-none transition-all focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10"
          />
        </div>

        <div class="flex gap-2 overflow-x-auto pb-2" id="info-agenda-filters">
          {categories.map((cat, idx) => (
            <button
              type="button"
              data-category={cat}
              class={`info-filter-btn min-h-10 shrink-0 rounded-xl px-4 py-2 text-xs font-bold transition-all sm:text-sm ${idx === 0 ? 'bg-blue-900 text-white shadow-sm' : 'border border-slate-200 bg-white text-slate-700 hover:bg-slate-50'}`}
            >
              {cat}
            </button>
          ))}
        </div>
      </div>

      <div id="info-agenda-grid" class="grid grid-cols-1 gap-5 md:grid-cols-2">
        {agendaData.map((item) => {
          let badgeColor = 'bg-blue-50 text-blue-900 border-blue-200';
          if (item.kategori === 'Pertanian') badgeColor = 'bg-teal-50 text-teal-900 border-teal-200';
          if (item.kategori === 'Kesehatan') badgeColor = 'bg-emerald-50 text-emerald-900 border-emerald-200';
          if (item.kategori === 'Kebudayaan') badgeColor = 'bg-indigo-50 text-indigo-900 border-indigo-200';
          if (item.kategori === 'Pemerintahan') badgeColor = 'bg-purple-50 text-purple-900 border-purple-200';

          return (
            <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition-all hover:-translate-y-1 hover:shadow-md sm:p-7">
              <div class="space-y-4">
                <div class="flex items-center justify-between gap-3">
                  <span class={`rounded-lg border px-2.5 py-1 text-xs font-bold ${badgeColor}`}>
                    {item.kategori}
                  </span>
                  <span class="rounded-lg bg-slate-50 px-2.5 py-1 font-mono text-xs font-bold text-slate-600">
                    {item.tanggal}
                  </span>
                </div>

                <h3 class="text-lg font-bold leading-snug text-slate-900">
                  {item.nama}
                </h3>

                <p class="text-sm leading-relaxed text-slate-600">
                  {item.deskripsi}
                </p>

                <div class="grid grid-cols-1 gap-3 border-t border-slate-100 pt-4 text-sm text-slate-600 sm:grid-cols-2">
                  <div class="flex items-center gap-2">
                    <svg class="h-4 w-4 shrink-0 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <span>{item.waktu}</span>
                  </div>

                  <div class="flex items-center gap-2">
                    <svg class="h-4 w-4 shrink-0 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    </svg>
                    <span class="truncate">{item.lokasi}</span>
                  </div>
                </div>
              </div>

              <div class="mt-4 flex items-center justify-between gap-3 border-t border-slate-100 pt-3 text-xs text-slate-500">
                <span>Penyelenggara: <strong class="text-slate-800">{item.penyelenggara}</strong></span>
                <span class="font-bold text-blue-900">{item.peserta}</span>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="border-t border-white/70 bg-gray-100 py-14 sm:py-16">
    <div class="mx-auto max-w-7xl space-y-8 px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <span class="rounded-full bg-blue-100 px-3 py-1 text-xs font-bold uppercase tracking-wider text-blue-900">
          Wilayah Kependudukan
        </span>

        <h2 class="mt-3 text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">
          13 Dusun Desa Timpik
        </h2>

        <p class="mt-2 text-sm leading-relaxed text-slate-600 sm:text-base">
          Desa Timpik menaungi 13 dusun dengan keunikan potensi kesenian, pertanian sawah, dan kerukunan warga.
        </p>
      </div>

      <div id="info-dusun-grid" class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {dusun.map((d) => (
          <article class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition-all hover:-translate-y-1 hover:shadow-md">
            <div class="relative aspect-[16/9] bg-gradient-to-br from-blue-100 to-slate-200">
              <div class="absolute inset-0 flex items-center justify-center text-sm font-semibold text-slate-500">
                Foto dusun belum tersedia
              </div>
              {d.foto && (
                <img
                  src={d.foto}
                  alt={`Foto wilayah ${d.nama}`}
                  width="640"
                  height="360"
                  loading="lazy"
                  decoding="async"
                  class="dusun-photo relative h-full w-full object-cover"
                />
              )}
            </div>

            <div class="flex flex-1 flex-col justify-between p-5">
              <div>
                <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-blue-100 text-sm font-black text-blue-900">
                  {d.panggilan.slice(0, 2).toUpperCase()}
                </div>

                <h3 class="mb-1 text-lg font-bold text-slate-900">{d.nama}</h3>
                <p class="line-clamp-3 text-sm leading-relaxed text-slate-600">{d.deskripsi}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-gradient-to-br from-blue-950 via-blue-900 to-blue-800 py-16 text-white">
    <div class="mx-auto max-w-5xl space-y-6 px-4 text-center sm:px-6 lg:px-8">
      <span class="rounded-full border border-blue-700 bg-blue-900/80 px-3.5 py-1.5 text-xs font-bold text-blue-200">
        Layanan Cepat & Tanggap
      </span>

      <h2 class="text-2xl font-extrabold tracking-tight sm:text-4xl">
        Butuh Bantuan Administrasi atau Menghubungi Perangkat Desa?
      </h2>

      <p class="mx-auto max-w-2xl text-sm leading-relaxed text-blue-100 sm:text-base">
        Pemerintah Desa Timpik menyediakan akses layanan surat online, kontak siaga balai desa & medis, serta kanal pengaduan warga.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
        <a href="/layanan-surat" class="inline-flex min-h-12 items-center justify-center rounded-xl bg-blue-600 px-6 py-3 text-sm font-bold text-white shadow-lg transition-all hover:bg-blue-700">
          Buat Surat Mandiri Online
        </a>

        <a href="/kontak" class="inline-flex min-h-12 items-center justify-center rounded-xl border border-slate-700 bg-slate-800 px-6 py-3 text-sm font-bold text-white transition-all hover:bg-slate-700">
          Kontak Balai Desa
        </a>

        <a href="/layanan-aduan" class="inline-flex min-h-12 items-center justify-center rounded-xl bg-rose-700 px-6 py-3 text-sm font-bold text-white transition-all hover:bg-rose-800">
          Sampaikan Aduan Warga
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  const escapeInfoDusun = (value: unknown) =>
    String(value ?? '').replace(/[&<>"']/g, (char) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#39;'
    })[char] || char);

  const safeInfoDusunPhoto = (value: unknown) => {
    try {
      const url = new URL(String(value ?? ''));
      return url.protocol === 'https:' &&
        url.hostname.endsWith('.supabase.co') &&
        url.pathname.startsWith('/storage/v1/object/public/dusun/')
        ? url.href
        : '';
    } catch {
      return '';
    }
  };

  const renderInfoDusun = (items: unknown) => {
    const grid = document.getElementById('info-dusun-grid');
    if (!grid || !Array.isArray(items)) return;

    grid.innerHTML = items.map((dusun: any) => {
      const name = escapeInfoDusun(dusun?.nama || 'Wilayah Desa Timpik');
      const photo = safeInfoDusunPhoto(dusun?.foto);
      const id = String(dusun?.id ?? '').trim();

      return `
        <article class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition-all hover:-translate-y-1 hover:shadow-md">
          <div class="relative aspect-[16/9] bg-gradient-to-br from-blue-100 to-slate-200">
            <div class="absolute inset-0 flex items-center justify-center text-sm font-semibold text-slate-500">Foto dusun belum tersedia</div>
            ${photo ? `<img src="${escapeInfoDusun(photo)}" alt="Foto wilayah ${name}" width="640" height="360" loading="lazy" decoding="async" class="relative h-full w-full object-cover" />` : ''}
          </div>
          <div class="p-5">
            <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-blue-100 text-sm font-black text-blue-900">${escapeInfoDusun(String(dusun?.panggilan || name).slice(0, 2).toUpperCase())}</div>
            <h3 class="mb-1 text-lg font-bold text-slate-900">${name}</h3>
            <p class="mb-2 text-sm font-bold text-blue-900">${escapeInfoDusun(dusun?.potensi_utama || '')}</p>
            <p class="mb-4 line-clamp-3 text-sm leading-relaxed text-slate-600">${escapeInfoDusun(dusun?.deskripsi || '')}</p>
            <div class="space-y-2 border-t border-slate-100 pt-3 text-sm text-slate-700">
              <div class="flex justify-between gap-2">
                <span class="text-slate-500">Penduduk:</span>
                <span class="font-bold text-slate-900">${escapeInfoDusun(dusun?.jumlah_penduduk || '-')}</span>
              </div>
              <div class="flex justify-between gap-2">
                <span class="text-slate-500">Wilayah RT/RW:</span>
                <span class="font-semibold text-slate-900">${escapeInfoDusun(dusun?.jumlah_rt || '-')}</span>
              </div>
              ${id ? `<a href="/dusun/${encodeURIComponent(id)}" class="mt-2 flex min-h-11 items-center justify-center rounded-xl border border-blue-200 bg-blue-50 px-3 py-2.5 text-center text-sm font-bold text-blue-950 transition-colors hover:bg-blue-100">Detail Dusun ${escapeInfoDusun(dusun?.panggilan || '')} →</a>` : ''}
            </div>
          </div>
        </article>
      `;
    }).join('');
  };

  const existingProfil = (window as any).__timpikSupabaseContent?.profil;

  if (Array.isArray(existingProfil?.dusun)) {
    renderInfoDusun(existingProfil.dusun);
  }

  window.addEventListener('timpik-supabase-content', (event: Event) => {
    const profil = (event as CustomEvent).detail?.profil;
    if (Array.isArray(profil?.dusun)) {
      renderInfoDusun(profil.dusun);
    }
  });
</script>

<script is:inline define:vars={{ initialAgenda: agendaData }}>
  const announcementStorageKey = 'timpik_pengumuman_list';
  const agendaStorageKey = 'timpik_agenda_list';

  const announcementGrid = document.getElementById('info-pengumuman-grid');
  const announcementSearch = document.getElementById('info-pengumuman-search');
  const announcementFilter = document.getElementById('info-pengumuman-filter');
  const announcementCount = document.getElementById('info-pengumuman-count');

  let announcementList = [];
  let announcementSearchTerm = '';
  let announcementCategory = 'Semua Kategori';

  const escapeHTML = (value) => String(value ?? '').replace(/[&<>"']/g, (char) => ({
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
    "'": '&#39;'
  })[char]);

  const safeAnnouncementUrl = (value) => {
    const raw = String(value ?? '').trim();
    if (!raw) return '';

    if (raw.startsWith('/') && !raw.startsWith('//')) {
      return raw;
    }

    try {
      const url = new URL(raw);
      return ['http:', 'https:'].includes(url.protocol) ? url.href : '';
    } catch {
      return '';
    }
  };

  const formatAnnouncementDate = (value) => {
    if (!value) return 'Tanggal tidak tersedia';

    const date = new Date(`${value}T00:00:00`);
    if (Number.isNaN(date.getTime())) return escapeHTML(value);

    return new Intl.DateTimeFormat('id-ID', {
      day: 'numeric',
      month: 'long',
      year: 'numeric'
    }).format(date);
  };

  const getAnnouncementBadge = (category) => {
    const colors = {
      Pertanian: 'bg-teal-50 text-teal-800 border-teal-200',
      Kesehatan: 'bg-emerald-50 text-emerald-800 border-emerald-200',
      Kebudayaan: 'bg-indigo-50 text-indigo-800 border-indigo-200',
      Pemerintahan: 'bg-purple-50 text-purple-800 border-purple-200',
      Administrasi: 'bg-blue-50 text-blue-800 border-blue-200',
      Sosial: 'bg-rose-50 text-rose-800 border-rose-200',
      Lainnya: 'bg-slate-100 text-slate-700 border-slate-200'
    };

    return colors[category] || colors.Lainnya;
  };

  const renderAnnouncements = () => {
    if (!announcementGrid) return;

    const published = announcementList.filter((item) =>
      String(item?.status || '').toLowerCase() === 'terbit'
    );

    const filtered = published
      .filter((item) => {
        const categoryMatch =
          announcementCategory === 'Semua Kategori' ||
          item.kategori === announcementCategory;

        const searchable = [
          item.judul,
          item.kategori,
          item.ringkasan,
          item.isi
        ].join(' ').toLowerCase();

        const searchMatch =
          !announcementSearchTerm ||
          searchable.includes(announcementSearchTerm);

        return categoryMatch && searchMatch;
      })
      .sort((a, b) => {
        const priorityA = a.prioritas === 'penting' ? 1 : 0;
        const priorityB = b.prioritas === 'penting' ? 1 : 0;

        if (priorityA !== priorityB) {
          return priorityB - priorityA;
        }

        return String(b.tanggal || '').localeCompare(String(a.tanggal || ''));
      });

    if (announcementCount) {
      announcementCount.textContent =
        `${filtered.length} pengumuman ditampilkan`;
    }

    if (!filtered.length) {
      announcementGrid.innerHTML = `
        <div class="col-span-full rounded-2xl border border-dashed border-slate-300 bg-white px-6 py-14 text-center">
          <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-slate-100 text-slate-400">
            <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M8 7h8M8 11h8m-8 4h4m-7 5h14a2 2 0 002-2V6a2 2 0 00-2-2H7L5 6v12a2 2 0 002 2z"/>
            </svg>
          </div>
          <h3 class="text-base font-bold text-slate-800">Belum ada pengumuman</h3>
          <p class="mt-1 text-sm text-slate-500">Belum ada informasi yang sesuai dengan pencarian atau kategori ini.</p>
        </div>
      `;
      return;
    }

    announcementGrid.innerHTML = filtered.map((item) => {
      const category = escapeHTML(item.kategori || 'Lainnya');
      const title = escapeHTML(item.judul || 'Pengumuman Desa');
      const summary = escapeHTML(item.ringkasan || '');
      const content = escapeHTML(item.isi || '');
      const date = formatAnnouncementDate(item.tanggal);
      const important = item.prioritas === 'penting';
      const url = safeAnnouncementUrl(item.url);
      const linkLabel = escapeHTML(item.label_tautan || 'Informasi selengkapnya');

      return `
        <article class="announcement-card flex flex-col rounded-2xl border ${important ? 'border-amber-200' : 'border-slate-200'} bg-white p-5 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg sm:p-6">
          <div class="mb-4 flex flex-wrap items-center justify-between gap-2">
            <span class="rounded-lg border px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider ${getAnnouncementBadge(item.kategori)}">
              ${category}
            </span>
            ${important ? `
              <span class="inline-flex items-center gap-1.5 rounded-lg bg-amber-50 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-amber-800">
                <span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span>
                Penting
              </span>
            ` : ''}
          </div>

          <div class="flex-1">
            <h3 class="text-lg font-bold leading-snug text-slate-900">
              ${title}
            </h3>

            <div class="mt-3 flex items-center gap-2 text-xs font-medium text-slate-400">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
              ${date}
            </div>

            <p class="mt-4 text-sm leading-relaxed text-slate-600">
              ${summary}
            </p>
          </div>

          <div class="mt-5 space-y-3 border-t border-slate-100 pt-4">
            ${content ? `
              <details class="announcement-details group">
                <summary class="flex min-h-10 cursor-pointer list-none items-center justify-between gap-3 text-sm font-bold text-blue-900 transition-colors hover:text-blue-700">
                  <span>Baca informasi lengkap</span>
                  <svg class="h-4 w-4 shrink-0 transition-transform duration-200 group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19 9-7 7-7-7"/>
                  </svg>
                </summary>
                <div class="mt-3 whitespace-pre-line rounded-xl bg-slate-50 p-4 text-sm leading-relaxed text-slate-600">
                  ${content}
                </div>
              </details>
            ` : ''}

            ${url ? `
              <a href="${escapeHTML(url)}" ${url.startsWith('http') ? 'target="_blank" rel="noopener noreferrer"' : ''} class="inline-flex min-h-10 items-center gap-2 text-sm font-bold text-blue-800 transition-colors hover:text-blue-950">
                ${linkLabel}
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17 17 7M7 7h10v10"/>
                </svg>
              </a>
            ` : ''}
          </div>

          <div class="mt-4 border-t border-slate-100 pt-3 text-[11px] font-medium text-slate-400">
            Informasi resmi Pemerintah Desa Timpik
          </div>
        </article>
      `;
    }).join('');
  };

  const loadLocalAnnouncements = () => {
    try {
      const stored = localStorage.getItem(announcementStorageKey);
      if (stored) {
        const parsed = JSON.parse(stored);
        if (Array.isArray(parsed)) {
          announcementList = parsed;
        }
      }
    } catch (error) {
      console.warn('Gagal membaca data pengumuman lokal:', error);
    }
  };

  const loadLocalAgenda = () => {
    let list = initialAgenda;

    try {
      const stored = localStorage.getItem(agendaStorageKey);
      if (stored) {
        const parsed = JSON.parse(stored);
        if (Array.isArray(parsed)) {
          list = parsed;
        }
      }
    } catch (error) {
      console.warn('Gagal membaca data agenda:', error);
    }

    return Array.isArray(list) ? list : [];
  };

  announcementSearch?.addEventListener('input', (event) => {
    announcementSearchTerm = event.target.value.trim().toLowerCase();
    renderAnnouncements();
  });

  announcementFilter?.addEventListener('change', (event) => {
    announcementCategory = event.target.value;
    renderAnnouncements();
  });

  loadLocalAnnouncements();

  const initialRemoteContent = window.__timpikSupabaseContent;

  if (Array.isArray(initialRemoteContent?.pengumuman)) {
    announcementList = initialRemoteContent.pengumuman;
  }

  renderAnnouncements();

  window.addEventListener('timpik-supabase-content', (event) => {
    const content = event.detail || {};

    if (Array.isArray(content.pengumuman)) {
      announcementList = content.pengumuman;
      renderAnnouncements();
    }

    if (Array.isArray(content.agenda)) {
      agendaList = content.agenda;
      renderAgenda();
    }
  });

  window.addEventListener('storage', (event) => {
    if (event.key === announcementStorageKey && event.newValue) {
      try {
        const parsed = JSON.parse(event.newValue);
        if (Array.isArray(parsed)) {
          announcementList = parsed;
          renderAnnouncements();
        }
      } catch (error) {
        console.warn('Gagal memperbarui pengumuman:', error);
      }
    }

    if (event.key === agendaStorageKey && event.newValue) {
      try {
        const parsed = JSON.parse(event.newValue);
        if (Array.isArray(parsed)) {
          agendaList = parsed;
          renderAgenda();
        }
      } catch (error) {
        console.warn('Gagal memperbarui agenda:', error);
      }
    }
  });

  let agendaList = loadLocalAgenda();
  let activeCategory = 'Semua Kategori';
  let agendaSearchTerm = '';

  const agendaGrid = document.getElementById('info-agenda-grid');
  const agendaSearch = document.getElementById('info-agenda-search');
  const agendaFilterButtons = document.querySelectorAll('.info-filter-btn');

  const getAgendaBadge = (category) => {
    const colors = {
      Pertanian: 'bg-teal-50 text-teal-800 border-teal-200',
      Kesehatan: 'bg-emerald-50 text-emerald-800 border-emerald-200',
      Kebudayaan: 'bg-indigo-50 text-indigo-800 border-indigo-200',
      Pemerintahan: 'bg-purple-50 text-purple-800 border-purple-200'
    };

    return colors[category] || 'bg-blue-50 text-blue-800 border-blue-200';
  };

  function renderAgenda() {
    if (!agendaGrid) return;

    const filtered = agendaList.filter((item) => {
      const categoryMatch =
        activeCategory === 'Semua Kategori' ||
        item.kategori === activeCategory;

      const searchable = [
        item.nama,
        item.deskripsi,
        item.lokasi,
        item.penyelenggara
      ].join(' ').toLowerCase();

      const searchMatch =
        !agendaSearchTerm ||
        searchable.includes(agendaSearchTerm);

      return categoryMatch && searchMatch;
    });

    if (!filtered.length) {
      agendaGrid.innerHTML = `
        <div class="col-span-full rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center">
          <p class="text-sm font-bold text-slate-700">Tidak ada agenda yang cocok.</p>
          <p class="mt-1 text-xs text-slate-400">Coba kata kunci atau kategori lain.</p>
        </div>
      `;
      return;
    }

    agendaGrid.innerHTML = filtered.map((item) => `
      <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition-all hover:-translate-y-1 hover:shadow-md">
        <div class="space-y-4">
          <div class="flex items-center justify-between gap-2">
            <span class="rounded-lg border px-2.5 py-1 text-xs font-bold ${getAgendaBadge(item.kategori)}">
              ${escapeHTML(item.kategori)}
            </span>
            <span class="rounded-lg bg-slate-50 px-2.5 py-1 font-mono text-xs font-bold text-slate-600">
              ${escapeHTML(item.tanggal)}
            </span>
          </div>

          <h3 class="text-lg font-bold leading-snug text-slate-900">
            ${escapeHTML(item.nama)}
          </h3>

          <p class="text-sm leading-relaxed text-slate-600">
            ${escapeHTML(item.deskripsi)}
          </p>

          <div class="grid grid-cols-1 gap-3 border-t border-slate-100 pt-4 text-sm text-slate-600 sm:grid-cols-2">
            <div class="flex items-center gap-2">
              <svg class="h-4 w-4 shrink-0 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <span>${escapeHTML(item.waktu)}</span>
            </div>

            <div class="flex items-center gap-2">
              <svg class="h-4 w-4 shrink-0 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              </svg>
              <span class="truncate">${escapeHTML(item.lokasi)}</span>
            </div>
          </div>
        </div>

        <div class="mt-4 flex items-center justify-between gap-3 border-t border-slate-100 pt-3 text-xs text-slate-500">
          <span>Penyelenggara: <strong class="text-slate-800">${escapeHTML(item.penyelenggara)}</strong></span>
          <span class="font-bold text-blue-900">${escapeHTML(item.peserta)}</span>
        </div>
      </article>
    `).join('');
  }

  agendaSearch?.addEventListener('input', (event) => {
    agendaSearchTerm = event.target.value.trim().toLowerCase();
    renderAgenda();
  });

  agendaFilterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      activeCategory = button.getAttribute('data-category') || 'Semua Kategori';

      agendaFilterButtons.forEach((item) => {
        item.className = 'info-filter-btn min-h-10 shrink-0 rounded-xl border border-slate-200 bg-white px-4 py-2 text-xs font-bold text-slate-700 transition-all hover:bg-slate-50 sm:text-sm';
      });

      button.className = 'info-filter-btn min-h-10 shrink-0 rounded-xl bg-blue-900 px-4 py-2 text-xs font-bold text-white shadow-sm transition-all sm:text-sm';

      renderAgenda();
    });
  });

  renderAgenda();

  try {
    const rawKontak = localStorage.getItem('timpik_kontak_data');

    if (rawKontak) {
      const parsed = JSON.parse(rawKontak);

      if (parsed?.operasional) {
        const elNama = document.getElementById('info-nama-kantor');
        const elStatus = document.getElementById('info-status-layanan');
        const elJam = document.getElementById('info-jam-operasional');

        if (elNama) elNama.textContent = parsed.operasional.nama_kantor || '';
        if (elStatus) elStatus.textContent = parsed.operasional.status_layanan || 'Informasi belum tersedia';

        if (elJam) {
          elJam.textContent = `Senin–Kamis: ${parsed.operasional.jam_senin_kamis || ''} | Jumat: ${parsed.operasional.jam_jumat || ''}`;
        }
      }
    }
  } catch (error) {
    console.warn('Gagal membaca informasi operasional balai desa:', error);
  }
</script>

<style>
  #info-pengumuman-grid .announcement-card {
    animation: announcement-enter 0.45s ease both;
  }

  #info-pengumuman-grid .announcement-card:nth-child(2) {
    animation-delay: 0.06s;
  }

  #info-pengumuman-grid .announcement-card:nth-child(3) {
    animation-delay: 0.12s;
  }

  #info-pengumuman-grid .announcement-details summary::-webkit-details-marker {
    display: none;
  }

  #info-pengumuman-grid .announcement-details summary {
    list-style: none;
  }

  @keyframes announcement-enter {
    from {
      opacity: 0;
      transform: translateY(12px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #info-pengumuman-grid .announcement-card {
      animation: none;
    }
  }
</style>