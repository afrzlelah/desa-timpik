---
import Layout from '../layouts/Layout.astro';
import potensiData from '../data/potensi.json';
---

<Layout
  title="Potensi Agraris & Seni Budaya Desa Timpik"
  description="Mengenal potensi pertanian, ketahanan pangan, kelembagaan agraris, dan kesenian tradisional Desa Timpik."
>
  <section class="bg-gradient-to-br from-blue-950 via-blue-900 to-blue-700 text-white border-b border-black/10 pt-14 pb-12 sm:pt-16 sm:pb-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-xs uppercase tracking-wider text-slate-300 mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition-colors">Beranda</a>
        <span class="text-slate-500">/</span>
        <span class="text-blue-200 font-semibold">Potensi Desa</span>
      </nav>

      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.18em] text-blue-200 mb-4">
          <span class="w-7 h-px bg-blue-300"></span>
          Kekayaan Desa Timpik
        </span>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight leading-tight">
          Potensi Pertanian & Kesenian
        </h1>

        <p class="text-sm sm:text-base text-blue-100/90 mt-4 leading-relaxed max-w-2xl">
          Mengenal kekuatan sektor agraris, kelembagaan pertanian, serta warisan kesenian yang menjadi bagian dari kehidupan masyarakat Desa Timpik.
        </p>
      </div>
    </div>
  </section>

  <section id="agraris" class="py-12 sm:py-16 bg-slate-50 border-b border-black/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-stretch">

        <div class="lg:col-span-7 rounded-2xl border border-black/10 bg-white p-6 sm:p-8 lg:p-9 shadow-sm flex flex-col justify-center">
          <div class="flex items-center gap-2 mb-4">
            <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
            <span class="text-xs font-bold uppercase tracking-widest text-emerald-800">
              Sektor Agraris
            </span>
          </div>

          <h2 class="text-2xl sm:text-3xl font-black tracking-tight text-slate-900 leading-tight">
            Hamparan Sawah 243 Hektar & Irigasi Mandiri
          </h2>

          <div class="w-16 h-1 bg-blue-800 rounded-full mt-5 mb-6"></div>

          <div class="space-y-4 text-sm sm:text-base text-slate-600 leading-relaxed">
            <p>
              Sebagai desa yang bertumpu pada sektor agraris, Desa Timpik dikaruniai hamparan sawah dan ladang yang produktif. Lebih dari <strong class="text-slate-900">76% penduduk</strong> berprofesi aktif sebagai petani padi, palawija, dan peternak.
            </p>

            <p>
              Keberhasilan siklus panen didukung oleh sinergi kelembagaan pertanian. <strong class="text-slate-900">GAPOKTAN "Putri Kencana"</strong> memfasilitasi pengadaan benih bersertifikat, pupuk bersubsidi, dan alat mesin pertanian. Sementara itu, <strong class="text-slate-900">P3A "Bogo Wastro"</strong> mengelola pembagian debit air irigasi persawahan bagi petani di wilayah Desa Timpik.
            </p>
          </div>

          <div class="grid grid-cols-2 gap-3 mt-8">
            <div class="rounded-xl bg-slate-50 border border-black/10 p-4">
              <span class="block text-2xl sm:text-3xl font-black text-blue-900">243 Ha</span>
              <span class="text-xs text-slate-500 mt-1 block">Luas sektor agraris</span>
            </div>

            <div class="rounded-xl bg-slate-50 border border-black/10 p-4">
              <span class="block text-2xl sm:text-3xl font-black text-emerald-700">76%+</span>
              <span class="text-xs text-slate-500 mt-1 block">Penduduk berprofesi agraris</span>
            </div>
          </div>
        </div>

        <div class="lg:col-span-5 rounded-2xl border border-black/10 bg-white shadow-sm overflow-hidden flex flex-col">
          <div class="p-6 sm:p-7 bg-slate-50 border-b border-black/10">
            <span class="text-xs font-bold uppercase tracking-widest text-blue-800">
              Organisasi & Kelembagaan
            </span>
            <h3 class="text-xl font-black text-slate-900 mt-2">
              Kelembagaan Pertanian
            </h3>
            <p class="text-sm text-slate-500 mt-2 leading-relaxed">
              Lembaga yang mendukung pengelolaan dan keberlanjutan sektor pertanian desa.
            </p>
          </div>

          <div class="divide-y divide-black/10 flex-1">
            <a href="/kelembagaan/gapoktan" class="p-5 sm:p-6 flex items-start justify-between gap-4 hover:bg-blue-50/60 transition-colors group">
              <div>
                <h4 class="font-bold text-slate-900 text-sm sm:text-base group-hover:text-blue-800 transition-colors">
                  GAPOKTAN "Putri Kencana"
                </h4>
                <p class="text-xs sm:text-sm text-slate-500 mt-2 leading-relaxed">
                  Gabungan kelompok tani yang mendukung proses tanam, mekanisasi pertanian, hingga pascapanen.
                </p>
              </div>
              <span class="text-blue-800 font-bold text-lg shrink-0 group-hover:translate-x-1 transition-transform">&rarr;</span>
            </a>

            <a href="/kelembagaan/p3a" class="p-5 sm:p-6 flex items-start justify-between gap-4 hover:bg-blue-50/60 transition-colors group">
              <div>
                <h4 class="font-bold text-slate-900 text-sm sm:text-base group-hover:text-blue-800 transition-colors">
                  P3A "Bogo Wastro"
                </h4>
                <p class="text-xs sm:text-sm text-slate-500 mt-2 leading-relaxed">
                  Perkumpulan petani pemakai air yang mengelola irigasi dan pemeliharaan saluran pertanian.
                </p>
              </div>
              <span class="text-blue-800 font-bold text-lg shrink-0 group-hover:translate-x-1 transition-transform">&rarr;</span>
            </a>

            <a href="/kelembagaan/lpm" class="p-5 sm:p-6 flex items-start justify-between gap-4 hover:bg-blue-50/60 transition-colors group">
              <div>
                <h4 class="font-bold text-slate-900 text-sm sm:text-base group-hover:text-blue-800 transition-colors">
                  Lumbung Pangan Masyarakat
                </h4>
                <p class="text-xs sm:text-sm text-slate-500 mt-2 leading-relaxed">
                  Cadangan pangan masyarakat untuk mendukung ketahanan pangan desa.
                </p>
              </div>
              <span class="text-blue-800 font-bold text-lg shrink-0 group-hover:translate-x-1 transition-transform">&rarr;</span>
            </a>
          </div>
        </div>

      </div>

      <div>
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 mb-6">
          <div>
            <span class="text-xs font-bold uppercase tracking-widest text-emerald-800">
              Hasil Pertanian
            </span>
            <h3 class="text-xl sm:text-2xl font-black text-slate-900 mt-2">
              Komoditas Unggulan Desa
            </h3>
            <p class="text-sm text-slate-500 mt-2">
              Ragam hasil pertanian yang menjadi bagian dari potensi agraris Desa Timpik.
            </p>
          </div>
          <span class="text-xs font-semibold text-slate-500">
            04 Komoditas
          </span>
        </div>

        <div id="potensi-komoditas-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
          {potensiData.agraris.komoditas_utama.map((item, idx) => (
            <article class="rounded-2xl border border-black/10 bg-white p-5 sm:p-6 flex flex-col justify-between gap-5 shadow-sm hover:shadow-md hover:border-blue-900/30 transition-all duration-200">
              <div>
                <span class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-blue-50 text-blue-900 text-xs font-black mb-4">
                  {String(idx + 1).padStart(2, '0')}
                </span>
                <h4 class="font-bold text-base sm:text-lg text-slate-900">
                  {item.nama}
                </h4>
                <p class="text-sm text-slate-500 mt-2 leading-relaxed">
                  {item.deskripsi}
                </p>
              </div>

              <div class="pt-4 border-t border-black/10">
                <span class="text-[10px] uppercase tracking-widest text-emerald-800 font-bold">
                  Komoditas Pertanian
                </span>
              </div>
            </article>
          ))}
        </div>
      </div>

    </div>
  </section>

  <section id="kesenian" class="py-12 sm:py-16 bg-white border-b border-black/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">

      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-4">
        <div class="max-w-3xl">
          <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-blue-800">
            <span class="w-7 h-px bg-blue-800"></span>
            Warisan Budaya
          </span>

          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black tracking-tight text-slate-950 mt-3 leading-tight">
            Kesenian dan Tradisi Masyarakat
          </h2>

          <p class="text-sm sm:text-base text-slate-500 mt-3 leading-relaxed">
            Mengenal kesenian tradisional yang tumbuh dan dipertahankan oleh masyarakat Desa Timpik sebagai bagian dari identitas budaya lokal.
          </p>
        </div>

        <span class="text-xs font-semibold text-slate-500 shrink-0">
          Seni & Budaya Desa Timpik
        </span>
      </div>

      <div id="potensi-kesenian-grid" class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-5">
        {potensiData.kebudayaan.kesenian.map((seni) => (
          <article class="rounded-2xl border border-black/10 bg-slate-50 p-6 sm:p-8 flex flex-col justify-between gap-7 shadow-sm hover:shadow-md hover:border-blue-900/30 transition-all duration-200">
            <div>
              <div class="flex items-center justify-between gap-3 mb-6">
                <span class="text-xs font-bold uppercase tracking-widest text-blue-800">
                  Seni dan Budaya
                </span>

                <a
                  href={seni.lokasi.toLowerCase().includes('bogo') ? '/dusun/bogo' : seni.lokasi.toLowerCase().includes('sumber') ? '/dusun/sumber' : '#'}
                  class="rounded-full text-xs font-bold px-3 py-2 bg-white text-blue-900 border border-black/10 hover:border-blue-900/30 hover:bg-blue-50 transition-colors"
                >
                  {seni.lokasi} &rarr;
                </a>
              </div>

              <h3 class="text-xl sm:text-2xl font-black text-slate-950 leading-snug">
                {seni.nama}
              </h3>

              <p class="text-sm sm:text-base text-slate-600 mt-4 leading-relaxed">
                {seni.deskripsi}
              </p>
            </div>

            <div class="pt-4 border-t border-black/10 flex items-center justify-between gap-3">
              <span class="text-xs font-semibold text-slate-500">
                Kesenian lokal Desa Timpik
              </span>
              <span class="text-blue-900 text-lg">&rarr;</span>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

  <script>
    const escapePotensi = (value: unknown): string => {
      const entities: Record<string, string> = {
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;'
      };

      return String(value ?? '').replace(/[&<>"']/g, (char) => entities[char]);
    };

    const getLokasiUrl = (lokasi: unknown): string => {
      const value = String(lokasi ?? '').toLowerCase();

      if (value.includes('bogo')) return '/dusun/bogo';
      if (value.includes('sumber')) return '/dusun/sumber';

      return '#';
    };

    const renderPotensi = (data: any) => {
      const komoditasGrid = document.getElementById('potensi-komoditas-grid');

      if (komoditasGrid && Array.isArray(data?.agraris?.komoditas_utama)) {
        const komoditas = data.agraris.komoditas_utama;

        komoditasGrid.innerHTML = komoditas.length
          ? komoditas.map((item: any, idx: number) => `
              <article class="rounded-2xl border border-black/10 bg-white p-5 sm:p-6 flex flex-col justify-between gap-5 shadow-sm hover:shadow-md hover:border-blue-900/30 transition-all duration-200">
                <div>
                  <span class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-blue-50 text-blue-900 text-xs font-black mb-4">
                    ${String(idx + 1).padStart(2, '0')}
                  </span>
                  <h4 class="font-bold text-base sm:text-lg text-slate-900">
                    ${escapePotensi(item.nama)}
                  </h4>
                  <p class="text-sm text-slate-500 mt-2 leading-relaxed">
                    ${escapePotensi(item.deskripsi)}
                  </p>
                </div>
                <div class="pt-4 border-t border-black/10">
                  <span class="text-[10px] uppercase tracking-widest text-emerald-800 font-bold">
                    Komoditas Pertanian
                  </span>
                </div>
              </article>
            `).join('')
          : '<p class="col-span-full text-sm text-slate-500 text-center py-8">Data komoditas belum tersedia.</p>';
      }

      const kesenianGrid = document.getElementById('potensi-kesenian-grid');

      if (kesenianGrid && Array.isArray(data?.kebudayaan?.kesenian)) {
        const kesenian = data.kebudayaan.kesenian;

        kesenianGrid.innerHTML = kesenian.length
          ? kesenian.map((seni: any) => {
              const lokasiUrl = getLokasiUrl(seni.lokasi);
              const lokasi = escapePotensi(seni.lokasi);
              const nama = escapePotensi(seni.nama);
              const deskripsi = escapePotensi(seni.deskripsi);

              return `
                <article class="rounded-2xl border border-black/10 bg-slate-50 p-6 sm:p-8 flex flex-col justify-between gap-7 shadow-sm hover:shadow-md hover:border-blue-900/30 transition-all duration-200">
                  <div>
                    <div class="flex items-center justify-between gap-3 mb-6">
                      <span class="text-xs font-bold uppercase tracking-widest text-blue-800">
                        Seni dan Budaya
                      </span>
                      <a href="${lokasiUrl}" class="rounded-full text-xs font-bold px-3 py-2 bg-white text-blue-900 border border-black/10 hover:border-blue-900/30 hover:bg-blue-50 transition-colors">
                        ${lokasi} &rarr;
                      </a>
                    </div>
                    <h3 class="text-xl sm:text-2xl font-black text-slate-950 leading-snug">
                      ${nama}
                    </h3>
                    <p class="text-sm sm:text-base text-slate-600 mt-4 leading-relaxed">
                      ${deskripsi}
                    </p>
                  </div>
                  <div class="pt-4 border-t border-black/10 flex items-center justify-between gap-3">
                    <span class="text-xs font-semibold text-slate-500">
                      Kesenian lokal Desa Timpik
                    </span>
                    <span class="text-blue-900 text-lg">&rarr;</span>
                  </div>
                </article>
              `;
            }).join('')
          : '<p class="col-span-full text-sm text-slate-500 text-center py-8">Data kesenian belum tersedia.</p>';
      }
    };

    const loadPotensi = () => {
      const supabaseContent = (window as any).__timpikSupabaseContent;
      const initialPotensi = supabaseContent?.potensi;

      if (initialPotensi) {
        renderPotensi(initialPotensi);
      }
    };

    loadPotensi();

    window.addEventListener('timpik-supabase-content', (event: Event) => {
      const customEvent = event as CustomEvent;
      const data = customEvent.detail?.potensi;

      if (data) {
        renderPotensi(data);
      }
    });
  </script>
</Layout>