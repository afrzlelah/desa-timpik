---
import Layout from '../layouts/Layout.astro';
import potensiData from '../data/potensi.json';
---

<Layout
  title="Potensi Agraris & Seni Budaya Desa Timpik"
  description="Kekayaan potensi Desa Timpik: sektor agraris 243 Ha, lumbung pangan padi, kesenian Wayang Orang Badoyo Dusun Bogo, Karawitan, dan Tari Angguk Alhidayah."
>
  <!-- Architectural Civic Header -->
  <section class="bg-gradient-to-br from-blue-950 via-blue-900 to-blue-700 text-white border-b border-white/20 pt-14 pb-12 sm:pt-16 sm:pb-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs  uppercase tracking-wider text-slate-400 mb-5" aria-label="Breadcrumb">
        <a href="/" class="hover:text-civic-cream transition-colors">Beranda</a>
        <span class="text-slate-600">/</span>
        <span class="text-civic-gold">Potensi Desa</span>
      </nav>

      <div class="max-w-3xl space-y-3">
        <div class="flex items-center gap-2.5">
        </div>
        
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-serif  font-black tracking-tight text-white leading-tight">
          Potensi Pertanian & Kesenian
        </h1>
        
        <!-- <p class="text-slate-300 text-sm sm:text-base leading-relaxed pt-1">
          Menelusuri kesuburan tanah persawahan 243 Hektar di lereng Merbabu, manajemen air P3A Bogo Wastro, serta kemegahan seni pertunjukan Wayang Orang Badoyo warisan leluhur warga Desa Timpik.
        </p> -->
      </div>

    </div>
  </section>

  <!-- Part 1: Sektor Agraris & Ketahanan Pangan -->
  <section id="agraris" class="py-14 sm:py-16 bg-gray-100 border-b border-white/70">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
        
        <div class="lg:col-span-7 space-y-5">
          <div class="border-b border-civic-border pb-3">
            <!-- <span class="text-[10px]  uppercase tracking-widest text-emerald-800 block">Sektor Pangan Unggulan</span> -->
            <h2 class="text-2xl sm:text-3xl  font-black text-civic-navy mt-1">
              Hamparan Sawah 243 Hektar & Irigasi Mandiri
            </h2>
          </div>

          <p class="text-civic-ink text-sm sm:text-base leading-relaxed">
            Sebagai desa yang bertumpu pada sektor agraris, Desa Timpik dikaruniai hamparan sawah dan ladang yang sangat produktif. Lebih dari <strong>76% penduduk</strong> berprofesi aktif sebagai petani padi, palawija, dan peternak.
          </p>

          <p class="text-civic-ink text-sm sm:text-base leading-relaxed">
            Keberhasilan siklus panen didukung penuh oleh sinergi dua kelembagaan utama: <strong>GAPOKTAN "Putri Kencana"</strong> yang memfasilitasi pengadaan benih bersertifikat, pupuk bersubsidi, dan alat mesin pertanian; serta <strong>P3A "Bogo Wastro"</strong> yang mengelola tata pembagian debit air irigasi persawahan secara adil bagi seluruh petani 4 dusun.
          </p>
        </div>

        <div class="lg:col-span-5 glass-panel rounded-2xl overflow-hidden divide-y divide-slate-200/70">
          <div class="p-5 bg-blue-800/10">
            <h3 class=" font-bold text-civic-navy text-base">Kelembagaan Pertanian Timpik:</h3>
          </div>

          <a href="/kelembagaan/gapoktan" class="p-5 block hover:bg-blue-800/10 transition-colors group">
            <div class="flex items-center justify-between">
              <h4 class=" font-bold text-civic-navy group-hover:text-civic-gold text-sm">GAPOKTAN "Putri Kencana"</h4>
              <span class="text-xs  text-civic-gold font-bold">&rarr;</span>
            </div>
            <p class="text-xs text-civic-muted mt-1 leading-relaxed">Gabungan kelompok tani yang mengawal proses tanam, mekanisasi traktor & combine harvester, hingga pasca-panen.</p>
          </a>

          <a href="/kelembagaan/p3a" class="p-5 block hover:bg-blue-800/10 transition-colors group">
            <div class="flex items-center justify-between">
              <h4 class=" font-bold text-civic-navy group-hover:text-civic-gold text-sm">P3A "Bogo Wastro"</h4>
              <span class="text-xs  text-civic-gold font-bold">&rarr;</span>
            </div>
            <p class="text-xs text-civic-muted mt-1 leading-relaxed">Perkumpulan petani pemakai air yang mengelola debit irigasi persawahan teknis dan pemeliharaan saluran parit.</p>
          </a>

          <a href="/kelembagaan/lpm" class="p-5 block hover:bg-blue-800/10 transition-colors group">
            <div class="flex items-center justify-between">
              <h4 class=" font-bold text-civic-navy group-hover:text-civic-gold text-sm">Lumbung Pangan Masyarakat (LPM)</h4>
              <span class="text-xs  text-civic-gold font-bold">&rarr;</span>
            </div>
            <p class="text-xs text-civic-muted mt-1 leading-relaxed">Cadangan gabah darurat desa guna melindungi ketahanan pangan warga dari fluktuasi cuaca.</p>
          </a>
        </div>

      </div>

      <!-- 4 Komoditas Ledger -->
      <div>
        <div class="border-b border-civic-border pb-3 mb-6">
          <!-- <span class="text-xs  uppercase tracking-widest text-civic-gold block">Hasil Bumi Utama</span> -->
          <h3 class="text-xl  font-black text-civic-navy">Empat Komoditas Unggulan Sawah Desa</h3>
        </div>

        <div id="potensi-komoditas-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {potensiData.agraris.komoditas_utama.map((item, idx) => (
            <div class="glass-panel rounded-2xl p-6 flex flex-col justify-between space-y-3">
              <div>
                <span class="text-xs  text-civic-gold font-bold block mb-1">0{idx + 1}</span>
                <h4 class=" font-bold text-base text-civic-navy">{item.nama}</h4>
                <p class="text-xs text-civic-muted mt-2 leading-relaxed">{item.deskripsi}</p>
              </div>
              <span class="text-[10px]  uppercase tracking-wider text-emerald-800 font-bold block pt-2 border-t border-civic-border/60">
                Lumbung Timpik
              </span>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>

  <!-- Part 2: Warisan Seni Budaya Adiluhung -->
  <section id="kesenian" class="py-14 sm:py-16 bg-gray-100 text-slate-900 border-y border-white/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="max-w-3xl">
        <div class="flex items-center gap-2 mb-2">
          <span class="h-1 w-8 rounded-full bg-blue-800"></span>
          <!-- <span class="text-xs  uppercase tracking-widest text-civic-gold">Warisan Luhur Lintas Generasi</span> -->
        </div>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black tracking-tight text-slate-950">
          Kesenian Wayang Orang, Karawitan & Tari Angguk
        </h2>
        <!-- <p class="text-slate-300 text-sm sm:text-base mt-2 leading-relaxed">
          Kesenian di Desa Timpik bukan sekadar atraksi pentas, melainkan tuntunan budi pekerti luhur dan perekat kebersamaan warga 4 dusun yang dipelihara secara turun-temurun.
        </p> -->
      </div>

      <!-- Kesenian Cards Grid -->
      <div id="potensi-kesenian-grid" class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {potensiData.kebudayaan.kesenian.map((seni) => (
          <div class="glass-panel rounded-2xl p-6 sm:p-8 flex flex-col justify-between space-y-6">
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <a
                  href={seni.lokasi.includes('Bogo') ? '/dusun/bogo' : '/dusun/sumber'}
                  class="rounded-full text-xs uppercase tracking-wide px-3 py-2 bg-blue-800/10 text-blue-950 border border-blue-800/20 hover:bg-blue-800/15 transition-colors font-bold"
                >
                  {seni.lokasi} &rarr;
                </a>
                
              </div>

              <h3 class="text-2xl font-bold text-slate-950">
                {seni.nama}
              </h3>

              <p class="text-slate-700 text-sm sm:text-base leading-relaxed">
                {seni.deskripsi}
              </p>

              {/* <div class="p-4 bg-sky-50/5 border border-white/10 text-xs text-white font-sans">
                <strong>Keunikan Tradisi:</strong> {seni.keunikan}
              </div> */}
            </div>

            <div class="pt-4 border-t border-slate-200 flex items-center justify-between text-sm">
              <a href="/layanan-surat" class="text-blue-900 hover:text-blue-700 font-bold inline-flex items-center gap-1">
                <span>Izin Pentas Seni &rarr;</span>
              </a>
            </div>
          </div>
        ))}
      </div>

      <!-- Gapura Punokawan Callout -->
      <div class="glass-panel-blue p-6 sm:p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6 rounded-2xl">
        <div class="space-y-2 max-w-3xl">
          <span class="text-xs uppercase tracking-widest text-blue-100 font-bold block">
            Filosofi Arsitektur Balai Desa
          </span>
          <h3 class="text-xl sm:text-2xl  font-bold text-white">Patung Tokoh Wayang Punokawan di Gerbang Utama</h3>
          <p class="text-sm sm:text-base text-blue-50 leading-relaxed font-sans">
            Pada gerbang masuk Balai Desa Timpik terpasang ornamen tokoh Punokawan (Semar, Petruk, Gareng, Bagong). Ini melambangkan pengayoman pemerintah desa yang bijaksana, merakyat, tulus, dan selalu mendengarkan aspirasi warga masyarakat.
          </p>
        </div>
        <div class="shrink-0">
          <a
            href="/"
            class="px-5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white  text-xs uppercase tracking-wider font-bold transition-colors inline-block rounded-lg shadow-sm"
          >
            Lihat di Beranda &rarr;
          </a>
        </div>
      </div>

    </div>
  </section>
  <script>
    const escapePotensi = (value: unknown) => String(value ?? '').replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char]!));
    const renderPotensi = (data: any) => {
      const komoditasGrid = document.getElementById('potensi-komoditas-grid');
      if (komoditasGrid && Array.isArray(data?.agraris?.komoditas_utama)) {
        komoditasGrid.innerHTML = data.agraris.komoditas_utama.map((item: any, idx: number) => `
          <div class="glass-panel rounded-2xl p-6 flex flex-col justify-between space-y-3">
            <div><span class="text-xs text-civic-gold font-bold block mb-1">${String(idx + 1).padStart(2, '0')}</span><h4 class="font-bold text-base text-civic-navy">${escapePotensi(item.nama)}</h4><p class="text-xs text-civic-muted mt-2 leading-relaxed">${escapePotensi(item.deskripsi)}</p></div>
            <span class="text-[10px] uppercase tracking-wider text-emerald-800 font-bold block pt-2 border-t border-civic-border/60">Lumbung Timpik</span>
          </div>`).join('');
      }
      const kesenianGrid = document.getElementById('potensi-kesenian-grid');
      if (kesenianGrid && Array.isArray(data?.kebudayaan?.kesenian)) {
        kesenianGrid.innerHTML = data.kebudayaan.kesenian.map((seni: any) => `
          <div class="glass-panel rounded-2xl p-6 sm:p-8 flex flex-col justify-between space-y-6">
            <div class="space-y-4"><div class="flex items-center justify-between"><a href="${String(seni.lokasi || '').toLowerCase().includes('bogo') ? '/dusun/bogo' : '/dusun/sumber'}" class="rounded-full text-xs uppercase tracking-wide px-3 py-2 bg-blue-800/10 text-blue-950 border border-blue-800/20 hover:bg-blue-800/15 transition-colors font-bold">${escapePotensi(seni.lokasi)} &rarr;</a></div>
            <h3 class="text-2xl font-bold text-slate-950">${escapePotensi(seni.nama)}</h3><p class="text-slate-700 text-sm sm:text-base leading-relaxed">${escapePotensi(seni.deskripsi)}</p></div>
            <div class="pt-4 border-t border-slate-200 flex items-center justify-between text-sm"><a href="/layanan-surat" class="text-blue-900 hover:text-blue-700 font-bold inline-flex items-center gap-1">Izin Pentas Seni &rarr;</a></div>
          </div>`).join('');
      }
    };
    const initialPotensi = (window as any).__timpikSupabaseContent?.potensi;
    if (initialPotensi) renderPotensi(initialPotensi);
    window.addEventListener('timpik-supabase-content', (event) => {
      const data = (event as CustomEvent).detail?.potensi;
      if (data) renderPotensi(data);
    });
  </script>
</Layout>
