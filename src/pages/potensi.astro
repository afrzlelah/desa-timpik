---
import Layout from '../layouts/Layout.astro';
import potensiData from '../data/potensi.json';
---

<Layout
  title="Potensi Agraris & Seni Budaya Desa Timpik"
  description="Mengenal potensi pertanian, ketahanan pangan, kelembagaan agraris, dan kesenian tradisional Desa Timpik."
>
  <section class="bg-gradient-to-br from-blue-950 via-blue-900 to-blue-700 text-white border-b border-black/10 pt-14 pb-12 sm:pt-16 sm:pb-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-xs uppercase tracking-wider text-slate-300 mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition-colors">Beranda</a>
        <span class="text-slate-500">/</span>
        <span class="text-blue-200 font-semibold">Potensi Desa</span>
      </nav>

      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.18em] text-blue-200 mb-4">
          <span class="w-7 h-px bg-blue-300"></span>
          Kekayaan Desa Timpik
        </span>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight leading-tight">
          Potensi Pertanian & Kesenian
        </h1>
      </div>
    </div>
  </section>

  <section id="agraris" class="border-b border-slate-200 bg-slate-50 py-14 sm:py-20">
    <div class="mx-auto max-w-7xl space-y-12 px-4 sm:px-6 lg:px-8">

      <!-- Section Heading -->
      <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <div>
          <span class="text-xs font-bold uppercase tracking-[0.18em] text-emerald-700">Potensi Unggulan Desa</span>
          <h2 class="mt-2 text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">
            Sektor Agraris & Pertanian
          </h2>
          <p class="mt-2 max-w-2xl text-sm leading-relaxed text-slate-500 sm:text-base">
            Mengenal kondisi pertanian, komoditas unggulan, dan sumber penghidupan masyarakat Desa Timpik.
          </p>
        </div>

        <span class="inline-flex w-fit shrink-0 items-center gap-2 rounded-full border border-emerald-200 bg-emerald-50 px-3.5 py-2 text-xs font-bold text-emerald-800">
          <span class="size-2 rounded-full bg-emerald-600"></span>
          Sektor Agraris
        </span>
      </div>

      <!-- Main Agraris Card: Full Width -->
      <article class="w-full overflow-hidden rounded-3xl border border-emerald-200 bg-white shadow-sm">

        <!-- Agraris Header -->
        <div class="relative isolate overflow-hidden bg-gradient-to-br from-emerald-950 via-emerald-900 to-emerald-800 px-6 py-8 sm:px-9 sm:py-10 lg:px-12 lg:py-12">
          <div class="absolute -right-12 -top-20 size-64 rounded-full border border-white/10"></div>
          <div class="absolute -right-5 -top-12 size-44 rounded-full border border-white/10"></div>
          <div class="absolute -bottom-24 left-1/2 size-64 rounded-full bg-emerald-400/10 blur-3xl"></div>

          <div class="relative z-10 max-w-4xl">
            <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-emerald-200">
              <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 22v-8m0 0c-4.5 0-8-3.5-8-8 4.5 0 8 3.5 8 8Zm0 0c0-4.5 3.5-8 8-8 0 4.5-3.5 8-8 8Z"/>
              </svg>
              Gambaran Sektor Pertanian
            </span>

            <h3 id="potensi-agraris-title" class="mt-4 text-2xl font-black leading-tight tracking-tight text-white sm:text-3xl lg:text-4xl">
              Hamparan Sawah & Irigasi Mandiri
            </h3>

            <div class="my-5 h-1 w-16 rounded-full bg-emerald-400"></div>

            <p id="potensi-agraris-description" class="max-w-3xl text-sm leading-relaxed text-emerald-100 sm:text-base sm:leading-8">
              {potensiData.agraris.deskripsi}
            </p>
          </div>
        </div>

        <!-- Agraris Statistics -->
        <div class="grid grid-cols-1 divide-y divide-slate-100 sm:grid-cols-2 sm:divide-x sm:divide-y-0">

          <div class="flex items-center gap-4 p-6 sm:p-8">
            <div class="flex size-12 shrink-0 items-center justify-center rounded-2xl bg-blue-50 text-blue-800">
              <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="m3 7 6-4 6 4 6-4v14l-6 4-6-4-6 4V7Zm6-4v14m6-10v14"/>
              </svg>
            </div>

            <div class="min-w-0">
              <span class="block text-xs font-bold uppercase tracking-wider text-slate-400">
                Luas Wilayah Agraris
              </span>
              <span id="potensi-agraris-area" class="mt-1 block text-2xl font-black text-slate-900 sm:text-3xl">
                {potensiData.agraris.luas_wilayah}
              </span>
            </div>
          </div>

          <div class="flex items-center gap-4 p-6 sm:p-8">
            <div class="flex size-12 shrink-0 items-center justify-center rounded-2xl bg-emerald-50 text-emerald-700">
              <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2m16 0v-2a4 4 0 0 0-3-3.87M14 3.13a4 4 0 0 1 0 7.75M14 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z"/>
              </svg>
            </div>

            <div class="min-w-0">
              <span class="block text-xs font-bold uppercase tracking-wider text-slate-400">
                Mata Pencaharian
              </span>
              <span id="potensi-agraris-livelihood" class="mt-1 block text-2xl font-black text-slate-900 sm:text-3xl">
                {potensiData.agraris.mayoritas_mata_pencaharian}
              </span>
            </div>
          </div>

        </div>
      </article>

      <!-- Komoditas Unggulan -->
      <div class="space-y-6">
        <div class="flex flex-col justify-between gap-3 sm:flex-row sm:items-end">
          <div>
            <span class="text-xs font-bold uppercase tracking-[0.18em] text-emerald-700">Hasil Pertanian</span>
            <h3 class="mt-2 text-xl font-extrabold tracking-tight text-slate-900 sm:text-2xl">
              Komoditas Unggulan Desa
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-500">
              Ragam hasil pertanian yang menjadi bagian dari potensi agraris Desa Timpik.
            </p>
          </div>

          <span id="potensi-komoditas-count" class="w-fit shrink-0 rounded-full border border-slate-200 bg-white px-3 py-1.5 text-xs font-bold text-slate-600">
            {String(potensiData.agraris.komoditas_utama.length).padStart(2, '0')} Komoditas
          </span>
        </div>

        <div id="potensi-komoditas-grid" class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {potensiData.agraris.komoditas_utama.map((item, idx) => (
            <article class="group flex h-full flex-col justify-between gap-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-emerald-300 hover:shadow-md sm:p-6">
              <div>
                <div class="mb-5 flex items-center justify-between">
                  <span class="flex size-10 items-center justify-center rounded-xl bg-emerald-50 text-xs font-black text-emerald-800 transition-colors group-hover:bg-emerald-700 group-hover:text-white">
                    {String(idx + 1).padStart(2, '0')}
                  </span>

                  <svg class="size-5 text-emerald-700 transition-transform duration-300 group-hover:rotate-12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 22v-8m0 0c-4.5 0-8-3.5-8-8 4.5 0 8 3.5 8 8Zm0 0c0-4.5 3.5-8 8-8 0 4.5-3.5 8-8 8Z"/>
                  </svg>
                </div>

                <h4 class="text-lg font-extrabold text-slate-900 transition-colors group-hover:text-emerald-800">
                  {item.nama}
                </h4>

                <p class="mt-3 text-sm leading-relaxed text-slate-500">
                  {item.deskripsi}
                </p>
              </div>

              <div class="border-t border-slate-100 pt-4">
                <span class="text-[10px] font-bold uppercase tracking-[0.15em] text-emerald-700">
                  Komoditas Pertanian
                </span>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="kesenian" class="py-12 sm:py-16 bg-white border-b border-black/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">

      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-4">
        <div class="max-w-3xl">
          <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-blue-800">
            <span class="w-7 h-px bg-blue-800"></span>
            Warisan Budaya
          </span>

            <h2 id="potensi-budaya-title" class="text-2xl sm:text-3xl lg:text-4xl font-black tracking-tight text-slate-950 mt-3 leading-tight">
            Kesenian dan Tradisi Masyarakat
          </h2>

          <p id="potensi-budaya-description" class="text-sm sm:text-base text-slate-500 mt-3 leading-relaxed">
            Mengenal kesenian tradisional yang tumbuh dan dipertahankan oleh masyarakat Desa Timpik sebagai bagian dari identitas budaya lokal.
          </p>
        </div>

        <span id="potensi-kesenian-count" class="text-xs font-semibold text-slate-500 shrink-0">
          {String(potensiData.kebudayaan.kesenian.length).padStart(2, '0')} Seni & Budaya
        </span>
      </div>

      <div id="potensi-kesenian-grid" class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-5">
        {potensiData.kebudayaan.kesenian.map((seni) => (
          <article class="rounded-2xl border border-black/10 bg-slate-50 p-6 sm:p-8 flex flex-col justify-between gap-7 shadow-sm hover:shadow-md hover:border-blue-900/30 transition-all duration-200">
            <div>
              <div class="flex items-center justify-between gap-3 mb-6">
                <span class="text-xs font-bold uppercase tracking-widest text-blue-800">
                  Seni dan Budaya
                </span>

                <a
                  href={seni.lokasi.toLowerCase().includes('bogo') ? '/dusun/bogo' : seni.lokasi.toLowerCase().includes('sumber') ? '/dusun/sumber' : '#'}
                  class="rounded-full text-xs font-bold px-3 py-2 bg-white text-blue-900 border border-black/10 hover:border-blue-900/30 hover:bg-blue-50 transition-colors"
                >
                  {seni.lokasi} &rarr;
                </a>
              </div>

              <h3 class="text-xl sm:text-2xl font-black text-slate-950 leading-snug">
                {seni.nama}
              </h3>

              <p class="text-sm sm:text-base text-slate-600 mt-4 leading-relaxed">
                {seni.deskripsi}
              </p>
            </div>

            <div class="pt-4 border-t border-black/10 flex items-center justify-between gap-3">
              <span class="text-xs font-semibold text-slate-500">
                Kesenian lokal Desa Timpik
              </span>
              <span class="text-blue-900 text-lg">&rarr;</span>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

  <script>
    const escapePotensi = (value: unknown): string => {
      const entities: Record<string, string> = {
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;'
      };

      return String(value ?? '').replace(/[&<>"']/g, (char) => entities[char]);
    };

    const getLokasiUrl = (lokasi: unknown): string => {
      const value = String(lokasi ?? '').toLowerCase();

      if (value.includes('bogo')) return '/dusun/bogo';
      if (value.includes('sumber')) return '/dusun/sumber';

      return '#';
    };

    const renderPotensi = (data: any) => {
      const agrarisTitle = document.getElementById('potensi-agraris-title');
      if (agrarisTitle && data?.agraris?.judul !== undefined) agrarisTitle.textContent = data.agraris.judul;
      const agrarisDescription = document.getElementById('potensi-agraris-description');
      if (agrarisDescription && data?.agraris?.deskripsi !== undefined) agrarisDescription.textContent = data.agraris.deskripsi;
      const agrarisArea = document.getElementById('potensi-agraris-area');
      if (agrarisArea && data?.agraris?.luas_wilayah !== undefined) agrarisArea.textContent = data.agraris.luas_wilayah;
      const livelihood = document.getElementById('potensi-agraris-livelihood');
      if (livelihood && data?.agraris?.mayoritas_mata_pencaharian !== undefined) livelihood.textContent = data.agraris.mayoritas_mata_pencaharian;

      const budayaTitle = document.getElementById('potensi-budaya-title');
      if (budayaTitle && data?.kebudayaan?.judul !== undefined) budayaTitle.textContent = data.kebudayaan.judul;
      const budayaDescription = document.getElementById('potensi-budaya-description');
      if (budayaDescription && data?.kebudayaan?.deskripsi !== undefined) budayaDescription.textContent = data.kebudayaan.deskripsi;

      const komoditasGrid = document.getElementById('potensi-komoditas-grid');

      if (komoditasGrid && Array.isArray(data?.agraris?.komoditas_utama)) {
        const komoditas = data.agraris.komoditas_utama;

        komoditasGrid.innerHTML = komoditas.length
          ? komoditas.map((item: any, idx: number) => `
              <article class="rounded-2xl border border-black/10 bg-white p-5 sm:p-6 flex flex-col justify-between gap-5 shadow-sm hover:shadow-md hover:border-blue-900/30 transition-all duration-200">
                <div>
                  <span class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-blue-50 text-blue-900 text-xs font-black mb-4">
                    ${String(idx + 1).padStart(2, '0')}
                  </span>
                  <h4 class="font-bold text-base sm:text-lg text-slate-900">
                    ${escapePotensi(item.nama)}
                  </h4>
                  <p class="text-sm text-slate-500 mt-2 leading-relaxed">
                    ${escapePotensi(item.deskripsi)}
                  </p>
                </div>
                <div class="pt-4 border-t border-black/10">
                  <span class="text-[10px] uppercase tracking-widest text-emerald-800 font-bold">
                    Komoditas Pertanian
                  </span>
                </div>
              </article>
            `).join('')
          : '<p class="col-span-full text-sm text-slate-500 text-center py-8">Data komoditas belum tersedia.</p>';
      }

      const kesenianGrid = document.getElementById('potensi-kesenian-grid');

      if (kesenianGrid && Array.isArray(data?.kebudayaan?.kesenian)) {
        const kesenian = data.kebudayaan.kesenian;
        const kesenianCount = document.getElementById('potensi-kesenian-count');
        if (kesenianCount) kesenianCount.textContent = `${String(kesenian.length).padStart(2, '0')} Seni & Budaya`;

        kesenianGrid.innerHTML = kesenian.length
          ? kesenian.map((seni: any) => {
              const lokasiUrl = getLokasiUrl(seni.lokasi);
              const lokasi = escapePotensi(seni.lokasi);
              const nama = escapePotensi(seni.nama);
              const deskripsi = escapePotensi(seni.deskripsi);

              return `
                <article class="rounded-2xl border border-black/10 bg-slate-50 p-6 sm:p-8 flex flex-col justify-between gap-7 shadow-sm hover:shadow-md hover:border-blue-900/30 transition-all duration-200">
                  <div>
                    <div class="flex items-center justify-between gap-3 mb-6">
                      <span class="text-xs font-bold uppercase tracking-widest text-blue-800">
                        Seni dan Budaya
                      </span>
                      <a href="${lokasiUrl}" class="rounded-full text-xs font-bold px-3 py-2 bg-white text-blue-900 border border-black/10 hover:border-blue-900/30 hover:bg-blue-50 transition-colors">
                        ${lokasi} &rarr;
                      </a>
                    </div>
                    <h3 class="text-xl sm:text-2xl font-black text-slate-950 leading-snug">
                      ${nama}
                    </h3>
                    <p class="text-sm sm:text-base text-slate-600 mt-4 leading-relaxed">
                      ${deskripsi}
                    </p>
                  </div>
                  <div class="pt-4 border-t border-black/10 flex items-center justify-between gap-3">
                    <span class="text-xs font-semibold text-slate-500">
                      Kesenian lokal Desa Timpik
                    </span>
                    <span class="text-blue-900 text-lg">&rarr;</span>
                  </div>
                </article>
              `;
            }).join('')
          : '<p class="col-span-full text-sm text-slate-500 text-center py-8">Data kesenian belum tersedia.</p>';
      }
    };

    const loadPotensi = () => {
      const supabaseContent = (window as any).__timpikSupabaseContent;
      const initialPotensi = supabaseContent?.potensi;

      if (initialPotensi) {
        renderPotensi(initialPotensi);
      }
    };

    loadPotensi();

    window.addEventListener('timpik-supabase-content', (event: Event) => {
      const customEvent = event as CustomEvent;
      const data = customEvent.detail?.potensi;

      if (data) {
        renderPotensi(data);
      }
    });

    window.addEventListener('storage', (event: StorageEvent) => {
      if (event.key !== 'timpik_potensi_data' || !event.newValue) return;
      try {
        renderPotensi(JSON.parse(event.newValue));
      } catch (error) {
        console.warn('Data potensi terbaru tidak dapat dibaca.', error);
      }
    });
  </script>
</Layout>
